{
  "hooks": {
    "UserPromptSubmit": [{"hooks": [{"type": "command", "command": "\"$HOME/.local/bin/stella\" hook prompt", "timeout": 30}]}],
    "SessionStart": [{"hooks": [{"type": "command", "command": "\"$HOME/.local/bin/stella\" hook session-start", "timeout": 30}]}],
    "SessionEnd": [{"hooks": [{"type": "command", "command": "\"$HOME/.local/bin/stella\" hook session-end", "timeout": 30}]}],
    "PreToolUse": [{"matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit", "hooks": [{"type": "command", "command": "\"$HOME/.local/bin/stella\" hook pretool", "timeout": 30}]}]
  }
}
