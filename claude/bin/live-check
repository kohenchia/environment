#!/usr/bin/python3 -I
"""live-check: prove that a step disturbed no running Claude Code session.

    live-check before        record every live Claude process (pid, start time, terminal, session, state,
                             token mode) as the baseline
    live-check diff          compare the live processes with the baseline; exit 1 if any process is gone,
                             was restarted (same pid, new start time) or changed token mode
    live-check show          print what is live now

A session lives in the Claude daemon as a `--bg-pty-host` process, plus any number of terminal clients
attached to it. Restarting a session (respawn, a token switch, a crash) replaces its pty host, so a
missing host pid or a changed start time is exactly what "disturbed" means. Clients (terminal windows
attached to a session, agents views) may come and go: they are listed, never counted as disturbance.

The process table comes from `ps`, so this must run where `ps` may run (outside the machine's command
sandbox, e.g. through the stella helper). Session state comes from ~/.claude/jobs/<id>/state.json and token
mode from ~/.local/state/claude-token/sessions/<session-id>, when those exist. Standard library only.
"""

from __future__ import annotations

import json
import os
import re
import subprocess
import sys
import time
from pathlib import Path

HOME = Path.home()
JOBS = HOME / ".claude/jobs"
TOKENS = Path(os.environ.get("CLAUDE_TOKEN_STATE", HOME / ".local/state/claude-token")) / "sessions"
STATE = Path(os.environ.get("LIVE_CHECK_STATE", HOME / ".local/state/stella/live-check"))
BASELINE = STATE / "baseline.json"


def processes() -> list[dict]:
    """Every Claude runtime process: pid, start time, terminal, kind, short session id."""
    out = subprocess.run(["ps", "-axww", "-o", "pid=,tty=,lstart=,command="],
                         capture_output=True, text=True, check=True).stdout
    procs = []
    for line in out.splitlines():
        m = re.match(r"\s*(\d+)\s+(\S+)\s+(\w{3} \w{3}\s+\d+ [\d:]+ \d{4})\s+(.*)", line)
        if not m:
            continue
        pid, tty, start, cmd = m.groups()
        if not re.search(r"claude-darwin-arm64|/claude(\s|$)", cmd) or re.search(r" __|daemon run|live-check", cmd):
            continue
        sid = (re.search(r"--session-id ([0-9a-f-]{36})", cmd) or re.search(r"/pty/([0-9a-f]{8})", cmd))
        if "--bg-pty-host" in cmd:
            kind = "host"
        elif re.search(r"\sagents(\s|$)", cmd):
            kind = "agents-view"
        else:
            kind = "client" if tty != "??" else "other"
        procs.append({"pid": int(pid), "start": start, "tty": tty, "kind": kind,
                      "sid": sid.group(1)[:8] if sid else None})
    return procs


def jobs() -> dict[str, dict]:
    """Short session id -> {name, state, session id}, from the daemon's job records."""
    out = {}
    for p in JOBS.glob("*/state.json"):
        try:
            d = json.loads(p.read_text())
        except (OSError, ValueError):
            continue
        sid = str(d.get("sessionId") or p.parent.name)
        out[sid[:8]] = {"name": d.get("name"), "state": d.get("state"), "session": sid}
    return out


def token(session: str) -> str | None:
    for p in TOKENS.glob(session[:8] + "*"):
        try:
            return p.read_text().strip()
        except OSError:
            return None
    return None


def snapshot() -> dict:
    js = jobs()
    procs = processes()
    for p in procs:
        j = js.get(p["sid"] or "")
        p["name"] = j and j["name"]
        p["state"] = j and j["state"]
        p["token"] = token(j["session"]) if j else None
    return {"at": time.strftime("%Y-%m-%dT%H:%M:%S%z"), "processes": procs}


def describe(p: dict) -> str:
    who = p.get("name") or p.get("sid") or "-"
    return f"{p['kind']:11} pid {p['pid']:>6} {p['tty']:8} {who} [{p.get('state') or '-'}, {p.get('token') or '-'}]"


def diff(base: dict, now: dict) -> list[str]:
    cur = {p["pid"]: p for p in now["processes"]}
    problems = []
    for p in base["processes"]:
        if p["kind"] != "host":  # a terminal client coming and going (attach, detach) disturbs nothing
            continue
        q = cur.get(p["pid"])
        if q is None:
            problems.append(f"gone:      {describe(p)}")
        elif q["start"] != p["start"]:
            problems.append(f"restarted: {describe(p)} (started {p['start']}, now {q['start']})")
        elif p.get("token") and q.get("token") and p["token"] != q["token"]:
            problems.append(f"token:     {describe(p)} ({p['token']} -> {q['token']})")
    return problems


def main(argv: list[str]) -> int:
    cmd = argv[1] if len(argv) > 1 else "show"
    if cmd == "show":
        for p in snapshot()["processes"]:
            print(describe(p))
        return 0
    if cmd == "before":
        snap = snapshot()
        STATE.mkdir(parents=True, exist_ok=True)
        BASELINE.write_text(json.dumps(snap, indent=1))
        print(f"live-check: baseline of {len(snap['processes'])} processes written to {BASELINE}")
        return 0
    if cmd == "diff":
        if not BASELINE.exists():
            print("live-check: no baseline; run `live-check before` first", file=sys.stderr)
            return 2
        base = json.loads(BASELINE.read_text())
        now = snapshot()
        problems = diff(base, now)
        new = {p["pid"] for p in now["processes"]} - {p["pid"] for p in base["processes"]}
        for line in problems:
            print(line)
        for p in now["processes"]:
            if p["pid"] in new:
                print(f"new:       {describe(p)}")
        verdict = "DISTURBED" if problems else "ok: nothing gone, restarted or re-tokened"
        print(f"live-check: {verdict} (baseline {base['at']}, {len(base['processes'])} processes)")
        return 1 if problems else 0
    print("usage: live-check [show|before|diff]", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
