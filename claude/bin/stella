#!/usr/bin/python3 -I
"""stella: start, find and open Stella's session, and run her crew. The one command on this machine that
runs outside the command sandbox, so every argument is validated and nothing is passed through a shell.

    stella                       open Stella's session in this terminal (starting it if needed)
    stella start | id            start her in the background / print her id
    stella restart               stop her and resume her conversation with the start-of-session prompt
                                 (after a setup change: she reloads her manual and re-arms her watcher)
    stella agents [--all]        `claude agents --json`
    stella launch <name>         launch the crewmate whose brief and record Stella wrote in crew/<name>/
                                 (only from her own session); exit 75 and mark it queued when over a cap
    stella adopt <name|id> [--team T] [--project P]   record a session she did not launch (observation only)
    stella adopt --resume <session-uuid> <name> [--team T] [--project P]   bring back an unlisted session
                                 from its transcript under <name>, then adopt it
    stella project <name> <slug>|--none   put a crewmate (or adopted session) under a project, or take it out
    stella projects              every project with its crew, their state and the decisions waiting in it
                                 (the projects themselves are Stella's own file, projects.md)
    stella crew [--watch]        the crew as a compact list: project, crewmate, state, its one-line need;
                                 `--watch` redraws it every few seconds (the left pane of the work window)
    stella crew --pane           put that live list in a left pane of Stella's herdr tab (once)
    stella track-pr <url> [name] watch a PR with no session: a track record, so a merge, a failing check,
                                 requested changes or a new review wakes her (`untrack <name>` ends it)
    stella allow <name> <activity>...   grant a session the activities Kohen allowed for its task (a crewmate's
                                 record or an adopted one's; `--none` clears them): the hooks then skip those prompts
    stella view <name> | --all   open crewmates as terminal tabs (herdr), or print the attach command; only
                                 when Kohen asks to talk to one. `--all` opens every live crewmate's tab
    stella view --repair         re-attach the tabs that are open, close those of sessions that are gone;
                                 opens nothing (what `tw` runs)
    stella hide <name> | --all   close the herdr tabs of crewmates and adopted sessions (never any other tab);
                                 the sessions keep running
    stella tab [<id>]            what a herdr tab runs: attach to the session (Stella's by default) and attach
                                 again whenever its process is restarted (`tok`, respawn), until it is gone
    stella stop <name> | respawn <name> [--model M] | logs <name>
    stella rm <name>             remove a finished crewmate, its worktree and its tab, only once its work has
                                 landed (an open PR keeps it); a track record goes once its PR is closed
    stella live-check [show|before|diff]   the tripwire (it needs the process table)

A record is crew/<name>/record.json in Stella's home. Stella writes `repo`, `branch` (or `dir`), `skill`,
`model`, `weight`, `mode` (ship|scout|local), `team`, `project`, `then` and `report` before launch; this script fills
`id`, `session`, `dir` and `state`. `allow` lists the activities the hooks do not prompt for in that session
(ACTIVITIES); Stella writes it only from Kohen's explicit words for the task, or a canon principle. The brief, crew/<name>/brief.md, is the crewmate's first prompt.

Caps (W3-D25): at most SLOTS crewmates working or blocked, at most OPUS_UNITS of Opus weight working, no
Opus-weighted launch while `throttle-until` is in the future, and no launch at all when `quota.json` says
QUOTA_STOP of the day's budget is spent. Both files are written by stella-watch.
"""

from __future__ import annotations

import json
import os
import re
import subprocess
import sys
import time
import uuid
from pathlib import Path

HOME = Path.home()
STELLA_HOME = HOME / ".local/share/stella"
CREW = STELLA_HOME / "crew"
TOKENS = Path(os.environ.get("CLAUDE_TOKEN_STATE", HOME / ".local/state/claude-token")) / "sessions"
EXTENSION = HOME / ".claude/kc-extensions/stella.json"  # this machine's additions: start_roots, watches
BIN = Path(__file__).resolve().parent
FLAGS = ["--dangerously-skip-permissions"]
SLOTS, OPUS_UNITS, QUOTA_STOP = 6, 4.0, 0.85
QUEUED = 75
# This script runs outside the command sandbox, so it trusts nothing agents can write: an isolated
# interpreter (-I above), a fixed PATH, no shell rc files, and git with hooks and fsmonitor disabled.
# (STELLA_PATH is for the tests; acc-guard refuses a helper call with an environment prefix.)
os.environ["PATH"] = os.environ.get("STELLA_PATH", "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin")
GIT = ["git", "-c", "core.fsmonitor=", "-c", "core.hooksPath=/dev/null"]
TIMEOUT = 120

ACTIVITIES = ("push", "security-boundary")  # what a record's `allow` can grant; the hooks read it
NAME = re.compile(r"^[a-z0-9][a-z0-9-]{0,40}$")
PROJECT = NAME  # a project slug: lowercase letters, digits and dashes
REPO = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,60}$")
BRANCH = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._/-]{0,100}$")
MODEL = re.compile(r"^[a-z0-9][a-z0-9.\[\]-]{0,40}$")
SHORT_ID = re.compile(r"^[0-9a-f]{8}$")
# `gh pr view owner/repo#N` silently fails on the enterprise host, so a `pr` is always a full URL.
PR_URL = re.compile(r"^https://([A-Za-z0-9.-]+)/([A-Za-z0-9._-]+)/([A-Za-z0-9._-]+)/pull/([0-9]+)$")


def die(msg: str, code: int = 2) -> None:
    print(f"stella: {msg}", file=sys.stderr)
    sys.exit(code)


def claude(*args: str, cwd: Path | None = None, capture: bool = True) -> subprocess.CompletedProcess:
    return subprocess.run(["claude", *args], cwd=cwd, capture_output=capture, text=True, timeout=TIMEOUT)


def git(d: Path, *args: str) -> subprocess.CompletedProcess:
    return subprocess.run([*GIT, "-C", str(d), *args], capture_output=True, text=True, timeout=TIMEOUT)


def agents(all_: bool = True) -> list[dict]:
    p = claude("agents", "--json", *(["--all"] if all_ else []))
    try:
        rows = json.loads(p.stdout)
    except ValueError:
        die(f"claude agents --json failed: {(p.stderr or p.stdout).strip()[-200:]}", 1)
    return rows


def stella_row() -> dict | None:
    return next((a for a in agents(False) if a.get("name") == "stella" and a.get("kind") == "background"), None)


# ------------------------------------------------------------------ Stella herself

def start() -> str:
    row = stella_row()
    if row:
        return row["id"]
    STELLA_HOME.mkdir(parents=True, exist_ok=True)
    claude("--bg", "-n", "stella", "--agent", "stella", "--model", "sonnet", *FLAGS, "--", START_PROMPT,
           cwd=STELLA_HOME)
    for _ in range(10):
        row = stella_row()
        if row:
            return row["id"]
        time.sleep(1)
    die("started, but the session did not show up in 'claude agents' yet", 1)
    return ""


START_PROMPT = "Session start: do the start-of-session steps in your manual."


def restart() -> str:
    """Stop Stella and resume the same conversation with the start-of-session prompt, so she reloads her
    skill, reconciles the crew and re-arms her watcher (a plain re-attach would skip all of that)."""
    row = next((a for a in agents() if a.get("name") == "stella" and a.get("kind") == "background"), None)
    if not row:
        return start()
    if row.get("state") in ("working", "blocked") or row.get("pid"):
        if claude("stop", row["id"]).returncode != 0:
            die(f"could not stop Stella ({row['id']})", 1)
    p = claude("--bg", "--resume", row["sessionId"], "-n", "stella", "--agent", "stella", "--model", "sonnet",
               *FLAGS, "--", START_PROMPT, cwd=STELLA_HOME)
    if p.returncode != 0:
        die(f"could not resume Stella: {(p.stderr or p.stdout).strip()[-200:]}", 1)
    return row["id"]


# ------------------------------------------------------------------ records

def check_name(name: str) -> str:
    if not NAME.match(name):
        die(f"bad name {name!r} (lowercase letters, digits and dashes, at most 41)")
    return name


def check_project(slug: str) -> str:
    if not PROJECT.match(slug):
        die(f"bad project {slug!r} (lowercase letters, digits and dashes, at most 41)")
    return slug


def record_path(name: str) -> Path:
    return CREW / check_name(name) / "record.json"


def load(name: str) -> dict:
    p = record_path(name)
    if not p.exists():
        die(f"no record for {name} ({p})")
    return json.loads(p.read_text())


def save(name: str, rec: dict) -> None:
    p = record_path(name)
    p.parent.mkdir(parents=True, exist_ok=True)
    tmp = p.with_suffix(".tmp")
    tmp.write_text(json.dumps(rec, indent=1))
    tmp.replace(p)


def records() -> list[dict]:
    out = []
    for p in sorted(CREW.glob("*/record.json")):
        try:
            out.append(json.loads(p.read_text()))
        except (OSError, ValueError):
            pass
    return out


def live_state(rec: dict, rows: dict[str, dict]) -> str | None:
    row = rows.get(rec.get("id") or "") or rows.get((rec.get("session") or "")[:8])
    return row.get("state") if row else None


# ------------------------------------------------------------------ caps

def read_json(path: Path) -> dict:
    try:
        return json.loads(path.read_text())
    except (OSError, ValueError):
        return {}


def over_cap(rec: dict) -> str | None:
    listed = agents()
    rows = {a.get("id", ""): a for a in listed}
    rows.update({(a.get("sessionId") or "")[:8]: a for a in listed})
    busy = [r for r in records() if r.get("name") != rec.get("name") and not r.get("adopted")
            and live_state(r, rows) in ("working", "blocked")]
    working = [r for r in busy if live_state(r, rows) == "working"]
    weight = float(rec.get("weight") or 0)
    if len(busy) >= SLOTS:
        return f"slot cap: {len(busy)} of {SLOTS} crewmates are working or blocked"
    if weight and sum(float(r.get("weight") or 0) for r in working) + weight > OPUS_UNITS:
        return f"Opus weight cap: {OPUS_UNITS} units in use would be exceeded"
    until = read_json(STELLA_HOME / "throttle-until").get("until", 0)
    if weight and until > time.time():
        return f"Opus throttled; no Opus launch for {int(until - time.time())} s more"
    quota = STELLA_HOME / "quota.json"
    fresh = quota.exists() and time.time() - quota.stat().st_mtime < 1800
    q = read_json(quota) if fresh else {}
    frac = q.get("fraction")
    # The quota measures one token (e.g. the personal daily budget). A crewmate bills the token Stella runs
    # on, so the gate applies only when that is the token the quota measures.
    row = stella_row()
    mine = (TOKENS / row["sessionId"]).read_text().strip() if row and (TOKENS / row.get("sessionId", "")).is_file() else None
    if q.get("token") and mine and q["token"] != mine:
        frac = None
    if isinstance(frac, (int, float)) and frac >= QUOTA_STOP:
        return f"budget gate: {frac:.0%} of today's budget is spent"
    return None


# ------------------------------------------------------------------ launch

def inherit_token(session: str) -> None:
    """The crewmate bills the same token as Stella (W3-D29): copy her record before it starts."""
    row = stella_row()
    src = TOKENS / (row or {}).get("sessionId", "") if row else None
    if src and src.is_file():
        TOKENS.mkdir(parents=True, exist_ok=True)
        (TOKENS / session).write_text(src.read_text())


def worktree(rec: dict) -> Path:
    if rec.get("repo"):
        repo, branch = rec["repo"], rec.get("branch") or rec["name"]
        if not REPO.match(repo) or not BRANCH.match(branch) or ".." in branch:
            die(f"bad repo or branch: {repo} {branch}")
        if not (HOME / "github" / repo).is_dir():
            die(f"no repo at ~/github/{repo}")
        main = HOME / "github" / repo
        wt = HOME / "github" / f"{repo}-wt" / branch
        if not wt.is_dir():  # the same layout and semantics as the `wta` helper, without a shell rc file
            git(main, "fetch", "--quiet", "origin")
            exists = git(main, "show-ref", "--verify", "--quiet", f"refs/heads/{branch}").returncode == 0
            remote = git(main, "show-ref", "--verify", "--quiet", f"refs/remotes/origin/{branch}").returncode == 0
            wt.parent.mkdir(parents=True, exist_ok=True)
            if exists or remote:
                p = git(main, "worktree", "add", str(wt), branch)
            else:
                p = git(main, "worktree", "add", "-b", branch, str(wt), rec.get("base") or "origin/HEAD")
            if not wt.is_dir():
                die(f"could not make the worktree {wt}: {p.stderr.strip()[-300:]}", 1)
        return wt
    d = Path(os.path.expanduser(rec.get("dir") or "")).resolve()
    extra = [Path(os.path.expanduser(r)) for r in read_json(EXTENSION).get("start_roots", [])]
    roots = [r.resolve() for r in (HOME / "github", STELLA_HOME, *extra)]
    if not d.is_dir() or not any(d == r or r in d.parents for r in roots):
        die(f"start directory must be under ~/github, Stella's home or a start_roots entry: {d}")
    return d


def check_pr(url: str) -> str:
    if not PR_URL.match(url):
        die(f"bad pr {url!r}: write the full URL, https://<host>/<owner>/<repo>/pull/<N>"
            " (`gh pr view owner/repo#N` does not resolve on the enterprise host, so no PR event would ever fire)")
    return url


def launch(name: str) -> None:
    if Path.cwd().resolve() != STELLA_HOME.resolve():
        die("launch runs only from Stella's own session")
    rec = load(name)
    if rec.get("adopted") or rec.get("mode") == "track":
        die(f"{name} is adopted or tracked: it was not launched by Stella")
    if rec.get("pr"):
        check_pr(rec["pr"])
    if rec.get("project"):
        check_project(rec["project"])
    if rec.get("id") and any(a.get("id") == rec["id"] and a.get("state") in ("working", "blocked")
                             for a in agents()):
        die(f"{name} is already running ({rec['id']})")
    brief = (CREW / name / "brief.md")
    if not brief.is_file() or not brief.read_text().strip():
        die(f"no brief at {brief}")
    model = rec.get("model") or "sonnet"
    if not MODEL.match(model):
        die(f"bad model {model!r}")
    why = over_cap(rec)
    if why:
        rec["state"] = "queued"
        rec["queued_because"] = why
        save(name, rec)
        die(f"{name} queued: {why}", QUEUED)
    if rec.pop("security", False):  # the old flag: a task about the sandbox boundary
        rec["allow"] = sorted({*(rec.get("allow") or []), "security-boundary"})
    d = worktree(rec)
    session = str(uuid.uuid4())
    inherit_token(session)
    p = claude("--bg", "--session-id", session, "-n", name, "--model", model, *FLAGS, "--", brief.read_text(), cwd=d)
    if p.returncode != 0:
        die(f"claude --bg failed: {(p.stderr or p.stdout).strip()[-300:]}", 1)
    # `claude --bg` ignores --session-id and the daemon assigns its own, so the uuid above is not the
    # session: find the one just started under this name (newest first) and record its real ids.
    started = sorted((a for a in agents() if a.get("name") == name), key=lambda a: a.get("startedAt") or 0)
    if not started:
        die(f"launched {name}, but no session by that name is listed; run `stella agents --all`", 1)
    row = started[-1]
    if row.get("sessionId") and row["sessionId"] != session:
        inherit_token(row["sessionId"])  # the token file is keyed by the real session
    rec.update({"id": row.get("id"), "session": row.get("sessionId"), "dir": str(d),
                "state": "working", "launched_at": time.strftime("%Y-%m-%dT%H:%M:%S%z")})
    rec.pop("queued_because", None)
    save(name, rec)
    print(f"launched {name} ({rec['id']}) in {d} on {model}")


ADOPT_PROMPT = ("Stella has adopted this session so Kohen can see it in the agents list while its work is open. "
                "Nothing to do now: reply with one line on the state of its open PRs, then wait.")
UUID = re.compile(r"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$")


def adopt_resume(session: str, name: str, team: str | None, project: str | None = None) -> None:
    """Bring back a session that is no longer in `claude agents` (removed or never backgrounded) from its
    transcript, under `name`, then adopt it. Observation only, like adopt."""
    if not UUID.match(session):
        die(f"bad session id {session!r} (the full uuid of its transcript)")
    if record_path(name).exists():
        die(f"{name} already has a record")
    if any(a.get("sessionId") == session for a in agents()):
        die(f"{session[:8]} is already listed; use `stella adopt {session[:8]}`")
    found = sorted((HOME / ".claude/projects").glob(f"*/{session}.jsonl"))
    if not found:
        die(f"no transcript for {session}")
    cwd = HOME
    for line in found[0].open(errors="ignore"):
        try:
            c = json.loads(line).get("cwd")
        except ValueError:
            continue
        if c and Path(c).is_dir():
            cwd = Path(c)
            break
    p = claude("--bg", "--resume", session, "-n", name, *FLAGS, "--", ADOPT_PROMPT, cwd=cwd)
    if p.returncode != 0:
        die(f"claude --bg --resume failed: {(p.stderr or p.stdout).strip()[-300:]}", 1)
    rows = sorted((a for a in agents() if a.get("name") == name), key=lambda a: a.get("startedAt") or 0)
    if not rows:
        die(f"resumed {name}, but no session by that name is listed; run `stella agents --all`", 1)
    row = rows[-1]
    save(name, {"name": name, "id": row.get("id"), "session": row.get("sessionId"), "dir": str(cwd),
                "adopted": True, "team": team, "weight": 0, "state": row.get("state"), "resumed_from": session,
                **({"project": project} if project else {}),
                "adopted_at": time.strftime("%Y-%m-%dT%H:%M:%S%z")})
    print(f"resumed {session[:8]} as {name} ({row.get('id')}) and adopted it (observation only)")


def allow(name: str, activities: list[str]) -> None:
    rec = load(name)
    if activities == ["--none"]:
        activities = []
    bad = [a for a in activities if a not in ACTIVITIES]
    if bad:
        die(f"unknown activity {bad[0]!r}; the activities are: {', '.join(ACTIVITIES)}")
    rec["allow"] = sorted(set(activities))
    save(name, rec)
    print(f"{name} may: {', '.join(rec['allow']) or 'nothing extra'}")


def adopt(target: str, team: str | None, project: str | None = None) -> None:
    rows = agents()
    if target == "stella":
        die("Stella does not adopt herself")
    row = next((a for a in rows if target in (a.get("name"), a.get("id"), a.get("sessionId"))), None)
    if not row or row.get("name") == "stella":
        die(f"no session named or with id {target!r} in claude agents")
    name = row.get("name") if row.get("name") and NAME.match(row["name"]) else \
        re.sub(r"[^a-z0-9-]+", "-", (row.get("name") or row["id"]).lower()).strip("-")[:41] or row["id"]
    if record_path(name).exists():
        die(f"{name} already has a record")
    save(name, {"name": name, "id": row.get("id"), "session": row.get("sessionId"), "dir": row.get("cwd"),
                "adopted": True, "team": team, "weight": 0, "state": row.get("state"),
                **({"project": project} if project else {}), "adopted_at": time.strftime("%Y-%m-%dT%H:%M:%S%z")})
    print(f"adopted {row.get('name') or row['id']} as {name} (observation only)")


# ------------------------------------------------------------------ view / lifecycle

def _herdr() -> str:
    return subprocess.run(["sh", "-c", "command -v herdr"], capture_output=True, text=True).stdout.strip()


def _herdr_pane(out: str) -> str | None:
    m = re.search(r'"pane_id"\s*:\s*"([^"]+)"', out)
    return m.group(1) if m else None


def _tab_id(out: str) -> str | None:
    """The id of the tab in a `herdr tab create` reply (`.result.tab`)."""
    try:
        tab = json.loads(out)["result"]["tab"]
        return tab.get("tab_id") or tab.get("id")
    except (ValueError, KeyError, TypeError, AttributeError):
        return None


def _herdr_tabs(herdr: str) -> dict[str, str]:
    """{tab id: label} of every tab, from `herdr tab list` (any nesting; a tab has an id and a label)."""
    p = subprocess.run([herdr, "tab", "list"], capture_output=True, text=True, timeout=30)
    found: dict[str, str] = {}

    def walk(x):
        if isinstance(x, dict):
            tid = x.get("tab_id") or x.get("id")
            label = x.get("label") or x.get("custom_name")
            if isinstance(tid, str) and isinstance(label, str):
                found[tid] = label
            for v in x.values():
                walk(v)
        elif isinstance(x, list):
            for v in x:
                walk(v)

    try:
        walk(json.loads(p.stdout))
    except ValueError:
        pass
    return found


def close_tab(rec: dict) -> bool:
    """Close the herdr tab opened for this crewmate (`herdr tab close`): the id kept in its record, else
    the tab carrying its name as label. True when a tab was closed."""
    herdr = _herdr()
    if not herdr:
        return False
    tabs = _herdr_tabs(herdr)
    ids = [rec["tab"]] if rec.get("tab") in tabs else [t for t, label in tabs.items() if label == rec.get("name")]
    for t in ids:
        subprocess.run([herdr, "tab", "close", t], capture_output=True, text=True, timeout=30)
    return bool(ids)


# What a tab shows after its `claude attach` died with the process: "Session 3479a9f0 has exited."
EXITED_RE = re.compile(r"session [0-9a-f]{8} has exited|session exited", re.I)
FOLLOW_GRACE = float(os.environ.get("STELLA_FOLLOW_GRACE", "4"))  # seconds to tell a restart from a detach
FOLLOW_WAIT = float(os.environ.get("STELLA_FOLLOW_WAIT", "90"))  # seconds a restart may take to come back


def _process(sid: str) -> tuple[bool, object]:
    """(listed, identity of the running process) of a session; the identity changes when it restarts."""
    row = next((a for a in agents(True) if a.get("id") == sid), None)
    if row is None:
        return False, None
    return True, (row.get("pid"), row.get("startedAt")) if row.get("pid") else None


def follow(sid: str) -> int:
    """`claude attach` that survives a restart of the session: when attach returns because the process was
    replaced (same session id, new process), wait for the new one and attach again. A detach, or a session
    that is gone from `claude agents --all`, ends it."""
    while True:
        listed, ident = _process(sid)
        if not listed:
            print(f"session {sid} is gone")
            return 0
        rc = subprocess.run(["claude", "attach", sid]).returncode
        deadline, first = time.time() + FOLLOW_WAIT, time.time()
        while True:
            listed, now = _process(sid)
            if not listed:
                print(f"session {sid} is gone")
                return 0
            if now is not None and now != ident:
                print(f"session {sid} restarted; attaching again")
                break
            if now is not None and time.time() - first >= FOLLOW_GRACE:
                return rc  # the same process is still running: the attach ended on purpose
            if time.time() >= deadline:
                print(f"session {sid} did not come back", file=sys.stderr)
                return 1
            time.sleep(min(1.0, max(FOLLOW_GRACE / 4, 0.05)))


def _tab_panes(herdr: str, tab: str) -> list[str]:
    """Pane ids of a tab, from `herdr pane list` (any nesting; a pane has a pane_id and a tab_id)."""
    p = subprocess.run([herdr, "pane", "list"], capture_output=True, text=True, timeout=30)
    found: list[str] = []

    def walk(x):
        if isinstance(x, dict):
            if x.get("tab_id") == tab and isinstance(x.get("pane_id"), str):
                found.append(x["pane_id"])
            for v in x.values():
                walk(v)
        elif isinstance(x, list):
            for v in x:
                walk(v)

    try:
        walk(json.loads(p.stdout))
    except ValueError:
        pass
    return found


def _attach_cmd(sid: str) -> str:
    return f"{BIN / 'stella'} tab {sid}"


VERBOSE = bool(os.environ.get("STELLA_VERBOSE"))


def repair_tab(herdr: str, tab: str, sid: str) -> None:
    """A tab left showing 'session exited' (opened before tabs followed their session): attach it again."""
    panes = _tab_panes(herdr, tab)
    if VERBOSE:
        print(f"  tab {tab} ({sid}): panes {panes}")
    for pane in panes:
        r = subprocess.run([herdr, "pane", "read", pane, "--lines", "10"], capture_output=True, text=True,
                           timeout=30)
        out = r.stdout
        if VERBOSE:
            print(f"    pane {pane} rc={r.returncode} read={out[-300:]!r} err={r.stderr[-200:]!r}")
        if EXITED_RE.search(out):
            subprocess.run([herdr, "pane", "run", pane, _attach_cmd(sid)], capture_output=True, text=True,
                           timeout=30)


def view(name: str, quiet: bool = False) -> None:
    rec = load(name)
    sid = rec.get("id")
    if not sid or not SHORT_ID.match(sid):
        die(f"{name} has no session id yet")
    herdr = _herdr()
    if herdr:
        t = subprocess.run([herdr, "tab", "create", "--label", name, "--cwd", rec.get("dir") or str(HOME)],
                           capture_output=True, text=True, timeout=30)
        pane = _herdr_pane(t.stdout)
        if t.returncode == 0 and pane:
            subprocess.run([herdr, "pane", "run", pane, _attach_cmd(sid)], capture_output=True, text=True, timeout=30)
            tab = _tab_id(t.stdout)
            if tab:
                save(name, {**load(name), "tab": tab})
            if not quiet:
                print(f"{name}: herdr tab opened")
            return
    if not quiet:
        print(f"{name}: claude attach {sid}")


def view_all(open_missing: bool = True) -> None:
    """A tab for every live crewmate that has none (adopted ones included; only when `open_missing`), the
    tabs that are open re-attached, and no tab for a session that has exited for good: its record is landed,
    or `claude agents --all` no longer lists it."""
    listed = agents(True)
    live = {a.get("id") for a in agents(False)} - {None}
    known = {a.get("id") for a in listed}
    herdr = _herdr()
    tabs = _herdr_tabs(herdr) if herdr else {}
    if VERBOSE:
        print(f"tabs: {tabs}\nlive: {sorted(live)}")
    for rec in records():
        sid = rec.get("id")
        if not sid or rec.get("mode") == "track":
            continue
        has_tab = (rec.get("tab") in tabs) or rec.get("name") in tabs.values()
        if VERBOSE:
            print(f"{rec['name']}: sid={sid} live={sid in live} has_tab={has_tab} state={rec.get('state')}")
        if sid in live and not has_tab:
            if open_missing:
                view(rec["name"])
        elif sid in live and has_tab and herdr:
            tab = rec.get("tab") if rec.get("tab") in tabs else next(t for t, n in tabs.items() if n == rec["name"])
            repair_tab(herdr, tab, sid)
        elif has_tab and sid not in live and (rec.get("state") == "landed" or sid not in known):
            close_tab(rec)
            save(rec["name"], {k: v for k, v in load(rec["name"]).items() if k != "tab"})
    # Stella's own tab has no crew record: find it by its label and repair it the same way
    me = stella_row()
    if me and herdr:
        for tab, label in tabs.items():
            if label.lower() == "stella":
                repair_tab(herdr, tab, me["id"])


def hide(name: str | None) -> None:
    """Close the herdr tabs of crewmates and adopted sessions (one, or all). Only a tab that a crew record
    names (its `tab`, else a tab labelled with its name) is closed; Kohen's own tabs and Stella's stay."""
    recs = [load(name)] if name else records()
    closed = []
    for rec in recs:
        if rec.get("mode") == "track":
            continue
        if close_tab(rec):
            closed.append(rec["name"])
        if rec.get("tab"):
            save(rec["name"], {k: v for k, v in load(rec["name"]).items() if k != "tab"})
    print(f"hid {', '.join(closed)}" if closed else "no crew tabs open")


# ------------------------------------------------------------------ projects and the crew list

JOBS = HOME / ".claude/jobs"
PROJECTS_DIR = HOME / ".claude/projects"
STATUS_RULE = "━" * 40
GLYPH = {"waiting": "◆", "blocked": "✖", "working": "●", "queued": "○", "done": "✓", "watching": "◇", "unknown": "?"}
COLOR = {"waiting": "33", "blocked": "31", "working": "32", "queued": "90", "done": "90", "watching": "36", "unknown": "90"}
RANK = {k: i for i, k in enumerate(("waiting", "blocked", "working", "queued", "done", "watching", "unknown"))}


def _last_status_block(session: str) -> tuple[str | None, str]:
    """(NEXT|DONE|None, the block) from the last assistant message of a session's transcript."""
    hits = list(PROJECTS_DIR.glob(f"*/{session}.jsonl")) if session else []
    if not hits:
        return None, ""
    with open(hits[0], "rb") as f:
        f.seek(0, os.SEEK_END)
        f.seek(max(0, f.tell() - 200_000))
        lines = f.read().decode("utf-8", "replace").splitlines()
    for line in reversed(lines):
        try:
            ev = json.loads(line)
        except ValueError:
            continue
        if ev.get("type") != "assistant":
            continue
        c = (ev.get("message") or {}).get("content")
        text = c if isinstance(c, str) else "\n".join(
            b.get("text", "") for b in c or [] if isinstance(b, dict) and b.get("type") == "text")
        if not text.strip():
            continue
        if STATUS_RULE not in text:
            return None, ""
        block = text.rsplit(STATUS_RULE, 1)[1].strip()
        return ("NEXT" if "NEXT FOR YOU" in block else "DONE" if "ALL DONE" in block else None), block
    return None, ""


def crew_status(rec: dict) -> tuple[str, str]:
    """(state, one-line need) of a record, from files only: waiting (on Kohen), blocked, working, queued,
    done, watching (a track record) or unknown."""
    if rec.get("mode") == "track":
        return "watching", rec.get("pr") or ""
    if rec.get("state") == "queued":
        return "queued", rec.get("queued_because") or ""
    job = read_json(JOBS / str(rec.get("id")) / "state.json")
    need = job.get("needs") or ""
    kind, block = _last_status_block(rec.get("session") or "")
    if kind == "NEXT":
        items = [re.sub(r"^\d+\.\s*", "", l.strip()) for l in block.splitlines() if re.match(r"\s*\d+\.", l)]
        more = f" (+{len(items) - 1} more)" if len(items) > 1 else ""
        return "waiting", (items[0] if items else need) + more
    if job.get("state") == "blocked":
        return ("waiting", need) if need else ("blocked", job.get("detail") or "")
    if kind == "DONE" or job.get("state") == "done":
        return "done", ""
    return ("working" if job else "unknown"), ""


def project_notes() -> dict[str, tuple[str, str]]:
    """{slug: (title, status)} from Stella's projects.md: a section per project, `## <slug> — <title>`, with
    a `- status: …` line. Stella writes the file; the helper only reads it."""
    out: dict[str, tuple[str, str]] = {}
    cur = None
    try:
        text = (STELLA_HOME / "projects.md").read_text()
    except OSError:
        return out
    for line in text.splitlines():
        m = re.match(r"^##\s+([a-z0-9][a-z0-9-]*)\s*(?:[—:-]+\s*(.*))?$", line)
        if m:
            cur = m.group(1)
            out[cur] = (m.group(2) or "", "")
        elif cur and (m := re.match(r"^[-*]\s*status:\s*(.*)$", line, re.I)):
            out[cur] = (out[cur][0], m.group(1).strip())
    return out


def crew_rows() -> list[dict]:
    rows = []
    for rec in records():
        if rec.get("state") == "landed":
            continue
        state, need = crew_status(rec)
        rows.append({"name": rec.get("name"), "project": rec.get("project") or "", "state": state, "need": need})
    return sorted(rows, key=lambda r: (RANK[r["state"]], r["name"]))


def _clip(text: str, width: int) -> str:
    return text if len(text) <= width else text[: max(width - 1, 0)] + "…"


def render_crew(rows: list[dict], width: int, color: bool, detail: bool = False) -> str:
    """Rows grouped by project, a project with a decision waiting first. `detail` adds each project's title
    and status from projects.md (the `projects` command); without it this is the compact left-pane list."""
    notes = project_notes()
    by: dict[str, list[dict]] = {}
    for r in rows:
        by.setdefault(r["project"], []).append(r)
    if detail:
        for slug in notes:
            by.setdefault(slug, [])
    order = sorted(by, key=lambda k: (k == "", min([RANK[r["state"]] for r in by[k]] or [9]), k))

    def paint(code: str, text: str) -> str:
        return f"\033[{code}m{text}\033[0m" if color else text

    count = {s: sum(1 for r in rows if r["state"] == s) for s in RANK}
    head = " · ".join(f"{count[s]} {l}" for s, l in (("waiting", "need you"), ("blocked", "blocked"),
                                                       ("working", "working"), ("done", "done")) if count[s])
    lines = [paint("1", "CREW") + ("  " + head if head else "  none")]
    namew = max([len(r["name"]) for r in rows] + [8])
    for slug in order:
        title, status = notes.get(slug, ("", ""))
        label = slug or "(no project)"
        lines.append("")
        lines.append(paint("1", _clip(label + (f" — {title}" if detail and title else ""), width)))
        if detail and status:
            lines.append("  " + _clip("status: " + status, width - 2))
        for r in by[slug]:
            word = {"waiting": "needs you"}.get(r["state"], r["state"])
            left = f"  {GLYPH[r['state']]} {r['name']:<{namew}} "
            tail = f"{word}" + (f": {r['need']}" if r["need"] else "")
            lines.append(paint(COLOR[r["state"]], left) + _clip(tail, max(width - len(left), 8)))
        if detail and not by[slug]:
            lines.append("  no crew")
        waiting = [r for r in by[slug] if r["state"] in ("waiting", "blocked")]
        if detail and waiting:
            lines.append(paint("33", f"  decisions waiting: {len(waiting)}"))
    return "\n".join(lines)


def crew(watch: bool) -> None:
    import shutil
    if not watch:
        print(render_crew(crew_rows(), shutil.get_terminal_size((60, 20)).columns, sys.stdout.isatty()))
        return
    every = float(os.environ.get("STELLA_CREW_EVERY", "4"))
    frames = int(os.environ.get("STELLA_CREW_FRAMES", "0"))  # 0: until interrupted (the tests set a count)
    n = 0
    try:
        while True:
            width = shutil.get_terminal_size((40, 20)).columns
            print("\033[H\033[J" + render_crew(crew_rows(), width, True), flush=True)
            n += 1
            if frames and n >= frames:
                return
            time.sleep(every)
    except KeyboardInterrupt:
        return


def projects_report() -> None:
    import shutil
    print(render_crew(crew_rows(), shutil.get_terminal_size((100, 20)).columns, sys.stdout.isatty(), detail=True))


def set_project(name: str, slug: str) -> None:
    rec = load(name)
    if slug == "--none":
        rec.pop("project", None)
    else:
        rec["project"] = check_project(slug)
    save(name, rec)
    print(f"{name}: project {rec.get('project') or 'none'}")


def crew_pane() -> None:
    """Put the live crew list in a pane on the left of Stella's herdr tab, once: split her pane, run
    `stella crew --watch` in the new one and swap them so the list sits on the left."""
    herdr = _herdr()
    if not herdr:
        die("herdr is not installed", 1)
    tabs = _herdr_tabs(herdr)
    tab = next((t for t, label in tabs.items() if label.lower() == "stella"), None)
    if not tab:
        die("no herdr tab labelled Stella", 1)
    panes = _tab_panes(herdr, tab)
    mark = STELLA_HOME / "crew-pane"
    if mark.exists() and mark.read_text().strip() in panes:
        print("the crew list is already in Stella's tab")
        return
    if not panes:
        die("Stella's tab has no pane", 1)
    r = subprocess.run([herdr, "pane", "split", panes[0], "--direction", "right", "--ratio", "0.72", "--no-focus"],
                       capture_output=True, text=True, timeout=30)
    new = _herdr_pane(r.stdout)
    if r.returncode != 0 or not new:
        die(f"could not split Stella's pane: {(r.stderr or r.stdout).strip()[-200:]}", 1)
    subprocess.run([herdr, "pane", "run", new, f"{BIN / 'stella'} crew --watch"], capture_output=True, text=True, timeout=30)
    subprocess.run([herdr, "pane", "swap", "--source-pane", new, "--target-pane", panes[0]],
                   capture_output=True, text=True, timeout=30)
    mark.write_text(new + "\n")
    print("the crew list is in Stella's tab")


def lifecycle(cmd: str, name: str, model: str | None = None) -> None:
    rec = load(name)
    if rec.get("adopted") and cmd in ("stop", "respawn"):
        die(f"{name} is adopted: Stella never stops or restarts it")
    sid = rec.get("id") or ""
    if not SHORT_ID.match(sid):
        die(f"{name} has no session id")
    if cmd == "logs":
        sys.exit(claude("logs", sid, capture=False).returncode)
    if cmd == "stop":
        sys.exit(claude("stop", sid, capture=False).returncode)
    if model:  # continue the same conversation on another model (e.g. escalate to Opus)
        if not MODEL.match(model):
            die(f"bad model {model!r}")
        if claude("stop", sid).returncode != 0:
            die(f"could not stop {name} ({sid}) before moving it to {model}", 1)
        p = claude("--bg", "--resume", rec["session"], "-n", name, "--model", model, *FLAGS, "--",
                   f"Continue this task on {model}. Kohen's first mate moved you here because the last question was"
                   " beyond the previous model; carry on from where you were.", cwd=Path(rec.get("dir") or HOME))
        short = (p.stdout.strip().split() or [""])[-1]
        rec.update({"model": model, **({"id": short} if SHORT_ID.match(short) else {})})
        save(name, rec)
        sys.exit(p.returncode)
    sys.exit(claude("respawn", sid, capture=False).returncode)


def pr_state(rec: dict, d: Path) -> tuple[str, str]:
    """(state, url) of the crewmate's PR: the record's `pr` URL, else the PR of its branch ('' when none)."""
    url = rec.get("pr") or ""
    argv = ["gh", "pr", "view", *([url] if url else []), "--json", "state,url"]
    try:
        p = subprocess.run(argv, cwd=d if d.is_dir() else HOME, capture_output=True, text=True, timeout=TIMEOUT)
        got = json.loads(p.stdout)
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return "", url
    return got.get("state") or "", got.get("url") or url


def landed(rec: dict) -> str | None:
    """None when the crewmate's work is safely somewhere else, else why not."""
    mode = rec.get("mode") or "ship"
    d = Path(rec.get("dir") or "")
    state, url = pr_state(rec, d)
    if state == "OPEN":  # an open PR is not landed whatever the mode: removing it would leave the PR unwatched
        return f"its PR is still open ({url}); keep it so the watcher keeps telling Stella what happens to it"
    if mode == "scout":
        report = Path(os.path.expanduser(rec.get("report") or ""))
        return None if rec.get("report") and report.is_file() else "its report is missing"
    if not (d / ".git").exists():
        return "its directory is not a git checkout, so nothing proves the work landed"
    if git(d, "status", "--porcelain").stdout.strip():
        return "uncommitted changes in its worktree"
    if mode == "ship":  # a squash-merged PR whose remote branch is gone has landed even without an upstream
        return None if state == "MERGED" else f"its PR is not merged ({state or 'no PR'})"
    if git(d, "rev-parse", "--abbrev-ref", "@{u}").returncode != 0:
        return "its branch was never pushed"
    if git(d, "rev-list", "--count", "@{u}..HEAD").stdout.strip() not in ("", "0"):
        return "it has unpushed commits"
    return None


# ------------------------------------------------------------------ PR tracking

def track_pr(url: str, name: str | None) -> None:
    m = PR_URL.match(check_pr(url))
    name = check_name(name or f"track-{m.group(3)}-{m.group(4)}".lower())
    if record_path(name).exists() and load(name).get("state") != "landed":
        die(f"{name} already has a record")
    save(name, {"name": name, "mode": "track", "state": "watching", "pr": url,
                "tracked_at": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
                "watches": [{"name": f"{m.group(3)}#{m.group(4)}",
                             "command": ["gh", "pr", "view", url, "--json", "state,reviewDecision,statusCheckRollup"]}]})
    print(f"tracking {url} as {name}")


def untrack(name: str, require_closed: bool = False) -> None:
    rec = load(name)
    if rec.get("mode") != "track":
        die(f"{name} is not a track record")
    if require_closed:
        state, _ = pr_state(rec, HOME)
        if state not in ("MERGED", "CLOSED"):
            die(f"{name} not removed: its PR is still {state or 'unknown'}; `stella untrack {name}` stops watching it", 1)
    rec["state"] = "landed"
    rec["removed_at"] = time.strftime("%Y-%m-%dT%H:%M:%S%z")
    save(name, rec)
    print(f"{'removed' if require_closed else 'untracked'} {name}")


def rm(name: str) -> None:
    rec = load(name)
    if rec.get("mode") == "track":
        return untrack(name, require_closed=True)
    if rec.get("adopted"):
        die(f"{name} is adopted: Stella never removes it (say 'release' to drop the record)")
    why = landed(rec)
    if why:
        die(f"{name} not removed: {why}", 1)
    if SHORT_ID.match(rec.get("id") or ""):
        claude("rm", rec["id"])
    close_tab(rec)
    rec.pop("tab", None)
    wt = HOME / "github" / f"{rec.get('repo')}-wt" / (rec.get("branch") or name)
    if rec.get("repo") and REPO.match(rec["repo"]) and wt.is_dir():  # as `wtr` does; the branch is kept
        p = git(HOME / "github" / rec["repo"], "worktree", "remove", str(wt))
        if p.returncode != 0:
            die(f"session removed, but the worktree was not: {p.stderr.strip()[-200:]}", 1)
        try:
            wt.parent.rmdir()
        except OSError:
            pass
    rec["state"] = "landed"
    rec["removed_at"] = time.strftime("%Y-%m-%dT%H:%M:%S%z")
    save(name, rec)
    print(f"removed {name}")


# ------------------------------------------------------------------ main

def adopt_options(rest: list[str]) -> dict[str, str]:
    """`--team T` and `--project P` after an adopt target, each at most once."""
    out: dict[str, str] = {}
    while rest:
        if len(rest) < 2 or rest[0] not in ("--team", "--project") or rest[0][2:] in out:
            die("usage: stella adopt <name|id> [--team T] [--project P]")
        out[rest[0][2:]] = (check_name if rest[0] == "--team" else check_project)(rest[1])
        rest = rest[2:]
    return out


def main(argv: list[str]) -> None:
    cmd, rest = (argv[1] if len(argv) > 1 else "open"), argv[2:]
    if cmd == "open":
        os.execvp("claude", ["claude", "attach", start()])
    elif cmd == "tab" and len(rest) <= 1:
        if rest and not SHORT_ID.match(rest[0]):
            die(f"bad session id {rest[0]!r}")
        sys.exit(follow(rest[0] if rest else start()))
    elif cmd == "start":
        print(start())
    elif cmd == "restart" and not rest:
        print(restart())
    elif cmd == "id":
        row = stella_row()
        print(row["id"]) if row else sys.exit(1)
    elif cmd == "agents" and rest in ([], ["--all"]):
        print(json.dumps(agents(bool(rest)), indent=1))
    elif cmd == "launch" and len(rest) == 1:
        launch(rest[0])
    elif cmd == "adopt" and rest[:1] == ["--resume"] and len(rest) >= 3:
        opts = adopt_options(rest[3:])
        adopt_resume(rest[1], check_name(rest[2]), opts.get("team"), opts.get("project"))
    elif cmd == "adopt" and len(rest) >= 1:
        opts = adopt_options(rest[1:])
        target = rest[0]
        if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9 ._-]{0,80}", target):
            die(f"bad session name or id {target!r}")
        adopt(target, opts.get("team"), opts.get("project"))
    elif cmd == "project" and len(rest) == 2:
        set_project(check_name(rest[0]), rest[1])
    elif cmd == "projects" and not rest:
        projects_report()
    elif cmd == "crew" and rest in ([], ["--watch"]):
        crew(bool(rest))
    elif cmd == "crew" and rest == ["--pane"]:
        crew_pane()
    elif cmd == "hide" and rest == ["--all"]:
        hide(None)
    elif cmd == "hide" and len(rest) == 1:
        hide(check_name(rest[0]))
    elif cmd == "view" and rest == ["--repair"]:
        view_all(open_missing=False)
    elif cmd == "allow" and len(rest) >= 2:
        allow(check_name(rest[0]), rest[1:])
    elif cmd == "track-pr" and len(rest) in (1, 2):
        track_pr(rest[0], rest[1] if len(rest) == 2 else None)
    elif cmd == "untrack" and len(rest) == 1:
        untrack(rest[0])
    elif cmd == "view" and rest == ["--all", "--verbose"]:
        global VERBOSE
        VERBOSE = True
        view_all()
    elif cmd == "view" and rest == ["--all"]:
        view_all()
    elif cmd == "view" and len(rest) == 1:
        view(rest[0])
    elif cmd in ("stop", "logs") and len(rest) == 1:
        lifecycle(cmd, rest[0])
    elif cmd == "respawn" and (len(rest) == 1 or (len(rest) == 3 and rest[1] == "--model")):
        lifecycle(cmd, rest[0], rest[2] if len(rest) == 3 else None)
    elif cmd == "rm" and len(rest) == 1:
        rm(rest[0])
    elif cmd == "live-check" and len(rest) <= 1 and (not rest or rest[0] in ("show", "before", "diff")):
        os.execv(sys.executable, [sys.executable, str(BIN / "live-check"), *(rest or ["show"])])
    elif cmd in ("-h", "--help", "help"):
        print(__doc__.split("\n\n")[1])
    else:
        die("usage: stella [open|start|restart|id|agents|launch|adopt|project|projects|crew|allow|track-pr|untrack|view|hide|tab|stop|respawn|logs|rm|live-check] ...")


if __name__ == "__main__":
    main(sys.argv)
