#!/usr/bin/python3 -I
"""stella: start, find and open Stella's session, and run her crew. The one command on this machine that
runs outside the command sandbox, so every argument is validated and nothing is passed through a shell.

    stella                       open Stella's session in this terminal (starting it if needed)
    stella start | id            start her in the background / print her id
    stella restart               stop her and resume her conversation with the start-of-session prompt
                                 (after a setup change: she reloads her manual and re-arms her watcher)
    stella agents [--all]        `claude agents --json`
    stella launch <name>         launch the crewmate whose brief and record Stella wrote in crew/<name>/
                                 (only from her own session); exit 75 and mark it queued when over a cap
    stella adopt <name|id> [--team T] [--project P]   record a session she did not launch (observation only)
    stella adopt --resume <session-uuid> <name> [--team T] [--project P]   bring back an unlisted session
                                 from its transcript under <name>, then adopt it
    stella assign <name> <slug>|--none   put a crewmate (or adopted session) under a project, or take it out
                                 (was `stella project <name> <slug>`, still accepted for two weeks)
    stella project new <slug>|--ask      register a project and open its space (`--ask`: prompt for the name, the
                                 Cmd+Shift+N popup); `project rename <old> <new>`; `project close <slug>` closes the space
    stella project main --all    start the main Claude session in the first window of each project that has none
    stella window new <project> [<name>] | rename <project> <a> <b> | close <project> <a>   windows of a space
    stella prefs scan [YYYY-MM-DD]   Kohen's answers to crewmates since a date (question and his words), one JSON line each
    stella prefs propose         patterns in preferences.md: 3 or more same answers to a kind of question, none against
    stella pane rename <project> <window> <pane-number> <new name>
    stella projects              every project with its crew, their state and the decisions waiting in it
                                 (the projects themselves are Stella's own file, projects.md)
    stella crew [--watch]        the crew as a compact list: project, crewmate, state, its one-line need;
                                 `--watch` redraws it every few seconds
    stella crew sync             make herdr's sidebar the crew list: a workspace "└ <name>" per live crewmate
                                 after Stella's (not a tab of her window), repaired and tidied;
                                 launch, adopt, rm, `tw` and `tok` run it, and Stella after a wake
    stella crew doctor [--json]  what herdr holds now (workspaces in order, tabs, panes, agents) next to what the
                                 crew records expect; read-only, for debugging the sidebar
    stella crew doctor --spike [<session-id>]   the Workspace 4.0 spike in a throwaway herdr session `ws4-spike`
                                 (never the default one); prints every raw reply and a verdict per question
    stella crew follow [--ensure|--once]   the dot reporter: one detached process copying Claude's own state of
                                 each session onto its herdr window (yellow = awaiting input, blue = working);
                                 `--ensure` starts it when none runs (`tw` and `crew sync` do), `--once` is one cycle
    stella crew --unpane         close the crew-list pane an earlier version put in Stella's tab
    stella track-pr <url> [name] watch a PR with no session: a track record, so a merge, a failing check,
                                 requested changes or a new review wakes her (`untrack <name>` ends it)
    stella allow <name> <activity>...   grant a session the activities Kohen allowed for its task (a crewmate's
                                 record or an adopted one's; `--none` clears them): the hooks then skip those prompts
    stella view <name>           take Kohen to a crewmate: focus its workspace (made if missing),
                                 or print the attach command; only when Kohen asks to talk to one
    stella hide <name> | --all   close the crew tabs of the old layout (opened in the work window); never any
                                 other tab, the sidebar's included; the sessions keep running
    stella listed <id>           exit 0 while the session is listed in `claude agents --all` (the crew pane's loop)
    stella tab [<id>]            what Stella's own tab runs: attach to the session (Stella's by default) and attach
                                 again whenever its process is restarted (`tok`, respawn), until it is gone
    stella stop <name> | respawn <name> [--model M] | logs <name>
    stella rm <name>             remove a finished crewmate, its worktree and its sidebar entry, only once its work has
                                 landed (an open PR keeps it); a track record goes once its PR is closed
    stella live-check [show|before|diff]   the tripwire (it needs the process table)

A record is crew/<name>/record.json in Stella's home. Stella writes `repo`, `branch` (or `dir`), `skill`,
`model`, `weight`, `mode` (ship|scout|local), `team`, `project`, `then` and `report` before launch; this script fills
`id`, `session`, `dir` and `state`. `allow` lists the activities the hooks do not prompt for in that session
(ACTIVITIES); Stella writes it only from Kohen's explicit words for the task, or a canon principle. The brief, crew/<name>/brief.md, is the crewmate's first prompt.

Caps (W3-D25, no cap on the number of crewmates or projects: Kohen, 2026-10-18): at most OPUS_UNITS of Opus weight
working, no
Opus-weighted launch while `throttle-until` is in the future, and no launch at all when `quota.json` says
QUOTA_STOP of the day's budget is spent. Both files are written by stella-watch.
"""

from __future__ import annotations

import json
import os
import re
import subprocess
import sys
import time
import uuid
from pathlib import Path

HOME = Path.home()
STELLA_HOME = HOME / ".local/share/stella"
CREW = STELLA_HOME / "crew"
TOKENS = Path(os.environ.get("CLAUDE_TOKEN_STATE", HOME / ".local/state/claude-token")) / "sessions"
EXTENSION = HOME / ".claude/kc-extensions/stella.json"  # this machine's additions: start_roots, watches
BIN = Path(__file__).resolve().parent
FLAGS = ["--dangerously-skip-permissions"]
OPUS_UNITS, QUOTA_STOP = 4.0, 0.85
QUEUED = 75
# This script runs outside the command sandbox, so it trusts nothing agents can write: an isolated
# interpreter (-I above), a fixed PATH, no shell rc files, and git with hooks and fsmonitor disabled.
# (STELLA_PATH is for the tests; acc-guard refuses a helper call with an environment prefix.)
os.environ["PATH"] = os.environ.get("STELLA_PATH", "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin")
GIT = ["git", "-c", "core.fsmonitor=", "-c", "core.hooksPath=/dev/null"]
TIMEOUT = 120

ACTIVITIES = ("push", "security-boundary")  # what a record's `allow` can grant; the hooks read it
NAME = re.compile(r"^[a-z0-9][a-z0-9-]{0,40}$")
PROJECT = NAME  # a project slug: lowercase letters, digits and dashes
REPO = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,60}$")
BRANCH = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._/-]{0,100}$")
MODEL = re.compile(r"^[a-z0-9][a-z0-9.\[\]-]{0,40}$")
SHORT_ID = re.compile(r"^[0-9a-f]{8}$")
PROJECT_SEP = " · "  # between the project and the name in a crew workspace label
CHILD = "└ "  # a crewmate's herdr workspace is labelled "└ <name>", as firstmate labels its crew workspaces
TAB_PREFIX = "fm-"  # and its one tab "fm-<name>"
PARENT = "stella"  # the workspace that holds Stella's tab (firstmate's is "firstmate"); the crew sits right after it
OLD_PARENT = "work"  # what it was called before; sync renames it
OLD_CREW_WORKSPACE = "crew"  # the earlier layout: one workspace with a tab per crewmate
# `gh pr view owner/repo#N` silently fails on the enterprise host, so a `pr` is always a full URL.
PR_URL = re.compile(r"^https://([A-Za-z0-9.-]+)/([A-Za-z0-9._-]+)/([A-Za-z0-9._-]+)/pull/([0-9]+)$")


def die(msg: str, code: int = 2) -> None:
    print(f"stella: {msg}", file=sys.stderr)
    sys.exit(code)


def claude(*args: str, cwd: Path | None = None, capture: bool = True) -> subprocess.CompletedProcess:
    return subprocess.run(["claude", *args], cwd=cwd, capture_output=capture, text=True, timeout=TIMEOUT)


def git(d: Path, *args: str) -> subprocess.CompletedProcess:
    return subprocess.run([*GIT, "-C", str(d), *args], capture_output=True, text=True, timeout=TIMEOUT)


def agents(all_: bool = True) -> list[dict]:
    p = claude("agents", "--json", *(["--all"] if all_ else []))
    try:
        rows = json.loads(p.stdout)
    except ValueError:
        die(f"claude agents --json failed: {(p.stderr or p.stdout).strip()[-200:]}", 1)
    return rows


def stella_row() -> dict | None:
    return next((a for a in agents(False) if a.get("name") == "stella" and a.get("kind") == "background"), None)


# ------------------------------------------------------------------ Stella herself

def start() -> str:
    row = stella_row()
    if row:
        return row["id"]
    STELLA_HOME.mkdir(parents=True, exist_ok=True)
    claude("--bg", "-n", "stella", "--agent", "stella", "--model", "sonnet", *FLAGS, "--", START_PROMPT,
           cwd=STELLA_HOME)
    for _ in range(10):
        row = stella_row()
        if row:
            return row["id"]
        time.sleep(1)
    die("started, but the session did not show up in 'claude agents' yet", 1)
    return ""


START_PROMPT = "Session start: do the start-of-session steps in your manual."


def restart() -> str:
    """Stop Stella and resume the same conversation with the start-of-session prompt, so she reloads her
    skill, reconciles the crew and re-arms her watcher (a plain re-attach would skip all of that)."""
    row = next((a for a in agents() if a.get("name") == "stella" and a.get("kind") == "background"), None)
    if not row:
        return start()
    if row.get("state") in ("working", "blocked") or row.get("pid"):
        if claude("stop", row["id"]).returncode != 0:
            die(f"could not stop Stella ({row['id']})", 1)
    p = claude("--bg", "--resume", row["sessionId"], "-n", "stella", "--agent", "stella", "--model", "sonnet",
               *FLAGS, "--", START_PROMPT, cwd=STELLA_HOME)
    if p.returncode != 0:
        die(f"could not resume Stella: {(p.stderr or p.stdout).strip()[-200:]}", 1)
    return row["id"]


# ------------------------------------------------------------------ records

def check_name(name: str) -> str:
    if not NAME.match(name):
        die(f"bad name {name!r} (lowercase letters, digits and dashes, at most 41)")
    return name


def check_project(slug: str) -> str:
    if not PROJECT.match(slug):
        die(f"bad project {slug!r} (lowercase letters, digits and dashes, at most 41)")
    return slug


def record_path(name: str) -> Path:
    return CREW / check_name(name) / "record.json"


def load(name: str) -> dict:
    p = record_path(name)
    if not p.exists():
        die(f"no record for {name} ({p})")
    return json.loads(p.read_text())


def save(name: str, rec: dict) -> None:
    p = record_path(name)
    p.parent.mkdir(parents=True, exist_ok=True)
    tmp = p.with_suffix(".tmp")
    tmp.write_text(json.dumps(rec, indent=1))
    tmp.replace(p)


def records() -> list[dict]:
    out = []
    for p in sorted(CREW.glob("*/record.json")):
        try:
            out.append(json.loads(p.read_text()))
        except (OSError, ValueError):
            pass
    return out


def live_state(rec: dict, rows: dict[str, dict]) -> str | None:
    row = rows.get(rec.get("id") or "") or rows.get((rec.get("session") or "")[:8])
    return row.get("state") if row else None


# ------------------------------------------------------------------ caps

def read_json(path: Path) -> dict:
    try:
        return json.loads(path.read_text())
    except (OSError, ValueError):
        return {}


def over_cap(rec: dict) -> str | None:
    listed = agents()
    rows = {a.get("id", ""): a for a in listed}
    rows.update({(a.get("sessionId") or "")[:8]: a for a in listed})
    busy = [r for r in records() if r.get("name") != rec.get("name") and not r.get("adopted")
            and live_state(r, rows) in ("working", "blocked")]
    working = [r for r in busy if live_state(r, rows) == "working"]
    weight = float(rec.get("weight") or 0)
    if weight and sum(float(r.get("weight") or 0) for r in working) + weight > OPUS_UNITS:
        return f"Opus weight cap: {OPUS_UNITS} units in use would be exceeded"
    until = read_json(STELLA_HOME / "throttle-until").get("until", 0)
    if weight and until > time.time():
        return f"Opus throttled; no Opus launch for {int(until - time.time())} s more"
    quota = STELLA_HOME / "quota.json"
    fresh = quota.exists() and time.time() - quota.stat().st_mtime < 1800
    q = read_json(quota) if fresh else {}
    frac = q.get("fraction")
    # The quota measures one token (e.g. the personal daily budget). A crewmate bills the token Stella runs
    # on, so the gate applies only when that is the token the quota measures.
    row = stella_row()
    mine = (TOKENS / row["sessionId"]).read_text().strip() if row and (TOKENS / row.get("sessionId", "")).is_file() else None
    if q.get("token") and mine and q["token"] != mine:
        frac = None
    if isinstance(frac, (int, float)) and frac >= QUOTA_STOP:
        return f"budget gate: {frac:.0%} of today's budget is spent"
    return None


# ------------------------------------------------------------------ launch

def inherit_token(session: str) -> None:
    """The crewmate bills the same token as Stella (W3-D29): copy her record before it starts."""
    row = stella_row()
    src = TOKENS / (row or {}).get("sessionId", "") if row else None
    if src and src.is_file():
        TOKENS.mkdir(parents=True, exist_ok=True)
        (TOKENS / session).write_text(src.read_text())


def worktree(rec: dict) -> Path:
    if rec.get("repo"):
        repo, branch = rec["repo"], rec.get("branch") or rec["name"]
        if not REPO.match(repo) or not BRANCH.match(branch) or ".." in branch:
            die(f"bad repo or branch: {repo} {branch}")
        if not (HOME / "github" / repo).is_dir():
            die(f"no repo at ~/github/{repo}")
        main = HOME / "github" / repo
        wt = HOME / "github" / f"{repo}-wt" / branch
        if not wt.is_dir():  # the same layout and semantics as the `wta` helper, without a shell rc file
            git(main, "fetch", "--quiet", "origin")
            exists = git(main, "show-ref", "--verify", "--quiet", f"refs/heads/{branch}").returncode == 0
            remote = git(main, "show-ref", "--verify", "--quiet", f"refs/remotes/origin/{branch}").returncode == 0
            wt.parent.mkdir(parents=True, exist_ok=True)
            if exists or remote:
                p = git(main, "worktree", "add", str(wt), branch)
            else:
                p = git(main, "worktree", "add", "-b", branch, str(wt), rec.get("base") or "origin/HEAD")
            if not wt.is_dir():
                die(f"could not make the worktree {wt}: {p.stderr.strip()[-300:]}", 1)
        return wt
    d = Path(os.path.expanduser(rec.get("dir") or "")).resolve()
    extra = [Path(os.path.expanduser(r)) for r in read_json(EXTENSION).get("start_roots", [])]
    roots = [r.resolve() for r in (HOME / "github", STELLA_HOME, *extra)]
    if not d.is_dir() or not any(d == r or r in d.parents for r in roots):
        die(f"start directory must be under ~/github, Stella's home or a start_roots entry: {d}")
    return d


def check_pr(url: str) -> str:
    if not PR_URL.match(url):
        die(f"bad pr {url!r}: write the full URL, https://<host>/<owner>/<repo>/pull/<N>"
            " (`gh pr view owner/repo#N` does not resolve on the enterprise host, so no PR event would ever fire)")
    return url


def launch(name: str) -> None:
    if Path.cwd().resolve() != STELLA_HOME.resolve():
        die("launch runs only from Stella's own session")
    rec = load(name)
    if rec.get("adopted") or rec.get("mode") == "track":
        die(f"{name} is adopted or tracked: it was not launched by Stella")
    if rec.get("pr"):
        check_pr(rec["pr"])
    if rec.get("project"):
        check_project(rec["project"])
    if rec.get("id") and any(a.get("id") == rec["id"] and a.get("state") in ("working", "blocked")
                             for a in agents()):
        die(f"{name} is already running ({rec['id']})")
    brief = (CREW / name / "brief.md")
    if not brief.is_file() or not brief.read_text().strip():
        die(f"no brief at {brief}")
    model = rec.get("model") or "sonnet"
    if not MODEL.match(model):
        die(f"bad model {model!r}")
    why = over_cap(rec)
    if why:
        rec["state"] = "queued"
        rec["queued_because"] = why
        save(name, rec)
        die(f"{name} queued: {why}", QUEUED)
    if rec.pop("security", False):  # the old flag: a task about the sandbox boundary
        rec["allow"] = sorted({*(rec.get("allow") or []), "security-boundary"})
    d = worktree(rec)
    session = str(uuid.uuid4())
    inherit_token(session)
    p = claude("--bg", "--session-id", session, "-n", name, "--model", model, *FLAGS, "--", brief.read_text(), cwd=d)
    if p.returncode != 0:
        die(f"claude --bg failed: {(p.stderr or p.stdout).strip()[-300:]}", 1)
    # `claude --bg` ignores --session-id and the daemon assigns its own, so the uuid above is not the
    # session: find the one just started under this name (newest first) and record its real ids.
    started = sorted((a for a in agents() if a.get("name") == name), key=lambda a: a.get("startedAt") or 0)
    if not started:
        die(f"launched {name}, but no session by that name is listed; run `stella agents --all`", 1)
    row = started[-1]
    if row.get("sessionId") and row["sessionId"] != session:
        inherit_token(row["sessionId"])  # the token file is keyed by the real session
    rec.update({"id": row.get("id"), "session": row.get("sessionId"), "dir": str(d),
                "state": "working", "launched_at": time.strftime("%Y-%m-%dT%H:%M:%S%z")})
    rec.pop("queued_because", None)
    save(name, rec)
    print(f"launched {name} ({rec['id']}) in {d} on {model}")
    sync_quietly()


ADOPT_PROMPT = ("Stella has adopted this session so Kohen can see it in the agents list while its work is open. "
                "Nothing to do now: reply with one line on the state of its open PRs, then wait.")
UUID = re.compile(r"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$")


def adopt_resume(session: str, name: str, team: str | None, project: str | None = None) -> None:
    """Bring back a session that is no longer in `claude agents` (removed or never backgrounded) from its
    transcript, under `name`, then adopt it. Observation only, like adopt."""
    if not UUID.match(session):
        die(f"bad session id {session!r} (the full uuid of its transcript)")
    if record_path(name).exists():
        die(f"{name} already has a record")
    if any(a.get("sessionId") == session for a in agents()):
        die(f"{session[:8]} is already listed; use `stella adopt {session[:8]}`")
    found = sorted((HOME / ".claude/projects").glob(f"*/{session}.jsonl"))
    if not found:
        die(f"no transcript for {session}")
    cwd = HOME
    for line in found[0].open(errors="ignore"):
        try:
            c = json.loads(line).get("cwd")
        except ValueError:
            continue
        if c and Path(c).is_dir():
            cwd = Path(c)
            break
    p = claude("--bg", "--resume", session, "-n", name, *FLAGS, "--", ADOPT_PROMPT, cwd=cwd)
    if p.returncode != 0:
        die(f"claude --bg --resume failed: {(p.stderr or p.stdout).strip()[-300:]}", 1)
    rows = sorted((a for a in agents() if a.get("name") == name), key=lambda a: a.get("startedAt") or 0)
    if not rows:
        die(f"resumed {name}, but no session by that name is listed; run `stella agents --all`", 1)
    row = rows[-1]
    save(name, {"name": name, "id": row.get("id"), "session": row.get("sessionId"), "dir": str(cwd),
                "adopted": True, "team": team, "weight": 0, "state": row.get("state"), "resumed_from": session,
                **({"project": project} if project else {}),
                "adopted_at": time.strftime("%Y-%m-%dT%H:%M:%S%z")})
    print(f"resumed {session[:8]} as {name} ({row.get('id')}) and adopted it (observation only)")
    sync_quietly()


def allow(name: str, activities: list[str]) -> None:
    rec = load(name)
    if activities == ["--none"]:
        activities = []
    bad = [a for a in activities if a not in ACTIVITIES]
    if bad:
        die(f"unknown activity {bad[0]!r}; the activities are: {', '.join(ACTIVITIES)}")
    rec["allow"] = sorted(set(activities))
    save(name, rec)
    print(f"{name} may: {', '.join(rec['allow']) or 'nothing extra'}")


def adopt(target: str, team: str | None, project: str | None = None) -> None:
    rows = agents()
    if target == "stella":
        die("Stella does not adopt herself")
    row = next((a for a in rows if target in (a.get("name"), a.get("id"), a.get("sessionId"))), None)
    if not row or row.get("name") == "stella":
        die(f"no session named or with id {target!r} in claude agents")
    name = row.get("name") if row.get("name") and NAME.match(row["name"]) else \
        re.sub(r"[^a-z0-9-]+", "-", (row.get("name") or row["id"]).lower()).strip("-")[:41] or row["id"]
    if record_path(name).exists():
        die(f"{name} already has a record")
    save(name, {"name": name, "id": row.get("id"), "session": row.get("sessionId"), "dir": row.get("cwd"),
                "adopted": True, "team": team, "weight": 0, "state": row.get("state"),
                **({"project": project} if project else {}), "adopted_at": time.strftime("%Y-%m-%dT%H:%M:%S%z")})
    print(f"adopted {row.get('name') or row['id']} as {name} (observation only)")
    sync_quietly()


# ------------------------------------------------------------------ view / lifecycle

def _herdr() -> str:
    return subprocess.run(["sh", "-c", "command -v herdr"], capture_output=True, text=True).stdout.strip()


def _herdr_pane(out: str) -> str | None:
    m = re.search(r'"pane_id"\s*:\s*"([^"]+)"', out)
    return m.group(1) if m else None


def _tab_id(out: str) -> str | None:
    """The id of the tab in a `herdr tab create` reply (`.result.tab`)."""
    try:
        tab = json.loads(out)["result"]["tab"]
        return tab.get("tab_id") or tab.get("id")
    except (ValueError, KeyError, TypeError, AttributeError):
        return None


def _herdr_tabs(herdr: str, workspace: str | None = None) -> dict[str, str]:
    """{tab id: label} of every tab (of one workspace when given), from `herdr tab list` (any nesting; a tab
    has an id and a label)."""
    cmd = [herdr, "tab", "list"] + (["--workspace", workspace] if workspace else [])
    p = subprocess.run(cmd, capture_output=True, text=True, timeout=30)
    found: dict[str, str] = {}

    def walk(x):
        if isinstance(x, dict):
            tid = x.get("tab_id") or x.get("id")
            label = x.get("label") or x.get("custom_name")
            if isinstance(tid, str) and isinstance(label, str):
                found[tid] = label
            for v in x.values():
                walk(v)
        elif isinstance(x, list):
            for v in x:
                walk(v)

    try:
        walk(json.loads(p.stdout))
    except ValueError:
        pass
    return found


def _workspaces(herdr: str) -> dict[str, str] | None:
    """{workspace id: label} from `herdr workspace list`; None when herdr does not answer (no server)."""
    p = subprocess.run([herdr, "workspace", "list"], capture_output=True, text=True, timeout=30)
    if p.returncode != 0:
        return None
    found: dict[str, str] = {}

    def walk(x):
        if isinstance(x, dict):
            wid = x.get("workspace_id") or x.get("id")
            if isinstance(wid, str) and isinstance(x.get("label"), str) and "tab_id" not in x and "pane_id" not in x:
                found[wid] = x["label"]
            for v in x.values():
                walk(v)
        elif isinstance(x, list):
            for v in x:
                walk(v)

    try:
        walk(json.loads(p.stdout))
    except ValueError:
        return None
    return found


# What a tab shows after its `claude attach` died with the process: "Session 3479a9f0 has exited."
EXITED_RE = re.compile(r"session [0-9a-f]{8} has exited|session exited", re.I)
FOLLOW_GRACE = float(os.environ.get("STELLA_FOLLOW_GRACE", "4"))  # seconds to tell a restart from a detach
FOLLOW_WAIT = float(os.environ.get("STELLA_FOLLOW_WAIT", "90"))  # seconds a restart may take to come back


def _process(sid: str) -> tuple[bool, object]:
    """(listed, identity of the running process) of a session; the identity changes when it restarts."""
    row = next((a for a in agents(True) if a.get("id") == sid), None)
    if row is None:
        return False, None
    return True, (row.get("pid"), row.get("startedAt")) if row.get("pid") else None


def follow(sid: str) -> int:
    """`claude attach` that survives a restart of the session: when attach returns because the process was
    replaced (same session id, new process), wait for the new one and attach again. A detach, or a session
    that is gone from `claude agents --all`, ends it."""
    while True:
        listed, ident = _process(sid)
        if not listed:
            print(f"session {sid} is gone")
            return 0
        rc = subprocess.run(["claude", "attach", sid]).returncode
        deadline, first = time.time() + FOLLOW_WAIT, time.time()
        while True:
            listed, now = _process(sid)
            if not listed:
                print(f"session {sid} is gone")
                return 0
            if now is not None and now != ident:
                print(f"session {sid} restarted; attaching again")
                break
            if now is not None and time.time() - first >= FOLLOW_GRACE:
                return rc  # the same process is still running: the attach ended on purpose
            if time.time() >= deadline:
                print(f"session {sid} did not come back", file=sys.stderr)
                return 1
            time.sleep(min(1.0, max(FOLLOW_GRACE / 4, 0.05)))


def _tab_panes(herdr: str, tab: str) -> list[str]:
    """Pane ids of a tab, from `herdr pane list` (any nesting; a pane has a pane_id and a tab_id)."""
    p = subprocess.run([herdr, "pane", "list"], capture_output=True, text=True, timeout=30)
    found: list[str] = []

    def walk(x):
        if isinstance(x, dict):
            if x.get("tab_id") == tab and isinstance(x.get("pane_id"), str):
                found.append(x["pane_id"])
            for v in x.values():
                walk(v)
        elif isinstance(x, list):
            for v in x:
                walk(v)

    try:
        walk(json.loads(p.stdout))
    except ValueError:
        pass
    return found


def _dormant_cmd(sid: str) -> str:
    """What the window of a *finished* session runs: its log, then a wait. A viewer attached to a finished session
    makes the daemon start a host process for it, so none is attached until the session works again, when the loop
    attaches by itself (`stella dormant` says whether it is still finished)."""
    stella = BIN / "stella"
    return (f"claude logs {sid} 2>&1 | tail -n 60; echo '(finished: this window attaches by itself when it works "
            f"again, or run claude attach {sid} to continue it)'; while {stella} listed {sid}; do "
            f"if {stella} dormant {sid}; then sleep 5; else claude attach {sid}; sleep 2; fi; done")


def _attach_cmd(sid: str, dormant: bool = False) -> str:
    """What a crew pane runs, typed into the pane's shell: `claude attach` itself is the foreground process, so
    herdr detects a Claude agent (a python parent in front of it, as `stella tab` is, hides it). The loop attaches
    again after a restart (`tok`, respawn) for as long as the session is listed."""
    if dormant:
        return _dormant_cmd(sid)
    stella = BIN / "stella"
    return f"while {stella} listed {sid}; do claude attach {sid}; sleep 2; done"


VERBOSE = bool(os.environ.get("STELLA_VERBOSE"))


SHELLS = {"zsh", "bash", "sh", "fish", "dash", "ksh", "tcsh"}


def _strings(x, key: str = ""):
    """(key, string) pairs of every string in a JSON value, at any depth (list items carry their list's key)."""
    if isinstance(x, str):
        yield key, x
    elif isinstance(x, dict):
        for k, v in x.items():
            yield from _strings(v, k)
    elif isinstance(x, list):
        for v in x:
            yield from _strings(v, key)


def pane_foreground(herdr: str, pane: str) -> list[str] | None:
    """The names of the processes `herdr pane process-info` reports in a pane (the foreground job's when it says
    which), lowercase; None when it cannot be read or holds no process name at all."""
    p = _herdr_run(herdr, "pane", "process-info", pane)
    try:
        info = json.loads(p.stdout)
    except ValueError:
        return None
    found = []
    for k, v in _strings(info.get("result", info)):
        if re.search(r"name|comm|command|cmd|exe|argv|process|title", k, re.I) and not re.search(r"cwd|path|dir", k, re.I):
            first = v.strip().split(" ")[0] if v.strip() else ""
            if first:
                found.append(os.path.basename(first).lstrip("-").lower())
                found += [w.lower() for w in re.findall(r"[A-Za-z][\w.-]*", v)][:6]
    return found or None


def pane_is_shell(herdr: str, pane: str) -> bool:
    """True only when a shell is what the pane runs in the foreground: never text into a Claude (or anything
    unknown) that is already there. A pane whose processes cannot be read is not a shell."""
    names = pane_foreground(herdr, pane)
    return bool(names) and any(n in SHELLS for n in names) and not any(n in ("claude", "node") for n in names)


def repair_tab(herdr: str, tab: str, sid: str) -> None:
    """A tab left showing 'session exited' (opened before tabs followed their session): attach it again, but only
    when the pane is at a shell: a Claude on screen that mentions 'session exited' in its chat is left alone."""
    panes = _tab_panes(herdr, tab)
    if VERBOSE:
        print(f"  tab {tab} ({sid}): panes {panes}")
    for pane in panes:
        r = subprocess.run([herdr, "pane", "read", pane, "--lines", "10"], capture_output=True, text=True,
                           timeout=30)
        out = r.stdout
        if VERBOSE:
            print(f"    pane {pane} rc={r.returncode} read={out[-300:]!r} err={r.stderr[-200:]!r}")
        if EXITED_RE.search(out) and pane_is_shell(herdr, pane):
            subprocess.run([herdr, "pane", "run", pane, _attach_cmd(sid, _is_finished(sid))], capture_output=True,
                           text=True, timeout=30)


def _herdr_run(herdr: str, *args: str) -> subprocess.CompletedProcess:
    return subprocess.run([herdr, *args], capture_output=True, text=True, timeout=30)


def _socket_path(herdr: str) -> str | None:
    """The control socket of the herdr server: $STELLA_HERDR_SOCKET, $HERDR_SOCKET_PATH, else the default
    session's from `herdr session list --json`."""
    env = os.environ.get("STELLA_HERDR_SOCKET") or os.environ.get("HERDR_SOCKET_PATH")
    if env:
        return env
    p = _herdr_run(herdr, "session", "list", "--json")
    try:
        return next((x["socket_path"] for x in json.loads(p.stdout)["sessions"] if x.get("default")), None)
    except (ValueError, KeyError, TypeError, StopIteration):
        return None


def _rpc(herdr: str, method: str, params: dict) -> dict | None:
    """One request over the control socket (herdr has no CLI for some methods); the reply's `result`, or None
    when the socket is out of reach or herdr refuses. The request is the one firstmate's presentation ordering
    sends (bin/backends/herdr-workspace-move.py, MIT)."""
    import socket
    path = _socket_path(herdr)
    if not path or not path.startswith("/"):
        return None
    req = {"id": "stella-" + method, "method": method, "params": params}
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as c:
            c.settimeout(5)
            c.connect(path)
            c.sendall((json.dumps(req, separators=(",", ":")) + "\n").encode())
            buf = b""
            while b"\n" not in buf:
                chunk = c.recv(65536)
                if not chunk:
                    break
                buf += chunk
        reply = json.loads(buf.split(b"\n", 1)[0])
    except (OSError, ValueError):
        return None
    if reply.get("error") is not None or reply.get("id") != req["id"]:
        return None
    return reply.get("result") or {}


def _move_workspace(herdr: str, ws: str, index: int) -> bool:
    """`workspace.move`: put workspace `ws` at `index`; best effort, the crew stays where herdr put it when
    this fails."""
    return _rpc(herdr, "workspace.move", {"workspace_id": ws, "insert_index": index}) is not None


def priority_rank(recs: list[dict]) -> dict[str, int]:
    """{project: rank} from priorities.md: a project ranks by the first numbered priority that names its slug
    or one of its crewmates; a project no priority names has no rank."""
    try:
        lines = (STELLA_HOME / "priorities.md").read_text().splitlines()
    except OSError:
        return {}
    items: list[str] = []  # a numbered item runs over the lines after it, up to a blank line or heading
    open_item = False
    for ln in lines:
        if re.match(r"\s*\d+\.\s", ln):
            items.append(ln)
            open_item = True
        elif open_item and ln.strip() and not ln.startswith("#"):
            items[-1] += " " + ln
        else:
            open_item = False
    rank: dict[str, int] = {}
    for proj in {r["project"] for r in recs if r.get("project")}:
        words = {proj} | {r["name"] for r in recs if r.get("project") == proj}
        for i, ln in enumerate(items):
            if any(re.search(rf"(?<![A-Za-z0-9-]){re.escape(w)}(?![A-Za-z0-9-])", ln) for w in words):
                rank[proj] = i
                break
    return rank


def crew_sort(recs: list[dict], every: list[dict] | None = None) -> list[dict]:
    """Projects in the order of priorities.md, then the rest alphabetically; crewmates of a project
    alphabetically; a crewmate with no project last."""
    rank = priority_rank(every or recs)  # a priority may name a crewmate that is not live now
    return sorted(recs, key=lambda r: (not r.get("project"), rank.get(r.get("project"), 1 << 30),
                                       r.get("project") or "", r["name"]))


def _agent_panes(herdr: str) -> set[str]:
    """Pane ids that `herdr agent list` reports an agent in (any nesting)."""
    found: set[str] = set()

    def walk(x):
        if isinstance(x, dict):
            if isinstance(x.get("pane_id"), str):
                found.add(x["pane_id"])
            for v in x.values():
                walk(v)
        elif isinstance(x, list):
            for v in x:
                walk(v)

    try:
        walk(json.loads(_herdr_run(herdr, "agent", "list").stdout))
    except ValueError:
        pass
    return found


REPORT_SOURCE = "stella"
ATTACH_VERSION = 2  # 1: `stella tab` in the pane; 2: `claude attach` itself in a shell loop


def _retire_old_crew_workspace(herdr: str, wss: dict[str, str], names: set[str]) -> None:
    """Close the one-workspace-with-a-tab-per-crewmate layout of the first sidebar version, once every tab
    in it is a crewmate's (a tab of Kohen's is never closed)."""
    for w, label in wss.items():
        if label != OLD_CREW_WORKSPACE:
            continue
        tabs = _herdr_tabs(herdr, w)
        if all(t in names for t in tabs.values()):
            _herdr_run(herdr, "workspace", "close", w)
            print(f"closed the old {OLD_CREW_WORKSPACE} workspace")


# ------------------------------------------------------------------ the dot reporter (Workspace 4.0)

# herdr decides a Claude pane's state by reading its screen, and a session that ended its turn waiting for
# Kohen sits at its `❯` prompt, which herdr reads as idle. Claude's own state (the job file the agent view
# reads) says "blocked" there. `stella crew follow` copies Claude's state onto each window's pane.
FOLLOW_EVERY = float(os.environ.get("STELLA_FOLLOW_EVERY", "2"))  # seconds between two reads of the job states
FOLLOW_SYNC = float(os.environ.get("STELLA_FOLLOW_SYNC", "30"))  # at most this often: sync, when the sessions changed
VIEW_EVERY = float(os.environ.get("STELLA_VIEW_EVERY", "60"))  # the agent view is transient: set it again this often
FOLLOW_VERSION = 4  # bump when the reporter changes: `crew sync` and `follow --ensure` replace one running an older version
REFIX_EVERY = float(os.environ.get("STELLA_REFIX_EVERY", "10"))  # a pane herdr shows differently is reported again, at most this often
FOLLOW_PID = STELLA_HOME / "follow.pid"
FOLLOW_LOG = STELLA_HOME / "follow.log"
VIEW_MARK = STELLA_HOME / "view-applied.json"  # when the reporter last set the agent view (doctor reads it)
NEED_LABEL = "needs you"
HERDR_STATE = {"blocked": "blocked", "working": "working"}  # every other Claude state (done, stopped, ...) is idle
VIEW = {"source": REPORT_SOURCE, "label": "this space",
        "filter": {"op": "eq", "field": "workspace_id", "value": {"context": "current_workspace_id"}},
        "sort": [{"field": "attention"}, {"field": "tab_order"}]}


def claude_state(sid: str, rows: dict[str, dict] | None = None) -> str | None:
    """Claude's own state of a session: the job state its agent view reads, else the `claude agents` row's."""
    job = read_json(JOBS / sid / "state.json").get("state")
    if job:
        return job
    row = (rows or {}).get(sid)
    return row.get("state") if row else None


def dot_of(state: str | None) -> str | None:
    """What a window's dot shows for Claude's state: blocked, working or idle; None when there is no session."""
    return HERDR_STATE.get(state, "idle") if state else None


def _need_text(rec: dict | None, sid: str) -> str:
    """The one line saying what a blocked session needs: its first NEXT FOR YOU item, else the job's `needs`."""
    if rec:
        return crew_status(rec)[1]
    job = read_json(JOBS / sid / "state.json")
    return job.get("needs") or job.get("detail") or ""


def _tab_panes_by_tab(herdr: str) -> dict[str, list[str]]:
    """{tab id: pane ids} from one `herdr pane list`."""
    p = _herdr_run(herdr, "pane", "list")
    found: dict[str, list[str]] = {}

    def walk(x):
        if isinstance(x, dict):
            if isinstance(x.get("pane_id"), str) and isinstance(x.get("tab_id"), str):
                found.setdefault(x["tab_id"], []).append(x["pane_id"])
            for v in x.values():
                walk(v)
        elif isinstance(x, list):
            for v in x:
                walk(v)

    try:
        walk(json.loads(p.stdout))
    except ValueError:
        pass
    return found


def session_windows(herdr: str, wss: dict[str, str]) -> list[dict]:
    """Every window that shows a Claude session, as {sid, name, rec, space, panes}: a crewmate's (its record's
    `tab` in its project's `space`, or the workspace of the earlier layout), Stella's own, and the sessions in
    windows.json (nobody adopted them). Panes come from one `pane list`."""
    by_tab = _tab_panes_by_tab(herdr)
    out: list[dict] = []
    for rec in records():
        if not rec.get("id") or rec.get("mode") == "track" or rec.get("state") == "landed":
            continue
        if rec.get("space") and rec.get("tab"):
            tabs, space = [rec["tab"]], rec["space"]
        elif rec.get("crew_ws") in wss:
            tabs, space = list(_herdr_tabs(herdr, rec["crew_ws"])), rec["crew_ws"]
        else:
            continue
        out.append({"sid": rec["id"], "name": rec["name"], "rec": rec, "space": space,
                    "panes": [pn for t in tabs for pn in by_tab.get(t, [])][:1]})
    me = stella_row()
    parent = next((w for w, label in wss.items() if label in (PARENT, OLD_PARENT)), None)
    if me and parent:
        tabs = [t for t, label in _herdr_tabs(herdr, parent).items() if label.lower() == "stella"]
        out.append({"sid": me["id"], "name": "stella", "rec": None, "space": parent,
                    "panes": [pn for t in tabs for pn in by_tab.get(t, [])][:1]})
    for sid, w in read_json(STELLA_HOME / "windows.json").items():
        if isinstance(w, dict) and w.get("tab"):
            out.append({"sid": sid, "name": w.get("name") or sid, "rec": None, "space": w.get("space"),
                        "panes": by_tab.get(w["tab"], [])[:1]})
    return out


def apply_agent_view(herdr: str) -> bool:
    """Scope herdr's Agents panel to the focused space (`agent.view.set`); the view is transient, so the reporter
    sets it again whenever it may have been lost. Writes view-applied.json for doctor."""
    ok = _rpc(herdr, "agent.view.set", VIEW) is not None
    if ok:
        VIEW_MARK.write_text(json.dumps({"at": time.time(), "pid": os.getpid()}))
    return ok


def follow_once(herdr: str, last: dict, rows: dict[str, dict] | None = None) -> int:
    """One cycle: copy Claude's state onto every window's pane and the count of its blocked windows onto every
    space, calling herdr only for what changed since `last` (the previous cycle's reports). Returns the number
    of herdr calls made."""
    wss = _workspaces(herdr)
    if wss is None:
        last.clear()  # the server is gone: everything is reported again when it comes back
        return 0
    calls = 0
    need_by_space: dict[str, int] = {}
    seen: set[str] = set()
    shown = _agent_states(herdr)  # what herdr shows now: a report is dropped when the pane's process changes
    for w in session_windows(herdr, wss):
        state = dot_of(claude_state(w["sid"], rows))
        if state is None or not w["panes"]:
            continue
        pane = w["panes"][0]
        seen.add(pane)
        text = (_need_text(w["rec"], w["sid"]) if state == "blocked" else "")[:80]
        if state == "blocked":
            need_by_space[w["space"]] = need_by_space.get(w["space"], 0) + 1
        key = (state, text)
        agrees = shown.get(pane) == state or (state == "idle" and shown.get(pane) in ("idle", "done"))
        if last.get(pane) == key and (agrees or time.time() - last.get(("fix", pane), 0) < REFIX_EVERY):
            continue
        last[("fix", pane)] = time.time()
        seq = str(time.time_ns() // 1000)
        _herdr_run(herdr, "pane", "report-agent", pane, "--source", REPORT_SOURCE, "--agent", "claude",
                   "--state", state, "--message", text or state, "--seq", seq)
        _herdr_run(herdr, "pane", "report-metadata", pane, "--source", REPORT_SOURCE, "--agent", "claude",
                   "--state-label", f"blocked={NEED_LABEL}", "--seq", seq,
                   *(["--title", text] if text else ["--clear-title"]))
        last[pane] = key
        calls += 2
    for space in wss:
        n = need_by_space.get(space, 0)
        if last.get(("space", space)) == n:
            continue
        _herdr_run(herdr, "workspace", "report-metadata", space, "--source", REPORT_SOURCE,
                   *(["--token", f"need={n} waiting"] if n else ["--clear-token", "need"]))
        last[("space", space)] = n
        calls += 1
    for k in [k for k in last if isinstance(k, str) and k not in seen]:
        del last[k]  # a pane that is gone: forget it, a new pane of the same id is reported again
    return calls


def _alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def follower_pid() -> int | None:
    """The pid of the running reporter, or None (no pidfile, or a stale one)."""
    try:
        pid = int(FOLLOW_PID.read_text().split()[0])
    except (OSError, ValueError, IndexError):
        return None
    return pid if _alive(pid) else None


def follower_version() -> int:
    try:
        return int(FOLLOW_PID.read_text().split()[1])
    except (OSError, ValueError, IndexError):
        return 0


def ensure_follower() -> int | None:
    """Start the reporter when none runs. It is detached (a session of its own, no controlling terminal), so
    stopping Stella's process tree cannot stop it; running it again while one lives starts nothing."""
    pid = follower_pid()
    herdr = _herdr()
    if not herdr or os.environ.get("STELLA_NO_FOLLOWER"):  # (the tests start none of their own accord)
        return pid
    if pid and follower_version() == FOLLOW_VERSION:
        return pid
    if pid:  # it runs older code: replace it (only the reporter; no session is touched)
        try:
            os.kill(pid, 15)
        except OSError:
            pass
        for _ in range(30):
            if not _alive(pid):
                break
            time.sleep(0.1)
    STELLA_HOME.mkdir(parents=True, exist_ok=True)
    log = open(FOLLOW_LOG, "ab")
    p = subprocess.Popen([sys.executable, "-I", str(BIN / "stella"), "crew", "follow"], stdin=subprocess.DEVNULL,
                         stdout=log, stderr=log, start_new_session=True, cwd=str(HOME))
    FOLLOW_PID.write_text(f"{p.pid} {FOLLOW_VERSION}\n")
    return p.pid


def follow_loop(once: bool = False) -> None:
    """`stella crew follow`: the reporter loop (one instance, by pidfile). Every FOLLOW_EVERY seconds it reads
    the job states and reports what changed; every VIEW_EVERY it sets the agent view; when the sessions Claude
    lists change it runs a sync (at most every FOLLOW_SYNC) so every session has a window."""
    herdr = _herdr()
    if not herdr:
        die("herdr is not installed", 1)
    if not once:
        mine = follower_pid()
        if mine and mine != os.getpid():
            print(f"the reporter already runs ({mine})")
            return
        FOLLOW_PID.write_text(f"{os.getpid()} {FOLLOW_VERSION}\n")
    last: dict = {}
    t_view = t_sync = 0.0
    seen_sessions: frozenset | None = None
    cycles = int(os.environ.get("STELLA_FOLLOW_CYCLES", "1" if once else "0"))  # 0: until stopped (tests count)
    n = 0
    while True:
        try:
            now = time.time()
            if now - t_view >= VIEW_EVERY:
                if apply_agent_view(herdr):
                    t_view = now
            if now - t_sync >= FOLLOW_SYNC and not cycles:
                ids = frozenset(a.get("id") for a in agents(True))
                if ids != seen_sessions:
                    sync_sidebar(restart_follower=False)
                    seen_sessions = ids
                t_sync = now
            follow_once(herdr, last)
            if n % 3 == 0 or once:
                detect_project_renames(herdr)
                mirror_space_titles(herdr)
        except (Exception, SystemExit) as e:  # noqa: BLE001 - the reporter never dies of a herdr or claude hiccup (die() exits)
            print(f"{time.strftime('%H:%M:%S')} follow: {type(e).__name__}: {str(e)[:160]}", flush=True)
        n += 1
        if cycles and n >= cycles:
            return
        time.sleep(FOLLOW_EVERY)


# ------------------------------------------------------------------ the layout: one space per project (Workspace 4.0)

# herdr's words and Kohen's: a *space* (herdr: workspace) is a project, labelled with its slug, and Stella's
# comes first; a *window* (herdr: tab) is either his own shell in the project's directory (the first one,
# named after the project) or one Claude session, named after the session and running the attach loop.
VIEW_STATE = STELLA_HOME / "view.json"  # {"spaces": {slug: ws}, "firsts": {slug: tab}, "closed": {...}, "all": bool}
WINDOWS = STELLA_HOME / "windows.json"  # {sid: {"name", "space", "tab", "closed"}}: sessions with no crew record
RENAMES = STELLA_HOME / "renames.jsonl"  # one line per project renamed in herdr: the watcher wakes Stella for it


def view_state() -> dict:
    v = read_json(VIEW_STATE)
    for k in ("spaces", "firsts", "closed"):
        v.setdefault(k, {})
    v.setdefault("all", True)  # `claude agents --json --all` is the call that lists exactly Claude's agent view
    v.setdefault("no_window", ["stopped"])  # states with no window: attaching to a stopped session may resume it
    return v


def save_view_state(v: dict) -> None:
    VIEW_STATE.parent.mkdir(parents=True, exist_ok=True)
    tmp = VIEW_STATE.with_suffix(".tmp")
    tmp.write_text(json.dumps(v, indent=1))
    tmp.replace(VIEW_STATE)


def _all_tabs(herdr: str, wss: dict[str, str]) -> dict[str, tuple[str, str]]:
    """{tab id: (label, workspace id)} of every tab, one `tab list` per workspace."""
    out: dict[str, tuple[str, str]] = {}
    for ws in wss:
        for t, label in _herdr_tabs(herdr, ws).items():
            out[t] = (label, ws)
    return out


def session_name(row: dict) -> str:
    """A window's name for a session nobody adopted: its Claude name, made a valid name."""
    raw = row.get("name") or row.get("id") or ""
    return raw if NAME.match(raw) else re.sub(r"[^a-z0-9-]+", "-", raw.lower()).strip("-")[:41] or row["id"]


def wanted_windows(rows: list[dict] | None = None) -> list[dict]:
    """A window for every session Claude's agent view lists, as {sid, name, project, rec}: a crewmate's in its
    project's space, every other session (Kohen's own, unadopted) and the crewmates of no project in Stella's.
    Stella's own running session is not one: her window is the one tw builds."""
    v = view_state()
    rows = agents(bool(v.get("all"))) if rows is None else rows
    me = stella_row()
    recs = {r["id"]: r for r in records() if r.get("id") and r.get("mode") != "track" and r.get("state") != "landed"}
    landed_ids = {r["id"] for r in records() if r.get("id") and r.get("state") == "landed"}
    out = []
    for row in rows:
        sid = row.get("id")
        if not sid or row.get("kind", "background") != "background" or (me and sid == me["id"]) or sid in landed_ids:
            continue
        if row.get("state") in v["no_window"] and not (recs.get(sid) or {}).get("tab"):
            continue
        rec = recs.get(sid)
        out.append({"sid": sid, "name": rec["name"] if rec else session_name(row), "rec": rec,
                    "project": (rec or {}).get("project") or None, "row": row})
    return out


def project_dir(slug: str, recs: list[dict]) -> Path:
    """The directory of a project's own shell window: `- dir: <path>` in its section of projects.md, else the
    main checkout of its first crewmate's repo, else ~/github."""
    try:
        text = (STELLA_HOME / "projects.md").read_text()
    except OSError:
        text = ""
    cur = None
    for line in text.splitlines():
        m = re.match(r"^##\s+([a-z0-9][a-z0-9-]*)", line)
        if m:
            cur = m.group(1)
        elif cur == slug and (m := re.match(r"^[-*]\s*dir:\s*(\S.*)$", line, re.I)):
            d = Path(os.path.expanduser(m.group(1).strip().strip("`")))
            if d.is_dir():
                return d
    for r in sorted((r for r in recs if r.get("project") == slug), key=lambda r: r["name"]):
        repo = r.get("repo")
        if repo and REPO.match(repo) and (HOME / "github" / repo).is_dir():
            return HOME / "github" / repo
    return HOME / "github" if (HOME / "github").is_dir() else HOME


def _holder(want: dict) -> dict:
    """What remembers a window: the crew record, or windows.json for a session without one."""
    return want["rec"] if want["rec"] else read_json(WINDOWS).get(want["sid"], {})


def _remember(want: dict, **kv) -> None:
    """Write (or, with a None value, drop) fields on the record or the windows.json entry of a window."""
    if want["rec"]:
        rec = {**load(want["rec"]["name"]), **kv}
        rec = {k: x for k, x in rec.items() if x is not None}
        save(want["rec"]["name"], rec)
        want["rec"] = rec
        return
    w = read_json(WINDOWS)
    cur = {**w.get(want["sid"], {"name": want["name"]}), **kv}
    w[want["sid"]] = {k: x for k, x in cur.items() if x is not None}
    WINDOWS.write_text(json.dumps(w, indent=1))


def _forget(sid: str) -> None:
    w = read_json(WINDOWS)
    if sid in w:
        del w[sid]
        WINDOWS.write_text(json.dumps(w, indent=1))


def _first_window(herdr: str, ws: str, slug: str) -> str | None:
    tabs = _herdr_tabs(herdr, ws)
    return next(iter(tabs), None)


MAIN_CMD = "cy"  # the shell function that starts a Claude session on the personal token


def start_main_sessions() -> None:
    """Start the main Claude session in the first window of every project that has none yet: a window that is
    still a shell at its prompt gets `cy` typed into it, once (`stella project main --all`)."""
    herdr = _herdr()
    if not herdr:
        die("herdr is not installed", 1)
    v = view_state()
    done = v.setdefault("main_started", [])
    for slug, tab in v["firsts"].items():
        panes = _tab_panes(herdr, tab)
        if slug in done or not panes:
            continue
        if pane_is_shell(herdr, panes[0]):
            _herdr_run(herdr, "pane", "run", panes[0], MAIN_CMD)
            print(f"{slug}: main session started")
        done.append(slug)
    save_view_state(v)


def ensure_space(herdr: str, ctx: dict, slug: str, wants: list[dict]) -> str | None:
    """The workspace of project `slug`: the one view.json names, else one Kohen made with that label, else a new
    one whose first window is a shell in the project's directory. A space Kohen closed stays closed until one of
    its sessions turns awaiting input again or a session joins it. None when it stays closed."""
    v, wss = ctx["view"], ctx["wss"]
    ws = v["spaces"].get(slug)
    if ws not in wss:
        ws = next((w for w, label in wss.items() if label == slug), None)
    if ws:
        v["spaces"][slug] = ws
        v["closed"].pop(slug, None)
        return ws
    blocked = any(claude_state(w["sid"]) == "blocked" for w in wants)
    if slug in v["spaces"]:  # we made it and it is gone: Kohen closed it
        c = v["closed"].setdefault(slug, {"state": "blocked" if blocked else "ok",
                                         "members": sorted(w["sid"] for w in wants)})
        if c["state"] == "blocked" and not blocked:
            c["state"] = "ok"
        joined = any(w["sid"] not in c["members"] for w in wants)
        if not ((blocked and c["state"] == "ok") or joined):
            return None
        v["closed"].pop(slug, None)
    cwd = str(project_dir(slug, ctx["recs"]))
    r = _herdr_run(herdr, "workspace", "create", "--label", slug, "--cwd", cwd, "--no-focus")
    try:
        res = json.loads(r.stdout)["result"]
        ws = res["workspace"].get("workspace_id") or res["workspace"].get("id")
        tab = res["tab"].get("tab_id") or res["tab"].get("id")
    except (ValueError, KeyError, TypeError, AttributeError):
        ws = tab = None
    if r.returncode != 0 or not ws or not tab:
        print(f"{slug}: could not open its space: {(r.stderr or r.stdout).strip()[-200:]}", file=sys.stderr)
        return None
    _herdr_run(herdr, "tab", "rename", tab, slug)
    pane = _herdr_pane(r.stdout)
    if pane:  # the project's first window is its main Claude session, in the project's directory
        _herdr_run(herdr, "pane", "run", pane, MAIN_CMD)
        v.setdefault("main_started", []).append(slug)
    v["spaces"][slug] = ws
    v["firsts"][slug] = tab
    ctx["wss"][ws] = slug
    print(f"{slug}: space opened")
    return ws


def _is_finished(sid: str) -> bool:
    return claude_state(sid) == "done"


def _new_window(herdr: str, space: str, want: dict, cwd: str) -> tuple[str, str] | None:
    """A new window in `space` named after the session, running the attach loop. (tab id, pane id)."""
    r = _herdr_run(herdr, "tab", "create", "--workspace", space, "--label", want["name"], "--cwd", cwd, "--no-focus")
    tab, pane = _tab_id(r.stdout), _herdr_pane(r.stdout)
    if r.returncode != 0 or not tab or not pane:
        print(f"{want['name']}: could not open its window: {(r.stderr or r.stdout).strip()[-200:]}", file=sys.stderr)
        return None
    _herdr_run(herdr, "pane", "run", pane, _attach_cmd(want["sid"], _is_finished(want["sid"])))
    return tab, pane


def _move_into(herdr: str, ctx: dict, pane: str, space: str, label: str) -> str | None:
    """`pane move` into a new window of `space`: the live `claude attach` process is moved, not restarted. The new
    window's tab id, found as the one tab the space gained; None when herdr refused."""
    before = set(_herdr_tabs(herdr, space))
    r = _herdr_run(herdr, "pane", "move", pane, "--new-tab", "--workspace", space, "--label", label, "--no-focus")
    gained = set(_herdr_tabs(herdr, space)) - before
    if r.returncode != 0 or len(gained) != 1:
        return None
    return gained.pop()


def ensure_window(herdr: str, ctx: dict, want: dict, space: str) -> None:
    """The one window of a session, in `space`: kept, moved there from another space, brought over from the
    workspace of the earlier layout (its pane moves, nothing restarts), or opened. A window Kohen closed stays
    closed until the session awaits input again."""
    tabs = ctx["tabs"]  # {tab id: (label, workspace id)}
    hold = _holder(want)
    tab, state = hold.get("tab"), claude_state(want["sid"])
    if hold.get("closed"):
        if hold["closed"] == "blocked" and state != "blocked":
            _remember(want, closed="ok")
            return
        if hold["closed"] == "blocked" or state != "blocked":
            return
        _remember(want, closed=None)  # it needs him again: open it anew
        hold, tab = _holder(want), None
    if tab and tab in tabs:
        label, ws = tabs[tab]
        if ws != space:  # the project changed: move the live pane, no restart
            panes = _tab_panes(herdr, tab)
            new = _move_into(herdr, ctx, panes[0], space, label) if panes else None
            if new:
                _remember(want, space=space, tab=new, crew_ws=None)
                tabs.pop(tab, None)
                tabs[new] = (label, space)
        elif hold.get("space") != space:
            _remember(want, space=space)
        if label != want["name"] and label == hold.get("label"):  # the session was renamed, and Kohen had not
            _herdr_run(herdr, "tab", "rename", tab, want["name"])
        if hold.get("label") != label and label == want["name"]:
            _remember(want, label=label)
        return
    if tab:  # recorded, and gone from herdr: Kohen closed the window
        _remember(want, closed="blocked" if state == "blocked" else "ok", tab=None, space=None)
        return
    legacy = hold.get("crew_ws")
    if legacy in ctx["wss"]:  # the earlier layout: bring the live attach pane over, then drop the old workspace
        old_tabs = _herdr_tabs(herdr, legacy)
        panes = [pn for t in old_tabs for pn in _tab_panes(herdr, t)]
        new = _move_into(herdr, ctx, panes[0], space, want["name"]) if panes else None
        moved = bool(new)
        if not new:  # fallback: a fresh window with the same loop; the old workspace goes, the session is untouched
            made = _new_window(herdr, space, want, hold.get("dir") or str(HOME))
            new = made[0] if made else None
        if new:
            _remember(want, space=space, tab=new, crew_ws=None, label=want["name"], attach=ATTACH_VERSION)
            tabs[new] = (want["name"], space)
            if not moved or not any(_tab_panes(herdr, t) for t in _herdr_tabs(herdr, legacy)):
                _herdr_run(herdr, "workspace", "close", legacy)
                ctx["wss"].pop(legacy, None)
            print(f"{want['name']}: moved into {ctx['wss'].get(space, space)}")
        return
    made = _new_window(herdr, space, want, hold.get("dir") or (want["row"] or {}).get("cwd") or str(HOME))
    if made:
        _remember(want, space=space, tab=made[0], label=want["name"], attach=ATTACH_VERSION,
                  dormant_ok=True if _is_finished(want["sid"]) else None)
        tabs[made[0]] = (want["name"], space)
        print(f"{want['name']}: window opened")


def project_order(recs: list[dict], slugs: set[str]) -> list[str]:
    """Projects in the order of priorities.md, then the rest alphabetically."""
    rank = priority_rank(recs)
    return sorted(slugs, key=lambda s: (rank.get(s, 1 << 30), s))


def _order_spaces(herdr: str, wanted: list[str]) -> None:
    """Put Stella's space first and the project spaces right after it, in `wanted` order. Idempotent: a space
    already at its place is not moved, and Kohen's own workspaces only keep their relative order (they follow the
    projects)."""
    p = _herdr_run(herdr, "workspace", "list")
    try:
        cur = [w.get("workspace_id") or w.get("id") for w in json.loads(p.stdout)["result"]["workspaces"]]
        labels = {(w.get("workspace_id") or w.get("id")): w.get("label") or "" for w in json.loads(p.stdout)["result"]["workspaces"]}
    except (ValueError, KeyError, TypeError, AttributeError):
        return
    mine = next((w for w in cur if labels[w] in (PARENT, OLD_PARENT)), None)
    if mine and cur[0] != mine:  # Stella's space is first
        if not _move_workspace(herdr, mine, 0):
            return
        cur.remove(mine)
        cur.insert(0, mine)
    for k, ws in enumerate(wanted):
        parent = next((i for i, w in enumerate(cur) if labels[w] in (PARENT, OLD_PARENT)), None)
        if parent is None or ws not in cur:
            return
        at = parent + 1 + k
        if at >= len(cur) or cur[at] == ws:
            continue
        if not _move_workspace(herdr, ws, at):
            return
        cur.remove(ws)
        cur.insert(at, ws)


def _close_window(herdr: str, tab: str | None) -> None:
    if tab:
        _herdr_run(herdr, "tab", "close", tab)


def sync_sidebar(restart_follower: bool = True) -> None:
    """Make herdr's left column the project list. Stella's space first; then one space per project, labelled
    with its slug, whose first window is Kohen's shell in the project's directory and which holds one window per
    session of the project; every other session Claude lists has a window in Stella's space. Idempotent: it opens
    what is missing, moves the live pane of an earlier layout's workspace into its project's space (no session
    restarts), closes the window of a session that is gone or landed, attaches again in a window showing 'session
    exited', orders the spaces by priority and leaves everything of Kohen's alone."""
    herdr = _herdr()
    if not herdr:
        print("herdr is not installed: no sidebar to keep")
        return
    wss = _workspaces(herdr)
    if wss is None:
        print("herdr is not running: no sidebar to keep")
        return
    old = [w for w, label in wss.items() if label == OLD_PARENT]
    if len(old) == 1 and PARENT not in wss.values():  # Stella's workspace was called `work`
        _herdr_run(herdr, "workspace", "rename", old[0], PARENT)
        wss[old[0]] = PARENT
        print(f"renamed the workspace {OLD_PARENT} to {PARENT}")
    known = {a.get("id") for a in agents(True)}
    allrecs = [r for r in records() if r.get("id") and r.get("mode") != "track"]
    _retire_old_crew_workspace(herdr, wss, {r["name"] for r in allrecs})
    wants = wanted_windows()
    ctx = {"view": view_state(), "wss": wss, "recs": allrecs, "tabs": _all_tabs(herdr, wss)}
    parent = next((w for w, label in wss.items() if label in (PARENT, OLD_PARENT)), None)
    by_project: dict[str, list[dict]] = {}
    for w in wants:
        by_project.setdefault(w["project"] or "", []).append(w)
    for slug in ctx["view"]["spaces"]:  # a project made by hand (`project new`) has a space even with no session
        by_project.setdefault(slug, [])
    spaces: dict[str, str] = {}
    for slug in project_order(allrecs, {s for s in by_project if s}):
        ws = ensure_space(herdr, ctx, slug, by_project[slug])
        if ws:
            spaces[slug] = ws
    ctx["tabs"] = _all_tabs(herdr, ctx["wss"])
    for slug, group in by_project.items():
        space = spaces.get(slug) if slug else parent
        if not space:
            continue
        for want in sorted(group, key=lambda w: w["name"]):
            ensure_window(herdr, ctx, want, space)
    # a session that is gone for good, or landed: its window closes
    wanted_sids = {w["sid"] for w in wants}
    for rec in records():
        gone = rec.get("state") == "landed" or (rec.get("id") and rec["id"] not in known)
        if rec.get("id") and gone and rec.get("mode") != "track":
            if rec.get("tab") and rec["tab"] in ctx["tabs"]:
                _close_window(herdr, rec["tab"])
                print(f"{rec['name']}: left the sidebar")
            if rec.get("crew_ws") in ctx["wss"]:
                _herdr_run(herdr, "workspace", "close", rec["crew_ws"])
                print(f"{rec['name']}: left the sidebar")
            if any(k in rec for k in ("tab", "space", "crew_ws")):
                save(rec["name"], {k: x for k, x in load(rec["name"]).items() if k not in ("tab", "space", "crew_ws")})
    for sid, w in read_json(WINDOWS).items():
        if sid not in known:
            _close_window(herdr, w.get("tab"))
            _forget(sid)
    # a window still attached to a session that has finished: close it and open a dormant one (a fresh shell, so
    # nothing is ever typed into the Claude that is attached there; the viewer going away stops nothing)
    for want in wants:
        hold = _holder(want)
        tab = hold.get("tab")
        if tab and tab in ctx["tabs"] and _is_finished(want["sid"]) and not hold.get("dormant_ok"):
            _close_window(herdr, tab)
            ctx["tabs"].pop(tab, None)
            space = hold.get("space") or (spaces.get(want["project"]) if want["project"] else parent)
            made = _new_window(herdr, space, want, hold.get("dir") or str(HOME)) if space else None
            if made:
                _remember(want, tab=made[0], space=space, label=want["name"], dormant=None, dormant_ok=True)
                ctx["tabs"][made[0]] = (want["name"], space)
                print(f"{want['name']}: finished, its window no longer holds a host process")
    # a window of an earlier layout still showing 'session exited' is attached again; every crew window is checked
    for want in wants:
        tab = _holder(want).get("tab")
        if tab and tab in ctx["tabs"]:
            repair_tab(herdr, tab, want["sid"])
    me = stella_row()
    if me and parent:
        for tab, label in _herdr_tabs(herdr, parent).items():
            if label.lower() == "stella":
                repair_tab(herdr, tab, me["id"])
    _order_spaces(herdr, [spaces[s] for s in project_order(allrecs, set(spaces))])
    save_view_state(ctx["view"])
    _ = wanted_sids
    if restart_follower:
        ensure_follower()


def rename_project(old: str, new: str, source: str = "verb") -> None:
    """Rename a project everywhere it is written: the records' `project`, the `## <slug>` heading of projects.md,
    view.json, the space and its first window. Appends a line to renames.jsonl; the watcher wakes Stella for it so
    she updates priorities.md and her journal."""
    check_project(old)
    check_project(new)
    if old == new:
        return
    taken = {r.get("project") for r in records()} | set(project_notes()) | set(view_state()["spaces"])
    if new in taken:
        die(f"there is already a project {new}")
    for rec in records():
        if rec.get("project") == old:
            save(rec["name"], {**load(rec["name"]), "project": new})
    p = STELLA_HOME / "projects.md"
    if p.exists():
        p.write_text(re.sub(rf"(?m)^(##\s+){re.escape(old)}(?=\s|$)", rf"\g<1>{new}", p.read_text()))
    v = view_state()
    herdr = _herdr()
    if old in v["spaces"]:
        ws = v["spaces"].pop(old)
        v["spaces"][new] = ws
        if herdr:
            _herdr_run(herdr, "workspace", "rename", ws, new)
    if old in v["firsts"]:
        tab = v["firsts"].pop(old)
        v["firsts"][new] = tab
        if herdr:
            _herdr_run(herdr, "tab", "rename", tab, new)
    save_view_state(v)
    with open(RENAMES, "a") as f:
        f.write(json.dumps({"at": time.time(), "old": old, "new": new, "source": source}) + "\n")
    print(f"project {old} is now {new}")


def ordered_tabs(herdr: str, ws: str) -> list[tuple[str, str]]:
    """[(tab id, label)] of a space in the order of its window bar (herdr numbers them)."""
    p = _herdr_run(herdr, "tab", "list", "--workspace", ws)
    try:
        tabs = json.loads(p.stdout)["result"]["tabs"]
    except (ValueError, KeyError, TypeError):
        return list(_herdr_tabs(herdr, ws).items())
    tabs = sorted(enumerate(tabs), key=lambda it: (it[1].get("number", it[0]), it[0]))
    return [(t.get("tab_id"), t.get("label") or "") for _, t in tabs if t.get("tab_id")]


def mirror_space_titles(herdr: str) -> None:
    """A project space's title is always the name of its first window (the leftmost): when the first window is
    closed, moved or renamed, the title follows. Display only: the project's name (records, projects.md) changes
    only when the project's own first window is renamed (`detect_project_renames`)."""
    v = view_state()
    wss = _workspaces(herdr) or {}
    for slug, ws in v["spaces"].items():
        if ws not in wss:
            continue
        tabs = ordered_tabs(herdr, ws)
        if tabs and tabs[0][1] and wss[ws] != tabs[0][1]:
            _herdr_run(herdr, "workspace", "rename", ws, tabs[0][1])


def detect_project_renames(herdr: str) -> None:
    """Kohen renamed a project's first window (Cmd+Shift+R): the project is renamed to match."""
    v = view_state()
    for slug, tab in list(v["firsts"].items()):
        ws = v["spaces"].get(slug)
        if not ws:
            continue
        label = _herdr_tabs(herdr, ws).get(tab)
        if label is None or label == slug:
            continue
        new = re.sub(r"[^a-z0-9-]+", "-", label.lower()).strip("-")[:41]
        if NAME.match(new) and new not in v["spaces"]:
            rename_project(slug, new, source="window")
        else:
            _herdr_run(herdr, "tab", "rename", tab, slug)  # not a valid name: put it back


def sync_quietly() -> None:
    """The sidebar follows a launch, an adoption or a removal; a herdr problem never fails those."""
    try:
        sync_sidebar()
    except Exception as e:  # noqa: BLE001
        print(f"sidebar not updated: {type(e).__name__}: {str(e)[:120]}", file=sys.stderr)


def view(name: str) -> None:
    """Take Kohen to a session: focus its window (opened if missing, even one he closed). Sessions are named by
    their crew record, else by windows.json."""
    herdr = _herdr()
    try:
        rec = load(name) if record_path(name).exists() else None
    except SystemExit:
        rec = None
    if rec is None:
        sid, w = next(((k, x) for k, x in read_json(WINDOWS).items() if x.get("name") == name), (None, None))
        if not sid:
            die(f"no record or window named {name}")
        want = {"sid": sid, "name": name, "rec": None, "project": None, "row": {}}
    else:
        sid = rec.get("id")
        if not sid or not SHORT_ID.match(sid):
            die(f"{name} has no session id yet")
        want = {"sid": sid, "name": name, "rec": rec, "project": rec.get("project"), "row": {}}

    def find() -> str | None:
        tab = _holder(want).get("tab")
        return tab if tab and herdr and tab in _herdr_tabs(herdr) else None

    tab = find()
    if herdr and not tab:
        _remember(want, closed=None)
        sync_quietly()
        want["rec"] = load(name) if rec is not None else None
        tab = find()
    if herdr and tab:
        _herdr_run(herdr, "tab", "focus", tab)
        ws = _holder(want).get("space")
        if ws:
            _herdr_run(herdr, "workspace", "focus", ws)
        print(f"{name}: focused in its window")
    else:
        print(f"{name}: claude attach {sid}")


def hide(name: str | None) -> None:
    """The earlier layout opened crew tabs in the work window; none is ever opened now."""
    print("no crew tabs open")


def _agent_states(herdr: str) -> dict[str, str]:
    """{pane id: herdr's agent_status} from `herdr agent list`."""
    found: dict[str, str] = {}

    def walk(x):
        if isinstance(x, dict):
            if isinstance(x.get("pane_id"), str) and isinstance(x.get("agent_status"), str):
                found[x["pane_id"]] = x["agent_status"]
            for v in x.values():
                walk(v)
        elif isinstance(x, list):
            for v in x:
                walk(v)

    try:
        walk(json.loads(_herdr_run(herdr, "agent", "list").stdout))
    except ValueError:
        pass
    return found


YELLOW, BLUE = "blocked", "working"  # herdr's states drawn yellow and blue by the theme override


def doctor(as_json: bool) -> None:
    """What herdr holds right now next to what Claude and the crew records say, for debugging the left column:
    per project space its label and first window; per session exactly one window, in the right space; per window
    herdr's state against Claude's; no `└` space left; the reporter and the agent view alive; and one parity
    line comparing Claude's counts (awaiting input, working, completed) with herdr's dots (yellow, blue,
    green or hollow). Any mismatch is BAD. Read-only."""
    herdr = _herdr()
    if not herdr:
        die("herdr is not installed", 1)
    raw: dict[str, object] = {}
    for label, args in (("version", ["--version"]), ("workspaces", ["workspace", "list"]), ("tabs", ["tab", "list"]),
                        ("panes", ["pane", "list"]), ("agents", ["agent", "list"]), ("sessions", ["session", "list", "--json"])):
        p = _herdr_run(herdr, *args)
        try:
            raw[label] = json.loads(p.stdout)
        except ValueError:
            raw[label] = {"rc": p.returncode, "stdout": p.stdout.strip()[-400:], "stderr": p.stderr.strip()[-400:]}
    wss = _workspaces(herdr)
    checks: list[dict] = []
    parity = ""
    if wss is None:
        checks.append({"check": "herdr server answers `workspace list`", "ok": False})
    else:
        v = view_state()
        wants = wanted_windows()
        allrecs = [r for r in records() if r.get("id") and r.get("mode") != "track"]
        tabs = _all_tabs(herdr, wss)
        by_tab = _tab_panes_by_tab(herdr)
        states = _agent_states(herdr)
        parent = next((w for w, label in wss.items() if label in (PARENT, OLD_PARENT)), None)
        checks.append({"check": "Stella's space is first", "ok": parent is not None and list(wss).index(parent) == 0})
        slugs = sorted({w["project"] for w in wants if w["project"]} | set(v["spaces"]))
        for slug in slugs:
            ws = v["spaces"].get(slug)
            members = [w for w in wants if w["project"] == slug]
            closed = ws not in wss and slug in v["closed"]
            first = v["firsts"].get(slug)
            first_gone = first not in tabs  # Kohen closed or merged it into another window: his to arrange
            first_ok = first_gone or tabs[first][0] == slug
            fpanes = by_tab.get(first) or [] if not first_gone else []
            lead = (ordered_tabs(herdr, ws) or [("", "")])[0][1] if ws in wss else ""
            checks.append({"check": f"space {slug}", "workspace": ws, "closed_by_kohen": closed,
                           "label_ok": closed or wss.get(ws) == lead,
                           "first_window": "closed by Kohen" if first_gone else "ok" if first_ok else "wrong label",
                           "first_window_foreground": pane_foreground(herdr, fpanes[0]) if fpanes else None,
                           "ok": closed or (wss.get(ws) == lead and first_ok)})
            _ = members
        claude_n = {"awaiting": 0, "working": 0, "completed": 0}
        herdr_n = {"yellow": 0, "blue": 0, "green/hollow": 0}
        me = stella_row()
        every = list(wants)
        if me:
            every.append({"sid": me["id"], "name": "stella", "rec": None, "project": None, "row": me,
                          "_tab": next((t for t, (label, w) in tabs.items() if w == parent and label.lower() == "stella"), None)})
        for w in every:
            hold = _holder(w) if w["name"] != "stella" or w["rec"] else {}
            tab = w.get("_tab") or hold.get("tab")
            want_space = (v["spaces"].get(w["project"]) if w["project"] else parent)
            cstate = claude_state(w["sid"], {w["sid"]: w["row"]}) if w["row"] else claude_state(w["sid"])
            expected = dot_of(cstate)
            if hold.get("closed"):
                continue  # Kohen closed that window: it counts on neither side
            claude_n["awaiting" if cstate == "blocked" else "working" if cstate == "working" else "completed"] += 1
            pane = (by_tab.get(tab) or [None])[0] if tab else None
            actual = states.get(pane) if pane else None
            if actual:
                herdr_n["yellow" if actual == YELLOW else "blue" if actual == BLUE else "green/hollow"] += 1
            where = tabs.get(tab) if tab else None
            chk = {"crewmate": w["name"], "session": w["sid"], "claude": cstate, "expected_herdr": expected,
                   "herdr": actual, "window": tab, "label": where[0] if where else None,
                   "space_ok": bool(where) and where[1] == want_space,
                   "state_ok": actual == expected or (expected == "idle" and actual in ("done", "idle")),
                   "legacy_workspace": hold.get("crew_ws")}
            if pane:  # a Claude in the foreground that is attached to another session than the window's
                try:
                    info = json.loads(_herdr_run(herdr, "pane", "process-info", pane).stdout)
                except ValueError:
                    info = {}
                ids = set(re.findall(r"attach\s+([0-9a-f]{8})", " ".join(v for _, v in _strings(info))))
                chk["attached_other"] = bool(ids) and w["sid"] not in ids
                chk["foreground"] = pane_foreground(herdr, pane)
            chk["ok"] = (chk["space_ok"] and chk["state_ok"] and not chk["legacy_workspace"]
                         and not chk.get("attached_other"))
            checks.append(chk)
        checks.append({"check": "no `└` space is left", "left": [l for l in wss.values() if l.startswith(CHILD)],
                       "ok": not any(l.startswith(CHILD) for l in wss.values())})
        checks.append({"check": "old `crew` workspace gone", "ok": OLD_CREW_WORKSPACE not in wss.values()})
        pid = follower_pid()
        checks.append({"check": "the reporter (`stella crew follow`) runs", "pid": pid, "ok": pid is not None})
        mark = read_json(VIEW_MARK)
        fresh = time.time() - mark.get("at", 0) < 3 * VIEW_EVERY
        checks.append({"check": "the agent view is set (by the reporter, recently)", "ok": fresh,
                       "age_s": round(time.time() - mark["at"]) if mark.get("at") else None})
        nowin = [a for a in agents(bool(v.get("all"))) if a.get("kind", "background") == "background"
                 and a.get("state") in v["no_window"] and a.get("id") not in {w["sid"] for w in wants}]
        parity = (f"Claude {claude_n['awaiting']} awaiting · {claude_n['working']} working · {claude_n['completed']} completed"
                  f" = herdr {herdr_n['yellow']} yellow · {herdr_n['blue']} blue · {herdr_n['green/hollow']} green/hollow"
                  + (f" (+{len(nowin)} stopped, no window)" if nowin else ""))
        checks.append({"check": "parity: Claude's counts equal herdr's dots", "line": parity,
                       "ok": (claude_n["awaiting"], claude_n["working"], claude_n["completed"]) ==
                             (herdr_n["yellow"], herdr_n["blue"], herdr_n["green/hollow"])})
    cfg = HOME / ".config/herdr/config.toml"
    out = {"raw": raw, "checks": checks, "parity": parity, "config": str(cfg.resolve()) if cfg.exists() else None}
    if as_json:
        print(json.dumps(out, indent=1))
        return
    print("herdr:", raw.get("version", {}).get("stdout") if isinstance(raw.get("version"), dict) else raw.get("version"))
    print("spaces (in order):")
    for w, label in (wss or {}).items():
        print(f"  {w}  {label}  windows: {', '.join(_herdr_tabs(herdr, w).values()) or '-'}")
    print("checks:")
    for c in checks:
        print("  " + ("ok " if c.get("ok") else "BAD") + "  " + json.dumps({k: x for k, x in c.items() if k != "ok"}))
    if parity:
        print(parity)
    print("(use `stella crew doctor --json` for the raw herdr output)")


# ------------------------------------------------------------------ projects and the crew list

JOBS = HOME / ".claude/jobs"
PROJECTS_DIR = HOME / ".claude/projects"
STATUS_RULE = "━" * 40
GLYPH = {"waiting": "◆", "blocked": "✖", "working": "●", "queued": "○", "done": "✓", "watching": "◇", "unknown": "?"}
COLOR = {"waiting": "33", "blocked": "31", "working": "32", "queued": "90", "done": "90", "watching": "36", "unknown": "90"}
RANK = {k: i for i, k in enumerate(("waiting", "blocked", "working", "queued", "done", "watching", "unknown"))}


def _last_status_block(session: str) -> tuple[str | None, str]:
    """(NEXT|DONE|None, the block) from the last assistant message of a session's transcript."""
    hits = list(PROJECTS_DIR.glob(f"*/{session}.jsonl")) if session else []
    if not hits:
        return None, ""
    with open(hits[0], "rb") as f:
        f.seek(0, os.SEEK_END)
        f.seek(max(0, f.tell() - 200_000))
        lines = f.read().decode("utf-8", "replace").splitlines()
    for line in reversed(lines):
        try:
            ev = json.loads(line)
        except ValueError:
            continue
        if ev.get("type") != "assistant":
            continue
        c = (ev.get("message") or {}).get("content")
        text = c if isinstance(c, str) else "\n".join(
            b.get("text", "") for b in c or [] if isinstance(b, dict) and b.get("type") == "text")
        if not text.strip():
            continue
        if STATUS_RULE not in text:
            return None, ""
        block = text.rsplit(STATUS_RULE, 1)[1].strip()
        return ("NEXT" if "NEXT FOR YOU" in block else "DONE" if "ALL DONE" in block else None), block
    return None, ""


def crew_status(rec: dict) -> tuple[str, str]:
    """(state, one-line need) of a record, from files only: waiting (on Kohen), blocked, working, queued,
    done, watching (a track record) or unknown."""
    if rec.get("mode") == "track":
        return "watching", rec.get("pr") or ""
    if rec.get("state") == "queued":
        return "queued", rec.get("queued_because") or ""
    job = read_json(JOBS / str(rec.get("id")) / "state.json")
    need = job.get("needs") or ""
    kind, block = _last_status_block(rec.get("session") or "")
    if kind == "NEXT":
        items = [re.sub(r"^\d+\.\s*", "", l.strip()) for l in block.splitlines() if re.match(r"\s*\d+\.", l)]
        more = f" (+{len(items) - 1} more)" if len(items) > 1 else ""
        return "waiting", (items[0] if items else need) + more
    if job.get("state") == "blocked":
        return ("waiting", need) if need else ("blocked", job.get("detail") or "")
    if kind == "DONE" or job.get("state") == "done":
        return "done", ""
    return ("working" if job else "unknown"), ""


def project_notes() -> dict[str, tuple[str, str]]:
    """{slug: (title, status)} from Stella's projects.md: a section per project, `## <slug> — <title>`, with
    a `- status: …` line. Stella writes the file; the helper only reads it."""
    out: dict[str, tuple[str, str]] = {}
    cur = None
    try:
        text = (STELLA_HOME / "projects.md").read_text()
    except OSError:
        return out
    for line in text.splitlines():
        m = re.match(r"^##\s+([a-z0-9][a-z0-9-]*)\s*(?:[—:-]+\s*(.*))?$", line)
        if m:
            cur = m.group(1)
            out[cur] = (m.group(2) or "", "")
        elif cur and (m := re.match(r"^[-*]\s*status:\s*(.*)$", line, re.I)):
            out[cur] = (out[cur][0], m.group(1).strip())
    return out


def crew_rows() -> list[dict]:
    rows = []
    for rec in records():
        if rec.get("state") == "landed":
            continue
        state, need = crew_status(rec)
        rows.append({"name": rec.get("name"), "project": rec.get("project") or "", "state": state, "need": need})
    return sorted(rows, key=lambda r: (RANK[r["state"]], r["name"]))


def _clip(text: str, width: int) -> str:
    return text if len(text) <= width else text[: max(width - 1, 0)] + "…"


def render_crew(rows: list[dict], width: int, color: bool, detail: bool = False) -> str:
    """Rows grouped by project, a project with a decision waiting first. `detail` adds each project's title
    and status from projects.md (the `projects` command); without it this is the compact left-pane list."""
    notes = project_notes()
    by: dict[str, list[dict]] = {}
    for r in rows:
        by.setdefault(r["project"], []).append(r)
    if detail:
        for slug in notes:
            by.setdefault(slug, [])
    order = sorted(by, key=lambda k: (k == "", min([RANK[r["state"]] for r in by[k]] or [9]), k))

    def paint(code: str, text: str) -> str:
        return f"\033[{code}m{text}\033[0m" if color else text

    count = {s: sum(1 for r in rows if r["state"] == s) for s in RANK}
    head = " · ".join(f"{count[s]} {l}" for s, l in (("waiting", "need you"), ("blocked", "blocked"),
                                                       ("working", "working"), ("done", "done")) if count[s])
    lines = [paint("1", "CREW") + ("  " + head if head else "  none")]
    namew = max([len(r["name"]) for r in rows] + [8])
    for slug in order:
        title, status = notes.get(slug, ("", ""))
        label = slug or "(no project)"
        lines.append("")
        lines.append(paint("1", _clip(label + (f" — {title}" if detail and title else ""), width)))
        if detail and status:
            lines.append("  " + _clip("status: " + status, width - 2))
        for r in by[slug]:
            word = {"waiting": "needs you"}.get(r["state"], r["state"])
            left = f"  {GLYPH[r['state']]} {r['name']:<{namew}} "
            tail = f"{word}" + (f": {r['need']}" if r["need"] else "")
            lines.append(paint(COLOR[r["state"]], left) + _clip(tail, max(width - len(left), 8)))
        if detail and not by[slug]:
            lines.append("  no crew")
        waiting = [r for r in by[slug] if r["state"] in ("waiting", "blocked")]
        if detail and waiting:
            lines.append(paint("33", f"  decisions waiting: {len(waiting)}"))
    return "\n".join(lines)


def crew(watch: bool) -> None:
    import shutil
    if not watch:
        print(render_crew(crew_rows(), shutil.get_terminal_size((60, 20)).columns, sys.stdout.isatty()))
        return
    every = float(os.environ.get("STELLA_CREW_EVERY", "4"))
    frames = int(os.environ.get("STELLA_CREW_FRAMES", "0"))  # 0: until interrupted (the tests set a count)
    n = 0
    try:
        while True:
            width = shutil.get_terminal_size((40, 20)).columns
            print("\033[H\033[J" + render_crew(crew_rows(), width, True), flush=True)
            n += 1
            if frames and n >= frames:
                return
            time.sleep(every)
    except KeyboardInterrupt:
        return


def projects_report() -> None:
    import shutil
    print(render_crew(crew_rows(), shutil.get_terminal_size((100, 20)).columns, sys.stdout.isatty(), detail=True))


def set_project(name: str, slug: str) -> None:
    rec = load(name)
    if slug == "--none":
        rec.pop("project", None)
    else:
        rec["project"] = check_project(slug)
    save(name, rec)
    print(f"{name}: project {rec.get('project') or 'none'}")


def crew_unpane() -> None:
    """Close the crew-list pane an earlier version put in Stella's tab (recorded in crew-pane); the sidebar
    is the crew list now. Closes that one pane and nothing else."""
    mark = STELLA_HOME / "crew-pane"
    if not mark.exists():
        print("no crew-list pane to close")
        return
    pane = mark.read_text().strip()
    herdr = _herdr()
    if herdr and pane and any(pane in _tab_panes(herdr, t) for t in _herdr_tabs(herdr)):
        _herdr_run(herdr, "pane", "close", pane)
        print(f"closed the crew-list pane {pane}")
    else:
        print("the crew-list pane is already gone")
    mark.unlink()


def lifecycle(cmd: str, name: str, model: str | None = None) -> None:
    rec = load(name)
    if rec.get("adopted") and cmd in ("stop", "respawn"):
        die(f"{name} is adopted: Stella never stops or restarts it")
    sid = rec.get("id") or ""
    if not SHORT_ID.match(sid):
        die(f"{name} has no session id")
    if cmd == "logs":
        sys.exit(claude("logs", sid, capture=False).returncode)
    if cmd == "stop":
        sys.exit(claude("stop", sid, capture=False).returncode)
    if model:  # continue the same conversation on another model (e.g. escalate to Opus)
        if not MODEL.match(model):
            die(f"bad model {model!r}")
        if claude("stop", sid).returncode != 0:
            die(f"could not stop {name} ({sid}) before moving it to {model}", 1)
        p = claude("--bg", "--resume", rec["session"], "-n", name, "--model", model, *FLAGS, "--",
                   f"Continue this task on {model}. Kohen's first mate moved you here because the last question was"
                   " beyond the previous model; carry on from where you were.", cwd=Path(rec.get("dir") or HOME))
        short = (p.stdout.strip().split() or [""])[-1]
        rec.update({"model": model, **({"id": short} if SHORT_ID.match(short) else {})})
        save(name, rec)
        sys.exit(p.returncode)
    sys.exit(claude("respawn", sid, capture=False).returncode)


def pr_state(rec: dict, d: Path) -> tuple[str, str]:
    """(state, url) of the crewmate's PR: the record's `pr` URL, else the PR of its branch ('' when none)."""
    url = rec.get("pr") or ""
    argv = ["gh", "pr", "view", *([url] if url else []), "--json", "state,url"]
    try:
        p = subprocess.run(argv, cwd=d if d.is_dir() else HOME, capture_output=True, text=True, timeout=TIMEOUT)
        got = json.loads(p.stdout)
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return "", url
    return got.get("state") or "", got.get("url") or url


def landed(rec: dict) -> str | None:
    """None when the crewmate's work is safely somewhere else, else why not."""
    mode = rec.get("mode") or "ship"
    d = Path(rec.get("dir") or "")
    state, url = pr_state(rec, d)
    if state == "OPEN":  # an open PR is not landed whatever the mode: removing it would leave the PR unwatched
        return f"its PR is still open ({url}); keep it so the watcher keeps telling Stella what happens to it"
    if mode == "scout":
        report = Path(os.path.expanduser(rec.get("report") or ""))
        return None if rec.get("report") and report.is_file() else "its report is missing"
    if not (d / ".git").exists():
        return "its directory is not a git checkout, so nothing proves the work landed"
    if git(d, "status", "--porcelain").stdout.strip():
        return "uncommitted changes in its worktree"
    if mode == "ship":  # a squash-merged PR whose remote branch is gone has landed even without an upstream
        return None if state == "MERGED" else f"its PR is not merged ({state or 'no PR'})"
    if git(d, "rev-parse", "--abbrev-ref", "@{u}").returncode != 0:
        return "its branch was never pushed"
    if git(d, "rev-list", "--count", "@{u}..HEAD").stdout.strip() not in ("", "0"):
        return "it has unpushed commits"
    return None


# ------------------------------------------------------------------ PR tracking

def track_pr(url: str, name: str | None) -> None:
    m = PR_URL.match(check_pr(url))
    name = check_name(name or f"track-{m.group(3)}-{m.group(4)}".lower())
    if record_path(name).exists() and load(name).get("state") != "landed":
        die(f"{name} already has a record")
    save(name, {"name": name, "mode": "track", "state": "watching", "pr": url,
                "tracked_at": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
                "watches": [{"name": f"{m.group(3)}#{m.group(4)}",
                             "command": ["gh", "pr", "view", url, "--json", "state,reviewDecision,statusCheckRollup"]}]})
    print(f"tracking {url} as {name}")


def untrack(name: str, require_closed: bool = False) -> None:
    rec = load(name)
    if rec.get("mode") != "track":
        die(f"{name} is not a track record")
    if require_closed:
        state, _ = pr_state(rec, HOME)
        if state not in ("MERGED", "CLOSED"):
            die(f"{name} not removed: its PR is still {state or 'unknown'}; `stella untrack {name}` stops watching it", 1)
    rec["state"] = "landed"
    rec["removed_at"] = time.strftime("%Y-%m-%dT%H:%M:%S%z")
    save(name, rec)
    print(f"{'removed' if require_closed else 'untracked'} {name}")


def rm(name: str) -> None:
    rec = load(name)
    if rec.get("mode") == "track":
        return untrack(name, require_closed=True)
    if rec.get("adopted"):
        die(f"{name} is adopted: Stella never removes it (say 'release' to drop the record)")
    why = landed(rec)
    if why:
        die(f"{name} not removed: {why}", 1)
    if SHORT_ID.match(rec.get("id") or ""):
        claude("rm", rec["id"])
    _close_window(_herdr(), rec.get("tab")) if _herdr() else None
    rec.pop("tab", None)
    wt = HOME / "github" / f"{rec.get('repo')}-wt" / (rec.get("branch") or name)
    if rec.get("repo") and REPO.match(rec["repo"]) and wt.is_dir():  # as `wtr` does; the branch is kept
        p = git(HOME / "github" / rec["repo"], "worktree", "remove", str(wt))
        if p.returncode != 0:
            die(f"session removed, but the worktree was not: {p.stderr.strip()[-200:]}", 1)
        try:
            wt.parent.rmdir()
        except OSError:
            pass
    rec["state"] = "landed"
    rec["removed_at"] = time.strftime("%Y-%m-%dT%H:%M:%S%z")
    save(name, rec)
    print(f"removed {name}")
    sync_quietly()


# ------------------------------------------------------------------ project, window and pane verbs (the chords' plain words)

def norm_name(raw: str) -> str:
    """A name Kohen typed, made a valid one: lowercase, runs of anything else joined by dashes. Said in one line."""
    name = re.sub(r"[^a-z0-9-]+", "-", raw.strip().lower()).strip("-")[:41]
    if not NAME.match(name):
        die(f"bad name {raw!r} (lowercase letters, digits and dashes, at most 41)")
    if name != raw:
        print(f"(using the name {name})")
    return name


def project_new(slug: str, ask: bool = False) -> None:
    """Register a project (a stub section in projects.md) and open its space with the first window, a shell in
    the project's directory. `ask` prompts for the name (the Cmd+Shift+N popup)."""
    if ask:
        try:
            slug = input("New project name: ")
        except EOFError:
            die("no name given")
    slug = check_project(norm_name(slug))
    if slug in project_notes() or any(r.get("project") == slug for r in records()):
        die(f"there is already a project {slug}")
    p = STELLA_HOME / "projects.md"
    old = p.read_text() if p.exists() else "# Projects\n"
    p.write_text(old.rstrip("\n") + f"\n\n## {slug}\n- status: new\n")
    herdr = _herdr()
    if not herdr:
        print(f"project {slug} registered (herdr is not installed: no space)")
        return
    wss = _workspaces(herdr)
    if wss is None:
        print(f"project {slug} registered (herdr is not running: its space opens at the next sync)")
        return
    v = view_state()
    v["spaces"][slug] = ""  # remembered as one of ours even with no session in it
    ctx = {"view": v, "wss": wss, "recs": records(), "tabs": {}}
    v["spaces"].pop(slug)
    ws = ensure_space(herdr, ctx, slug, [])
    save_view_state(v)
    print(f"project {slug}: space {ws or 'not opened'}")
    if ws:
        _herdr_run(herdr, "workspace", "focus", ws)
        sync_quietly()


def project_close(slug: str) -> None:
    """Close a project's space in herdr. The sessions keep running; the space stays closed until one of its
    sessions awaits input again or another joins it."""
    check_project(slug)
    herdr = _herdr()
    v = view_state()
    ws = v["spaces"].get(slug)
    if not herdr or not ws:
        die(f"project {slug} has no open space")
    members = sorted(w["sid"] for w in wanted_windows() if w["project"] == slug)
    blocked = any(claude_state(sid) == "blocked" for sid in members)
    _herdr_run(herdr, "workspace", "close", ws)
    v["closed"][slug] = {"state": "blocked" if blocked else "ok", "members": members}
    save_view_state(v)
    print(f"project {slug}: space closed (its sessions keep running)")


def assign(name: str, slug: str) -> None:
    """Put a crewmate under a project (or `--none`), and move its window to that project's space."""
    set_project(name, slug)
    sync_quietly()


def _space_of(slug: str) -> tuple[str, str]:
    herdr = _herdr()
    if not herdr:
        die("herdr is not installed", 1)
    check_project(slug)
    ws = view_state()["spaces"].get(slug) or next((w for w, l in (_workspaces(herdr) or {}).items() if l == slug), None)
    if not ws:
        die(f"project {slug} has no open space")
    return herdr, ws


def _window_in(herdr: str, ws: str, label: str) -> str:
    """The window called `label` in a space. A session named like its project has two: the project's own first
    window and the session's; the session's is meant (the first window is closed with the project)."""
    tabs = [t for t, l in _herdr_tabs(herdr, ws).items() if l == label]
    firsts = set(view_state()["firsts"].values())
    if len(tabs) > 1:
        tabs = [t for t in tabs if t not in firsts] or tabs
    if len(tabs) != 1:
        die(f"{'no' if not tabs else 'several'} window called {label}")
    return tabs[0]


def window_new(slug: str, label: str | None) -> None:
    """A new shell window of Kohen's own in a project's space (sync never touches it)."""
    herdr, ws = _space_of(slug)
    label = norm_name(label) if label else f"shell-{len(_herdr_tabs(herdr, ws)) + 1}"
    r = _herdr_run(herdr, "tab", "create", "--workspace", ws, "--label", label, "--cwd",
                   str(project_dir(slug, records())), "--no-focus")
    if r.returncode != 0 or not _tab_id(r.stdout):
        die(f"could not open a window: {(r.stderr or r.stdout).strip()[-200:]}", 1)
    print(f"{slug}: window {label} opened")


def window_rename(slug: str, old: str, new: str) -> None:
    herdr, ws = _space_of(slug)
    new = norm_name(new)
    _herdr_run(herdr, "tab", "rename", _window_in(herdr, ws, old), new)
    print(f"{slug}: window {old} is now {new}")


def window_close(slug: str, label: str) -> None:
    """Close a window. A session's window closes without stopping the session; it stays closed until the
    session awaits input again (or `stella view <name>`)."""
    herdr, ws = _space_of(slug)
    tab = _window_in(herdr, ws, label)
    v = view_state()
    if v["firsts"].get(slug) == tab:
        die(f"{label} is the first window of {slug}: close the project instead (`stella project close {slug}`)")
    for rec in records():
        if rec.get("tab") == tab:
            save(rec["name"], {**load(rec["name"]), "closed": "blocked" if claude_state(rec.get("id") or "") == "blocked" else "ok",
                               "tab": None, "space": None})
            save(rec["name"], {k: x for k, x in load(rec["name"]).items() if x is not None})
    w = read_json(WINDOWS)
    for sid, x in w.items():
        if x.get("tab") == tab:
            w[sid] = {k: y for k, y in {**x, "closed": "blocked" if claude_state(sid) == "blocked" else "ok",
                                       "tab": None, "space": None}.items() if y is not None}
    WINDOWS.write_text(json.dumps(w, indent=1))
    _herdr_run(herdr, "tab", "close", tab)
    print(f"{slug}: window {label} closed (a session in it keeps running)")


def pane_rename(slug: str, window: str, number: int, new: str) -> None:
    herdr, ws = _space_of(slug)
    panes = _tab_panes(herdr, _window_in(herdr, ws, window))
    if not 1 <= number <= len(panes):
        die(f"{window} has {len(panes)} pane(s), not {number}")
    _herdr_run(herdr, "pane", "rename", panes[number - 1], new)
    print(f"{slug}/{window}: pane {number} is now {new}")


# ------------------------------------------------------------------ Kohen's preferences (the learning loop)

PREFS = STELLA_HOME / "preferences.md"
PREF_LINE = re.compile(r"^- (\d{4}-\d\d-\d\d) \| ([a-z0-9-]+) \| kind: ([a-z0-9-]+) \| answer: ([a-z0-9-]+) \| "
                       r"Q: (.*?) \| A: (.*)$")
PREF_MIN = 3  # answers to the same kind of question, all the same way, before a principle is proposed


def prefs_scan(since: str) -> None:
    """Every answer Kohen gave a crewmate in its window since `since` (YYYY-MM-DD), one JSON line each: the
    NEXT FOR YOU items of the session's last status block and the message of his that followed it, verbatim.
    The nightly log reads these, tags each with a `kind` and an `answer` and appends it to preferences.md."""
    for rec in sorted(records(), key=lambda r: r.get("name", "")):
        hits = list(PROJECTS_DIR.glob(f"*/{rec.get('session')}.jsonl")) if rec.get("session") else []
        if not hits or rec.get("mode") == "track":
            continue
        question = None
        for line in hits[0].open(errors="ignore"):
            try:
                ev = json.loads(line)
            except ValueError:
                continue
            c = (ev.get("message") or {}).get("content")
            text = c if isinstance(c, str) else "\n".join(
                b.get("text", "") for b in c or [] if isinstance(b, dict) and b.get("type") == "text")
            if ev.get("type") == "assistant" and text.strip():
                block = text.rsplit(STATUS_RULE, 1)[1] if STATUS_RULE in text else ""
                question = block.strip() if "NEXT FOR YOU" in block else None
            elif ev.get("type") == "user" and text.strip() and question:
                day = str(ev.get("timestamp") or "")[:10]
                if day >= since:
                    print(json.dumps({"date": day, "crewmate": rec["name"], "question": question, "answer": text.strip()}))
                question = None


def prefs_propose() -> None:
    """Group preferences.md by `kind`: a kind with PREF_MIN or more answers, all the same, and none against, is a
    pattern. Print each as a draft `J-NN (proposed)` with its dated evidence. A proposal is never canon and never
    used to answer for Kohen: it goes to him as one item, and only his yes moves it into canon.md."""
    try:
        lines = PREFS.read_text().splitlines()
    except OSError:
        lines = []
    kinds: dict[str, list[tuple]] = {}
    for ln in lines:
        m = PREF_LINE.match(ln)
        if m:
            kinds.setdefault(m.group(3), []).append(m.groups())
    found = 0
    for kind, rows in sorted(kinds.items()):
        answers = {r[3] for r in rows}
        if len(rows) >= PREF_MIN and len(answers) == 1:
            found += 1
            print(f"J-NN (proposed): {kind} — Kohen answers \"{next(iter(answers))}\" ({len(rows)} times, none against)")
            for d, who, _, _, q, a in rows:
                print(f"  - {d} {who}: {q} → \"{a}\"")
    if not found:
        print("no pattern yet: " + (", ".join(f"{k} ({len(r)}{'' if len({x[3] for x in r}) == 1 else ', mixed'})"
                                              for k, r in sorted(kinds.items())) or "no answers recorded"))


# ------------------------------------------------------------------ main

def adopt_options(rest: list[str]) -> dict[str, str]:
    """`--team T` and `--project P` after an adopt target, each at most once."""
    out: dict[str, str] = {}
    while rest:
        if len(rest) < 2 or rest[0] not in ("--team", "--project") or rest[0][2:] in out:
            die("usage: stella adopt <name|id> [--team T] [--project P]")
        out[rest[0][2:]] = (check_name if rest[0] == "--team" else check_project)(rest[1])
        rest = rest[2:]
    return out


def main(argv: list[str]) -> None:
    cmd, rest = (argv[1] if len(argv) > 1 else "open"), argv[2:]
    if cmd == "open":
        os.execvp("claude", ["claude", "attach", start()])
    elif cmd == "tab" and len(rest) <= 1:
        if rest and not SHORT_ID.match(rest[0]):
            die(f"bad session id {rest[0]!r}")
        sys.exit(follow(rest[0] if rest else start()))
    elif cmd == "listed" and len(rest) == 1 and SHORT_ID.match(rest[0]):  # what a crew pane's loop asks
        sys.exit(0 if _process(rest[0])[0] else 1)
    elif cmd == "dormant" and len(rest) == 1 and SHORT_ID.match(rest[0]):  # what a finished session's window asks
        sys.exit(0 if _is_finished(rest[0]) else 1)
    elif cmd == "start":
        print(start())
    elif cmd == "restart" and not rest:
        print(restart())
    elif cmd == "id":
        row = stella_row()
        print(row["id"]) if row else sys.exit(1)
    elif cmd == "agents" and rest in ([], ["--all"]):
        print(json.dumps(agents(bool(rest)), indent=1))
    elif cmd == "launch" and len(rest) == 1:
        launch(rest[0])
    elif cmd == "adopt" and rest[:1] == ["--resume"] and len(rest) >= 3:
        opts = adopt_options(rest[3:])
        adopt_resume(rest[1], check_name(rest[2]), opts.get("team"), opts.get("project"))
    elif cmd == "adopt" and len(rest) >= 1:
        opts = adopt_options(rest[1:])
        target = rest[0]
        if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9 ._-]{0,80}", target):
            die(f"bad session name or id {target!r}")
        adopt(target, opts.get("team"), opts.get("project"))
    elif cmd == "project" and rest[:1] == ["new"] and len(rest) in (2, 2) and rest[1] == "--ask":
        project_new("", ask=True)
    elif cmd == "project" and rest[:1] == ["new"] and len(rest) == 2:
        project_new(rest[1])
    elif cmd == "project" and rest[:1] == ["rename"] and len(rest) == 3:
        rename_project(check_project(rest[1]), check_project(norm_name(rest[2])), source="verb")
        sync_quietly()
    elif cmd == "project" and rest == ["main", "--all"]:
        start_main_sessions()
    elif cmd == "project" and rest[:1] == ["close"] and len(rest) == 2:
        project_close(rest[1])
    elif cmd == "project" and len(rest) == 2:  # the old `project <crewmate> <slug>`, kept for two weeks
        print("(`stella project <name> <slug>` is now `stella assign <name> <slug>`)", file=sys.stderr)
        assign(check_name(rest[0]), rest[1])
    elif cmd == "prefs" and rest == ["propose"]:
        prefs_propose()
    elif cmd == "prefs" and rest[:1] == ["scan"] and len(rest) <= 2 and re.fullmatch(r"\d{4}-\d\d-\d\d", (rest + ["0000-00-00"])[1]):
        prefs_scan(rest[1] if len(rest) == 2 else "0000-00-00")
    elif cmd == "assign" and len(rest) == 2:
        assign(check_name(rest[0]), rest[1])
    elif cmd == "window" and rest[:1] == ["new"] and len(rest) in (2, 3):
        window_new(rest[1], rest[2] if len(rest) == 3 else None)
    elif cmd == "window" and rest[:1] == ["rename"] and len(rest) == 4:
        window_rename(rest[1], rest[2], rest[3])
    elif cmd == "window" and rest[:1] == ["close"] and len(rest) == 3:
        window_close(rest[1], rest[2])
    elif cmd == "pane" and rest[:1] == ["rename"] and len(rest) >= 5 and rest[3].isdigit():
        pane_rename(rest[1], rest[2], int(rest[3]), " ".join(rest[4:]))
    elif cmd == "projects" and not rest:
        projects_report()
    elif cmd == "crew" and rest in ([], ["--watch"]):
        crew(bool(rest))
    elif cmd == "crew" and rest in (["follow"], ["follow", "--once"]):
        follow_loop(rest == ["follow", "--once"])
    elif cmd == "crew" and rest == ["follow", "--ensure"]:
        pid = ensure_follower()
        print(f"the reporter runs ({pid})" if pid else "herdr is not installed: no reporter")
    elif cmd == "crew" and rest == ["sync"]:
        sync_sidebar()
    elif cmd == "crew" and rest[:2] == ["doctor", "--spike"] and len(rest) <= 3 and (len(rest) == 2 or SHORT_ID.match(rest[2])):
        os.execv(sys.executable, [sys.executable, "-I", str(BIN / "stella-spike"), *rest[2:]])
    elif cmd == "crew" and rest in (["doctor"], ["doctor", "--json"]):
        doctor(rest[-1] == "--json")
    elif cmd == "crew" and rest == ["--unpane"]:
        crew_unpane()
    elif cmd == "hide" and rest == ["--all"]:
        hide(None)
    elif cmd == "hide" and len(rest) == 1:
        hide(check_name(rest[0]))
    elif cmd == "view" and rest in (["--repair"], ["--all"]):  # the old names of `crew sync`
        sync_sidebar()
    elif cmd == "allow" and len(rest) >= 2:
        allow(check_name(rest[0]), rest[1:])
    elif cmd == "track-pr" and len(rest) in (1, 2):
        track_pr(rest[0], rest[1] if len(rest) == 2 else None)
    elif cmd == "untrack" and len(rest) == 1:
        untrack(rest[0])
    elif cmd in ("crew", "view") and rest in (["sync", "--verbose"], ["--all", "--verbose"]):
        global VERBOSE
        VERBOSE = True
        sync_sidebar()
    elif cmd == "view" and len(rest) == 1:
        view(rest[0])
    elif cmd in ("stop", "logs") and len(rest) == 1:
        lifecycle(cmd, rest[0])
    elif cmd == "respawn" and (len(rest) == 1 or (len(rest) == 3 and rest[1] == "--model")):
        lifecycle(cmd, rest[0], rest[2] if len(rest) == 3 else None)
    elif cmd == "rm" and len(rest) == 1:
        rm(rest[0])
    elif cmd == "live-check" and len(rest) <= 1 and (not rest or rest[0] in ("show", "before", "diff")):
        os.execv(sys.executable, [sys.executable, str(BIN / "live-check"), *(rest or ["show"])])
    elif cmd in ("-h", "--help", "help"):
        print(__doc__.split("\n\n")[1])
    else:
        die("usage: stella [open|start|restart|id|agents|launch|adopt|project|assign|window|pane|projects|crew|allow|track-pr|untrack|view|hide|tab|stop|respawn|logs|rm|live-check] ...")


if __name__ == "__main__":
    main(sys.argv)
