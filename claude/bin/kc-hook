#!/usr/bin/env python3
"""Claude Code hook for every session: `kc-hook pretool`, the hook input as JSON on stdin.

The leak gate for the public repo ~/github/environment is a git pre-push hook (githooks/pre-push), which
fires for anyone who pushes, Claude or not. This hook only keeps a session from stepping around it: a Bash
command that pushes from that repo (or one of its worktrees) with `--no-verify`, or that changes
`core.hooksPath`, is denied. Reads and everything else pass.

Standard library only. A hook that fails must never trap a session, so any error allows the command.
"""

from __future__ import annotations

import json
import re
import sys
from pathlib import Path

HOME = Path.home()
PROTECTED = (HOME / "github/environment", HOME / "github/environment-wt")
SKIP_PUSH_HOOK = re.compile(r"git\b[^|;&\n]*\bpush\b[^|;&\n]*(--no-verify|\s-n\b)")
HOOKS_C = re.compile(r"-c\s*core\.hookspath", re.I)
GIT_CONFIG = re.compile(r"git\b[^|;&\n]*\bconfig\b([^|;&\n]*)", re.I)
MESSAGE = ("Pushes from ~/github/environment run a leak check (githooks/pre-push). Do not bypass it: rewrite "
           "what it reports generically, amend, and push again.")


def changes_hooks_path(cmd: str) -> bool:
    """True for a command that sets or unsets the hooks path; reading it is fine."""
    if HOOKS_C.search(cmd):
        return True
    for m in GIT_CONFIG.finditer(cmd):
        args = m.group(1)
        if "hookspath" not in args.lower():
            continue
        if "--unset" in args:
            return True
        words = [w for w in args.split() if not w.startswith("-")]
        key = next(i for i, w in enumerate(words) if "hookspath" in w.lower())
        if "--get" not in args and key + 1 < len(words):
            return True
    return False


def touches_protected(cmd: str, cwd: str) -> bool:
    text = cmd.replace("~", str(HOME)).replace("$HOME", str(HOME))
    return any(str(p) in text or cwd.startswith(str(p)) for p in PROTECTED)


def pretool(data: dict) -> None:
    cmd = (data.get("tool_input") or {}).get("command") or ""
    if (SKIP_PUSH_HOOK.search(cmd) or changes_hooks_path(cmd)) and touches_protected(cmd, data.get("cwd") or ""):
        print(json.dumps({"hookSpecificOutput": {"hookEventName": "PreToolUse", "permissionDecision": "deny",
                                                   "permissionDecisionReason": MESSAGE}}))


def main() -> None:
    try:
        data = json.load(sys.stdin)
        if sys.argv[1:] == ["pretool"]:
            pretool(data)
    except Exception:
        pass


if __name__ == "__main__":
    main()
