#!/usr/bin/env python3
"""A stand-in for the `herdr` CLI, for tests. Every call is appended as one JSON line to $FAKE_HERDR_LOG.
The tabs live in the JSON file $FAKE_HERDR_TABS ({id: label}): `tab create` adds one and prints the reply
shape herdr documents (`.result.tab`, `.result.root_pane`), `tab list [--workspace W]` prints them (a tab id
starts with its workspace id, and the entry names it as `workspace_id` too), `tab close` removes one.
Workspaces live in $FAKE_HERDR_TABS.ws ({id: label}); `workspace create` adds one with its seeded tab.
With $FAKE_HERDR_DOWN set, `workspace list` fails like a missing server. `workspace close` drops a workspace
with its tabs. A tab has one pane `<tab>:p1`, and split ones live in $FAKE_HERDR_TABS.panes ({pane: tab}); `pane
move <pane> --new-tab --workspace W --label L` takes a pane to a new tab of W (a tab left with no pane is closed
and the pane keeps its id and its process, as herdr's does; $FAKE_HERDR_MOVE_FAIL makes it fail). `agent list`
reports every pane as a Claude agent unless $FAKE_HERDR_AGENTS (a JSON list of pane ids) says which are, with
the `agent_status` that $FAKE_HERDR_STATUS ({pane: status}) gives, else `idle`. Report, release and focus
calls are only logged.
"""

import json
import os
import sys

args = sys.argv[1:]
with open(os.environ["FAKE_HERDR_LOG"], "a") as f:
    f.write(json.dumps(args) + "\n")
path = os.environ["FAKE_HERDR_TABS"]
tabs = json.load(open(path)) if os.path.exists(path) else {}
wspath = path + ".ws"
workspaces = json.load(open(wspath)) if os.path.exists(wspath) else {}
extra = path + ".panes"
more = json.load(open(extra)) if os.path.exists(extra) else {}  # {pane: tab}: split panes and moved ones
skip_path = path + ".skip"
skip = json.load(open(skip_path)) if os.path.exists(skip_path) else []  # seeded panes that moved away


def ws_of(tab):
    return tab.rsplit(":", 1)[0]


def all_panes():
    seeded = [{"pane_id": t + ":p1", "tab_id": t} for t in tabs if t + ":p1" not in skip]
    return seeded + [{"pane_id": p, "tab_id": t} for p, t in more.items() if t in tabs]


def save():
    json.dump(tabs, open(path, "w"))
    json.dump(workspaces, open(wspath, "w"))
    json.dump(more, open(extra, "w"))
    json.dump(skip, open(skip_path, "w"))


if args[:2] == ["workspace", "list"]:
    if os.environ.get("FAKE_HERDR_DOWN"):
        sys.exit(1)
    print(json.dumps({"result": {"workspaces": [{"workspace_id": w, "label": label} for w, label in workspaces.items()]}}))
elif args[:2] == ["workspace", "create"]:
    wid = f"w{max([int(w[1:]) for w in workspaces] + [9]) + 1}"
    workspaces[wid] = args[args.index("--label") + 1]
    tabs[wid + ":t1"] = "seed"
    save()
    print(json.dumps({"result": {"workspace": {"workspace_id": wid, "label": workspaces[wid]},
                                 "tab": {"tab_id": wid + ":t1", "label": "seed"}, "root_pane": {"pane_id": wid + ":t1:p1"}}}))
elif args[:2] == ["workspace", "rename"]:
    workspaces[args[2]] = args[3]
    save()
elif args[:2] == ["workspace", "close"]:
    workspaces.pop(args[2], None)
    tabs = {t: label for t, label in tabs.items() if not t.startswith(args[2] + ":")}
    save()
elif args[:2] == ["agent", "list"]:  # every pane is an agent, unless $FAKE_HERDR_AGENTS lists the ones that are
    every = [p["pane_id"] for p in all_panes()]
    pick = json.loads(os.environ["FAKE_HERDR_AGENTS"]) if "FAKE_HERDR_AGENTS" in os.environ else every
    status = json.loads(os.environ.get("FAKE_HERDR_STATUS", "{}"))
    tab_of = {p["pane_id"]: p["tab_id"] for p in all_panes()}
    print(json.dumps({"result": {"agents": [{"pane_id": pn, "agent": "claude", "agent_status": status.get(pn, "idle"),
                                              "tab_id": tab_of.get(pn, ""), "workspace_id": ws_of(tab_of.get(pn, ":"))}
                                             for pn in pick]}}))
elif args[:2] == ["session", "list"]:
    print(json.dumps({"sessions": [{"name": "default", "default": True, "socket_path": os.environ.get("FAKE_HERDR_SOCKET", "")}]}))
elif args[:2] == ["tab", "rename"]:
    tabs[args[2]] = args[3]
    save()
elif args[:2] == ["tab", "create"]:
    ws = args[args.index("--workspace") + 1] if "--workspace" in args else "w1"
    tid = f"{ws}:t{len([t for t in tabs if t.startswith(ws + ':')]) + 1 + int(os.environ.get('FAKE_HERDR_BUMP', '0'))}"
    while tid in tabs:
        tid += "x"
    tabs[tid] = args[args.index("--label") + 1]
    save()
    print(json.dumps({"result": {"tab": {"tab_id": tid, "label": tabs[tid]}, "root_pane": {"pane_id": tid + ":p1"}}}))
elif args[:2] == ["tab", "list"]:
    ws = args[args.index("--workspace") + 1] if "--workspace" in args else None
    print(json.dumps({"result": {"tabs": [{"tab_id": t, "label": label, "workspace_id": ws_of(t)} for t, label in tabs.items()
                                          if ws is None or t.startswith(ws + ":")]}}))
elif args[:2] == ["pane", "split"]:  # a new pane next to args[2]
    parent = args[2]
    new = f"{parent}:s{len(more) + 1}"
    more[new] = parent.rsplit(":", 1)[0]
    save()
    print(json.dumps({"result": {"pane": {"pane_id": new, "tab_id": more[new]}}}))
elif args[:2] == ["pane", "list"]:
    print(json.dumps({"result": {"panes": all_panes()}}))
elif args[:2] == ["pane", "move"]:
    if os.environ.get("FAKE_HERDR_MOVE_FAIL"):
        print("usage: herdr pane move", file=sys.stderr)
        sys.exit(2)
    pane = args[2]
    ws = args[args.index("--workspace") + 1]
    src = next(p["tab_id"] for p in all_panes() if p["pane_id"] == pane)
    tid = f"{ws}:t{len([t for t in tabs if t.startswith(ws + ':')]) + 1}"
    while tid in tabs:
        tid += "x"
    tabs[tid] = args[args.index("--label") + 1] if "--label" in args else "moved"
    if pane == src + ":p1":
        skip.append(pane)
    more[pane] = tid
    if not [p for p in all_panes() if p["tab_id"] == src]:  # the tab it left has no pane: herdr closes it
        tabs.pop(src, None)
    save()
    print(json.dumps({"result": {"tab": {"tab_id": tid}}}))
elif args[:2] == ["pane", "read"]:  # $FAKE_HERDR_SCREEN maps pane id -> text
    print(json.loads(os.environ.get("FAKE_HERDR_SCREEN", "{}")).get(args[2], ""))
elif args[:2] == ["tab", "close"]:
    tabs.pop(args[2], None)
    save()
