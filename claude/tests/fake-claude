#!/usr/bin/env python3
"""A stand-in for the `claude` CLI, for tests. It starts nothing.

Put its directory first on PATH under the name `claude` (the tests do this with a symlink). Every call is
appended as one JSON line to $FAKE_CLAUDE_LOG. `claude agents --json` prints $FAKE_CLAUDE_AGENTS (a JSON
file, default `[]`). `claude --bg ...` prints a fake short id. Anything else exits 0 silently.
"""

import json
import os
import sys

args = sys.argv[1:]
log = os.environ.get("FAKE_CLAUDE_LOG")
if log:
    with open(log, "a") as f:
        f.write(json.dumps({"argv": args, "cwd": os.getcwd()}) + "\n")

if args[:1] == ["agents"] and "--json" in args:
    path = os.environ.get("FAKE_CLAUDE_AGENTS")
    print(open(path).read() if path and os.path.exists(path) else "[]")
elif "--bg" in args:
    sid = args[args.index("--session-id") + 1] if "--session-id" in args else "00000000"
    print(sid[:8])
sys.exit(int(os.environ.get("FAKE_CLAUDE_EXIT", "0")))
