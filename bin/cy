#!/usr/bin/env python3
"""cy: run one Claude session in this window, and bring it back after a restart.

    cy [-n NAME] [--model M] [--effort E] [--agent A] [--token T] [--prompt-file F] [PROMPT]
    cy -r NAME|ID [--branch NEW] [--token T] [PROMPT]     resume a session here (or a copy of it, with --branch)
    cy restore                                            reopen the sessions a herdr restart ended
    cy --check                                            exit 0 if this file loads (the loop runs it before it updates)

The window runs `cy`, and `cy` runs `claude` as its child for the life of the window (the "window loop"). It holds the
session's lock, so two windows never run one conversation. When `claude` exits it decides what happened, from what is on
disk: a restart file from the follower (`cy-follow`) means relaunch the same conversation; otherwise a plain `/exit` ends
the session (⏎ resumes it here), and a crash says how to resume it. Everything is keyed by the session's first
conversation id, which `cy` chooses before launch (`claude --session-id`), so a rename or `/clear` changes nothing on disk.

Files, all under ~/.local/state/cy/:
    <id>.loop.json       written only by this loop: launch spec, the pid it launched, the current conversation, how it ended
    <id>.json            written only by the follower: the merged view (`cag` reads both)
    <id>.lock            held by the loop for its life
    next/<id>.json       the follower's restart or end order, for one launched pid
    requests/<id>/       requests from `tok`, `cag` and `kc-new`, applied by the follower in order
    crons/<session>.json written by the Stop hook: the session's crons and pending wakeups
    alerts/<session>.<kind>.json  written by a machine's hooks: something the session needs Kohen to fix (red dot)

The token is the machine's business: `~/.config/cy/launch-env TOKEN KEY [PARENT]` prints the environment for it
(KEY=VALUE lines, or -KEY to unset; `token=LABEL` names what it chose, and `pin=LABEL` says the session is pinned to it).
TOKEN is `default` unless the session was started or restarted on a named token (`--token`, a restart's `token`); KEY is
the session's key, so the hook keeps and reads the session's pin itself, at every launch; PARENT is the key a `--branch`
copy came from. Without that hook the session runs with the shell's environment and its token is recorded as `none`.

This file is also the shared library that `cy-follow` and `cag` load. Standard library only.
"""

from __future__ import annotations

import argparse
import calendar
import ctypes
import fcntl
import hashlib
import json
import os
import re
import shlex
import signal
import struct
import subprocess
import sys
import threading
import time
import uuid
from pathlib import Path

HOME = Path.home()
STATE = HOME / ".local" / "state" / "cy"
NEXT = STATE / "next"
REQUESTS = STATE / "requests"
CRONS = STATE / "crons"
ALERTS = STATE / "alerts"
LAUNCH_HOOK = HOME / ".config" / "cy" / "launch-env"
SESSIONS = HOME / ".claude" / "sessions"
PROJECTS = HOME / ".claude" / "projects"
ME = os.path.realpath(__file__)
BIN = os.path.dirname(ME)
NAME_RE = re.compile(r"^[a-z0-9][a-z0-9-]{0,48}$")
RESTART_MARK = "[cy restart]"
VIEW_OFF = {"disableAgentView": True}
OLD_PID_WAIT = 10.0  # seconds the loop waits for the old process to go before a relaunch (probe P2 measured 0.11 s)


# ── files ───────────────────────────────────────────────────────────────────────────────────────────────────────


def wait_for(pred, timeout: float, every: float = 1.0):
    """Call pred until it returns something truthy or the time is up; return the last value."""
    end = time.time() + timeout
    while True:
        value = pred()
        if value or time.time() >= end:
            return value
        time.sleep(every)


def read_json(path: Path, default=None):
    try:
        return json.loads(path.read_text())
    except (OSError, ValueError):
        return default


def write_json(path: Path, data) -> None:
    """Readers never see a half-written file."""
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(f".{path.name}.{os.getpid()}.{threading.get_ident()}.tmp")
    tmp.write_text(json.dumps(data, indent=1, sort_keys=True))
    os.replace(tmp, path)


def loop_file(sid: str) -> Path:
    return STATE / f"{sid}.loop.json"


def launch_file(sid: str) -> Path:
    return STATE / f"{sid}.json"


def lock_file(sid: str) -> Path:
    return STATE / f"{sid}.lock"


def next_file(sid: str) -> Path:
    return NEXT / f"{sid}.json"


def status_of(sid: str, loop: dict, view: dict) -> tuple[str, str | None]:
    """A session's status and how it ended. The loop holds its lock while it runs; once it has let go, the loop's own
    end record wins, then what the follower saw (herdr's pane.closed, its start-up check), else it simply ended."""
    if held(sid):  # a loop waiting at "⏎ resumes it here" holds the lock too, and has recorded the end
        return ("ended", "exit") if (loop.get("status"), loop.get("end")) == ("ended", "exit") else ("live", None)
    if loop.get("end") == "retired":
        return "retired", "retired"  # the window the follower closes after a retire is part of the retire
    if view.get("end") == "closed":
        return "ended", "closed"
    end = loop.get("end")
    if end in ("retired", "interrupted", "crashed"):
        return end, end
    if end in ("exit", "closed"):
        return "ended", end
    if view.get("status") in ("interrupted", "crashed", "orphan") and view.get("end"):
        return view["status"], view["end"]
    return "ended", end or view.get("end")


def launches() -> list[dict]:
    """Every session `cy` has started: the loop's facts, the follower's view on top, and the status both settle."""
    out = []
    for f in sorted(STATE.glob("*.loop.json")):
        sid = f.name[: -len(".loop.json")]
        loop, view = read_json(f, {}), read_json(launch_file(sid), {})
        merged = dict(loop)
        merged.update({k: v for k, v in view.items() if v is not None and k not in ("status", "end")})
        merged["status"], merged["end"] = status_of(sid, loop, view)
        merged["id"] = sid
        out.append(merged)
    return out


def held(sid: str) -> bool:
    """Is a window loop holding this session's lock right now?"""
    path = lock_file(sid)
    if not path.exists():
        return False
    with open(path, "a") as f:
        try:
            fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            return True
        fcntl.flock(f, fcntl.LOCK_UN)
        return False


# ── processes and Claude's registry ─────────────────────────────────────────────────────────────────────────────


def alive(pid: int | None) -> bool:
    if not pid:
        return False
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


def started_at(pid: int) -> float | None:
    """A process's start time in epoch seconds (macOS libproc), so a recycled pid is never mistaken for it."""
    try:
        lib = ctypes.CDLL("/usr/lib/libproc.dylib")
    except OSError:
        return None
    buf = ctypes.create_string_buffer(136)  # struct proc_bsdinfo
    if lib.proc_pidinfo(ctypes.c_int(pid), ctypes.c_int(3), ctypes.c_uint64(0), buf, ctypes.c_int(136)) != 136:
        return None
    return float(struct.unpack_from("Q", buf.raw, 120)[0])  # pbi_start_tvsec


def parent_of(pid: int) -> int | None:
    try:
        lib = ctypes.CDLL("/usr/lib/libproc.dylib")
    except OSError:
        return None
    buf = ctypes.create_string_buffer(136)
    if lib.proc_pidinfo(ctypes.c_int(pid), ctypes.c_int(3), ctypes.c_uint64(0), buf, ctypes.c_int(136)) != 136:
        return None
    return struct.unpack_from("I", buf.raw, 16)[0]  # pbi_ppid


def row_of_launch(launched_pid: int | None, rows: list[dict] | None = None, start=None) -> dict | None:
    """The registry row of the claude a loop launched: the launcher itself, or its child (the company launcher).

    Given the launcher's start time, a pid since reused by another process (a dead loop's stale file) finds nothing."""
    if not launched_pid or (start is not None and not same_process(launched_pid, start)):
        return None
    for d in rows if rows is not None else registry():
        if d.get("pid") == launched_pid or parent_of(d["pid"]) == launched_pid:
            return d
    return None


def as_epoch(start) -> float | None:
    if isinstance(start, (int, float)):
        return float(start)
    if isinstance(start, str) and start.strip():
        try:
            return float(calendar.timegm(time.strptime(" ".join(start.split()), "%a %b %d %H:%M:%S %Y")))
        except ValueError:
            return None
    return None


def same_process(pid: int | None, start) -> bool:
    if not pid:
        return False
    began, want = started_at(pid), as_epoch(start)
    return began is not None and want is not None and alive(pid) and abs(began - want) < 2


def signal_if_same(pid: int | None, start, sig=signal.SIGTERM) -> bool:
    if not same_process(pid, start):
        return False
    try:
        os.kill(pid, sig)
        return True
    except ProcessLookupError:
        return False


def registry() -> list[dict]:
    """Claude's registry of live processes (a killed process leaves its file behind, so check the pid)."""
    rows = []
    for f in SESSIONS.glob("*.json"):
        d = read_json(f)
        if isinstance(d, dict) and isinstance(d.get("pid"), int) and alive(d["pid"]):
            if d.get("procStart") and started_at(d["pid"]) is not None and not same_process(d["pid"], d["procStart"]):
                continue  # a dead session's file, its pid since reused
            rows.append(d)
    return rows


def live_row(conversation_ids: list[str], rows: list[dict] | None = None) -> dict | None:
    for d in rows if rows is not None else registry():
        if d.get("sessionId") in conversation_ids:
            return d
    return None


def name_in_use(name: str) -> str | None:
    """Where a live session already holds this name, or None."""
    for d in registry():
        if d.get("name") == name:
            return f"pid {d['pid']}"
    for l in launches():
        if l.get("name") == name and held(l["id"]):
            return f"{l.get('space') or '?'} / {l.get('window') or '?'}"
    return None


# ── transcripts and the state rule ──────────────────────────────────────────────────────────────────────────────


def transcript(sid: str | None) -> Path | None:
    if not sid:
        return None
    hits = sorted(PROJECTS.glob(f"*/{sid}.jsonl"))
    return hits[0] if hits else None


CUT = {"type": "cut"}  # the first record of a tail that does not start at the beginning: a turn is open before it


def records(path: Path | None, tail: int | None = None) -> list[dict]:
    """A transcript's records; with `tail`, only those in its last `tail` bytes (transcripts reach hundreds of MB),
    after a `CUT` record when the file is longer."""
    if not path or not path.exists():
        return []
    try:
        with open(path, "rb") as f:
            size = f.seek(0, 2)
            f.seek(max(0, size - tail) if tail else 0)
            data = f.read().decode("utf-8", "replace")
    except OSError:
        return []
    lines = data.splitlines()
    out = []
    if tail and size > tail:
        lines = lines[1:]  # the first line is cut
        out.append(dict(CUT))
    for line in lines:
        try:
            out.append(json.loads(line))
        except ValueError:
            pass
    return out


NEEDS = re.compile(r"^\|\s*Needs you\s*\|", re.M)
DONE = re.compile(r"Nothing left for you")
NOTHING = re.compile(r"(?i)\W*(nothing|none|no ask|n/a)\b")


def scan(path: Path | None, needle: bytes):
    """The records of the lines that contain `needle`, without parsing the others."""
    if not path:
        return
    try:
        with open(path, "rb") as f:
            for line in f:
                if needle in line:
                    try:
                        yield json.loads(line)
                    except ValueError:
                        pass
    except OSError:
        return


def pr_links_in(path: Path | None) -> list[str]:
    return pr_links(list(scan(path, b'"pr-link"')))


def last_mode_in(path: Path | None) -> str | None:
    return last_mode(list(scan(path, b"ermissionMode")))


def first_prompt_in(path: Path | None) -> str:
    """The first prompt's text, parsing lines only until it is found."""
    for rec in scan(path, b'"user"'):
        if is_user_prompt(rec):
            return text_of(rec)
    return ""


def text_of(rec: dict) -> str:
    c = (rec.get("message") or {}).get("content")
    if isinstance(c, str):
        return c
    if isinstance(c, list):
        return "\n".join(x.get("text", "") for x in c if isinstance(x, dict) and x.get("type") == "text")
    return ""


def is_user_prompt(rec: dict) -> bool:
    if rec.get("type") != "user" or rec.get("isMeta") or rec.get("isSidechain"):
        return False
    c = (rec.get("message") or {}).get("content")
    if isinstance(c, list) and c and all(isinstance(x, dict) and x.get("type") == "tool_result" for x in c):
        return False
    return True


def last_reply(recs: list[dict]) -> tuple[dict | None, str]:
    """The last reply that counts: skip each pair of a `[cy restart]` prompt and its reply, when nothing came between."""
    turns: list[tuple[dict, list[dict]]] = []  # (prompt, assistant records after it)
    current: tuple[dict, list[dict]] | None = None
    if recs and recs[0].get("type") == CUT["type"]:  # a tail: its first records belong to a turn begun before it
        current = ({}, [])
        turns.append(current)
    for r in recs:
        if r.get("isSidechain"):
            continue
        if is_user_prompt(r) or (r.get("origin") or {}).get("kind") == "peer":
            current = (r, [])
            turns.append(current)
        elif r.get("type") == "assistant" and current is not None:
            current[1].append(r)
    while turns and RESTART_MARK in text_of(turns[-1][0]) and len(turns) > 1:
        turns.pop()
    for prompt, replies in reversed(turns):
        texts = [text_of(a) for a in replies if text_of(a).strip()]
        if texts or any(a.get("isApiErrorMessage") for a in replies):
            last = replies[-1]
            return last, texts[-1] if texts else text_of(last)
    return None, ""


def needs_asks(text: str) -> list[str]:
    m = NEEDS.search(text)
    if not m:
        return []
    asks = []
    for ln in text[m.end():].splitlines()[1:]:
        if not ln.startswith("|"):
            break
        cells = [c.strip() for c in ln.strip().strip("|").split("|")]
        if cells and cells[0] and not set(cells[0]) <= set("-: ") and not NOTHING.match(cells[0]):
            asks.append(re.sub(r"^\d+\.\s*", "", cells[0]))
    return asks


def state_of(row: dict | None, recs: list[dict]) -> dict:
    """The plan's state rule: working, waiting on you, stopped on an API error, done or idle, and what is needed."""
    status = (row or {}).get("status")
    if status in ("busy", "shell"):
        return {"state": "working" if status == "busy" else "working (background command)", "waiting_kind": None,
                "needs": ""}
    if status == "waiting":
        return {"state": "waiting on you", "waiting_kind": "dialog", "needs": (row or {}).get("waitingFor") or ""}
    rec, text = last_reply(recs)
    if rec is not None and rec.get("isApiErrorMessage"):
        return {"state": "stopped: API error", "waiting_kind": None, "needs": text.strip().splitlines()[0][:120] if text.strip() else ""}
    if DONE.search(text):
        return {"state": "done", "waiting_kind": None, "needs": ""}
    asks = needs_asks(text)
    if asks:
        return {"state": "waiting on you", "waiting_kind": "reply", "needs": asks[0]}
    paras = [p for p in text.strip().split("\n\n") if p.strip()]
    if paras and paras[-1].rstrip().endswith("?"):
        return {"state": "waiting on you", "waiting_kind": "question", "needs": paras[-1].strip()[:120]}
    return {"state": "idle", "waiting_kind": None, "needs": ""}


def last_mode(recs: list[dict]) -> str | None:
    for r in reversed(recs):
        if r.get("type") in ("permission-mode", "user") and r.get("permissionMode"):
            return r["permissionMode"]
    return None


def last_model(recs: list[dict]) -> str | None:
    for r in reversed(recs):
        m = (r.get("message") or {}).get("model") if r.get("type") == "assistant" else None
        if m and not str(m).startswith("<"):
            return m
    return None


def pr_links(recs: list[dict]) -> list[str]:
    seen = []
    for r in recs:
        if r.get("type") == "pr-link" and r.get("prUrl") and r["prUrl"] not in seen:
            seen.append(r["prUrl"])
    return seen


def title_of(recs: list[dict]) -> str | None:
    for r in reversed(recs):
        if r.get("type") in ("custom-title", "agent-name"):
            return r.get("customTitle") or r.get("agentName")
    return None


# ── alerts ──────────────────────────────────────────────────────────────────────────────────────────────────────

ALERT_TAIL = 1 << 20  # a fix is looked for in the transcript's last 1 MB: the follower reads it every 2 s while one is up


def iso_epoch(ts) -> float | None:
    try:
        return calendar.timegm(time.strptime(str(ts)[:19], "%Y-%m-%dT%H:%M:%S"))
    except ValueError:
        return None


def fixed_since(path: Path | None, text: str, at: float) -> bool:
    """Does a record later than `at` begin with `text` (the output of the command that fixes what an alert is about,
    such as a reconnect)? Only lines that contain it are parsed, and only from the transcript's tail."""
    if not path or not text:
        return False
    try:
        with open(path, "rb") as f:
            size = f.seek(0, 2)
            f.seek(max(0, size - ALERT_TAIL))
            data = f.read()
    except OSError:
        return False
    needle = text.encode()
    if needle not in data:
        return False
    for line in data.splitlines():
        if needle not in line:
            continue
        try:
            rec = json.loads(line)
        except ValueError:
            continue
        said = text_of(rec) or (rec.get("content") if isinstance(rec.get("content"), str) else "")
        if said.lstrip().startswith(text) and (iso_epoch(rec.get("timestamp")) or 0) >= int(at):
            return True
    return False


def alerts(conv: str | None, drop: bool = False) -> list[dict]:
    """What the machine's hooks say this conversation needs Kohen to fix: `alerts/<conversation id>.<kind>.json`, each
    {"kind", "note" (one line for him), "at", "cleared_by" (optional)}. The hook that wrote one removes it when the
    trouble is gone; one whose `cleared_by` text has appeared in the transcript since is gone too (removed with `drop`).
    The follower shows a live session with an alert red."""
    if not conv or not re.fullmatch(r"[\w-]+", conv):
        return []
    out = []
    for f in sorted(ALERTS.glob(f"{conv}.*.json")):
        a = read_json(f)
        if not isinstance(a, dict) or not a.get("note"):
            continue
        if a.get("cleared_by") and fixed_since(transcript(conv), str(a["cleared_by"]), float(a.get("at") or 0)):
            if drop:
                f.unlink(missing_ok=True)
            continue
        a.setdefault("kind", f.name[len(conv) + 1: -len(".json")])
        out.append(a)
    return out


# ── requests ────────────────────────────────────────────────────────────────────────────────────────────────────

KINDS = ("restart", "rename", "retire")


def submit(sid: str, kind: str, body: dict | None = None, *, by: str = "", not_after: float = 1800) -> Path:
    """Queue a request for the follower; returns its file (the result appears beside it as .result.json)."""
    if kind not in KINDS:
        raise ValueError(f"unknown request kind {kind!r}")
    if not loop_file(sid).exists():
        raise ValueError(f"{sid} is not a session cy started")
    path = REQUESTS / sid / f"{time.time_ns():020d}-{uuid.uuid4().hex[:6]}-{kind}.json"  # one clock: sorts in order
    write_json(path, {"kind": kind, "body": body or {}, "by": by, "at": time.time(), "not_after": time.time() + not_after})
    return path


def pending(sid: str) -> list[Path]:
    d = REQUESTS / sid
    return sorted(p for p in d.glob("*.json") if not p.name.endswith(".result.json")) if d.exists() else []


def result_of(request: Path) -> dict | None:
    return read_json(request.with_name(request.name[:-5] + ".result.json"))


# ── herdr, from Kohen's shell or a pane ─────────────────────────────────────────────────────────────────────────


def herdr(*args: str, timeout: float = 10) -> dict:
    try:
        p = subprocess.run(["herdr", *args], capture_output=True, text=True, timeout=timeout)
    except (OSError, subprocess.TimeoutExpired) as e:
        return {"error": str(e)}
    try:
        return json.loads(p.stdout)
    except ValueError:
        return {"error": (p.stderr or p.stdout).strip()[-300:], "returncode": p.returncode}


def herdr_ok(reply: dict) -> bool:
    """herdr answered without an error (it puts one in the reply, or exits non-zero)."""
    return not reply.get("error") and reply.get("returncode", 0) == 0


def find_key(d, key):
    if isinstance(d, dict):
        if key in d:
            return d[key]
        for v in d.values():
            found = find_key(v, key)
            if found is not None:
                return found
    elif isinstance(d, list):
        for v in d:
            found = find_key(v, key)
            if found is not None:
                return found
    return None


def interrupted_answer(answered: bool, said: str) -> bool:
    """On SIGHUP: did herdr's server stop (interrupted), rather than this pane go?"""
    low = said.lower()
    return (not answered or "server_unavailable" in low or "shutting down" in low or "server_not_running" in low
            or "not running" in low or "connection refused" in low)


# ── the token and the claude command ────────────────────────────────────────────────────────────────────────────


class LaunchHookFailed(Exception):
    pass


def token_env(token: str | None, key: str, parent: str | None = None) -> tuple[dict, str, bool]:
    """The machine's launch hook decides the environment: for a named token, or ('default') for the session's own pin,
    else the default. Returns the environment, the label it chose and whether that is a pin.
    A hook that fails stops the launch: a session must never start on a token nobody chose."""
    env = dict(os.environ)
    env.pop("CLAUDECODE", None)
    if not LAUNCH_HOOK.exists():
        return env, "none", False
    try:
        p = subprocess.run([str(LAUNCH_HOOK), token or "default", key, *([parent] if parent else [])],
                           capture_output=True, text=True, timeout=20)
    except (OSError, subprocess.TimeoutExpired) as e:
        raise LaunchHookFailed(str(e))
    if p.returncode != 0:  # stderr only: the hook's stdout carries the environment, secrets included
        raise LaunchHookFailed(p.stderr.strip()[-300:] or f"exit {p.returncode}")
    label, pinned = token or "default", False
    for line in p.stdout.splitlines():
        if line.startswith("token="):
            label = line[6:].strip()
        elif line.startswith("pin="):
            label, pinned = line[4:].strip(), True
        elif line.startswith("-"):
            env.pop(line[1:].strip(), None)
        elif "=" in line:
            k, v = line.split("=", 1)
            env[k.strip()] = v
    return env, label, pinned


CRONS_HOOK = os.path.join(os.path.dirname(BIN), "claude", "bin", "cy-crons")  # the Stop hook that saves a window's crons


def settings_json(extra: dict | None) -> str:
    """The one `--settings` value a window's claude gets: what a converted job carried, the agent view off, and the Stop
    hook that saves the session's crons for a restart (only `cy` windows need it, so it rides here)."""
    merged = dict(extra or {})
    merged.update(VIEW_OFF)
    if os.path.exists(CRONS_HOOK):
        hooks = dict(merged.get("hooks") or {})
        hooks["Stop"] = list(hooks.get("Stop") or []) + [{"hooks": [{"type": "command", "command": shlex.quote(CRONS_HOOK)}]}]
        merged["hooks"] = hooks
    return json.dumps(merged)


def claude_argv(spec: dict) -> list[str]:
    a = ["claude", "-n", spec["name"], "--permission-mode", spec.get("mode") or "bypassPermissions",
         "--settings", settings_json(spec.get("settings"))]
    if spec.get("resume"):
        a += ["--resume", spec["resume"]]
        if spec.get("fork"):
            a += ["--fork-session", "--session-id", spec["id"]]
    else:
        a += ["--session-id", spec["id"]]
    for flag in ("model", "effort", "agent"):
        if spec.get(flag):
            a += [f"--{flag}", spec[flag]]
    if spec.get("prompt"):
        a += (["--"] if spec["prompt"].startswith("-") else []) + [spec["prompt"]]
    return a


# ── the follower ────────────────────────────────────────────────────────────────────────────────────────────────


def follower_running() -> bool:
    path = STATE / "follow.lock"
    if not path.exists():
        return False
    with open(path, "a") as f:
        try:
            fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            return True
        fcntl.flock(f, fcntl.LOCK_UN)
        return False


def file_version(path: str) -> str:
    try:
        return hashlib.sha256(Path(path).read_bytes()).hexdigest()[:12]
    except OSError:
        return ""


def follower_version() -> str:
    """The follower runs this file's code too, so its version covers both."""
    return file_version(os.path.join(BIN, "cy-follow")) + file_version(ME)


def start_follower() -> str:
    """Start cy-follow detached, or replace one running older code. Never from inside a Claude sandbox."""
    status = read_json(STATE / "follow.status.json", {})
    if follower_running() and status.get("version") == follower_version():
        return "running"  # whoever asks, a current follower is enough
    if os.environ.get("CLAUDECODE"):
        return "not started (inside a Claude session)"
    if os.environ.get("CY_NO_FOLLOWER"):
        return "not started (CY_NO_FOLLOWER)"
    follow = os.path.join(BIN, "cy-follow")
    if follower_running():
        signal_if_same(status.get("pid"), status.get("start"))
        time.sleep(1)
    STATE.mkdir(parents=True, exist_ok=True)
    log = open(STATE / "follow.log", "ab")
    subprocess.Popen([sys.executable, follow], stdin=subprocess.DEVNULL, stdout=log, stderr=log, start_new_session=True,
                     close_fds=True)
    log.close()
    return "started"


# ── the window loop ─────────────────────────────────────────────────────────────────────────────────────────────


INTERRUPTED = b"[Request interrupted by user"


def interrupted_since(conv: str | None, at: float) -> bool:
    """Was a turn stopped with Esc after the crons were saved? The Stop hook does not run then (probe P6), so the
    saved list may still hold a loop Kohen just cancelled: it is stale."""
    for rec in scan(transcript(conv), INTERRUPTED):
        try:
            when = calendar.timegm(time.strptime(str(rec.get("timestamp"))[:19], "%Y-%m-%dT%H:%M:%S"))
        except ValueError:
            continue
        if rec.get("type") == "user" and INTERRUPTED.decode() in text_of(rec) and when >= at:
            return True
    return False


def rearm_text(conv: str | None, request_prompt: str | None = None) -> str | None:
    """A restarted session's first prompt: the request's own words, then what it had scheduled and lost.

    Only session crons and wakeups are listed (a durable cron survives on its own). When nothing else is said, the
    prompt starts with `[cy restart]`, which the state rule skips, so a restart never hides an ask."""
    data = read_json(CRONS / f"{conv}.json", {}) if conv else {}
    items = [c for c in (data.get("session_crons") or []) if not c.get("durable")]
    if not items or interrupted_since(conv, data.get("at") or 0):
        return request_prompt
    listed = "; ".join(f"{c.get('schedule') or c.get('at') or ''} \"{(c.get('prompt') or '')[:80]}\"" for c in items)
    text = (f"Restarted at {time.strftime('%H:%M')}. These were scheduled in this session and were lost with the old "
            f"process: {listed}. Set them up again, unless you had stopped them.")
    return f"{request_prompt}\n\n{text}" if request_prompt else f"{RESTART_MARK} {text}"


class Loop:
    """One window's loop: lock, launch, watch, decide, relaunch."""

    def __init__(self, spec: dict):
        self.spec = spec
        self.sid = spec["key"]  # the first conversation id: the session's key on disk
        self.lock = None
        self.child: subprocess.Popen | None = None
        self.hup = None
        self.term = False
        self._mu = threading.Lock()

    def facts(self) -> dict:
        return read_json(loop_file(self.sid), {})

    def record(self, **fields):
        with self._mu:  # the watcher thread and the loop both write this file
            d = self.facts()
            d.update(fields)
            write_json(loop_file(self.sid), d)

    def take_lock(self) -> bool:
        STATE.mkdir(parents=True, exist_ok=True)
        fd = self.spec.pop("lock_fd", None)
        if fd is not None:  # a self-update kept the lock across exec
            self.lock = os.fdopen(fd, "a")
            return True
        self.lock = open(lock_file(self.sid), "a")
        try:
            fcntl.flock(self.lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return True
        except OSError:
            return False

    def child_alive(self) -> bool:
        return bool(self.child) and self.child.poll() is None

    def on_hup(self, _sig, _frm):
        if not self.child_alive():  # at the ⏎ prompt: the window is going, the session already ended
            self.record(status="ended", end=self.facts().get("end") or "closed", ended_at=time.time())
            os._exit(0)
        pane = os.environ.get("HERDR_PANE_ID", "")
        try:
            p = subprocess.run(["herdr", "pane", "get", pane], capture_output=True, text=True, timeout=0.5)
            answered, said = True, p.stdout + p.stderr
        except (subprocess.TimeoutExpired, OSError) as e:
            answered, said = False, str(e)
        self.hup = "interrupted" if interrupted_answer(answered, said) else "closed"
        self.record(status=self.hup if self.hup == "interrupted" else "ended", end=self.hup, ended_at=time.time())
        next_file(self.sid).unlink(missing_ok=True)

    def on_term(self, _sig, _frm):
        """SIGTERM to the loop itself: end claude too, so it never stays on the window's terminal beside the shell."""
        self.term = True
        if self.child_alive():
            self.child.send_signal(signal.SIGTERM)

    def watch(self, stop: threading.Event):
        """While claude runs, follow its conversation id (it changes on /clear and /branch) and its registry pid."""
        while not stop.wait(3):
            if not self.child_alive():
                continue
            row = row_of_launch(self.child.pid)
            if not row:
                continue
            convs = self.facts().get("conversations", [])
            if row.get("sessionId") and row["sessionId"] != self.facts().get("conversation"):
                self.record(conversations=convs + [row["sessionId"]] if row["sessionId"] not in convs else convs,
                            conversation=row["sessionId"])  # /clear and /branch change it; the registry knows
            if row.get("name") and row["name"] != self.spec["name"] and row.get("nameSource") == "user":
                self.spec["name"] = row["name"]  # Kohen's own /rename is kept
                self.record(name=row["name"])
            self.record(claude_pid=row["pid"], claude_start=row.get("procStart"))

    def wait_old_gone(self):
        pid, start = self.facts().get("claude_pid"), self.facts().get("claude_start")
        if not pid:
            return
        end = time.time() + OLD_PID_WAIT
        while time.time() < end and same_process(pid, start):
            time.sleep(0.1)
        if same_process(pid, start):
            signal_if_same(pid, start, signal.SIGKILL)
            self.record(note=f"old claude {pid} outlived its launcher; killed")

    def run(self) -> int:
        if not self.take_lock():
            print(f"cy: {self.spec['name']} is live in another window", file=sys.stderr)
            return 1
        pf = self.spec.pop("prompt_file", None)
        if pf:  # read and removed only now: a refused start keeps its prompt file
            try:
                text = Path(pf).read_text()
                resumed = self.spec.get("resume") and not self.spec.get("fork")
                self.spec["prompt"] = rearm_text(self.spec["resume"], text) if resumed else text  # keep the re-arm notice
                Path(pf).unlink()
            except OSError as e:
                print(f"cy: cannot read the prompt file: {e}", file=sys.stderr)
                return 1
        facts = self.facts()
        convs = facts.get("conversations") or []
        for c in (self.spec.get("resume"), self.spec["id"]) if not self.spec.get("resume") or self.spec.get("fork") \
                else (self.spec.get("resume"),):
            if c and c not in convs:
                convs.append(c)
        self.record(id=self.sid, name=self.spec["name"], cwd=os.getcwd(), model=self.spec.get("model"),
                    effort=self.spec.get("effort"), agent=self.spec.get("agent"), token_asked=self.spec.get("token"),
                    started_by=self.spec.get("started_by") or facts.get("started_by"),
                    conversations=convs, status="live", end=None,
                    started_at=facts.get("started_at") or time.time(), version=file_version(ME))
        start_follower()
        signal.signal(signal.SIGHUP, self.on_hup)
        signal.signal(signal.SIGTERM, self.on_term)
        stop = threading.Event()
        threading.Thread(target=self.watch, args=(stop,), daemon=True).start()
        try:
            return self._loop()
        finally:
            stop.set()

    @staticmethod
    def child_signals():
        """In claude, Ctrl+C and the hangup do what they always do (the loop ignores Ctrl+C for itself)."""
        signal.signal(signal.SIGINT, signal.SIG_DFL)
        signal.signal(signal.SIGHUP, signal.SIG_DFL)

    def _loop(self) -> int:
        while True:
            try:
                env, label, pinned = token_env(self.spec.get("token"), self.sid, self.spec.get("parent"))
            except LaunchHookFailed as e:
                print(f"cy: the launch hook for token {self.spec.get('token') or 'default'} failed: {e}", file=sys.stderr)
                self.record(status="crashed", end="crashed", ended_at=time.time(), note=f"launch hook: {e}")
                return 1
            env["CY_SESSION"] = self.sid  # who asks (its key), when this session queues a request with cag or tok
            argv = claude_argv(self.spec)
            signal.signal(signal.SIGINT, signal.SIG_IGN)  # Ctrl+C is for claude
            self.child = subprocess.Popen(argv, env=env, preexec_fn=self.child_signals)
            self.spec["prompt"] = None  # a prompt is sent once; a restart brings its own
            self.spec["token"] = self.spec["parent"] = None  # asked once: from then on the hook keeps the session's pin
            self.record(launched_pid=self.child.pid, launched_start=started_at(self.child.pid), token=label, pinned=pinned,
                        conversation=self.spec["id"] if self.spec.get("fork") or not self.spec.get("resume")
                        else self.spec["resume"], status="live", end=None,  # a --branch copy has its own id
                        pane=os.environ.get("HERDR_PANE_ID"), tab=os.environ.get("HERDR_TAB_ID"),
                        workspace=os.environ.get("HERDR_WORKSPACE_ID"))
            code = self.child.wait()
            signal.signal(signal.SIGINT, signal.SIG_DFL)
            if self.hup:
                return 0
            order = read_json(next_file(self.sid))
            next_file(self.sid).unlink(missing_ok=True)
            if self.term and not (order and order.get("for_pid") == self.child.pid):
                self.record(status="ended", end="exit", ended_at=time.time())
                return 0
            if order and order.get("for_pid") == self.child.pid:
                if order.get("end") == "retired":
                    self.record(status="retired", end="retired", ended_at=time.time())
                    return 0
                self.wait_old_gone()
                self.spec.update({k: v for k, v in order.items() if k in ("name", "token", "model", "effort", "agent",
                                                                         "mode", "settings")})
                self.spec["prompt"] = order.get("prompt")
                self.spec["resume"] = order.get("conversation") or self.facts().get("conversation") or self.sid
                self.spec["fork"] = False
                if order.get("fresh"):  # a new conversation under the same session key
                    self.spec["resume"], self.spec["id"] = None, str(uuid.uuid4())
                    self.record(conversations=self.facts().get("conversations", []) + [self.spec["id"]])
                self.record(name=self.spec["name"], token_asked=self.spec.get("token"),
                            restarts=self.facts().get("restarts", 0) + 1)
                if file_version(ME) != self.facts().get("version") and self.checks_ok():
                    os.set_inheritable(self.lock.fileno(), True)
                    write_json(STATE / f"{self.sid}.continue.json", dict(self.spec, lock_fd=self.lock.fileno()))
                    os.execv(sys.executable, [sys.executable, ME, "--continue", self.sid])
                continue
            if code == 0:
                self.record(status="ended", end="exit", ended_at=time.time())
                print(f"\n{self.spec['name']} ended. ⏎ resumes it here, Ctrl+D leaves.")
                try:
                    input()
                except (EOFError, KeyboardInterrupt):
                    return 0
                conv = self.facts().get("conversation") or self.sid
                self.spec.update(resume=conv, fork=False, prompt=rearm_text(conv))
                self.record(status="live", end=None)
                continue
            self.record(status="crashed", end="crashed", ended_at=time.time(), exit_code=code)
            print(f"\ncy: {self.spec['name']} stopped (exit {code}). Resume it with: cy -r {self.spec['name']}",
                  file=sys.stderr)
            return code

    @staticmethod
    def checks_ok() -> bool:
        return subprocess.run([sys.executable, ME, "--check"], capture_output=True).returncode == 0


# ── resolving a session for -r ──────────────────────────────────────────────────────────────────────────────────


def resolve(target: str) -> dict | None:
    """A session by name, former name, first or later conversation id; then by a transcript's title or file name."""
    for l in sorted(launches(), key=lambda x: x.get("started_at") or 0, reverse=True):
        if target in (l.get("id"), l.get("name")) or target in (l.get("former_names") or []) \
                or target in (l.get("conversations") or []):
            return l
    by_id = sorted(PROJECTS.glob(f"*/{target}.jsonl"))
    if by_id:
        return {"id": target, "name": None, "conversations": [target], "cwd": None, "from_transcript": True}
    if not NAME_RE.match(target):
        return None
    newest = sorted(PROJECTS.glob("*/*.jsonl"), key=lambda p: p.stat().st_mtime, reverse=True)[:400]
    for f in newest:  # titles only in the last 400 transcripts: a typo must not read every transcript there is
        if title_of(records(f)) == target:
            return {"id": f.stem, "name": target, "conversations": [f.stem], "cwd": None, "from_transcript": True}
    return None


def where(l: dict) -> str:
    return f"{l.get('space') or l.get('workspace') or '?'} / {l.get('window') or l.get('tab') or '?'}"


def listing() -> int:
    rows = sorted(launches(), key=lambda x: x.get("started_at") or 0, reverse=True)
    if not rows:
        print("cy: no session has been started with cy yet")
        return 0
    for l in rows[:40]:
        print(f"  {l.get('name') or '?':40} {l.get('status'):12} {where(l)}")
    print("resume one with: cy -r NAME")
    return 0


# ── cy restore ──────────────────────────────────────────────────────────────────────────────────────────────────


def restore() -> int:
    """Reopen, each in its space, every session a herdr restart interrupted that is not live again."""
    n = 0
    for l in launches():
        if l.get("status") != "interrupted" or live_row(l.get("conversations") or []):
            continue
        ws = herdr("workspace", "list")
        wid = None
        for w in find_key(ws, "workspaces") or []:
            if w.get("label") == l.get("space") or w.get("workspace_id") == l.get("workspace"):
                wid = w.get("workspace_id")
        reply = herdr("tab", "create", "--workspace", wid, "--label", l.get("name", "cy"), "--no-focus") if wid else \
            herdr("workspace", "create", "--label", l.get("space") or "restored", "--no-focus")
        pane = find_key(reply, "pane_id")
        if pane:  # by its path: until the switch, a bare `cy` in a shell is still the old function
            herdr("pane", "run", pane, f"cd {shlex.quote(l.get('cwd') or str(HOME))} && {shlex.quote(ME)} -r {l['id']}")
            n += 1
    print(f"cy: reopened {n} session{'s' if n != 1 else ''}")
    return 0


# ── main ────────────────────────────────────────────────────────────────────────────────────────────────────────


def default_name() -> str:
    return f"{re.sub(r'[^a-z0-9-]', '-', os.path.basename(os.getcwd()).lower())[:30]}-{time.strftime('%H%M%S')}"


def main(argv: list[str]) -> int:
    if argv[:1] == ["--check"]:
        return 0
    if argv[:1] == ["--continue"] and len(argv) == 2:
        spec = read_json(STATE / f"{argv[1]}.continue.json")
        (STATE / f"{argv[1]}.continue.json").unlink(missing_ok=True)
        return Loop(spec).run() if spec else 1
    if argv[:1] == ["restore"]:
        return restore()
    if argv in (["-r"], ["--resume"]):
        return listing()
    ap = argparse.ArgumentParser(prog="cy", description=__doc__.split("\n\n")[0])
    ap.add_argument("-n", "--name")
    ap.add_argument("-r", "--resume", metavar="NAME|ID")
    ap.add_argument("--branch", metavar="NEW")
    ap.add_argument("--model")
    ap.add_argument("--effort")
    ap.add_argument("--agent")
    ap.add_argument("--token", help="the token to bill (a pin); default: the machine's default")
    ap.add_argument("--token-of", metavar="KEY", help="a new session bills what session KEY is pinned to (kc-new: the asker)")
    ap.add_argument("--prompt-file")
    ap.add_argument("prompt", nargs="*")
    a = ap.parse_args(argv)
    if os.environ.get("CLAUDECODE"):
        print("cy: run me in a window's shell, not from inside a Claude session", file=sys.stderr)
        return 2
    prompt = " ".join(a.prompt) or None
    if a.resume:
        l = resolve(a.resume)
        if not l:
            print(f"cy: no session named {a.resume} (cy -r alone lists them)", file=sys.stderr)
            return 1
        convs = l.get("conversations") or [l["id"]]
        conv = l.get("conversation") or convs[-1]
        recs = records(transcript(conv))
        if l.get("cwd") and os.path.isdir(l["cwd"]):
            os.chdir(l["cwd"])
        if a.branch:
            if not NAME_RE.match(a.branch) or name_in_use(a.branch):
                print(f"cy: {a.branch} is not a free session name", file=sys.stderr)
                return 1
            new = str(uuid.uuid4())
            spec = {"key": new, "id": new, "name": a.branch, "resume": conv, "fork": True,
                    "token": a.token, "parent": l["id"],
                    "model": a.model or last_model(recs), "effort": a.effort or l.get("effort"),
                    "agent": a.agent or l.get("agent"), "mode": last_mode(recs), "prompt": prompt,
                    "prompt_file": a.prompt_file, "started_by": os.environ.get("CY_STARTED_BY") or l["id"]}
            return Loop(spec).run()
        if held(l["id"]) or live_row(convs):
            print(f"cy: {l.get('name') or a.resume} is live in {where(l)}", file=sys.stderr)
            return 1
        if l.get("status") == "retired":
            print(f"cy: {l.get('name')} was retired; resuming it")
        name = l.get("name") or (a.resume if NAME_RE.match(a.resume) else default_name())
        spec = {"key": l["id"], "id": l["id"], "name": name, "resume": conv,
                "token": a.token,
                "model": a.model or last_model(recs) or l.get("model"), "effort": a.effort or l.get("effort"),
                "agent": a.agent or l.get("agent"), "mode": last_mode(recs),
                "prompt": rearm_text(conv, prompt), "prompt_file": a.prompt_file}
        return Loop(spec).run()
    name = a.name or default_name()
    if not NAME_RE.match(name):
        print(f"cy: {name!r} is not a session name (lower-case letters, digits, dashes)", file=sys.stderr)
        return 1
    busy = name_in_use(name)
    if busy:
        print(f"cy: {name} is already live in {busy}", file=sys.stderr)
        return 1
    sid = str(uuid.uuid4())
    spec = {"key": sid, "id": sid, "name": name, "token": a.token, "parent": a.token_of, "model": a.model, "effort": a.effort,
            "agent": a.agent, "prompt": prompt, "prompt_file": a.prompt_file, "mode": "bypassPermissions",
            "started_by": os.environ.get("CY_STARTED_BY")}
    return Loop(spec).run()


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
