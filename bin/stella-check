#!/usr/bin/env python3
"""stella-check: decide, without a model, when Stella's session needs to wake.

    stella-check            dry run: print what is new now, without saving anything (safe to run by hand)
    stella-check --watch    keep checking; exit 2 with what is new, so the hook that started it wakes Stella
    stella-check --watch --fresh   the same, for the SessionStart hook only (by hand it ends Stella's watcher): ends a
                                   watcher left by the previous process (hooks run detached, so one can outlive a
                                   restart) and redelivers a wake that was never acknowledged
    stella-check --ack      Stella's last step on a wake turn: the wake was delivered and handled
    stella-check --status   one line: the watcher's pid and age, the PR lists' age, and the last line of events.log
    stella-check --compact-note   the SessionStart (compact) hook's answer: redo the start steps after a compaction
    stella-check --once     one real check that saves what it saw (tests and repairs)

Stella's session starts `--watch` from its SessionStart, Stop and StopFailure hooks (asyncRewake), which `stella`
writes into her project settings. Only one watcher runs at a time (a lock in her store); a second exits at once.

What wakes her is what her manual's "How you are woken" section acts on, and nothing else. No wake for what she
cannot or will not act on, kind by kind (the numbers are in "Stella calm - plan", Assets):
  - blocked: once per episode of a session waiting on a bare question (its last reply ends with one and has no
    "Needs you" table) or on a dialog (a permission prompt, Claude's registry says `waiting`), for 15 minutes counted
    from that reply (from the session's last activity, for a dialog). The state is `cag`'s state rule, read from the
    sessions table (`cag`'s light read: registry, transcript tails, launch files), for jobs and `cy` windows alike. A
    new reply is a new episode; nothing else is. Not a wake: a session whose last message marks its asks as Kohen's (a
    "Needs you" table: outside the overnight window the manual forbids answering what the session marked as his call,
    and inside it her hourly check reads those sessions itself). Sessions already waiting when this state first loads
    are known, not news.
  - api_error: a session stopped on an API error (the state rule's "stopped: API error") for 5 minutes, again each hour
    for 3 hours.
  - act and orphan (the PR helper's items): a conflict counts once it has held for two helper runs on the same sha
    (the flag flaps); an item Stella marked `noted` for that exact signature does not come back (it is listed in
    pr-tasks.json for her status); the owner's `would_be_held` mode rides along. A different signature (a new commit,
    thread, comment or check) is news.
  - unacknowledged, stuck, held: when they appear (held and stuck are also tasks in pr-tasks.json).
  - merged: a session that has merged PRs and is not working (a working session reports by itself).
  - reminders: due ones. helper errors: once, and once more as "persisting" after an hour; failures within half an hour
    of each other are one error.
  - the check itself crashing (once per kind of crash).
  - Not a wake at all: a session in a mode that holds her messages (wrong_mode). It matters only when she has something
    to send it, and then the act/orphan item says `would_be_held`.
A finding wakes her once, when it appears; one that stays is not news. One that goes and comes back is news again,
except the kinds above. A failed run of the helper keeps what it listed before, so its recovery is not news. Findings
that arrive within SETTLE seconds of each other are one wake.

A wake stays pending until Stella runs `--ack`. Only a `--fresh` watcher (a new session process, from SessionStart
`startup|resume`) delivers a pending wake again: the old process's queue is gone. A watcher in the same process (the
Stop hook, or after a compaction) never does, so a wake that is still queued is not doubled.

Every wake appends one line to events.log. The PR helper's lasting lists (held, stuck, unacknowledged,
waiting_review) are written to pr-tasks.json, which her status reads.

Sessions are keyed by their first conversation id (a job's `sessionId`, a `cy` window's key), which neither a rename
nor a restart nor `/clear` changes.

It runs inside the session's command sandbox: it reads files and runs the PR helper (which calls `gh`); it never
calls `claude` and never messages anyone.

Standard library only.
"""

from __future__ import annotations

import contextlib
import fcntl
import hashlib
import importlib.machinery
import importlib.util
import json
import os
import re
import signal
import subprocess
import sys
import time
from pathlib import Path

POLL = int(os.environ.get("STELLA_CHECK_POLL", "60"))  # seconds between checks of the job records
HELPER_EVERY = 600  # seconds between runs of the PR helper (it calls gh for every open PR)
BLOCKED_AFTER = 15 * 60
API_ERROR_AFTER = 5 * 60
REPEAT = 3600  # an api_error she could not continue yet comes back once an hour, for REPEATS hours
REPEATS = 3
SETTLE = int(os.environ.get("STELLA_CHECK_SETTLE", "20"))  # seconds the first finding waits for others to join its wake
ERROR_PERSISTS = 3600  # a helper error still there after this is news again, as "persisting"
ERROR_GAP = 1800  # failures further apart than this are separate errors
ALIVE_WITHIN = 900  # a watcher that has not beat for this long is gone (a helper run takes up to 6 minutes)
RECENT = 3 * 3600  # sessions with no activity for longer than this are not looked at
MAX_LIFE = 23 * 3600  # exit quietly before the hook's one-day timeout kills it; the next turn's Stop hook restarts it
SELF = ("stella",)
COMPACT_NOTE = ("Your conversation was just compacted. Do the start-of-session steps in your manual again now, and read "
                "pr-tasks.json, tasks.md and the end of events.log in your store before answering anything about PRs or "
                "sessions.")
HELPER_FAILS = (RuntimeError, ValueError, OSError, subprocess.TimeoutExpired)


def home() -> Path:
    return Path(os.environ.get("HOME") or Path.home())


def store() -> Path:
    return Path(os.environ.get("STELLA_STORE") or home() / ".local/share/stella")


def now() -> float:
    return time.time()


def digest(text: str) -> str:
    return hashlib.sha1(text.encode()).hexdigest()[:10]


def hour() -> int:
    return int(now() // REPEAT)


_CAG = None


def cag():
    """The sessions table (`cag`, next to this file): the same rows Kohen sees."""
    global _CAG
    if _CAG is None:
        path = Path(os.environ.get("STELLA_CAG") or Path(__file__).resolve().with_name("cag"))
        loader = importlib.machinery.SourceFileLoader("cag_lib", str(path))
        _CAG = importlib.util.module_from_spec(importlib.util.spec_from_loader("cag_lib", loader))
        loader.exec_module(_CAG)
    return _CAG


def sessions() -> list[dict]:
    """Every session with activity in the last RECENT seconds, but Stella herself (cag's light read)."""
    return [r for r in cag().rows(light=True, since=now() - RECENT) if r.get("name") not in SELF
            and r.get("first_conversation_id") and now() - (r.get("last_activity_at") or r.get("started_at") or 0) <= RECENT]


GIVEN_WORK = 80  # a first prompt longer than this is a task, not a start message


def worked(r: dict) -> bool:
    """Has the session been given work: more than one prompt, a tool used, or a first prompt that is a task. A session
    that only answered its start message ("Session start: wait for my first message.") has not, and its question
    ("What would you like to work on?") is for Kohen."""
    c = cag().cy
    recs = c.records(Path(r["transcript"]), tail=cag().TAIL) if r.get("transcript") else []
    prompts = [t for t in (c.text_of(x).strip() for x in recs if c.is_user_prompt(x))
               if t and not t.startswith(("<local-command-", "<command-name>", "<command-message>"))]  # not slash commands
    return len(prompts) > 1 or any(used_a_tool(x) for x in recs) or any(len(p) > GIVEN_WORK for p in prompts)


def used_a_tool(rec: dict) -> bool:
    content = (rec.get("message") or {}).get("content") if rec.get("type") == "assistant" else None
    return isinstance(content, list) and any(isinstance(b, dict) and b.get("type") == "tool_use" for b in content)


def session_findings() -> dict[str, dict]:
    found = {}
    for r in sessions():
        name, key = str(r.get("name") or r["first_conversation_id"]), r["first_conversation_id"]
        state, kind = r.get("rule_state") or r.get("state") or "", r.get("waiting_kind")  # a dormant job's too
        if state.startswith("waiting on you") and kind in ("question", "dialog"):
            # A bare question or a dialog: once per episode, when it has waited BLOCKED_AFTER. A Needs-you table is
            # Kohen's (kind "reply") and wakes no one.
            # A question waits from its reply; a dialog from the session's last activity (the tool call it asks about).
            # Either episode is keyed by the reply, so records written while a dialog is open start no new one.
            since = (r.get("last_reply_at") if kind == "question" else r.get("last_activity_at")) or now()
            episode = f"{int(r.get('last_reply_at') or since)}" + ("" if kind == "question" else ":dialog")
            if now() - since >= BLOCKED_AFTER and (kind == "dialog" or worked(r)):
                found[f"blocked:{key}:{episode}"] = {"kind": "blocked", "session": name, "id": key, "waiting": kind,
                                                    "minutes": int((now() - since) / 60),
                                                    "needs": str(r.get("needs") or "")[:300],
                                                    "transcript": r.get("transcript"), "mode": r.get("permission_mode")}
            continue
        if state == "stopped: API error":
            age = now() - (r.get("last_reply_at") or r.get("last_activity_at") or now())
            if age >= API_ERROR_AFTER and age // REPEAT <= REPEATS:
                again = int(age // REPEAT)  # comes back once an hour of being stopped, while it stays
                found[f"apierror:{key}:h{again}"] = {"kind": "api_error", "session": name, "id": key,
                                                     "minutes": int(age / 60), "transcript": r.get("transcript"),
                                                     "detail": str(r.get("last_reply") or r.get("needs") or "")[:300]}
    return found


def helper() -> Path:
    return store() / "approved-prs/approved-prs.py"


def run_helper(*args: str) -> dict:
    p = subprocess.Popen([sys.executable, str(helper()), *args], stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                         text=True, start_new_session=True)
    try:
        stdout, stderr = p.communicate(timeout=120)
    except BaseException:  # a timeout, or the watcher being ended: never leave the helper (and its gh calls) running
        try:
            os.killpg(p.pid, signal.SIGKILL)
        except OSError:
            pass
        p.wait()
        raise
    if p.returncode:
        raise RuntimeError((stderr or stdout).strip()[-200:] or f"exit {p.returncode}")
    out = json.loads(stdout)
    if not isinstance(out, dict):
        raise RuntimeError("not a JSON object")
    return out


def items(out: dict, bucket: str) -> list[dict]:
    return [it for it in out.get(bucket) or [] if isinstance(it, dict)]


def error_finding(state: dict, errors: list, what: str, error: str) -> None:
    """A helper error: news when it first appears and once more, as "persisting", after an hour of it. Failures less
    than half an hour apart are one error, so a helper that fails every other run does not wake her every time."""
    rec = state.setdefault("errors", {}).get(what)
    if not rec or now() - rec.get("last", 0) > ERROR_GAP:
        rec = state["errors"][what] = {"first": now(), "announced": []}
    rec["last"] = now()
    level = "persisting" if now() - rec["first"] >= ERROR_PERSISTS else "first"
    if level in rec["announced"]:
        return
    rec["announced"].append(level)
    errors.append({"key": f"error:{what}:{level}", "kind": "helper_error", "what": what, "error": error[:200],
                   **({"persisting": True, "minutes": int((now() - rec["first"]) / 60)} if level == "persisting" else {})})


def ledger() -> dict:
    """The PR helper's ledger of what Stella told or noted (read only: only her `mark-*` calls write it)."""
    try:
        d = json.loads((helper().parent / "ledger.json").read_text())
        return d if isinstance(d, dict) else {}
    except (OSError, ValueError):
        return {}


def norm_sig(sig: str) -> str:
    """The helper's signature (sha|conflict|threads|red|approved|feedback) with the conflict flag, which flaps,
    left out."""
    parts = str(sig).split("|")
    if len(parts) > 1:
        parts[1] = "-"
    return "|".join(parts)


def pr_items(s: dict, state: dict, errors: list) -> tuple[dict[str, dict], list[dict], list[str]]:
    """The act and orphan items as findings, minus what Stella cannot or will not act on: a conflict that has not held
    for two helper runs, and an item she marked `noted` for this signature. Also the items she noted (for her status)
    and the conflicts seen in this run."""
    led, before = ledger(), set(state.get("conflicts", []))
    found: dict[str, dict] = {}
    noted: list[dict] = []
    conflicts: list[str] = []
    for bucket, kind in (("act", "act"), ("orphans", "orphan")):
        for it in items(s, bucket):
            if it.get("error"):
                error_finding(state, errors, str(it.get("repo")), str(it["error"]))
                continue
            pr = it.get("pr")
            if not pr:
                continue
            reasons = [str(r) for r in it.get("reasons") or []]
            seen = f"{pr}:{it.get('sha')}"
            if "conflict" in reasons:
                conflicts.append(seen)
                if seen not in before:  # the flag flaps on an unchanged sha: it counts once it has held for two runs
                    reasons = [r for r in reasons if r != "conflict"]
            if not reasons:
                continue
            sig = norm_sig(it.get("signature", ""))
            e = led.get(pr)
            if isinstance(e, dict) and e.get("noted") and norm_sig(e.get("sig", "")) == sig:
                noted.append({"pr": pr, "kind": kind, "reasons": reasons, "owner": (it.get("owner") or {}).get("name"),
                              "noted_at": int(e.get("ts") or 0)})
                continue
            f = {"kind": kind, "pr": pr, "reasons": reasons}
            if kind == "act":
                f["owner"] = (it.get("owner") or {}).get("name")
            if it.get("would_be_held"):
                f["would_be_held"] = True  # the owner's mode holds her messages: restart it first (manual)
            found[f"{kind}:{pr}:{sig}:{'|'.join(sorted(reasons))}"] = f
    return found, noted, conflicts


def pr_findings(state: dict, errors: list, save: bool = True) -> tuple[dict[str, dict], set[str]]:
    """The PR helper's buckets as findings, and which of its commands failed. Writes pr-tasks.json on success."""
    found: dict[str, dict] = {}
    failed: set[str] = set()
    if not helper().exists():
        return found, failed
    try:
        s = run_helper("steward")
    except HELPER_FAILS as e:
        failed.add("steward")
        error_finding(state, errors, "steward", str(e))
        s = None
    if s is not None:
        acts, noted, conflicts = pr_items(s, state, errors)
        found.update(acts)
        state["conflicts_now"] = conflicts
        if save:
            keep = {k: items(s, k) for k in ("held", "stuck", "unacknowledged", "waiting_review")}
            write_atomic(store() / "pr-tasks.json", json.dumps(
                {"updated": int(now()), "since": previous_since() or int(now()), **keep, "noted": noted}, indent=1) + "\n")
        for it in items(s, "unacknowledged"):
            if it.get("pr"):
                found[f"unack:{it['pr']}:{it.get('told')}"] = {"kind": "unacknowledged", "pr": it["pr"], "told": it.get("told")}
        for it in items(s, "stuck"):
            if it.get("pr"):
                found[f"stuck:{it['pr']}:{it.get('times')}"] = {"kind": "stuck", "pr": it["pr"], "told": it.get("told")}
        for it in items(s, "held"):
            if it.get("pr"):
                found[f"held:{it['pr']}:{digest(str(it.get('why')))}"] = {"kind": "held", "pr": it["pr"], "why": it.get("why")}
    for what, bucket in (("merged", "merged"), ("reminders", "due")):
        try:
            r = run_helper(what)
        except HELPER_FAILS as e:
            failed.add(what)
            error_finding(state, errors, what, str(e))
            continue
        for it in items(r, bucket):
            if what == "merged" and it.get("state") == "working":
                continue  # a working session reports by itself; it comes back when it is no longer working
            ident = it.get("key") or it.get("id") or it.get("session") or digest(json.dumps(it, sort_keys=True))
            found[f"{what}:{ident}:{it.get('signature', '')}"] = {**it, "kind": what, "helper_kind": it.get("kind")}
    return found, failed


def previous_since() -> int | None:
    try:
        return int(json.loads((store() / "pr-tasks.json").read_text()).get("since"))
    except (OSError, ValueError, TypeError, AttributeError):
        return None


def write_atomic(path: Path, text: str) -> None:
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(text)
    tmp.replace(path)


def load_state() -> dict:
    try:
        d = json.loads((store() / "check-state.json").read_text())
        return d if isinstance(d, dict) else {}
    except (OSError, ValueError):
        return {}


def save_state(state: dict) -> None:
    write_atomic(store() / "check-state.json", json.dumps(state, indent=1) + "\n")


def log(line: str) -> None:
    with open(store() / "events.log", "a") as f:
        f.write(time.strftime("%Y-%m-%d %H:%M:%S ") + line + "\n")


@contextlib.contextmanager
def state_lock():
    fh = open(store() / "check-state.lock", "a+")
    fcntl.flock(fh, fcntl.LOCK_EX)
    try:
        yield
    finally:
        fh.close()


def update_state(change) -> None:
    """Load, change and save the state under a lock, so a check (which runs the helper for minutes) never overwrites
    an `--ack` or a pending wake written meanwhile."""
    with state_lock():
        st = load_state()
        change(st)
        save_state(st)


RULES = 3  # bump when the keys of the findings change. 3: sessions keyed by their first conversation id (the table's)


def moved(key: str, before: set) -> bool:
    """A finding already known under its key from before RULES 3, when sessions were keyed by their job id: the first 8
    characters of the job's first conversation id (`apierror:<id>:h1`, `merged:<id>:<signature>`)."""
    kind, ident, rest = (key.split(":", 2) + ["", ""])[:3]
    return kind in ("apierror", "merged") and f"{kind}:{ident[:8]}:{rest}" in before


def check(with_helper: bool, save: bool = True) -> list[dict]:
    """One check: the findings that are new since the last one."""
    state = load_state()
    before = set(state.get("sessions", [])) | set(state.get("pr", []))
    woken = dict(state.get("woken", {}))  # blocked episodes already woken for: a session that drops out of view
    errors: list[dict] = []
    try:
        found = session_findings()        # (it is out of view for hours) and comes back is the same episode
        state.pop("sessions_crash", None)
    except Exception as e:  # noqa: BLE001 - the sessions table failing must not silence the PR wakes too
        found = {k: {} for k in state.get("sessions", [])}  # what was found before still stands
        kind = type(e).__name__
        if state.get("sessions_crash") != kind:
            state["sessions_crash"] = kind
            errors.append({"key": f"crash:sessions:{kind}", "kind": "crash", "error": f"sessions table: {kind}: {str(e)[:200]}"})
    if state.get("rules") != RULES:  # first run with these rules: a session already waiting is known, not news
        woken.update({k: now() for k in found if k.startswith("blocked:")})
    before |= {k for k in found if moved(k, before)}
    pr: dict[str, dict] = {}
    if with_helper:
        kept = state.get("pr", [])
        pr, failed = pr_findings(state, errors, save)
        if "steward" not in failed:
            state["conflicts"] = state.pop("conflicts_now", [])
        if "steward" in failed:  # what the steward listed before still stands
            pr = {**{k: {} for k in kept if not k.startswith(("merged:", "reminders:"))}, **pr}
        for what in ("merged", "reminders"):
            if what in failed:
                pr = {**{k: {} for k in kept if k.startswith(what + ":")}, **pr}
        before |= {k for k in pr if moved(k, before)}
    new = [{"key": k, **v} for k, v in {**found, **pr}.items()
           if k not in before and v and not (k.startswith("blocked:") and k in woken)] + errors
    woken.update({f["key"]: now() for f in new if f["key"].startswith("blocked:")})
    if save:
        def apply(st: dict) -> None:
            st["sessions"] = sorted(found)
            st["rules"] = RULES
            if "sessions_crash" in state:
                st["sessions_crash"] = state["sessions_crash"]
            else:
                st.pop("sessions_crash", None)
            st["woken"] = {k: t for k, t in woken.items() if now() - t < 7 * 86400}
            if with_helper:
                st["pr"], st["helper_at"], st["errors"] = sorted(pr), int(now()), state.get("errors", {})
                st["conflicts"] = state.get("conflicts", st.get("conflicts", []))
        update_state(apply)
    return new


def summary(f: dict) -> str:
    k = f["kind"]
    if k in ("blocked", "api_error"):
        return f"{k} {f['session']} ({f['minutes']} min)"
    if k == "helper_error":
        return f"helper error ({f.get('what')}{', persisting' if f.get('persisting') else ''}): {f.get('error')}"
    if k == "crash":
        return f"stella-check crashed: {f.get('error')}"
    return f"{k} {f.get('pr') or f.get('key') or f.get('session') or ''}".strip()


def deliver(new: list[dict]) -> int:
    """Keep the wake as pending, log it, print it (the hook's wake carries stderr when there is any), and exit 2."""
    update_state(lambda st: st.__setitem__("pending", {"at": int(now()), "findings": new}))
    log("wake: " + "; ".join(summary(f) for f in new))
    text = "stella-check: " + json.dumps(new)
    print(text)
    print(text, file=sys.stderr)
    return 2


def lock():
    """The watcher's lock, held for its life; None when another watcher holds it."""
    fh = open(store() / "watch.lock", "a+")
    try:
        fcntl.flock(fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        fh.close()
        return None
    beat(fh, now())
    return fh


def beat(fh, since: float) -> None:
    """The lock file reads `pid since heartbeat`; --status trusts a pid only while the heartbeat is recent."""
    fh.seek(0)
    fh.truncate()
    fh.write(f"{os.getpid()} {int(since)} {int(now())}\n")
    fh.flush()


def lock_free() -> bool:
    """True when no watcher holds the lock (the only reliable test: a pid in the file can be stale or reused)."""
    fh = open(store() / "watch.lock", "a+")
    try:
        fcntl.flock(fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
        return True
    except BlockingIOError:
        return False
    finally:
        fh.close()


def take_over() -> None:
    """End a watcher that still holds the lock, left by the previous session process (hooks run detached)."""
    if lock_free():
        return
    old = watcher_pid()
    if old and old[0] != os.getpid():
        try:
            os.kill(old[0], signal.SIGTERM)
        except OSError:
            pass
    for _ in range(50):
        if lock_free():
            return
        time.sleep(0.1)


def stop_watching(*_):
    sys.exit(0)  # raises in the main thread, so run_helper can end the helper it is waiting for


def watch(fresh: bool) -> int:
    if fresh:
        take_over()
    held = lock()
    if held is None:
        return 0
    signal.signal(signal.SIGTERM, stop_watching)
    started = now()
    pending = load_state().get("pending")
    if fresh and isinstance(pending, dict):
        log("redeliver: the last wake was not acknowledged before the restart")
        return deliver(pending.get("findings") or [])
    while now() - started < MAX_LIFE:
        beat(held, started)
        try:
            new = check(with_helper=now() - load_state().get("helper_at", 0) >= HELPER_EVERY)
        except Exception as e:  # noqa: BLE001 - a crash must wake her once, never kill the watcher silently
            kind = type(e).__name__
            if load_state().get("crash") != kind:
                update_state(lambda st: st.__setitem__("crash", kind))
                return deliver([{"key": f"crash:{kind}", "kind": "crash", "error": f"{kind}: {str(e)[:200]}"}])
            time.sleep(POLL * 5)
            continue
        if new:
            if SETTLE:  # findings that arrive together are one wake
                time.sleep(SETTLE)
                try:
                    new += check(with_helper=False)
                except Exception:  # noqa: BLE001 - the first findings still go out
                    pass
            update_state(lambda st: st.pop("crash", None))
            return deliver(new)
        time.sleep(POLL)
    return 0


def ack() -> int:
    update_state(lambda st: st.pop("pending", None))
    return 0


def watcher_pid() -> tuple[int, int] | None:
    """The watcher's pid and start, when its heartbeat is recent and the pid is alive (a hint: lock_free() decides)."""
    try:
        pid, since, last = (int(x) for x in (store() / "watch.lock").read_text().split())
        if now() - last > ALIVE_WITHIN:
            return None
        os.kill(pid, 0)
        return pid, since
    except (OSError, ValueError):
        return None


def status() -> str:
    w = watcher_pid()
    head = f"watcher pid {w[0]}, up {int((now() - w[1]) / 60)} min" if w else "watcher NOT running"
    try:
        updated = json.loads((store() / "pr-tasks.json").read_text()).get("updated", 0)
        prs = f"PR lists {int((now() - updated) / 60)} min old"
    except (OSError, ValueError, AttributeError):
        prs = "no PR lists yet"
    pending = "; a wake is pending" if load_state().get("pending") else ""
    try:
        last = (store() / "events.log").read_text().splitlines()[-1]
    except (OSError, IndexError):
        last = "no events yet"
    return f"{head}; {prs}{pending}; last event: {last[:120]}"


def main() -> int:
    store().mkdir(parents=True, exist_ok=True)
    args = sys.argv[1:]
    if args == []:
        print(json.dumps(check(with_helper=True, save=False), indent=1))
        return 0
    if args == ["--once"]:
        new = check(with_helper=True)
        if new:
            log("wake: " + "; ".join(summary(f) for f in new))
        print(json.dumps(new, indent=1))
        return 0
    if args in (["--watch"], ["--watch", "--fresh"]):
        sys.stdin.close()  # the hook's input
        try:
            return watch(fresh="--fresh" in args)
        except Exception as e:  # noqa: BLE001 - even a failure to start must reach Stella, once
            try:
                return deliver([{"key": "crash:start", "kind": "crash", "error": f"{type(e).__name__}: {str(e)[:200]}"}])
            except Exception:  # noqa: BLE001
                raise e
    if args == ["--ack"]:
        return ack()
    if args == ["--compact-note"]:
        print(json.dumps({"hookSpecificOutput": {"hookEventName": "SessionStart", "additionalContext": COMPACT_NOTE}}))
        return 0
    if args == ["--status"]:
        print(status())
        return 0
    sys.exit(__doc__)


if __name__ == "__main__":
    sys.exit(main())
