#!/usr/bin/env python3
"""stella-check: decide, without a model, when Stella's session needs to wake.

    stella-check            check once: print what is new since the last check (JSON), exit 0
    stella-check --watch    keep checking; exit 2 with what is new, so the hook that started it wakes Stella
    stella-check --status   one line: the watcher's pid and age, and the last line of events.log
    stella-check --compact-note   the SessionStart (compact) hook's answer: redo the start steps after a compaction

Stella's session starts `--watch` from its SessionStart, Stop and StopFailure hooks (asyncRewake), which `stella`
writes into her project settings. Only one watcher runs at a time (a lock in her store); a second exits at once.

What wakes her is what her manual's "When stella-check wakes you" section acts on, and nothing else:
  - a session blocked for 15 minutes (its job record says so and has not moved since);
  - a session stopped on an API error or a rate limit for 5 minutes;
  - each PR helper bucket (approved-prs/approved-prs.py in her store, when it exists): act, orphans,
    unacknowledged, stuck, held, wrong_mode_sessions, and its errors; merged sessions; due reminders.
A finding wakes her once, when it appears; one that stays is not news. One that goes and comes back is news again
(the PR helper drops an item for a while after Stella marks it, then lists it again if it still needs her).

Every check that finds something appends one line to events.log. The PR helper's lasting lists (held, stuck,
unacknowledged, waiting_review) are written to pr-tasks.json, which her status reads.

It runs inside the session's command sandbox: it reads files and runs the PR helper (which calls `gh`); it never
calls `claude` and never messages anyone.

Standard library only.
"""

from __future__ import annotations

import fcntl
import hashlib
import json
import os
import subprocess
import sys
import time
from pathlib import Path

POLL = int(os.environ.get("STELLA_CHECK_POLL", "60"))  # seconds between checks of the job records
HELPER_EVERY = 600  # seconds between runs of the PR helper (it calls gh for every open PR)
BLOCKED_AFTER = 15 * 60
API_ERROR_AFTER = 5 * 60
RECENT = 3 * 3600  # job records older than this are not looked at
MAX_LIFE = 23 * 3600  # exit quietly before the hook's one-day timeout kills it; the next turn's Stop hook restarts it
SELF = ("stella",)
COMPACT_NOTE = ("Your conversation was just compacted. Do the start-of-session steps in your manual again now, and read "
                "pr-tasks.json and the end of events.log in your store before answering anything about PRs or sessions.")


def home() -> Path:
    return Path(os.environ.get("HOME") or Path.home())


def store() -> Path:
    return Path(os.environ.get("STELLA_STORE") or home() / ".local/share/stella")


def now() -> float:
    return time.time()


def jobs() -> list[dict]:
    out = []
    for p in sorted((home() / ".claude/jobs").glob("*/state.json")):
        try:
            d = json.loads(p.read_text())
            d["_id"], d["_mtime"] = p.parent.name, p.stat().st_mtime
        except (OSError, ValueError):
            continue
        if d.get("name") in SELF or now() - d["_mtime"] > RECENT:
            continue
        out.append(d)
    return out


def digest(text: str) -> str:
    return hashlib.sha1(text.encode()).hexdigest()[:10]


def session_findings() -> dict[str, dict]:
    found = {}
    for j in jobs():
        age = now() - j["_mtime"]
        name, jid = j.get("name") or j["_id"], j["_id"]
        needs = str(j.get("needs") or "")
        detail = str(j.get("detail") or "")
        text = f"{needs} {detail}".lower()
        if "api error" in text or "rate limit" in text:
            if age >= API_ERROR_AFTER:
                found[f"apierror:{jid}:{int(j['_mtime'])}"] = {"kind": "api_error", "session": name, "id": jid,
                                                               "minutes": int(age / 60), "detail": (needs or detail)[:200]}
            continue
        if j.get("state") == "blocked" and age >= BLOCKED_AFTER:
            found[f"blocked:{jid}:{digest(needs)}"] = {"kind": "blocked", "session": name, "id": jid,
                                                      "minutes": int(age / 60), "needs": needs[:300]}
    return found


def helper() -> Path:
    return store() / "approved-prs/approved-prs.py"


def run_helper(*args: str) -> dict:
    p = subprocess.run([sys.executable, str(helper()), *args], capture_output=True, text=True, timeout=300)
    if p.returncode:
        raise RuntimeError((p.stderr or p.stdout).strip()[-200:] or f"exit {p.returncode}")
    return json.loads(p.stdout)


def pr_findings() -> dict[str, dict]:
    """The PR helper's buckets as findings; also writes pr-tasks.json. Nothing when the helper is not installed."""
    if not helper().exists():
        return {}
    found: dict[str, dict] = {}
    try:
        s = run_helper("steward")
    except (RuntimeError, ValueError, OSError, subprocess.TimeoutExpired) as e:
        return {"error:steward": {"kind": "helper_error", "what": "steward", "error": str(e)[:200]}}
    keep = {k: s.get(k, []) for k in ("held", "stuck", "unacknowledged", "waiting_review")}
    write_atomic(store() / "pr-tasks.json", json.dumps({"updated": int(now()), **keep}, indent=1) + "\n")
    for it in s.get("act", []):
        if it.get("error"):
            found[f"error:{it.get('repo')}"] = {"kind": "helper_error", "what": it.get("repo"), "error": it["error"][:200]}
        else:
            found[f"act:{it['pr']}:{it.get('signature', '')}"] = {"kind": "act", "pr": it["pr"], "reasons": it.get("reasons"),
                                                                  "owner": (it.get("owner") or {}).get("name")}
    for it in s.get("orphans", []):
        found[f"orphan:{it['pr']}:{it.get('signature', '')}"] = {"kind": "orphan", "pr": it["pr"], "reasons": it.get("reasons")}
    for it in s.get("unacknowledged", []):
        found[f"unack:{it['pr']}:{it.get('told')}"] = {"kind": "unacknowledged", "pr": it["pr"], "told": it.get("told")}
    for it in s.get("stuck", []):
        found[f"stuck:{it['pr']}:{it.get('times')}"] = {"kind": "stuck", "pr": it["pr"], "told": it.get("told")}
    for it in s.get("held", []):
        found[f"held:{it['pr']}:{digest(str(it.get('why')))}"] = {"kind": "held", "pr": it["pr"], "why": it.get("why")}
    for it in s.get("wrong_mode_sessions", []):
        found[f"mode:{it.get('id')}"] = {"kind": "wrong_mode", "session": it.get("name"), "mode": it.get("mode")}
    for what, key in (("merged", "merged"), ("reminders", "due")):
        try:
            r = run_helper(what)
        except (RuntimeError, ValueError, OSError, subprocess.TimeoutExpired) as e:
            found[f"error:{what}"] = {"kind": "helper_error", "what": what, "error": str(e)[:200]}
            continue
        for it in r.get(key, []):
            ident = it.get("key") or it.get("id") or it.get("session") or json.dumps(it, sort_keys=True)
            found[f"{what}:{ident}:{it.get('signature', '')}"] = {"kind": what, **it}
    return found


def write_atomic(path: Path, text: str) -> None:
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(text)
    tmp.replace(path)


def load_state() -> dict:
    try:
        return json.loads((store() / "check-state.json").read_text())
    except (OSError, ValueError):
        return {}


def log(line: str) -> None:
    with open(store() / "events.log", "a") as f:
        f.write(time.strftime("%Y-%m-%d %H:%M:%S ") + line + "\n")


def check(with_helper: bool) -> list[dict]:
    """One check: the findings that are new since the last one. Keeps the PR helper's findings between its runs."""
    state = load_state()
    found = session_findings()
    seen_pr = state.get("pr", {})
    if with_helper:
        pr = pr_findings()
        state["pr"], state["helper_at"] = sorted(pr), int(now())
    else:
        pr = {k: {} for k in seen_pr}
    previous = set(state.get("sessions", [])) | set(seen_pr)
    new = [{"key": k, **v} for k, v in {**found, **pr}.items() if k not in previous and v]
    state["sessions"] = sorted(found)
    write_atomic(store() / "check-state.json", json.dumps(state, indent=1) + "\n")
    if new:
        log("wake: " + "; ".join(summary(f) for f in new))
    return new


def summary(f: dict) -> str:
    k = f["kind"]
    if k in ("blocked", "api_error"):
        return f"{k} {f['session']} ({f['minutes']} min)"
    if k == "wrong_mode":
        return f"wrong_mode {f.get('session')}"
    if k == "helper_error":
        return f"helper error ({f.get('what')}): {f.get('error')}"
    return f"{k} {f.get('pr') or f.get('key') or f.get('session') or ''}".strip()


def helper_due() -> bool:
    return now() - load_state().get("helper_at", 0) >= HELPER_EVERY


def lock():
    """The watcher's lock, held for its life; None when another watcher holds it."""
    fh = open(store() / "watch.lock", "a+")
    try:
        fcntl.flock(fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        fh.close()
        return None
    fh.seek(0)
    fh.truncate()
    fh.write(f"{os.getpid()} {int(now())}\n")
    fh.flush()
    return fh


def watch() -> int:
    held = lock()
    if held is None:
        return 0
    started = now()
    while now() - started < MAX_LIFE:
        new = check(with_helper=helper_due())
        if new:
            print("stella-check: " + json.dumps(new))
            return 2
        time.sleep(POLL)
    return 0


def status() -> str:
    try:
        pid, since = (store() / "watch.lock").read_text().split()
    except (OSError, ValueError):
        pid, since = "", "0"
    alive = False
    if pid:
        fh = open(store() / "watch.lock", "a+")
        try:
            fcntl.flock(fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
            fcntl.flock(fh, fcntl.LOCK_UN)
        except BlockingIOError:
            alive = True
        fh.close()
    try:
        last = (store() / "events.log").read_text().splitlines()[-1]
    except (OSError, IndexError):
        last = "no events yet"
    w = f"watcher pid {pid}, up {int((now() - int(since)) / 60)} min" if alive else "watcher NOT running"
    return f"{w}; last event: {last[:120]}"


def main() -> int:
    store().mkdir(parents=True, exist_ok=True)
    args = sys.argv[1:]
    if args in ([], ["--once"]):
        print(json.dumps(check(with_helper=True), indent=1))
        return 0
    if args == ["--watch"]:
        sys.stdin.close()  # the hook's input
        return watch()
    if args == ["--compact-note"]:
        print(json.dumps({"hookSpecificOutput": {"hookEventName": "SessionStart", "additionalContext": COMPACT_NOTE}}))
        return 0
    if args == ["--status"]:
        print(status())
        return 0
    sys.exit(__doc__)


if __name__ == "__main__":
    sys.exit(main())
