#!/usr/bin/env bash
#
# claude-tmux-ready — mark the calling tmux pane as waiting on you, or clear it.
#
#   claude-tmux-ready set     Claude is done and wants input
#   claude-tmux-ready clear   Claude is working, or the session ended
#
# Driven by Claude Code hooks (Stop / Notification / UserPromptSubmit /
# SessionEnd) in ~/.claude/settings.json. It sets a pane-scoped @claude_ready
# option that ~/.tmux.conf reads to draw the ✳ marker on the tab and the pane
# border.
#
# Why a hook and not the pane title: Claude Code used to animate ◐/◑ in its
# terminal title while busy and fall back to ✳ when idle, so matching ✳ in
# pane_title meant "waiting on you". As of 1.9.0 it suppresses that animation
# under a multiplexer and emits a constant "✳ <title>" the whole time it runs,
# so the title no longer says anything about state. This does.
#
# Never fails: a hook that exits non-zero is noise in the transcript, and a
# missing marker is not worth interrupting anyone over.
#
# TEMPORARY: while the marker is being debugged, every invocation appends what
# it saw to $LOG — the action, the pane, whether tmux accepted the option, and
# how the two formats render. Delete the `log` calls once it's confirmed working.

set -u

readonly OPT='@claude_ready'
readonly LOG="${TMPDIR:-/tmp}/claude-tmux-ready.log"

log() { printf '%s | %s\n' "$(date '+%H:%M:%S')" "$*" >>"$LOG" 2>/dev/null || true; }

action="${1:-<none>}"

if [[ -z "${TMUX:-}" || -z "${TMUX_PANE:-}" ]]; then
    log "$action | NO TMUX ENV: TMUX='${TMUX:-}' TMUX_PANE='${TMUX_PANE:-}'"
    exit 0
fi
if ! command -v tmux >/dev/null 2>&1; then
    log "$action | tmux not on PATH (PATH=$PATH)"
    exit 0
fi

case "$action" in
    set)
        tmux set-option -p -t "$TMUX_PANE" "$OPT" 1 2>/dev/null
        rc=$?
        ;;
    clear)
        tmux set-option -p -u -t "$TMUX_PANE" "$OPT" 2>/dev/null
        rc=$?
        ;;
    *)
        printf 'usage: %s set|clear\n' "${0##*/}" >&2
        log "$action | bad usage"
        exit 0
        ;;
esac

# Read the option back and render both formats, so the log says whether the
# option landed AND whether tmux's own expansion produces a marker from it.
readback="$(tmux show-options -p -t "$TMUX_PANE" "$OPT" 2>&1)"
tab="$(tmux display-message -p -t "$TMUX_PANE" '#{E:@pane_ready}' 2>&1)"
lbl="$(tmux display-message -p -t "$TMUX_PANE" '#{E:@lbl_active}' 2>&1)"
loop="$(tmux display-message -p -t "$TMUX_PANE" '#{P:[#{pane_index}=#{@claude_ready}]}' 2>&1)"
log "$action | pane=$TMUX_PANE set_rc=$rc | readback='$readback' | tab='$tab' | label='$lbl' | loop='$loop'"

exit 0
