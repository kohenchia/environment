#!/usr/bin/env python3
"""fg-probes: check, once, the platform facts the foreground-sessions plan rests on.

    fg-probes [--only P1,P3] [--out DIR] [--keep]
    fg-probes --clean            end anything a killed or --keep run left behind

A sandboxed Claude session cannot start `claude` or reach herdr, so Kohen runs this once, in any terminal. It never
touches his own windows or sessions:

  * the probes that need only a foreground `claude` (P1 messaging, P2 end and resume, P5 agent view off, P6 idle
    status and the Stop hook) start small throwaway sessions (`fg-probe-*`, on Haiku) under a pseudo-terminal this
    script owns, in ~/github, each behind a small parent process as a window's shell would be;
  * the probes that need herdr (P3 restore and how a window ended, P4 following a move, P6 detached processes and
    agent detection) run in a throwaway herdr session named `probe`, with its own config, which is stopped and deleted
    at the end. Every herdr call goes to that session's socket; this script never stops any other server.

Results go to ~/.local/state/fg-probes/<time>/ (summary.md, results.json, one log per probe). It prints a table:
PASS, FAIL (with what was seen) or SKIP (a fact recorded, not judged, or a check that cannot run yet). It takes about
15 minutes. Closing the terminal or Ctrl+C still ends everything it started; `--keep` waits for Enter before it does,
so the probe sessions can be looked at, and `--clean` ends whatever a killed run left.

Internal modes, used inside the probe herdr session and by the probes: `fg-probes stand-in NAME`,
`fg-probes restored NAME DIR`, `fg-probes detach-test NAME`, `fg-probes wrap [--pidfile F] -- CMD...`.

Standard library only.
"""

from __future__ import annotations

import argparse
import calendar
import ctypes
import fcntl
import json
import os
import pty
import re
import select
import signal
import socket
import struct
import subprocess
import sys
import termios
import threading
import time
import uuid
from pathlib import Path

HOME = Path.home()
SESSIONS = HOME / ".claude" / "sessions"
PROJECTS = HOME / ".claude" / "projects"
JOBS = HOME / ".claude" / "jobs"
STATE = HOME / ".local" / "state" / "fg-probes"
CRONS = HOME / ".local" / "state" / "cy" / "crons"  # where the plan's Stop hook will write
WORKDIR = HOME / "github"  # an already trusted folder, so no trust dialog appears
ME = os.path.realpath(__file__)
PROBE_SESSION = "probe"
MODEL = "haiku"
PREFIX = "fg-probe"
SUBSCRIBE = {"subscriptions": [{"type": "pane.moved"}]}


class Interrupted(Exception):
    """Raised by a closed terminal or a SIGTERM, so the cleanup in main still runs."""


# ── small helpers ───────────────────────────────────────────────────────────────────────────────────────────────


def now() -> float:
    return time.time()


def wait_for(pred, timeout: float, every: float = 1.0):
    """Call pred until it returns something truthy or the time is up; return the last value."""
    end = now() + timeout
    while True:
        value = pred()
        if value or now() >= end:
            return value
        time.sleep(every)


def alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


def started_at(pid: int) -> float | None:
    """A process's start time in epoch seconds (macOS libproc), so a recycled pid is never mistaken for it."""
    try:
        lib = ctypes.CDLL("/usr/lib/libproc.dylib")
    except OSError:
        return None
    buf = ctypes.create_string_buffer(136)  # struct proc_bsdinfo
    if lib.proc_pidinfo(ctypes.c_int(pid), ctypes.c_int(3), ctypes.c_uint64(0), buf, ctypes.c_int(136)) != 136:
        return None
    return float(struct.unpack_from("Q", buf.raw, 120)[0])  # pbi_start_tvsec


def as_epoch(start) -> float | None:
    """A start time as epoch seconds: a number, or a registry `procStart` string (UTC, "Fri Oct 30 02:08:17 2026")."""
    if isinstance(start, (int, float)):
        return float(start)
    if isinstance(start, str) and start.strip():
        try:
            return float(calendar.timegm(time.strptime(" ".join(start.split()), "%a %b %d %H:%M:%S %Y")))
        except ValueError:
            return None
    return None


def same_process(pid: int, start) -> bool:
    began, want = started_at(pid), as_epoch(start)
    return began is not None and want is not None and alive(pid) and abs(began - want) < 2


def signal_if_same(pid: int, start, sig=signal.SIGTERM) -> bool:
    if not same_process(pid, start):
        return False
    try:
        os.kill(pid, sig)
        return True
    except ProcessLookupError:
        return False


def registry() -> list[dict]:
    """Claude's registry of live processes (a killed process leaves its file behind, so check the pid)."""
    rows = []
    for f in SESSIONS.glob("*.json"):
        try:
            d = json.loads(f.read_text())
        except (OSError, ValueError):
            continue
        if isinstance(d.get("pid"), int) and alive(d["pid"]):
            rows.append(d)
    return rows


def find_session(name: str | None = None, sid: str | None = None, rows: list[dict] | None = None) -> dict | None:
    for d in rows if rows is not None else registry():
        if (name is None or d.get("name") == name) and (sid is None or d.get("sessionId") == sid):
            return d
    return None


def transcript(sid: str | None) -> Path | None:
    if not sid:
        return None
    hits = sorted(PROJECTS.glob(f"*/{sid}.jsonl"))
    return hits[0] if hits else None


def records(path: Path | None) -> list[dict]:
    if not path or not path.exists():
        return []
    out = []
    for line in path.read_text(errors="replace").splitlines():
        try:
            out.append(json.loads(line))
        except ValueError:
            pass
    return out


def peer_messages(recs: list[dict]) -> list[dict]:
    """Messages another session sent this one (not a subagent's hand-back)."""
    out = []
    for r in recs:
        o = r.get("origin") or {}
        if o.get("kind") == "peer" and not o.get("senderTaskId"):
            out.append({"from": o.get("name"), "mode": o.get("fromMode"), "body": (o.get("body") or "")[:200]})
    return out


def tool_uses(recs: list[dict], name: str) -> list[dict]:
    out = []
    for r in recs:
        for c in (r.get("message") or {}).get("content") or []:
            if isinstance(c, dict) and c.get("type") == "tool_use" and c.get("name") == name:
                out.append(c)
    return out


def assistant_text(recs: list[dict]) -> str:
    parts = []
    for r in recs:
        if r.get("type") != "assistant":
            continue
        for c in (r.get("message") or {}).get("content") or []:
            if isinstance(c, dict) and c.get("type") == "text":
                parts.append(c.get("text", ""))
    return "\n".join(parts)


def replies(recs: list[dict]) -> int:
    return sum(1 for r in recs if r.get("type") == "assistant" and not r.get("isSidechain"))


def probe_jobs(job_ids, sid: str | None) -> list[str]:
    """Of these job directories, the ones a probe made: named fg-probe-*, or tied to the probe's conversation.

    Any other job that appeared meanwhile is Kohen's or Stella's and is never touched."""
    mine = []
    for j in job_ids:
        try:
            text = (JOBS / j / "state.json").read_text()
            d = json.loads(text)
        except (OSError, ValueError):
            continue
        if str(d.get("name") or "").startswith(PREFIX) or (sid and sid in text):
            mine.append(j)
    return mine


def hup_verdict(answered: bool, returncode: int | None, said: str) -> str:
    """How the window loop will tell a closed window from a stopped server when it gets SIGHUP."""
    low = said.lower()
    if (not answered or "server_not_running" in low or "server_unavailable" in low or "shutting down" in low
            or "not running" in low or "connection refused" in low):
        return "interrupted"
    if returncode != 0 or "not found" in low or "no such" in low or "pane_not_found" in low:
        return "closed"
    return "pane still there"


def clean_env() -> dict:
    """The environment for anything this script starts: nothing that points at Kohen's own herdr window or server."""
    env = {k: v for k, v in os.environ.items() if not k.startswith("HERDR_") and k != "CLAUDECODE"}
    if env.get("TERM_PROGRAM") == "herdr":
        del env["TERM_PROGRAM"]
    return env


# ── a foreground claude under a pseudo-terminal ───────────────────────────────────────────────────────────────


class Probe:
    """One throwaway foreground `claude`, run as a herdr window would: a parent process in front, a sized terminal."""

    def __init__(self, name: str, args: list[str], out: Path, env: dict | None = None, cwd: Path = WORKDIR,
                 exclude: set[int] | None = None):
        self.name = name
        self.log = out / f"{name}.screen.log"
        self.pidfile = out / f"{name}.{uuid.uuid4().hex[:6]}.launcher.pid"
        self.exclude = set(exclude or ())
        self.sid = None
        self.status = None
        child_env = dict(clean_env(), **(env or {}))
        self.pid, self.fd = pty.fork()
        if self.pid == 0:
            try:
                os.chdir(cwd)
                os.execve(sys.executable, [sys.executable, ME, "wrap", "--pidfile", str(self.pidfile), "--",
                                           "claude", *args], child_env)
            finally:
                os._exit(127)
        fcntl.ioctl(self.fd, termios.TIOCSWINSZ, struct.pack("HHHH", 50, 200, 0, 0))
        self.screen = ""
        self._stop = False
        self._lock = threading.Lock()
        threading.Thread(target=self._drain, daemon=True).start()

    def _drain(self):
        with open(self.log, "ab") as f:
            while not self._stop:
                try:
                    r, _, _ = select.select([self.fd], [], [], 0.5)
                    if not r:
                        continue
                    data = os.read(self.fd, 65536)
                except OSError:
                    return
                if not data:
                    return
                f.write(data)
                self.screen = (self.screen + data.decode(errors="replace"))[-20000:]
                if re.search(r"Do you trust the files in this folder", self.screen):
                    self.screen = ""
                    self._write(b"\r")  # accept the default "Yes, proceed"

    def _write(self, data: bytes):
        with self._lock:
            os.write(self.fd, data)

    def send(self, text: str):
        """Type a prompt, then Enter on its own, so the input box sees typing rather than a paste."""
        self._write(text.encode())
        time.sleep(0.4)
        self._write(b"\r")

    def key(self, seq: bytes):
        self._write(seq)

    def launcher_pid(self) -> int | None:
        try:
            return int(self.pidfile.read_text())
        except (OSError, ValueError):
            return None

    def row(self) -> dict | None:
        """This probe's registry row: named as asked (or holding its conversation), not an older process."""
        for d in registry():
            if d.get("pid") in self.exclude:
                continue
            if d.get("name") == self.name or (self.sid and d.get("sessionId") == self.sid):
                self.sid = d.get("sessionId") or self.sid
                return d
        return None

    def replies(self) -> int:
        return replies(records(transcript(self.sid)))

    def wait_ready(self, timeout: float = 180) -> bool:
        """The first turn (the prompt on the command line) is answered and the session is idle."""
        time.sleep(3)
        return bool(wait_for(lambda: (self.row() or {}).get("status") == "idle" and self.replies() >= 1, timeout, 2))

    def ask(self, text: str, timeout: float = 180) -> bool:
        """Send a prompt and wait for a new reply and an idle session."""
        base = self.replies()
        self.send(text)
        time.sleep(3)
        return bool(wait_for(lambda: self.replies() > base and (self.row() or {}).get("status") == "idle", timeout, 2))

    def exited(self) -> bool:
        try:
            done, _ = os.waitpid(self.pid, os.WNOHANG)
            return bool(done)
        except ChildProcessError:
            return True

    def end(self, sig=signal.SIGTERM, timeout: float = 20) -> float | None:
        """Signal the launcher (as the plan's restart will), then wait for the window's process to end."""
        t0 = now()
        if self.exited():
            self._stop = True
            return 0.0
        target = self.launcher_pid() or self.pid  # the wrapper is alive, so its child's pid is not recycled yet
        try:
            os.kill(target, sig)
        except ProcessLookupError:
            pass
        end = now() + timeout
        while now() < end:
            if self.exited():
                self._stop = True
                return now() - t0
            time.sleep(0.1)
        return None

    def kill(self):
        try:
            os.killpg(self.pid, signal.SIGKILL)
        except (ProcessLookupError, PermissionError):
            pass
        self.exited()
        self._stop = True


def claude_args(name: str, prompt: str | None = None, *, mode: str = "bypassPermissions", settings: dict | None = None,
                extra: list[str] | None = None) -> list[str]:
    a = ["-n", name, "--model", MODEL, "--permission-mode", mode]
    if settings:
        a += ["--settings", json.dumps(settings)]
    a += extra or []
    if prompt:
        a.append(prompt)
    return a


# ── results ─────────────────────────────────────────────────────────────────────────────────────────────────────


class Results:
    def __init__(self, out: Path):
        self.out = out
        self.rows: list[dict] = []

    def add(self, probe: str, check: str, ok: bool | None, seen: str = ""):
        status = "SKIP" if ok is None else ("PASS" if ok else "FAIL")
        self.rows.append({"probe": probe, "check": check, "status": status, "seen": seen})
        print(f"  {status:4}  {probe} · {check}" + (f"  ({seen})" if seen else ""), flush=True)

    def table(self) -> str:
        lines = ["| Probe | Check | Result | Seen |", "|---|---|---|---|"]
        for r in self.rows:
            seen = r["seen"].replace("|", "\\|").replace("\n", " ")
            lines.append(f"| {r['probe']} | {r['check'].replace('|', chr(92) + '|')} | {r['status']} | {seen} |")
        return "\n".join(lines)

    def save(self):
        (self.out / "results.json").write_text(json.dumps(self.rows, indent=2))
        counts = {s: sum(1 for r in self.rows if r["status"] == s) for s in ("PASS", "FAIL", "SKIP")}
        head = f"# fg-probes, {time.strftime('%Y-%m-%d %H:%M')}\n\n{counts['PASS']} pass · {counts['FAIL']} fail · {counts['SKIP']} skip\n\n"
        (self.out / "summary.md").write_text(head + self.table() + "\n")
        return counts


# ── P1 messaging ────────────────────────────────────────────────────────────────────────────────────────────────

REPLY = ("You are a throwaway test probe. Do nothing now and end your turn. Whenever a message from another session "
         "arrives, reply to that session with the SendMessage tool, text 'pong from {name}', and do nothing else.")


def from_peer(probe: Probe, sender: str):
    return [m for m in peer_messages(records(transcript(probe.sid))) if m["from"] == sender]


def p1(res: Results, out: Path, cleanup: list):
    a = Probe(f"{PREFIX}-a", claude_args(f"{PREFIX}-a", REPLY.format(name=f"{PREFIX}-a")), out)
    cleanup.append(a)
    if not a.wait_ready():
        res.add("P1", "a foreground probe starts", False, f"see {a.log.name}")
        return
    # a background session in bypass mode sends to the foreground one
    bg_name = f"{PREFIX}-bg"
    cleanup.append(("job", bg_name))
    p = subprocess.run(["claude", "--bg", "-n", bg_name, "--model", MODEL, "--dangerously-skip-permissions", "--",
                        f"You are a throwaway test probe. Use the SendMessage tool to send 'ping from {bg_name}' to "
                        f"the session named {PREFIX}-a. Then end your turn."],
                       cwd=WORKDIR, capture_output=True, text=True, timeout=120, env=clean_env())
    got = wait_for(lambda: from_peer(a, bg_name), 180, 3)
    res.add("P1", "background (bypass) → foreground (bypass) arrives as a turn", bool(got),
            json.dumps(got[:1]) if got else (p.stdout + p.stderr)[-200:])
    bg = find_session(name=bg_name)
    bg_got = wait_for(lambda: [m for m in peer_messages(records(transcript(bg["sessionId"]))) if m["from"] == a.name]
                      if bg else [], 120, 3)
    res.add("P1", "foreground replies to the background session", bool(bg_got), json.dumps(bg_got[:1]) if bg_got else "")
    stop_job(bg_name)  # P1 is the only probe that needs it
    # foreground → foreground
    b = Probe(f"{PREFIX}-b", claude_args(f"{PREFIX}-b", f"You are a throwaway test probe. Use the SendMessage tool to "
              f"send 'ping from {PREFIX}-b' to the session named {PREFIX}-a, then end your turn. If a message "
              f"arrives later, do nothing."), out)
    cleanup.append(b)
    got = wait_for(lambda: from_peer(a, b.name) if b.row() else [], 180, 3)
    res.add("P1", "foreground → foreground arrives", bool(got), json.dumps(got[:1]) if got else "")
    back = wait_for(lambda: from_peer(b, a.name), 120, 3)
    res.add("P1", "foreground → foreground reply arrives", bool(back), json.dumps(back[:1]) if back else "")
    # with crossSessionInbound: accept, bypass → default is delivered, and so is default → bypass
    accept = {"crossSessionInbound": "accept"}
    c = Probe(f"{PREFIX}-c", claude_args(f"{PREFIX}-c", REPLY.format(name=f"{PREFIX}-c"), mode="default",
              settings=accept, extra=["--allowedTools", "SendMessage"]), out)
    cleanup.append(c)
    c.wait_ready()
    d = Probe(f"{PREFIX}-d", claude_args(f"{PREFIX}-d", f"You are a throwaway test probe. Use the SendMessage tool to "
              f"send 'ping from {PREFIX}-d' to the session named {PREFIX}-c, then end your turn.", settings=accept), out)
    cleanup.append(d)
    got = wait_for(lambda: from_peer(c, d.name) if d.row() else [], 180, 3)
    res.add("P1", "bypass → default-mode receiver, with accept", bool(got), json.dumps(got[:1]) if got else "")
    back = wait_for(lambda: from_peer(d, c.name), 120, 3)
    res.add("P1", "default-mode sender → bypass receiver, with accept", bool(back), json.dumps(back[:1]) if back else "")


# ── P2 end and resume ───────────────────────────────────────────────────────────────────────────────────────────


def p2(res: Results, out: Path, cleanup: list):
    sid = str(uuid.uuid4())
    name = f"{PREFIX}-r"
    r = Probe(name, claude_args(name, "You are a throwaway test probe. Reply with the single word ready.",
              extra=["--session-id", sid]), out)
    cleanup.append(r)
    r.sid = sid
    ok = r.wait_ready()
    row = r.row()
    res.add("P2", "--session-id starts a session with that id", bool(row and row.get("sessionId") == sid),
            f"registry sessionId {row and row.get('sessionId')}")
    launched = {"first": r.launcher_pid()}
    reg_pid = row.get("pid") if row else None
    before = len(records(transcript(sid)))
    took = r.end(signal.SIGTERM)
    t_exit = now()
    res.add("P2", "SIGTERM to the launcher ends the session", took is not None, f"window process gone after {took} s")
    lingered = None
    if reg_pid:
        wait_for(lambda: not alive(reg_pid), 30, 0.1)
        lingered = round(now() - t_exit, 2)
    res.add("P2", "how long the old registry pid outlives the launcher (measured)", None,
            f"registry pid {reg_pid}: {lingered} s{' (still alive at 30 s)' if reg_pid and alive(reg_pid) else ''}")
    after = len(records(transcript(sid)))
    res.add("P2", "transcript intact after SIGTERM", ok and after >= before, f"{before} → {after} records")
    r2 = Probe(name, claude_args(name, "Reply with the single word again.", extra=["--resume", sid]), out,
               exclude={reg_pid} if reg_pid else None)
    cleanup.append(r2)
    r2.sid = sid
    base = replies(records(transcript(sid)))
    resumed = wait_for(lambda: (r2.row() or {}).get("status") == "idle" and r2.replies() > base, 180, 2)
    row2 = r2.row()
    new_pid = bool(row2 and row2.get("pid") != reg_pid)
    res.add("P2", "--resume keeps the conversation id (a new process, a new reply)",
            bool(resumed and new_pid and row2.get("sessionId") == sid), f"sessionId {row2 and row2.get('sessionId')}")
    res.add("P2", "--resume with -n keeps the name", bool(row2 and row2.get("name") == name), f"name {row2 and row2.get('name')}")
    launched["resumed"] = r2.launcher_pid()
    sid2 = str(uuid.uuid4())
    fork = Probe(f"{name}2", claude_args(f"{name}2", "Reply with the single word copy.",
                 extra=["--resume", sid, "--fork-session", "--session-id", sid2]), out)
    cleanup.append(fork)
    fork.sid = sid2
    fork.wait_ready()
    rowf = fork.row()
    res.add("P2", "--resume --fork-session --session-id gives the copy that id", bool(rowf and rowf.get("sessionId") == sid2),
            f"sessionId {rowf and rowf.get('sessionId')}")
    (out / "P2-launched-pids.json").write_text(json.dumps(launched))
    res.add("P2", "token line of each launched pid (read after the run)", None, f"launcher pids {launched}")


# ── P5 agent view off ───────────────────────────────────────────────────────────────────────────────────────────


def jobs_now() -> set[str]:
    return {p.name for p in JOBS.iterdir()} if JOBS.exists() else set()


def p5(res: Results, out: Path, cleanup: list):
    off = {"disableAgentView": True}
    w = Probe(f"{PREFIX}-w", claude_args(f"{PREFIX}-w", REPLY.format(name=f"{PREFIX}-w")), out)
    cleanup.append(w)
    w.wait_ready()
    v = Probe(f"{PREFIX}-v", claude_args(f"{PREFIX}-v", "You are a throwaway test probe. Reply with the single word ready.",
              settings=off), out)
    cleanup.append(v)
    if not v.wait_ready():
        res.add("P5", "a probe with the agent view off starts", False, f"see {v.log.name}")
        return
    jobs0 = jobs_now()
    v.key(b"\x1b[D")  # ← on an empty prompt
    time.sleep(10)
    row = v.row()
    parked = (row or {}).get("parkedJobId")
    new_mine = probe_jobs(jobs_now() - jobs0, v.sid)
    for j in set(new_mine + ([parked] if parked else [])):
        cleanup.append(("jobid", j))
    still = bool(row) and not parked and not v.exited() and not new_mine
    res.add("P5", "← does not park the session into a job", still,
            f"parkedJobId {parked}, probe jobs created {new_mine}, process alive {not v.exited()}")
    if not still:
        return  # the rest would type into the agents view or a parked session
    v.ask(f"Call the ListAgents tool, then use the SendMessage tool to send 'ping from {PREFIX}-v' to the session named "
          f"{PREFIX}-w, then reply with the number of peer sessions ListAgents listed.")
    recs = records(transcript(v.sid))
    res.add("P5", "ListAgents works with the view off", bool(tool_uses(recs, "ListAgents")), "")
    got = wait_for(lambda: from_peer(w, v.name), 120, 3)
    res.add("P5", "SendMessage out works with the view off", bool(got), "")
    back = wait_for(lambda: from_peer(v, w.name), 120, 3)
    res.add("P5", "SendMessage in works with the view off", bool(back), "")
    v.ask("Use the Agent tool with run_in_background true and model haiku, asking it to reply with the words sub done. "
          "Wait for it to finish, then reply with the word finished.", 240)
    recs = records(transcript(v.sid))
    notes = [r for r in recs if (r.get("origin") or {}).get("kind") == "task-notification"]
    res.add("P5", "background agents run with the view off", bool(tool_uses(recs, "Agent")) and bool(notes),
            f"{len(tool_uses(recs, 'Agent'))} Agent calls, {len(notes)} notifications")
    jobs1 = jobs_now()
    v.ask("/fork reply with the single word forked", 90)
    time.sleep(10)
    made = probe_jobs(jobs_now() - jobs1, v.sid)
    for j in made:
        cleanup.append(("jobid", j))
    others = sorted(jobs_now() - jobs1 - set(made))
    res.add("P5", "/fork with the view off makes no background job", not made,
            f"probe jobs {made or 'none'}; other new jobs left alone: {others or 'none'}; see {v.log.name}")
    old_pid = (v.row() or {}).get("pid")
    sid = v.sid
    v.end()
    base = replies(records(transcript(sid)))
    v2 = Probe(f"{PREFIX}-v", claude_args(f"{PREFIX}-v", "Reply with the single word back.", settings=off,
               extra=["--resume", sid]), out, exclude={old_pid} if old_pid else None)
    cleanup.append(v2)
    v2.sid = sid
    ok = wait_for(lambda: (v2.row() or {}).get("status") == "idle" and v2.replies() > base, 180, 2)
    row = v2.row()
    res.add("P5", "--resume works with the view off", bool(ok and row and row.get("pid") != old_pid
                                                            and row.get("sessionId") == sid), "")


# ── P6 idle status, crons and the Stop hook ─────────────────────────────────────────────────────────────────────


def hook_inputs(prefix: str) -> list[dict]:
    out = []
    for f in sorted(CRONS.glob(f"{prefix}-*.json")):
        try:
            out.append(json.loads(f.read_text()))
        except (OSError, ValueError):
            pass
    return out


def p6_claude(res: Results, out: Path, cleanup: list):
    CRONS.mkdir(parents=True, exist_ok=True)
    tag = f"{PREFIX}-{uuid.uuid4().hex[:6]}"
    cleanup.append(("glob", str(CRONS / f"{tag}-*.json")))
    hook = {"hooks": {"Stop": [{"hooks": [{"type": "command",
                                           "command": f"cat > \"{CRONS}/{tag}-$(date +%s%N).json\"; exit 0"}]}]}}
    s = Probe(f"{PREFIX}-s", claude_args(f"{PREFIX}-s", "You are a throwaway test probe. Reply with the single word ready.",
              settings=hook), out)
    cleanup.append(s)
    s.wait_ready()
    files = wait_for(lambda: hook_inputs(tag), 30)
    res.add("P6", "a sandboxed Stop hook can write ~/.local/state/cy/crons/", bool(files), f"{len(files)} hook inputs")
    s.ask("/loop 2m reply with the single word tick")
    seen = set()
    end = now() + 50
    while now() < end:
        row = s.row()
        if row:
            seen.add(row.get("status"))
        time.sleep(2)
    res.add("P6", "registry reads idle between /loop ticks", "idle" in seen and "busy" not in seen, f"statuses {sorted(seen)}")
    latest = (hook_inputs(tag) or [{}])[-1]
    crons = latest.get("session_crons")
    res.add("P6", "the Stop hook input lists the loop's wakeup in session_crons", bool(crons), json.dumps(crons)[:200])
    # Esc during a tick: does the Stop hook run? (recorded, not judged)
    n_before = len(hook_inputs(tag))
    busy = wait_for(lambda: (s.row() or {}).get("status") == "busy", 150, 1)
    if busy:
        s.key(b"\x1b")
        time.sleep(8)
    n_after = len(hook_inputs(tag))
    res.add("P6", "the Stop hook on a turn stopped with Esc (recorded)", None,
            f"hook inputs {n_before} → {n_after}" if busy else "no tick started in time")
    s.wait_ready(60)
    s.send("Run the shell command `sleep 45` with run_in_background set to true, then end your turn immediately.")
    shell = wait_for(lambda: (s.row() or {}).get("status") == "shell", 60, 1)  # not `ask`: it waits for idle
    res.add("P6", "a background command reads shell", bool(shell), "")
    s.ask("Use the Monitor tool to watch the output of the shell command `sleep 40; echo done`, then end your turn.", 60)
    monitor = bool(tool_uses(records(transcript(s.sid)), "Monitor"))
    mshell = wait_for(lambda: (s.row() or {}).get("status") == "shell", 30, 1) if monitor else None
    res.add("P6", "a running Monitor reads shell", bool(mshell) if monitor else None,
            "" if monitor else "the probe did not call the Monitor tool")
    res.add("P6", "a follower started detached by kc-new survives the asking session's restart", None,
            "needs kc-new to start the follower (branch B3); checked by acceptance A1")


# ── herdr: a throwaway session named `probe` ────────────────────────────────────────────────────────────────────


class Herdr:
    """Every call goes to the `probe` session's socket. There is deliberately no way to stop any other server."""

    def __init__(self, out: Path):
        self.out = out
        self.config = out / "herdr-probe.toml"
        self.config.write_text("[session]\nresume_agents_on_restore = true\nstartup_per_agent_delay_ms = 100\n")
        self.sock = None
        self.server = None

    @staticmethod
    def sessions() -> list[dict] | None:
        """herdr's named sessions, or None when its answer cannot be read (then nothing herdr runs)."""
        p = subprocess.run(["herdr", "session", "list", "--json"], capture_output=True, text=True, timeout=30,
                           env=clean_env())
        try:
            return json.loads(p.stdout).get("sessions", [])
        except (ValueError, AttributeError):
            return None

    def start(self) -> bool:
        """Start the probe session's server, with this script's folder on PATH so a restored pane finds fg-probes."""
        env = dict(clean_env(), HERDR_CONFIG_PATH=str(self.config),
                   PATH=f"{os.path.dirname(ME)}:{os.environ.get('PATH', '')}")
        log = open(self.out / "herdr-probe-server.log", "ab")
        self.server = subprocess.Popen(["herdr", "--session", PROBE_SESSION, "server"], env=env, stdout=log,
                                       stderr=log, stdin=subprocess.DEVNULL, start_new_session=True)
        log.close()
        s = wait_for(lambda: next((x for x in (self.sessions() or []) if x.get("name") == PROBE_SESSION
                                   and x.get("socket_path") and os.path.exists(x["socket_path"])), None), 30)
        self.sock = s["socket_path"] if s else None
        return bool(self.sock) and self.call("workspace", "list").returncode == 0

    def call(self, *args: str, timeout: float = 30) -> subprocess.CompletedProcess:
        if "server" in args or "session" in args[:1]:
            raise RuntimeError("fg-probes never manages a herdr server or session through the socket")
        env = dict(clean_env(), HERDR_SOCKET_PATH=self.sock or "/nonexistent")
        p = subprocess.run(["herdr", *args], env=env, capture_output=True, text=True, timeout=timeout)
        with open(self.out / "herdr-calls.log", "a") as f:
            f.write(f"$ herdr {' '.join(args)}\n{p.returncode} {p.stdout[-2000:]}{p.stderr[-1000:]}\n")
        return p

    def js(self, *args: str) -> dict:
        p = self.call(*args)
        try:
            return json.loads(p.stdout)
        except ValueError:
            return {"error": (p.stderr or p.stdout).strip()[-300:], "returncode": p.returncode}

    def stop_session(self):
        subprocess.run(["herdr", "session", "stop", PROBE_SESSION], capture_output=True, text=True, timeout=60,
                       env=clean_env())
        if self.server:
            try:
                self.server.wait(timeout=20)
            except subprocess.TimeoutExpired:
                self.server.kill()

    @staticmethod
    def delete_session():
        subprocess.run(["herdr", "session", "delete", PROBE_SESSION], capture_output=True, text=True, timeout=60,
                       env=clean_env())


def find_key(d, key):
    if isinstance(d, dict):
        if key in d:
            return d[key]
        for v in d.values():
            found = find_key(v, key)
            if found is not None:
                return found
    elif isinstance(d, list):
        for v in d:
            found = find_key(v, key)
            if found is not None:
                return found
    return None


def new_pane(h: Herdr, label: str) -> str | None:
    """A new tab in the probe session; returns its root pane id."""
    ws = h.js("workspace", "list")
    wid = find_key(ws, "workspace_id")
    reply = h.js("tab", "create", "--workspace", wid, "--label", label, "--cwd", str(WORKDIR), "--no-focus") if wid \
        else h.js("workspace", "create", "--label", label, "--cwd", str(WORKDIR), "--no-focus")
    return find_key(reply, "pane_id")


class EventListener(threading.Thread):
    """Subscribes to the probe session's events over its socket and keeps every event it gets."""

    def __init__(self, sock: str, method: str):
        super().__init__(daemon=True)
        self.sock, self.method, self.events, self.error = sock, method, [], None

    def run(self):
        try:
            with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as c:
                c.connect(self.sock)
                c.sendall((json.dumps({"id": "fg-probes", "method": self.method, "params": SUBSCRIBE}) + "\n").encode())
                buf = b""
                c.settimeout(120)
                while True:
                    chunk = c.recv(65536)
                    if not chunk:
                        return
                    buf += chunk
                    while b"\n" in buf:
                        line, buf = buf.split(b"\n", 1)
                        try:
                            self.events.append(json.loads(line))
                        except ValueError:
                            pass
        except OSError as e:
            self.error = str(e)


def subscribe_method(h: Herdr) -> str | None:
    text = json.dumps(h.js("api", "schema", "--json"))
    return next((m for m in ("events.subscribe", "events.stream", "event.subscribe") if m in text), None)


def moved_event(events: list, old_pane: str | None) -> dict | None:
    """The pane.moved event for this pane: the old id must be the one we moved."""
    for e in events:
        if "moved" in json.dumps(e) and old_pane and find_key(e, "previous_pane_id") == old_pane:
            return e
    return None


def agents_in(reply: dict) -> list:
    found = find_key(reply, "agents")
    return found if isinstance(found, list) else []


def p3_p4_p6_herdr(res: Results, out: Path, cleanup: list, only: set[str]):
    known = Herdr.sessions()
    if known is None:
        res.add("P3", "read herdr's session list", False, "its answer could not be read; no herdr probe ran")
        return
    if any(s.get("name") == PROBE_SESSION for s in known):
        res.add("P3", "a herdr session named probe already exists; not touching it", False,
                "run `fg-probes --clean`, then rerun")
        return
    h = Herdr(out)
    cleanup.append(("herdr", h))
    if not h.start():
        res.add("P3", "start a throwaway herdr session `probe`", False, f"see {out}/herdr-probe-server.log")
        return
    panes = {label: new_pane(h, f"fg-probe-{label}") for label in ("A", "B", "D", "E", "F", "G")}
    res.add("P3", "panes created in the probe session", all(panes.values()), json.dumps(panes))
    marks = out / "marks"
    marks.mkdir(exist_ok=True)
    for label in ("A", "B"):
        if panes[label]:
            h.call("pane", "run", panes[label], f"FG_PROBES_OUT={marks} {ME} stand-in {label}")
    time.sleep(3)
    if "P3" in only and panes["A"] and panes["B"]:
        a = panes["A"]
        r1 = h.js("pane", "report-agent-session", "--source", "kc-cy", "--agent", "claude", a, "--", "fg-probes",
                  "restored", "A", str(marks))
        accepted = "error" not in json.dumps(r1).lower()
        res.add("P3", "an outside process reports a resume command (report-agent-session)", accepted, json.dumps(r1)[:200])
        if not accepted:
            r2 = h.js("pane", "report-agent", "--source", "kc-cy", "--agent", "claude", "--state", "idle", a, "--",
                      "fg-probes", "restored", "A", str(marks))
            res.add("P3", "fallback: report-agent with a state and the resume command", "error" not in json.dumps(r2).lower(),
                    json.dumps(r2)[:200])
        h.call("pane", "close", panes["B"])  # Cmd+W
        hup_b = wait_for(lambda: (marks / "hup-B.json").exists() and json.loads((marks / "hup-B.json").read_text()), 20)
        res.add("P3", "closing a window: the loop sees its pane gone, herdr answering",
                bool(hup_b) and hup_b.get("verdict") == "closed", json.dumps(hup_b)[:200] if hup_b else "no SIGHUP record")
    if "P4" in only and panes["E"]:
        method = subscribe_method(h)
        listener = EventListener(h.sock, method) if method else None
        if listener:
            listener.start()
            time.sleep(2)
        moved = h.js("pane", "move", panes["E"], "--new-workspace", "--label", "fg-probe-moved", "--no-focus")
        time.sleep(5)
        event = moved_event(listener.events if listener else [], panes["E"])
        res.add("P4", "an outside subscriber sees pane.moved with the old and new ids", bool(event),
                json.dumps(event)[:200] if event else
                f"method {method}, error {listener and listener.error}, move {json.dumps(moved)[:120]}")
    if "P6" in only:
        if panes["D"]:
            h.call("pane", "run", panes["D"], f"FG_PROBES_OUT={marks} {ME} detach-test D")
        for label, env in (("F", ""), ("G", "HERDR_AGENT=claude ")):
            pane = panes[label]
            if not pane:
                continue
            pname = f"{PREFIX}-h{label.lower()}"
            cleanup.append(("name", pname))
            h.call("pane", "run", pane, f"{env}{ME} wrap -- claude -n {pname} --model {MODEL} "
                                        f"--permission-mode bypassPermissions 'Reply with the single word ready.'")
            time.sleep(25)
            seen = any(find_key(x, "pane_id") == pane and "claude" in json.dumps(x).lower()
                       for x in agents_in(h.js("agent", "list")))
            res.add("P6", f"herdr sees Claude behind a parent process, {'with' if env else 'without'} HERDR_AGENT "
                          f"(recorded)", None, "seen as Claude" if seen else "not seen as Claude")
    # stop the probe session with the stand-in A and the detached process alive, then start it again
    h.stop_session()
    hup_a = wait_for(lambda: (marks / "hup-A.json").exists() and json.loads((marks / "hup-A.json").read_text()), 20)
    if "P3" in only:
        res.add("P3", "a server stop: the loop sees herdr not answering",
                bool(hup_a) and hup_a.get("verdict") == "interrupted", json.dumps(hup_a)[:200] if hup_a else "no SIGHUP record")
    if "P6" in only:
        det = marks / "detached-D.pid"
        d = json.loads(det.read_text()) if det.exists() else {}
        pid, start = d.get("pid"), d.get("start")
        if pid:
            cleanup.append(("pid", pid, start))
        res.add("P6", "a detached process survives a herdr session stop", bool(pid and same_process(pid, start)),
                f"pid {pid}")
    if "P3" in only:
        if not h.start():
            res.add("P3", "restart the probe session", False, "")
        else:
            got = wait_for(lambda: (marks / "restored-A.json").exists(), 45)
            res.add("P3", "after a restart herdr reruns the reported resume command", bool(got),
                    (marks / "restored-A.json").read_text()[:200] if got else "pane A came back without it")


# ── modes run inside the probe herdr session, and by the probes ────────────────────────────────────────────────


def stand_in(name: str):
    """Stands in for the window loop: waits; on SIGHUP asks herdr about its pane, as the real loop will."""
    out = Path(os.environ.get("FG_PROBES_OUT", STATE))
    pane = os.environ.get("HERDR_PANE_ID", "")

    def hup(_sig, _frm):
        t0 = now()
        try:
            p = subprocess.run(["herdr", "pane", "get", pane], capture_output=True, text=True, timeout=0.5)
            answered, code, said = True, p.returncode, p.stdout + p.stderr
        except subprocess.TimeoutExpired:
            answered, code, said = False, None, "timeout"
        except OSError as e:
            answered, code, said = False, None, str(e)
        (out / f"hup-{name}.json").write_text(json.dumps({
            "pane": pane, "answered": answered, "returncode": code, "verdict": hup_verdict(answered, code, said),
            "seconds": round(now() - t0, 3), "said": said[-300:]}))
        os._exit(0)

    signal.signal(signal.SIGHUP, hup)
    while True:
        time.sleep(3600)


def restored(name: str, where: str | None = None):
    out = Path(where) if where else STATE / "marks"
    out.mkdir(parents=True, exist_ok=True)
    (out / f"restored-{name}.json").write_text(json.dumps({"at": time.strftime("%H:%M:%S"),
                                                           "pane": os.environ.get("HERDR_PANE_ID")}))
    print(f"fg-probes: restored {name}")


def detach_test(name: str):
    out = Path(os.environ.get("FG_PROBES_OUT", STATE))
    p = subprocess.Popen(["sleep", "900"], start_new_session=True, stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    (out / f"detached-{name}.pid").write_text(json.dumps({"pid": p.pid, "start": started_at(p.pid)}))
    time.sleep(3600)


def wrap(argv: list[str]):
    """A parent process in front of `claude`, as a window's shell (and later the window loop) will be."""
    pidfile = None
    if argv[:1] == ["--pidfile"]:
        pidfile, argv = argv[1], argv[2:]
    if argv[:1] == ["--"]:
        argv = argv[1:]
    child = subprocess.Popen(argv)
    if pidfile:
        Path(pidfile).write_text(str(child.pid))
    signal.signal(signal.SIGINT, signal.SIG_IGN)  # Ctrl+C is for claude, not for its parent
    sys.exit(child.wait())


# ── cleanup and main ────────────────────────────────────────────────────────────────────────────────────────────


def agent_rows() -> list[dict]:
    p = subprocess.run(["claude", "agents", "--json", "--all"], capture_output=True, text=True, timeout=60,
                       env=clean_env())
    try:
        return json.loads(p.stdout)
    except ValueError:
        return []


def remove_job(job_id: str):
    """Stop a probe's background job, wait until it has stopped, then remove its record."""
    subprocess.run(["claude", "stop", job_id], capture_output=True, timeout=60, env=clean_env())
    wait_for(lambda: not any(r.get("id") == job_id and r.get("pid") and alive(r["pid"]) for r in agent_rows()), 20, 2)
    subprocess.run(["claude", "rm", job_id], capture_output=True, timeout=60, env=clean_env())


def stop_job(name: str):
    if not name.startswith(PREFIX):
        return
    for r in agent_rows():
        if r.get("name") == name and r.get("id"):
            remove_job(r["id"])


def end_probe_sessions():
    """Any live session named fg-probe-* is ours: end it (its launcher first, so it shuts down cleanly)."""
    for d in registry():
        if str(d.get("name") or "").startswith(PREFIX) and d.get("kind") == "interactive":
            signal_if_same(d["pid"], d.get("procStart"))


def do_cleanup(items: list, keep: bool):
    if keep:
        try:
            input("fg-probes: --keep: the probe sessions are still running; press Enter to end them ")
        except (EOFError, KeyboardInterrupt, Interrupted):
            pass
    for sig in (signal.SIGINT, signal.SIGHUP, signal.SIGTERM):
        signal.signal(sig, signal.SIG_IGN)  # a second Ctrl+C or a closed window must not cut the cleanup short
    print("fg-probes: cleaning up…", flush=True)
    probes = [i for i in items if isinstance(i, Probe)]
    for p in probes:  # end them all at once, then wait
        if not p.exited():  # the wrapper is alive, so its child's pid is not recycled yet
            try:
                os.kill(p.launcher_pid() or p.pid, signal.SIGTERM)
            except ProcessLookupError:
                pass
    end = now() + 20
    while now() < end and not all(p.exited() for p in probes):
        time.sleep(0.2)
    for p in probes:
        if not p.exited():
            p.kill()
    for item in reversed([i for i in items if not isinstance(i, Probe)]):
        try:
            if item[0] == "job":
                stop_job(item[1])
            elif item[0] == "jobid":
                remove_job(item[1])
            elif item[0] == "name":
                row = find_session(name=item[1])
                if row:
                    signal_if_same(row["pid"], row.get("procStart"))
            elif item[0] == "pid":
                signal_if_same(item[1], item[2])
            elif item[0] == "glob":
                for f in Path(item[1]).parent.glob(Path(item[1]).name):
                    f.unlink(missing_ok=True)
            elif item[0] == "herdr":
                item[1].stop_session()
                item[1].delete_session()
        except Exception as e:  # cleanup goes on whatever fails
            print(f"fg-probes: cleanup of {item!r} failed: {e}", file=sys.stderr)
    end_probe_sessions()


def clean() -> int:
    """End whatever a killed or --keep run left: fg-probe-* sessions and jobs, the herdr session `probe`."""
    end_probe_sessions()
    for r in agent_rows():
        if str(r.get("name") or "").startswith(PREFIX) and r.get("id"):
            remove_job(r["id"])
    if any(s.get("name") == PROBE_SESSION for s in (Herdr.sessions() or [])):
        subprocess.run(["herdr", "session", "stop", PROBE_SESSION], capture_output=True, timeout=60, env=clean_env())
        Herdr.delete_session()
    for f in CRONS.glob(f"{PREFIX}-*.json"):
        f.unlink(missing_ok=True)
    print("fg-probes: cleaned up")
    return 0


PROBES = ("P1", "P2", "P3", "P4", "P5", "P6")


def interrupted(_sig, _frm):
    raise Interrupted()


def main(argv: list[str]) -> int:
    if argv[:1] == ["stand-in"]:
        stand_in(argv[1])
    if argv[:1] == ["restored"]:
        restored(argv[1], argv[2] if len(argv) > 2 else None)
        return 0
    if argv[:1] == ["detach-test"]:
        detach_test(argv[1])
    if argv[:1] == ["wrap"]:
        wrap(argv[1:])
    ap = argparse.ArgumentParser(prog="fg-probes", description=__doc__.split("\n\n")[0])
    ap.add_argument("--only", default=",".join(PROBES), help="comma-separated probes to run (default: all)")
    ap.add_argument("--out", help="results folder (default: ~/.local/state/fg-probes/<time>)")
    ap.add_argument("--keep", action="store_true", help="wait for Enter before ending the probe sessions")
    ap.add_argument("--clean", action="store_true", help="end what an earlier run left behind, and stop")
    args = ap.parse_args(argv)
    if os.environ.get("CLAUDECODE"):
        print("fg-probes: run me in a plain terminal, not from a Claude session (its sandbox cannot start claude)",
              file=sys.stderr)
        return 2
    if args.clean:
        return clean()
    left = [d.get("name") for d in registry() if str(d.get("name") or "").startswith(PREFIX)]
    if left:
        print(f"fg-probes: probe sessions from an earlier run are still live ({', '.join(left)}); run `fg-probes --clean`",
              file=sys.stderr)
        return 2
    only = {p.strip().upper() for p in args.only.split(",") if p.strip()}
    out = Path(args.out) if args.out else STATE / time.strftime("%Y%m%d-%H%M%S")
    out.mkdir(parents=True, exist_ok=True)
    res = Results(out)
    cleanup: list = []
    signal.signal(signal.SIGHUP, interrupted)
    signal.signal(signal.SIGTERM, interrupted)
    print(f"fg-probes: results in {out}")
    steps = [("P1", p1), ("P2", p2), ("P5", p5), ("P6", p6_claude)]
    try:
        for name, fn in steps:
            if name in only:
                print(f"{name}…", flush=True)
                try:
                    fn(res, out, cleanup)
                except (Interrupted, KeyboardInterrupt):
                    raise
                except Exception as e:
                    res.add(name, "ran to the end", False, f"{type(e).__name__}: {e}")
        if only & {"P3", "P4", "P6"}:
            print("P3/P4/P6 (herdr)…", flush=True)
            try:
                p3_p4_p6_herdr(res, out, cleanup, only)
            except (Interrupted, KeyboardInterrupt):
                raise
            except Exception as e:
                res.add("P3", "herdr probes ran to the end", False, f"{type(e).__name__}: {e}")
    except (Interrupted, KeyboardInterrupt):
        res.add("—", "the run was interrupted", False, "the probes after this point did not run")
    finally:
        do_cleanup(cleanup, args.keep)
        counts = res.save()
    print(f"\n{res.table()}\n\nfg-probes: {counts['PASS']} pass, {counts['FAIL']} fail, {counts['SKIP']} skip; "
          f"saved in {out}")
    return 0 if counts["FAIL"] == 0 else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
