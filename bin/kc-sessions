#!/usr/bin/env python3
"""kc-sessions: restart Claude background sessions without disturbing anything else.

A background session is a job of Claude's daemon (an 8-hex id, a name). Kohen watches most of them in herdr windows
that run `claude attach <id>`. Restarting a session ends that attach, and some ways of restarting it change its id
and leave the old record behind under the same name. This tool restarts sessions the safe way, puts every window
back, and says what is wrong when something already is.

    kc-sessions list [--json]                 every job: running worker, state, mode, and whether another job supersedes it
    kc-sessions respawn TARGET... [--wait-idle SECONDS]
                                              restart sessions in place (same job id, same flags, same crons). A session
                                              that is working is waited for up to SECONDS (default 0: restart now);
                                              the windows that showed them are given their attach back
    kc-sessions restart TARGET --prompt TEXT  restart in place with a first message (stop, then a bare resume: same job id)
    kc-sessions fork TARGET [--prompt TEXT]   the one restart that must change the id: continue the conversation in
                                              bypass-permissions mode. New job first, windows moved, then the old one is
                                              stopped and removed (never when it has done work since, or has a worktree)
    kc-sessions retire ID [--rm]              stop a superseded job (and remove it when that is safe)
    kc-sessions check [--files-only] [--json] report drift: duplicate names, stale or dropped windows, grey dots,
                                              sessions not in bypass mode. Exit 1 when anything is wrong
    kc-sessions repair                        give the windows this tool detached their attach back
    kc-sessions windows                       every window and what it attaches to
    kc-sessions snapshot / diff BEFORE AFTER  the state a restart must not change, and what differs between two of them

TARGET is a job id or a session name. A name must resolve to exactly one session: the only one with a running worker,
else the only one, else the newest when the others are superseded by a recorded fork; anything else is an error that
lists the candidates.

Text is typed into a pane only when every process in it is a shell and its screen has stopped changing, and only for
panes this tool saw attached to the job it restarted. Standard library only; reads ~/.claude/jobs and
~/.claude/daemon/roster.json directly, so `check --files-only` works inside a sandbox.
"""

from __future__ import annotations

import argparse
import contextlib
import fcntl
import json
import os
import re
import subprocess
import sys
import time
from dataclasses import dataclass, field
from datetime import datetime, timezone
from pathlib import Path

ATTACH = re.compile(r"\battach\s+([0-9a-f]{8})\b")
RESPAWNED = re.compile(r"\b([0-9a-f]{8})\s*(?:→|->)\s*([0-9a-f]{8})\b")
SHELLS = {"zsh", "bash", "sh", "fish", "dash"}
# Flags a fork repeats from the old session. Everything else (ids, names, the permission mode, the daemon's
# --settings blob, one-shot options) is either set by the fork itself or must not be copied.
COPY_FLAGS = {"--effort", "--agent", "--agents", "--add-dir", "--plugin-dir", "--mcp-config", "--fallback-model",
              "--append-system-prompt", "--append-system-prompt-file", "--allowed-tools", "--allowedTools",
              "--disallowed-tools", "--disallowedTools", "--tools", "--thinking"}
MODELS = ("opus", "sonnet", "haiku")


def home() -> Path:
    return Path(os.environ.get("HOME") or Path.home())


def state_dir() -> Path:
    return Path(os.environ.get("KC_SESSIONS_STATE") or home() / ".local/state/kc-sessions")


def poll() -> float:
    return float(os.environ.get("KC_SESSIONS_POLL", "1.0"))


def scaled(seconds: float) -> float:
    return seconds * float(os.environ.get("KC_SESSIONS_TIMEOUT_SCALE", "1.0"))


def now() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


class Failure(Exception):
    """A refusal or an error whose message is the answer."""


# ── jobs ─────────────────────────────────────────────────────────────────────────────────────────────────────

@dataclass
class Job:
    id: str
    name: str
    state: str
    tempo: str
    created: str
    cwd: str
    flags: list
    in_flight: dict
    session_id: str
    template: str
    transcript: str
    worker: dict | None = None
    raw: dict = field(default_factory=dict)

    @property
    def running(self) -> bool:
        return self.worker is not None

    @property
    def live_id(self) -> str:
        """The conversation the daemon resumes. `session_id` is the one the job was created with; after a /clear the live
        conversation has another id (`resumeSessionId`), and resuming the old one brings back a stale conversation."""
        return (self.raw or {}).get("resumeSessionId") or self.session_id

    @property
    def busy(self) -> bool:
        """In the middle of work: a turn is running, or subagents / background commands are in flight. A session that only
        waits for a wake or a cron is idle between turns, and restarting it loses nothing."""
        inflight = self.in_flight or {}
        kinds = [k for k in (inflight.get("kinds") or []) if k != "session_cron"]
        return self.tempo == "active" or bool(kinds) or bool(inflight.get("queued"))

    @property
    def mode(self) -> str:
        if "--dangerously-skip-permissions" in self.flags:
            return "bypassPermissions"
        if "--permission-mode" in self.flags and self.flags.index("--permission-mode") + 1 < len(self.flags):
            return self.flags[self.flags.index("--permission-mode") + 1]
        return "default"


def load_jobs() -> list[Job]:
    jobs_dir = home() / ".claude/jobs"
    try:
        workers = json.loads((home() / ".claude/daemon/roster.json").read_text()).get("workers") or {}
    except (OSError, ValueError):
        workers = {}
    out = []
    for p in sorted(jobs_dir.glob("*/state.json")):
        try:
            st = json.loads(p.read_text())
        except (OSError, ValueError):
            continue
        flags = st.get("respawnFlags")
        try:
            flags = json.loads(flags) if isinstance(flags, str) else (flags or [])
        except ValueError:
            flags = []
        inflight = st.get("inFlight")
        if isinstance(inflight, str):
            try:
                inflight = json.loads(inflight)
            except ValueError:
                inflight = {}
        out.append(Job(id=p.parent.name, name=st.get("name") or "", state=st.get("state") or "", tempo=st.get("tempo") or "",
                       created=st.get("createdAt") or "", cwd=st.get("cwd") or "", flags=list(flags),
                       in_flight=inflight if isinstance(inflight, dict) else {}, session_id=st.get("sessionId") or "",
                       template=st.get("template") or "", transcript=st.get("linkScanPath") or "",
                       worker=workers.get(p.parent.name), raw=st))
    return out


def lineage() -> dict:
    try:
        return json.loads((state_dir() / "lineage.json").read_text())
    except (OSError, ValueError):
        return {}


def write_json_atomic(path: Path, data) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + f".{os.getpid()}.tmp")
    tmp.write_text(json.dumps(data, indent=1))
    os.replace(tmp, path)


@contextlib.contextmanager
def state_lock(timeout: float = 60.0):
    """One lock for the small files this tool and kc-new / stella write (the ledger and the lineage)."""
    state_dir().mkdir(parents=True, exist_ok=True)
    f = open(state_dir() / "lock", "w")
    deadline = time.time() + timeout
    while True:
        try:
            fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
            break
        except OSError:
            if time.time() > deadline:
                raise Failure("another kc-sessions operation holds the state lock")
            time.sleep(0.1)
    try:
        yield
    finally:
        fcntl.flock(f, fcntl.LOCK_UN)
        f.close()


def lineage_set(old: str, new: str) -> None:
    with state_lock():
        link = lineage()
        link[old] = {"new": new, "at": now()}
        write_json_atomic(state_dir() / "lineage.json", link)


def superseded_by(job: Job, jobs: list[Job]) -> Job | None:
    """The job that replaced this one, when a recorded fork says so or the choice is otherwise unambiguous."""
    new = lineage().get(job.id, {}).get("new")
    by_id = {j.id: j for j in jobs}
    if new in by_id:
        return by_id[new]
    return None


def candidates(name: str, jobs: list[Job]) -> list[Job]:
    return [j for j in jobs if j.name == name]


def resolve(target: str, jobs: list[Job] | None = None) -> Job:
    """One job for an id or a name, or a Failure that lists the candidates."""
    jobs = load_jobs() if jobs is None else jobs
    for j in jobs:
        if target in (j.id, j.session_id, j.live_id):
            return j
    named = candidates(target, jobs)
    if not named:
        raise Failure(f"no session called {target}")
    live = [j for j in named if not superseded_by(j, jobs)]
    running = [j for j in live if j.running]
    pool = running or live
    if len(pool) == 1:
        return pool[0]
    desc = "; ".join(f"{j.id} ({j.state}{', running' if j.running else ''})" for j in named)
    raise Failure(f"{target} names more than one session: {desc}. Pass the id, or retire the old copy with "
                  f"`kc-sessions retire <id>`")


def rename_job(job_id: str, new: str) -> None:
    """Rename a job the way the agents view does: its state.json takes the new `name` with `nameSource` "user", and the
    worker follows. The `-n` in respawnFlags keeps the old name, as it does for every job renamed in the agents view
    (the name in state.json wins). The daemon rewrites state.json by itself, so the change is read back and, if a
    concurrent write undid it, made again."""
    path = home() / ".claude/jobs" / job_id / "state.json"
    for _ in range(3):
        try:
            st = json.loads(path.read_text())
        except (OSError, ValueError) as e:
            raise Failure(f"cannot read the state of {job_id}: {e}")
        stamp = datetime.now(timezone.utc)
        st.update(name=new, nameSource="user", updatedAt=stamp.strftime("%Y-%m-%dT%H:%M:%S.") + f"{stamp.microsecond // 1000:03d}Z")
        tmp = path.with_name(f"state.json.{os.getpid()}.tmp")
        with os.fdopen(os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w") as f:
            json.dump(st, f, indent=2, ensure_ascii=False)
        os.replace(tmp, path)
        time.sleep(poll())
        try:
            if json.loads(path.read_text()).get("name") == new:
                return
        except (OSError, ValueError):
            pass
    raise Failure(f"{job_id} did not keep the name {new}: the daemon keeps writing the old one")


def duplicate_names(jobs: list[Job]) -> dict[str, list[Job]]:
    """Names held by more than one job where no recorded fork says which one is current and which is old."""
    out = {}
    for name in sorted({j.name for j in jobs if j.name}):
        group = candidates(name, jobs)
        live = [j for j in group if not superseded_by(j, jobs)]
        running = [j for j in live if j.running]
        if len(running) > 1 or (len(live) > 1 and not running):
            out[name] = group
    return out


# ── claude and herdr ─────────────────────────────────────────────────────────────────────────────────────────

def run(*cmd: str, cwd: str | None = None, timeout: float = 60) -> subprocess.CompletedProcess:
    try:
        return subprocess.run(cmd, cwd=cwd, capture_output=True, text=True, timeout=timeout)
    except (OSError, subprocess.TimeoutExpired) as e:
        return subprocess.CompletedProcess(cmd, 127, "", str(e))


def herdr_json(*args: str):
    p = run("herdr", *args, timeout=30)
    try:
        return json.loads(p.stdout)
    except ValueError:
        return None


def walk_dicts(x):
    if isinstance(x, dict):
        yield x
        for v in x.values():
            yield from walk_dicts(v)
    elif isinstance(x, list):
        for v in x:
            yield from walk_dicts(v)


def herdr_reachable() -> bool:
    return herdr_json("workspace", "list") is not None


@dataclass
class Pane:
    id: str
    tab_id: str
    workspace: str
    tab: str
    cwd: str
    focused: bool = False


def panes() -> list[Pane]:
    """Every pane, in herdr's order, with its space and window labels."""
    ws_label: dict[str, str] = {}
    tab_label: dict[str, tuple[str, str]] = {}
    ws_reply = herdr_json("workspace", "list")
    if ws_reply is None:
        raise Failure("herdr is not answering")
    for w in walk_dicts(ws_reply):
        wid = w.get("workspace_id") or w.get("id")
        if isinstance(wid, str) and isinstance(w.get("label"), str):
            ws_label[wid] = w["label"]
            for t in walk_dicts(herdr_json("tab", "list", "--workspace", wid) or {}):
                tid = t.get("tab_id") or t.get("id")
                if isinstance(tid, str):
                    tab_label[tid] = (w["label"], t.get("label") if isinstance(t.get("label"), str) else "")
    out, seen = [], set()
    for d in walk_dicts(herdr_json("pane", "list") or {}):
        pid = d.get("pane_id")
        if isinstance(pid, str) and pid not in seen:
            seen.add(pid)
            ws, tab = tab_label.get(d.get("tab_id"), ("", ""))
            out.append(Pane(pid, d.get("tab_id") or "", ws, tab, d.get("cwd") or d.get("foreground_cwd") or "",
                            bool(d.get("focused"))))
    return out


def commands(info) -> list[str]:
    out: list[str] = []

    def walk(x):
        if isinstance(x, list) and x and all(isinstance(i, str) for i in x):
            out.append(" ".join(x))
        elif isinstance(x, dict):
            for v in x.values():
                walk(v)
        elif isinstance(x, list):
            for v in x:
                walk(v)

    walk(info)
    return out


def process_info(pane: str):
    return herdr_json("pane", "process-info", "--pane", pane)


def attached_job(info) -> str | None:
    for c in commands(info):
        m = ATTACH.search(c)
        if m:
            return m.group(1)
    return None


def only_shell(info) -> bool:
    """True when every process in the pane is a shell. An unreadable reply is not a shell: fail safe."""
    cmds = commands(info)
    return bool(cmds) and all(Path(c.split()[0].lstrip("-")).name in SHELLS for c in cmds)


def screen(pane: str) -> str:
    """The last lines on a pane's screen as text. herdr may answer with plain text or with a JSON object that also carries a
    revision counter; only the text is compared."""
    p = run("herdr", "pane", "read", pane, "--lines", "4", timeout=15)
    if p.returncode != 0:
        return ""
    try:
        obj = json.loads(p.stdout)
    except ValueError:
        return p.stdout
    for d in walk_dicts(obj):
        if isinstance(d.get("text"), str):
            return d["text"]
    return p.stdout


def screen_still(pane: str) -> bool:
    """The screen did not change for a moment: nobody is typing there."""
    first = screen(pane)
    time.sleep(min(1.0, poll()))
    return bool(first) and first == screen(pane)


def dot(pane: str) -> str | None:
    for d in walk_dicts(herdr_json("agent", "list") or {}):
        if d.get("pane_id") == pane and isinstance(d.get("agent_status"), str):
            return d["agent_status"]
    return None


def attach_pid(info) -> int | None:
    """The pid of the `claude attach` process in a process-info reply."""
    for d in walk_dicts(info):
        argv = d.get("argv")
        if isinstance(argv, list) and argv and all(isinstance(i, str) for i in argv) and ATTACH.search(" ".join(argv)):
            return d.get("pid")
    return None


def attachments() -> dict[str, tuple]:
    """{pane id: (job id, pid of the attach process)} for every pane that runs `claude attach`."""
    out = {}
    for p in panes():
        info = process_info(p.id)
        job = attached_job(info)
        if job:
            out[p.id] = (job, attach_pid(info))
    return out


# ── detached ledger ──────────────────────────────────────────────────────────────────────────────────────────

LEDGER_TTL = 30 * 60  # a window that lost its attach is only ever repaired within this long


def ledger() -> dict:
    try:
        return json.loads((state_dir() / "detached.json").read_text())
    except (OSError, ValueError):
        return {}


def ledger_add(entries: dict) -> None:
    with state_lock():
        data = ledger()
        data.update(entries)
        write_json_atomic(state_dir() / "detached.json", data)


def ledger_drop(pane: str) -> None:
    with state_lock():
        data = ledger()
        data.pop(pane, None)
        write_json_atomic(state_dir() / "detached.json", data)


def entry_for(pane: str, job: str, pid) -> dict:
    return {"job": job, "since": now(), "pid": pid}


def age_seconds(stamp: str) -> float:
    try:
        return time.time() - datetime.strptime(stamp, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc).timestamp()
    except ValueError:
        return 0.0


def give_back(pane: str, entry: dict, log) -> bool:
    """Type the attach into a pane that lost it. True when the pane shows a NEW attach to the job (and a dot). The attach
    that was there when the session was restarted takes a moment to exit: it is waited for, never counted."""
    jobs = load_jobs()
    target = lineage().get(entry["job"], {}).get("new", entry["job"])
    live = next((j for j in jobs if j.id == target), None)
    if live is None or not live.running:
        log(f"{pane}: {target} has no running worker; not reviving it for a window")
        return False
    deadline = time.time() + scaled(40)
    typed = False
    seen_shell = False
    while time.time() < deadline:
        info = process_info(pane)
        if info is None:
            time.sleep(poll())
            continue
        cur, pid = attached_job(info), attach_pid(info)
        if cur:
            dying = (pid is not None and pid == entry.get("pid")) or (entry.get("pid") is None and cur == entry["job"] and not seen_shell)
            if dying:
                time.sleep(poll())
                continue
            if cur == target:
                if dot(pane) not in (None, "unknown") or time.time() > deadline - scaled(20):
                    log(f"{pane}: attached to {target}")
                    return True
                time.sleep(poll())
                continue
            log(f"{pane}: shows {cur}, left alone")
            return False
        if only_shell(info):
            seen_shell = True
            if not typed and screen_still(pane):
                run("herdr", "pane", "run", pane, f"claude attach {target}", timeout=15)
                typed = True
        time.sleep(poll())
    log(f"{pane}: could not give back the attach to {target} (not a quiet shell); `kc-sessions repair` retries")
    return False


def restore_ledger(log, jobs: set | None = None) -> int:
    """Give the windows in the ledger their attach back (only those of `jobs`, when given). Entries for windows herdr no
    longer has, older than half an hour, or whose job has no worker are dropped. Returns how many remain."""
    try:
        known = {p.id for p in panes()}
    except Failure:
        known = None
    left = 0
    for pane, entry in list(ledger().items()):
        if jobs is not None and entry["job"] not in jobs and lineage().get(entry["job"], {}).get("new") not in jobs:
            continue  # another session's window: its own restart gives it back
        if known is not None and pane not in known:
            ledger_drop(pane)
            log(f"{pane}: the window is gone; forgotten")
            continue
        if age_seconds(entry["since"]) > LEDGER_TTL:
            ledger_drop(pane)
            log(f"{pane}: lost its attach more than half an hour ago; forgotten (type `claude attach {entry['job']}` there if you want it)")
            continue
        if give_back(pane, entry, log):
            ledger_drop(pane)
        elif not next((j for j in load_jobs() if j.id == lineage().get(entry["job"], {}).get("new", entry["job"]) and j.running), None):
            ledger_drop(pane)  # nothing running to attach: the problem is the session, reported elsewhere
        else:
            left += 1
    return left


# ── restarts ─────────────────────────────────────────────────────────────────────────────────────────────────

def wait_restarted(job_id: str, before: str | None) -> bool:
    deadline = time.time() + scaled(40)
    while time.time() < deadline:
        for j in load_jobs():
            if j.id == job_id and j.worker and j.worker.get("procStart") != before:
                return True
        time.sleep(poll())
    return False


def respawn(targets: list[str], wait_idle: float, log) -> int:
    """Restart sessions in place. Returns the number of problems."""
    jobs = load_jobs()
    chosen = [resolve(t, jobs) for t in targets]
    problems = 0
    try:
        before = attachments()
    except Failure:
        before = {}
        log("herdr is not answering: windows are not tracked, check them with `kc-sessions check`")
    ids = {j.id for j in chosen}
    ledger_add({pane: entry_for(pane, job, pid) for pane, (job, pid) in before.items() if job in ids})
    deadline = time.time() + wait_idle
    pending = sorted(chosen, key=lambda j: j.busy)  # idle sessions first
    last_waiting = ""
    while pending:
        fresh = {j.id: j for j in load_jobs()}
        ready = [j for j in pending if not fresh.get(j.id, j).busy or time.time() >= deadline]
        if not ready:
            waiting = ", ".join(j.name for j in pending)
            if waiting != last_waiting:
                log(f"waiting for {waiting} to go idle")
                last_waiting = waiting
            time.sleep(max(poll(), min(5.0, poll() * 5)))
            continue
        job = ready[0]
        pending.remove(job)
        was = (fresh.get(job.id, job).worker or {}).get("procStart")
        p = run("claude", "respawn", job.id)
        if p.returncode != 0:
            log(f"{job.name} ({job.id}): claude respawn failed: {(p.stderr or p.stdout).strip()[-160:]}")
            problems += 1
            continue
        target_id = job.id
        m = RESPAWNED.search(p.stdout + p.stderr)
        if m and m.group(1) == job.id and m.group(2) != job.id:
            target_id = m.group(2)
            log(f"{job.name}: the daemon gave it a new id {target_id}; recording the link")
            lineage_set(job.id, target_id)
            was = None
        if not wait_restarted(target_id, was):
            # a stopped job may not answer `respawn`: a bare resume (no flags) continues the same job in place
            if target_id == job.id and not any(j.running for j in load_jobs() if j.id == job.id):  # never beside a live worker: that forks
                run("claude", "--bg", "--resume", job.live_id, "--", "Resumed: carry on where you left off.", cwd=job.cwd or None)
            if not wait_restarted(target_id, was):
                log(f"{job.name} ({job.id}): no new worker seen after the respawn")
                problems += 1
                continue
            log(f"{job.name} ({job.id}): revived with a bare resume")
        else:
            log(f"{job.name} ({job.id}): restarted")
        problems += restore_ledger(log, {job.id, target_id})  # this session's windows now, not after the others
    return problems + restore_ledger(log)


COPY_NOTE = re.compile(r"started a (?:restricted )?copy (?:of that conversation )?as ([0-9a-f]{8})")


def session_open(session_id: str) -> bool:
    """Does a live process still hold this conversation (a session file under ~/.claude/sessions with a live pid)?"""
    for f in (Path.home() / ".claude/sessions").glob("*.json"):
        try:
            d = json.loads(f.read_text())
            if d.get("sessionId") != session_id:
                continue
            os.kill(int(d["pid"]), 0)
            return True
        except (OSError, ValueError, KeyError, TypeError):
            continue
    return False


def restart_with_prompt(target: str, prompt: str, log) -> int:
    """Restart a session in place and give it a first message: `claude stop`, then a bare `claude --bg --resume`
    (no flags, so the daemon continues the same job with its saved flags). If the daemon forks anyway, the fork is
    recorded and the windows follow it."""
    job = resolve(target)
    try:
        before = attachments()
    except Failure:
        before = {}
        log("herdr is not answering: windows are not tracked, check them with `kc-sessions check`")
    ledger_add({pane: entry_for(pane, j, pid) for pane, (j, pid) in before.items() if j == job.id})
    known = {j.id for j in load_jobs()}
    if job.running:
        if run("claude", "stop", job.id).returncode != 0:
            raise Failure(f"claude stop {job.id} failed")
        deadline = time.time() + scaled(30)
        while time.time() < deadline and any(j.running for j in load_jobs() if j.id == job.id):
            time.sleep(poll())
        # the job is "stopped" a moment before its process is gone, and the daemon starts a COPY of a session that
        # still looks open: wait for the process to go
        deadline = time.time() + scaled(20)
        while time.time() < deadline and session_open(job.live_id):
            time.sleep(poll())
        time.sleep(scaled(1))
    p = run("claude", "--bg", "--resume", job.live_id, "--", prompt, cwd=job.cwd)
    if p.returncode != 0:
        raise Failure(f"claude --bg --resume failed: {(p.stderr or p.stdout).strip()[-200:]}")
    said = f"{p.stdout}\n{p.stderr}"
    if (m := COPY_NOTE.search(said)) and m.group(1) not in known:
        # the daemon started a copy (its note says why) instead of continuing the job: undo it, keep the job
        note = next((ln.strip() for ln in said.splitlines() if "started a" in ln), m.group(0))
        log(f"{job.name} ({job.id}): the daemon started a copy ({m.group(1)}) instead of continuing it: {note}")
        retire(m.group(1), log, remove=True)
        log(f"{job.name} ({job.id}): restarting it in place without the first message")
        return respawn([job.id], 0.0, log)
    deadline = time.time() + scaled(40)
    problems = 0
    while time.time() < deadline:
        jobs = load_jobs()
        same = next((j for j in jobs if j.id == job.id and j.running), None)
        copy = next((j for j in jobs if j.name == job.name and j.id not in known and j.running), None)
        if same:
            log(f"{job.name} ({job.id}): restarted in place")
            break
        if copy:
            log(f"{job.name}: the daemon continued it as {copy.id} (a fork); recording the link")
            lineage_set(job.id, copy.id)
            break
        time.sleep(poll())
    else:
        log(f"{job.name} ({job.id}): no worker after the resume")
        problems += 1
    return problems + restore_ledger(log)


def transcript_size(job: Job) -> int:
    try:
        return Path(job.transcript).stat().st_size if job.transcript else 0
    except OSError:
        return 0


def transcript_turns(job: Job) -> int:
    """How many conversation entries (user and assistant messages) the transcript holds. Stopping a session appends
    bookkeeping lines (cost, title, mode) that are not work, so the size cannot tell whether it did anything."""
    n = 0
    try:
        with open(job.transcript, "rb") as f:
            for line in f:
                if b'"type":"user"' in line or b'"type":"assistant"' in line:
                    n += 1
    except OSError:
        return 0
    return n


def last_model(job: Job) -> str | None:
    """opus, sonnet or haiku: the model of the last main-thread assistant message in the transcript (subagent and
    tool lines also carry model names, so the lines are parsed, not searched)."""
    try:
        with open(job.transcript, "rb") as f:
            f.seek(0, 2)
            f.seek(max(0, f.tell() - 2_000_000))
            lines = f.read().decode("utf-8", "replace").splitlines()
    except OSError:
        return None
    for line in reversed(lines):
        if '"model"' not in line:
            continue
        try:
            obj = json.loads(line)
        except ValueError:
            continue
        if obj.get("isSidechain"):
            continue
        message = obj.get("message")
        model = message.get("model") if isinstance(message, dict) else None
        if not isinstance(model, str):
            continue
        for name in MODELS:
            if name in model:
                return name
    return None


def copied_flags(job: Job) -> list[str]:
    out, flags, i = [], job.flags, 0
    while i < len(flags):
        f = flags[i]
        if f in COPY_FLAGS:
            out.append(f)
            if i + 1 < len(flags) and not flags[i + 1].startswith("--"):
                out.append(flags[i + 1])
                i += 1
        i += 1
    model = last_model(job)
    if model and "--model" not in out:
        out += ["--model", model]
    return out


def in_worktree(cwd: str) -> bool:
    """True when cwd is a linked git worktree: `claude rm` may delete a worktree, so those are never removed."""
    if not cwd or not Path(cwd).is_dir():
        return False
    a = run("git", "-C", cwd, "rev-parse", "--git-dir", timeout=10).stdout.strip()
    b = run("git", "-C", cwd, "rev-parse", "--git-common-dir", timeout=10).stdout.strip()
    return bool(a and b and os.path.realpath(os.path.join(cwd, a)) != os.path.realpath(os.path.join(cwd, b)))


def retire(job_id: str, log, *, remove: bool, grown_since: int | None = None) -> bool:
    job = next((j for j in load_jobs() if j.id == job_id), None)
    if job is None:
        log(f"{job_id}: no such job")
        return False
    if job.running:
        run("claude", "stop", job.id)
        deadline = time.time() + scaled(30)
        while time.time() < deadline and any(j.running for j in load_jobs() if j.id == job.id):
            time.sleep(poll())
        if any(j.running for j in load_jobs() if j.id == job.id):
            log(f"{job.name} ({job.id}): still has a worker after claude stop; left as is")
            return False
    log(f"{job.name} ({job.id}): stopped")
    if not remove:
        return True
    if grown_since is not None and transcript_turns(job) > grown_since:
        log(f"{job.name} ({job.id}): its transcript grew after the fork, so it is kept (work exists only there)")
        return True
    if in_worktree(job.cwd):
        log(f"{job.name} ({job.id}): runs in a git worktree ({job.cwd}); kept, `claude rm {job.id}` by hand if wanted")
        return True
    p = run("claude", "rm", job.id)
    log(f"{job.name} ({job.id}): " + ("removed" if p.returncode == 0 else f"claude rm failed: {(p.stderr or p.stdout).strip()[-120:]}"))
    return True


def fork(target: str, prompt: str, log, *, fresh: bool = False) -> int:
    """Continue a conversation in bypass-permissions mode. The id has to change; nothing else may.
    With `fresh` the new session starts an empty conversation (same name, flags, directory and windows) instead of
    continuing the old one, and the old job is removed whatever it grew."""
    jobs = load_jobs()
    old = resolve(target, jobs)
    if old.busy:
        raise Failure(f"{old.name} is busy (state {old.state}, in flight {old.in_flight or 'none'}); try again when it is idle")
    if not old.live_id or not old.cwd or not Path(old.cwd).is_dir():
        raise Failure(f"{old.name} has no conversation to continue")
    try:
        before = attachments()
    except Failure:
        before = {}
    ledger_add({pane: entry_for(pane, j, pid) for pane, (j, pid) in before.items() if j == old.id})
    known = {j.id for j in jobs}
    size = transcript_turns(old)
    flags = ["--dangerously-skip-permissions", *copied_flags(old)]
    p = run("claude", "--bg", *([] if fresh else ["--resume", old.live_id]), "-n", old.name, *flags, "--", prompt, cwd=old.cwd)
    if p.returncode != 0:
        raise Failure(f"claude --bg --resume failed: {(p.stderr or p.stdout).strip()[-200:]}")
    new = None
    deadline = time.time() + scaled(40)
    while time.time() < deadline and new is None:
        new = next((j for j in load_jobs() if j.name == old.name and j.id not in known and j.running), None)
        if new is None:
            time.sleep(poll())
    if new is None:
        raise Failure(f"the continuation of {old.name} did not appear; the old session is untouched")
    lineage_set(old.id, new.id)
    log(f"{old.name}: " + ("started afresh" if fresh else "continued") + f" as {new.id} (was {old.id}, mode {old.mode} -> bypassPermissions)")
    retire(old.id, log, remove=True, grown_since=None if fresh else size)
    return restore_ledger(log)


# ── checks ───────────────────────────────────────────────────────────────────────────────────────────────────

def check(files_only: bool) -> list[dict]:
    jobs = load_jobs()
    issues = []
    for name, group in duplicate_names(jobs).items():
        issues.append({"kind": "duplicate-name", "name": name,
                       "jobs": [{"id": j.id, "state": j.state, "running": j.running} for j in group]})
    for j in jobs:
        if j.running and j.mode != "bypassPermissions" and j.name != "":
            issues.append({"kind": "not-bypass", "name": j.name, "id": j.id, "mode": j.mode, "info": True})
    for pane, entry in ledger().items():
        issues.append({"kind": "detached-window", "pane": pane, "job": entry["job"], "since": entry["since"]})
    if files_only:
        return issues
    try:
        table = {p.id: p for p in panes()}
        att = {p: j for p, (j, _) in attachments().items()}
    except Failure as e:
        return issues + [{"kind": "herdr-unreachable", "detail": str(e)}]
    by_id = {j.id: j for j in jobs}
    for pane, job_id in att.items():
        job = by_id.get(job_id)
        label = f"{table[pane].workspace}/{table[pane].tab}"
        if job is None:
            issues.append({"kind": "stale-attach", "pane": pane, "window": label, "job": job_id, "why": "no such job"})
        elif not job.running:
            issues.append({"kind": "stale-attach", "pane": pane, "window": label, "job": job_id,
                           "why": f"{job.name} has no running worker", "successor": succ.id if (succ := superseded_by(job, jobs)) else None})
        if dot(pane) == "unknown":
            issues.append({"kind": "grey-dot", "pane": pane, "window": label, "job": job_id})
    return issues


def describe(issue: dict) -> str:
    k = issue["kind"]
    if k == "duplicate-name":
        return f"{issue['name']}: held by " + ", ".join(f"{j['id']} ({j['state']}{', running' if j['running'] else ''})" for j in issue["jobs"])
    if k == "not-bypass":
        return f"{issue['name']} ({issue['id']}) runs in {issue['mode']} mode (messages to it expire)"
    if k == "detached-window":
        return f"window {issue['pane']} lost its attach to {issue['job']} at {issue['since']}; `kc-sessions repair`"
    if k == "stale-attach":
        succ = f"; its successor is {issue['successor']}" if issue.get("successor") else ""
        return f"window {issue['window']} ({issue['pane']}) attaches {issue['job']}: {issue['why']}{succ}"
    if k == "grey-dot":
        return f"window {issue['window']} ({issue['pane']}) shows a grey dot (attached to {issue['job']})"
    return f"{k}: {issue.get('detail', '')}"


# ── the invariant: what a restart must not change ────────────────────────────────────────────────────────────

def normalised_flags(flags: list) -> list:
    """The flags without the daemon's --settings blob (it is rebuilt at every start)."""
    out, i = [], 0
    while i < len(flags):
        if flags[i] == "--settings":
            i += 2
            continue
        out.append(flags[i])
        i += 1
    return out


def snapshot(with_herdr: bool = True) -> dict:
    """Everything a restart must leave alone: the jobs (id, name, session id, cwd, flags, transcript), which of them have a
    worker, and every herdr window (ids, labels, order, cwd, focus) with the job its pane attaches. Pids, times, states
    and counters are left out on purpose: they change by themselves."""
    jobs = load_jobs()
    snap = {
        "jobs": {j.id: {"name": j.name, "sessionId": j.session_id, "cwd": j.cwd, "flags": normalised_flags(j.flags),
                        "transcript": j.transcript, "template": j.template} for j in jobs},
        "workers": sorted(j.id for j in jobs if j.running),
    }
    if with_herdr:
        try:
            rows = []
            for p in panes():
                info = process_info(p.id)
                rows.append({"id": p.id, "tab_id": p.tab_id, "workspace": p.workspace, "tab": p.tab, "cwd": p.cwd,
                             "focused": p.focused, "attach": attached_job(info), "shell": only_shell(info)})
            snap["panes"] = rows
        except Failure:
            snap["panes"] = None
    return snap


def diff(before: dict, after: dict, workers: set | None = None) -> list[str]:
    """Differences that are not allowed. Empty means the restart changed nothing but the workers' processes. Focus, new
    windows and new jobs are not damage (the user works while a restart runs); `workers` names the jobs that must still
    have a worker (the ones a restart touched; an idle one may be retired by the daemon at any time)."""
    out = []
    for jid, b in before["jobs"].items():
        a = after["jobs"].get(jid)
        if a is None:
            out.append(f"job {jid} ({b['name']}) is gone")
            continue
        for k in b:
            if b[k] != a[k]:
                out.append(f"job {jid} ({b['name']}): {k} changed from {b[k]!r} to {a[k]!r}")
    for jid in (workers or ()):
        if jid in before["workers"] and jid not in after["workers"] and jid in before["jobs"]:
            out.append(f"{before['jobs'][jid]['name']} ({jid}) had a worker and has none now")
    bp, ap = before.get("panes"), after.get("panes")
    if bp is not None and ap is None:
        out.append("herdr stopped answering")
    elif bp is not None:
        by_id = {p["id"]: p for p in ap}
        for p in bp:
            q = by_id.get(p["id"])
            if q is None:
                out.append(f"window {p['workspace']}/{p['tab']} ({p['id']}) is gone")
                continue
            for k in ("tab_id", "workspace", "tab", "cwd"):
                if p[k] != q[k]:
                    out.append(f"window {p['workspace']}/{p['tab']} ({p['id']}): {k} changed from {p[k]!r} to {q[k]!r}")
            if p["attach"] != q["attach"]:
                out.append(f"window {p['workspace']}/{p['tab']} ({p['id']}) attached {p['attach']} and now shows {q['attach']}")
        kept = [p["id"] for p in ap if p["id"] in {x["id"] for x in bp}]
        if [p["id"] for p in bp if p["id"] in by_id] != kept:
            out.append("the windows changed order")
    return out


# ── command line ─────────────────────────────────────────────────────────────────────────────────────────────

def say(line: str) -> None:
    print(line, flush=True)


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(prog="kc-sessions", description=__doc__.split("\n\n")[0])
    sub = ap.add_subparsers(dest="cmd", required=True)
    l = sub.add_parser("list")
    l.add_argument("--json", action="store_true")
    r = sub.add_parser("respawn")
    r.add_argument("targets", nargs="+")
    r.add_argument("--wait-idle", type=float, default=0.0, metavar="SECONDS")
    f = sub.add_parser("fork")
    f.add_argument("--fresh", action="store_true", help="start an empty conversation instead of continuing the old one")
    f.add_argument("target")
    f.add_argument("--prompt", default="Continue where you left off. The session was restarted in bypass-permissions mode.")
    t = sub.add_parser("retire")
    t.add_argument("id")
    t.add_argument("--rm", action="store_true")
    c = sub.add_parser("check")
    c.add_argument("--files-only", action="store_true")
    c.add_argument("--json", action="store_true")
    q = sub.add_parser("restart")
    q.add_argument("target")
    q.add_argument("--prompt", required=True)
    s = sub.add_parser("snapshot")
    s.add_argument("--no-herdr", action="store_true")
    d = sub.add_parser("diff")
    d.add_argument("before")
    d.add_argument("after")
    sub.add_parser("repair")
    sub.add_parser("windows")
    a = ap.parse_args(argv)
    try:
        if a.cmd == "list":
            jobs = load_jobs()
            rows = [{"id": j.id, "name": j.name, "state": j.state, "running": j.running, "mode": j.mode,
                     "superseded_by": (superseded_by(j, jobs).id if superseded_by(j, jobs) else None)} for j in jobs]
            if a.json:
                say(json.dumps(rows, indent=1))
            else:
                for x in sorted(rows, key=lambda x: x["name"]):
                    say(f"{x['id']}  {x['name']:38} {x['state']:8} {'running' if x['running'] else 'no worker':10} {x['mode']}"
                        + (f"  superseded by {x['superseded_by']}" if x["superseded_by"] else ""))
            return 0
        if a.cmd == "respawn":
            return 1 if respawn(a.targets, a.wait_idle, say) else 0
        if a.cmd == "restart":
            return 1 if restart_with_prompt(a.target, a.prompt, say) else 0
        if a.cmd == "fork":
            return 1 if fork(a.target, a.prompt, say, fresh=a.fresh) else 0
        if a.cmd == "retire":
            return 0 if retire(a.id, say, remove=a.rm) else 1
        if a.cmd == "check":
            issues = check(a.files_only)
            if a.json:
                say(json.dumps(issues, indent=1))
            else:
                for i in issues:
                    say(("info: " if i.get("info") else "drift: ") + describe(i))
                if not issues:
                    say("ok: nothing to fix")
            return 1 if any(not i.get("info") for i in issues) else 0
        if a.cmd == "snapshot":
            say(json.dumps(snapshot(not a.no_herdr), indent=1))
            return 0
        if a.cmd == "diff":
            b4 = json.loads(Path(a.before).read_text())
            lines = diff(b4, json.loads(Path(a.after).read_text()), workers=set(b4["workers"]))
            for ln in lines:
                say("changed: " + ln)
            return 1 if lines else 0
        if a.cmd == "repair":
            left = restore_ledger(say)
            return 1 if left else 0
        if a.cmd == "windows":
            att = {p: j for p, (j, _) in attachments().items()}
            for p in panes():
                say(f"{p.id:8} {p.workspace[:24]:24} {p.tab[:30]:30} {att.get(p.id, '-')}")
            return 0
    except Failure as e:
        print(f"kc-sessions: {e}", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
