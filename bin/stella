#!/usr/bin/env python3
"""stella: open Stella's permanent Claude session, starting it in the background first when it is not running.

    stella            attach to her session (Ctrl+Z drops back to the shell; she keeps running)
    stella start      start her in the background if she is not running, without attaching
    stella restart    restart her in place (same job, same window) so she reloads her manual and routines

She is an ordinary background session of Claude's daemon, named `stella`, running the agent file
~/.claude/agents/stella.md in her store ~/.local/share/stella. Nothing else is needed for her to exist.

Every run also writes her project settings (~/.local/share/stella/.claude/settings.json), so they can
always be rebuilt from this repo: the hooks that run `stella-check --watch` (it wakes her only when something needs
her), recaps off, a one-hour prompt cache, and, once `stella-check` has kept her PR tasks in files for a day, a
200k-token compaction window. Keys of that file this script does not manage are kept.

Standard library only.
"""

from __future__ import annotations

import importlib.machinery
import importlib.util
import json
import os
import subprocess
import sys
import time
from pathlib import Path

STORE = Path.home() / ".local/share/stella"
START = "Session start: do the start-of-session steps in your manual."
FLAGS = ["--dangerously-skip-permissions"]
CAP_AFTER = 86400  # the compaction cap waits until stella-check has written her PR tasks to files for this long


def watcher_hook() -> dict:
    # asyncRewake: runs in the background and wakes her on exit code 2; the timeout (seconds) must outlive the
    # watcher, or Claude Code kills it silently (the default is 600 s). stella-check exits on its own before a day.
    return {"type": "command", "command": "$HOME/.local/bin/stella-check --watch", "asyncRewake": True, "timeout": 86400}


def cap_ready() -> bool:
    try:
        first = (STORE / "events.log").read_text().splitlines()[0][:19]
        return time.time() - time.mktime(time.strptime(first, "%Y-%m-%d %H:%M:%S")) >= CAP_AFTER
    except (OSError, IndexError, ValueError):
        return False


def write_settings() -> None:
    """Her project settings: the watcher hooks, recaps off, a one-hour cache, and the compaction cap when ready."""
    path = STORE / ".claude/settings.json"
    path.parent.mkdir(parents=True, exist_ok=True)
    try:
        s = json.loads(path.read_text())
    except (OSError, ValueError):
        s = {}
    s.setdefault("env", {})["CLAUDE_CODE_ENABLE_AWAY_SUMMARY"] = "0"
    s["promptCacheTtl"] = "1h"
    if cap_ready():
        s["autoCompactWindow"] = 200000
    compact_note = {"type": "command", "command": "$HOME/.local/bin/stella-check --compact-note"}
    s["hooks"] = {**s.get("hooks", {}),
                  "SessionStart": [{"hooks": [watcher_hook()]}, {"matcher": "compact", "hooks": [compact_note]}],
                  "Stop": [{"hooks": [watcher_hook()]}],
                  "StopFailure": [{"hooks": [watcher_hook()]}]}
    tmp = path.with_suffix(".json.tmp")
    tmp.write_text(json.dumps(s, indent=2) + "\n")
    tmp.replace(path)


def claude(*args: str, cwd: Path | None = None) -> subprocess.CompletedProcess:
    return subprocess.run(["claude", *args], cwd=cwd, capture_output=True, text=True, timeout=60)


def row() -> dict | None:
    p = claude("agents", "--json", "--all")
    try:
        rows = json.loads(p.stdout)
    except ValueError:
        sys.exit(f"stella: claude agents failed: {(p.stderr or p.stdout).strip()[-200:]}")
    return next((a for a in rows if a.get("name") == "stella" and a.get("kind") == "background"), None)


def start() -> str:
    STORE.mkdir(parents=True, exist_ok=True)
    claude("--bg", "-n", "stella", "--agent", "stella", "--model", "sonnet", *FLAGS, "--", START, cwd=STORE)
    for _ in range(15):
        r = row()
        if r:
            return r["id"]
        time.sleep(1)
    sys.exit("stella: started, but the session did not show up in `claude agents`")


def sessions():
    """The kc-sessions module that sits next to this file."""
    path = Path(__file__).resolve().with_name("kc-sessions")
    loader = importlib.machinery.SourceFileLoader("kc_sessions", str(path))
    mod = importlib.util.module_from_spec(importlib.util.spec_from_loader("kc_sessions", loader))
    sys.modules["kc_sessions"] = mod
    loader.exec_module(mod)
    return mod


def restart() -> str:
    """Restart her in place (same job id, same flags, her window gets its attach back) so she reloads her manual."""
    r = row()
    if not r:
        return start()
    ks = sessions()
    try:
        problems = ks.restart_with_prompt("stella", START, lambda line: print(line, flush=True))
        job = ks.resolve("stella")
    except ks.Failure as e:
        sys.exit(f"stella: {e}")
    if problems:
        sys.exit("stella: restarted, but not every window was put back; run `kc-sessions check`")
    return job.id


def main() -> None:
    cmd = sys.argv[1:]
    if cmd not in ([], ["start"], ["restart"]):
        sys.exit(__doc__)
    write_settings()  # every path, so a running Stella picks up a changed hook at her next settings reload
    sid = restart() if cmd == ["restart"] else (row() or {}).get("id") or start()
    if cmd == ["start"]:
        return
    os.execvp("claude", ["claude", "attach", sid])


if __name__ == "__main__":
    main()
