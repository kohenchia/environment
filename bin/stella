#!/usr/bin/env python3
"""stella: open Stella's permanent Claude session, starting it first when it is not running.

    stella            go to her window (opening it when she is not running)
    stella start      make sure she runs, without going to her window; also starts `cy-follow` (`tw` runs this)
    stella restart    start her again with an empty conversation (her store keeps what she learned), so she reloads her
                      manual and routines and knows today's date

She is an ordinary Claude session named `stella`, running the agent file ~/.claude/agents/stella.md in her store
~/.local/share/stella. Since the switch to foreground sessions (`~/.local/state/cy/enabled`) she runs under `cy` in a
window of the herdr space `stella`, like every session; until her background job is moved into that window
(`cag adopt stella`, the migration's last step) she stays the background job of Claude's daemon she was, and
`stella` attaches it as before. Nothing else is needed for her to exist.

`start`, `restart` and a run that starts her also write her project settings (~/.local/share/stella/.claude/settings.json), so they can
always be rebuilt from this repo: the hooks that run `stella-check --watch` (it wakes her only when something needs
her), recaps off, a one-hour prompt cache, and, once `stella-check` has kept her PR tasks in files for a day, a
200k-token compaction window. Other keys and other hooks in that file are kept.

Standard library only.
"""

from __future__ import annotations

import importlib.machinery
import importlib.util
import json
import os
import shlex
import subprocess
import sys
import time
from pathlib import Path

STORE = Path.home() / ".local/share/stella"


def start_prompt() -> str:
    """Her first message: the date too, because a fresh conversation has no other way to know what day it is."""
    return f"Session start (today is {time.strftime('%A %Y-%m-%d')}): do the start-of-session steps in your manual."


FLAGS = ["--dangerously-skip-permissions"]
CAP_AFTER = 86400  # the compaction cap waits until stella-check has written her PR tasks to files for this long


def watcher_hook(fresh: bool = False) -> dict:
    # asyncRewake: runs in the background and wakes her on exit code 2; the timeout (seconds) must outlive the
    # watcher, or Claude Code kills it silently (the default is 600 s). stella-check exits on its own before a day.
    command = "$HOME/.local/bin/stella-check --watch" + (" --fresh" if fresh else "")
    # rewakeMessage / rewakeSummary (@internal in Claude Code 2.1.293, but accepted and honoured): what the wake says to
    # her, and the one line it leaves on screen, which her /calm module hides by this exact text.
    return {"type": "command", "command": command, "asyncRewake": True, "timeout": 86400,
            "rewakeMessage": "A wake from stella-check (not an error):", "rewakeSummary": "stella-check wake"}


def cap_ready() -> bool:
    """True once stella-check has kept her PR lists in pr-tasks.json for a day ("since" is its first write)."""
    try:
        return time.time() - int(json.loads((STORE / "pr-tasks.json").read_text())["since"]) >= CAP_AFTER
    except (OSError, ValueError, KeyError, TypeError):
        return False


def ours(entry: dict) -> bool:
    return any("stella-check" in str(h.get("command", "")) for h in entry.get("hooks", []))


def write_settings() -> None:
    """Her project settings: the watcher hooks, recaps off, a one-hour cache, and the compaction cap when ready.
    Hooks other than stella-check's, and every other key, are kept; a file that does not parse is left alone."""
    if not (Path.home() / ".local/bin/stella-check").exists():  # hooks that exit 127 would leave her deaf, silently
        sys.exit("stella: ~/.local/bin/stella-check is missing; run ./setup.sh in ~/github/environment, then this again")
    path = STORE / ".claude/settings.json"
    path.parent.mkdir(parents=True, exist_ok=True)
    try:
        s = json.loads(path.read_text())
    except FileNotFoundError:
        s = {}
    except (OSError, ValueError) as e:
        sys.exit(f"stella: {path} does not parse ({e}); fix it, then run this again")
    if not isinstance(s, dict) or not isinstance(s.get("hooks", {}), dict) or not isinstance(s.get("env", {}), dict):
        sys.exit(f"stella: {path} is not the shape stella expects (an object with object hooks and env); fix it, then run this again")
    s.setdefault("env", {})["CLAUDE_CODE_ENABLE_AWAY_SUMMARY"] = "0"
    s["promptCacheTtl"] = "1h"
    if cap_ready():
        s["autoCompactWindow"] = 200000
    compact_note = {"type": "command", "command": "$HOME/.local/bin/stella-check --compact-note"}
    # The fresh watcher belongs to a new session process only (startup, resume); a compaction or /clear keeps the
    # process, and so its watcher and its queued wakes.
    mine = {"SessionStart": [{"matcher": "startup|resume", "hooks": [watcher_hook(fresh=True)]},
                             {"matcher": "compact", "hooks": [compact_note]}],
            "Stop": [{"hooks": [watcher_hook()]}],
            "StopFailure": [{"hooks": [watcher_hook()]}]}
    hooks = s.setdefault("hooks", {})
    for event, entries in mine.items():
        hooks[event] = [e for e in hooks.get(event, []) if not ours(e)] + entries
    tmp = path.with_suffix(".json.tmp")
    tmp.write_text(json.dumps(s, indent=2) + "\n")
    tmp.replace(path)


def claude(*args: str, cwd: Path | None = None) -> subprocess.CompletedProcess:
    return subprocess.run(["claude", *args], cwd=cwd, capture_output=True, text=True, timeout=60)


def row() -> dict | None:
    p = claude("agents", "--json", "--all")
    try:
        rows = json.loads(p.stdout)
    except ValueError:
        sys.exit(f"stella: claude agents failed: {(p.stderr or p.stdout).strip()[-200:]}")
    return next((a for a in rows if a.get("name") == "stella" and a.get("kind") == "background"), None)


def start() -> str:
    STORE.mkdir(parents=True, exist_ok=True)
    claude("--bg", "-n", "stella", "--agent", "stella", "--model", "sonnet", *FLAGS, "--", start_prompt(), cwd=STORE)
    for _ in range(15):
        r = row()
        if r:
            return r["id"]
        time.sleep(1)
    sys.exit("stella: started, but the session did not show up in `claude agents`")


def sessions():
    """The kc-sessions module that sits next to this file."""
    path = Path(__file__).resolve().with_name("kc-sessions")
    loader = importlib.machinery.SourceFileLoader("kc_sessions", str(path))
    mod = importlib.util.module_from_spec(importlib.util.spec_from_loader("kc_sessions", loader))
    sys.modules["kc_sessions"] = mod
    loader.exec_module(mod)
    return mod


def restart() -> str:
    """Restart her with an empty conversation (same name, flags and window, a new job id; the old job is removed) so she
    reloads her manual and learns what day it is. What she learned lives in her store, not in the conversation."""
    r = row()
    if not r:
        return start()
    ks = sessions()
    try:
        problems = ks.fork("stella", start_prompt(), lambda line: print(line, flush=True), fresh=True)
        job = ks.resolve("stella")
    except ks.Failure as e:
        sys.exit(f"stella: {e}")
    if problems:
        sys.exit("stella: restarted, but not every window was put back; run `kc-sessions check`")
    return job.id


# ── her window (after the switch) ──────────────────────────────────────────────────────────────────────────────


def load(name: str, module: str):
    """A tool next to this file, as a module (`cy`'s launch files and requests, `kc-new`'s herdr helpers)."""
    path = Path(__file__).resolve().with_name(name)
    loader = importlib.machinery.SourceFileLoader(module, str(path))
    mod = importlib.util.module_from_spec(importlib.util.spec_from_loader(module, loader))
    loader.exec_module(mod)
    return mod


def cy():
    if not hasattr(cy, "mod"):
        cy.mod = load("cy", "cy_lib")
    return cy.mod


def her_window() -> dict | None:
    """Her newest `cy` launch, live or not (renamed too: by her agent, or a former name)."""
    mine = [l for l in cy().launches() if "stella" in (l.get("name"), l.get("agent")) or "stella" in (l.get("former_names") or [])]
    return max(mine, key=lambda l: (l.get("status") == "live", l.get("started_at") or 0), default=None)


def her_job() -> bool:
    """A job record named stella, with a process or not (the daemon respawns and retires workers, and has none after a
    reboot): until `cag adopt stella` moves her into a window, she is that job."""
    for f in (Path.home() / ".claude/jobs").glob("*/state.json"):
        try:
            if json.loads(f.read_text()).get("name") == "stella":
                return True
        except (OSError, ValueError):
            continue
    return False


SWITCH = Path.home() / ".local/state/cy/enabled"


def in_window() -> bool:
    """After the switch, once she has a window, or when she never was a job."""
    if not SWITCH.exists():  # tested without loading cy, so a broken cy never stops the old path
        return False
    return her_window() is not None or not her_job()


def open_window() -> dict | None:
    """Make sure her window runs, in the space `stella`: her conversation resumed, or, never started, a new one. A window
    waiting at its "⏎ resumes it here" line is hers to resume there; one a herdr restart interrupted is given herdr's
    restore first (it reruns her window's `cy -r`)."""
    w = her_window()
    if w and w.get("status") == "interrupted":
        w = cy().wait_for(lambda: (lambda x: x if x and x.get("status") == "live" else None)(her_window()),
                          float(os.environ.get("STELLA_RESTORE_WAIT", "30"))) or her_window()
    if w and (w.get("status") == "live" or cy().held(w["id"])):
        return w
    pf = cy().HOME / ".local/state/kc-new/prompts/stella.txt"  # read and deleted by cy
    pf.parent.mkdir(parents=True, exist_ok=True)
    pf.write_text(start_prompt())
    me = shlex.quote(str(Path(__file__).resolve().with_name("cy")))
    command = (f"{me} -r {shlex.quote(w['id'])} --prompt-file {shlex.quote(str(pf))}" if w else
               f"{me} -n stella --agent stella --model sonnet --prompt-file {shlex.quote(str(pf))}")
    try:
        load("kc-new", "kc_new").place({"space": "stella", "name": "stella", "dir": str(STORE)}, command)
    except (RuntimeError, OSError) as e:
        pf.unlink(missing_ok=True)
        sys.exit(f"stella: could not open her window ({e}); is herdr running? (`tw` starts it)")
    return cy().wait_for(lambda: next((l for l in cy().launches() if l.get("name") == "stella"
                                       and l.get("status") == "live"), None), float(os.environ.get("KC_NEW_START_WAIT", "20")))


def go_to(w: dict | None) -> None:
    tab = (w or {}).get("tab") or (cy().wait_for(lambda: (her_window() or {}).get("tab"), 10))
    if not tab or not cy().herdr_ok(cy().herdr("tab", "focus", tab)):
        sys.exit("stella: her window is open in the space `stella`; herdr would not go to it")
    if w and w.get("status") != "live":
        print("stella: press ⏎ in her window to resume her")


def restart_window() -> None:
    """A fresh conversation in her window, as a restart request; when she is not running, her window is resumed first,
    so there is only ever one Stella (her old key would otherwise come back on its own)."""
    w = open_window()
    if not w:
        sys.exit("stella: her window did not start in time; look in the space `stella`, then `stella restart` again")
    if w.get("status") != "live":
        sys.exit("stella: her window waits at its \"⏎ resumes it here\" line: press ⏎ there, then `stella restart`")
    req = cy().submit(w["id"], "restart", {"fresh": True, "prompt": start_prompt()}, by="kohen", not_after=7 * 86400)
    print(f"stella: restart queued ({req.name}); she restarts with an empty conversation when she is idle")


def main() -> None:
    cmd = sys.argv[1:]
    if cmd not in ([], ["start"], ["restart"]):
        sys.exit(__doc__)
    if SWITCH.exists():
        cy().start_follower()  # the follower runs wherever Stella does; tw runs `stella start`
    if in_window():
        write_settings()
        if cmd == ["restart"]:
            return restart_window()
        w = open_window()
        if cmd == []:
            go_to(w)
        return
    if cmd or row() is None:  # start, restart, or starting her now; a plain attach to a running Stella writes nothing
        write_settings()
    sid = restart() if cmd == ["restart"] else (row() or {}).get("id") or start()
    if cmd == ["start"]:
        return
    os.execvp("claude", ["claude", "attach", sid])


if __name__ == "__main__":
    main()
