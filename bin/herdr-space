#!/usr/bin/env python3
"""herdr-space: the two things herdr itself cannot do for the work window.

    herdr-space move up|down    move the focused space one place (bound to Cmd+Ctrl+Shift+Up/Down)
    herdr-space sync [--hours N] [--dry-run]
                                one space per project for every Claude session that needs you, is working,
                                or finished in the last N hours (default 48); idempotent (run by `tw`)

A session belongs to a project, and the space is named after the project's slug in Stella's projects.md
(~/.local/share/stella/projects.md: `## <slug> — <title>`, and a `Crew:` line naming its sessions). A session
no project lists goes to the project whose section mentions the number in its name (PR 2398), else to
`pr-<number>`, else to the name of its repository (a worktree ~/github/<repo>-wt/<branch> counts as <repo>),
else of its directory. Stella's own session is the space `stella`.

A space is tied to its project by the herdr workspace id, recorded in ~/.local/state/herdr-space/spaces.json
(slug -> workspace id and the name it has now), not by its name: rename a space in herdr whenever you like and
sync keeps treating it as the same project. The file also tells Stella what you call each project.

A window is named after its session and runs `claude attach <id>`; a finished session's window shows its log
first and attaches only when you press Enter (attaching starts a host process).

sync only adds and tidies what it made: a window named like a session that sits in another space than its
project's, or a second window for the same session, is closed (the session keeps running); a space whose name
is the bare number an earlier run used is renamed to its project. Your own windows and spaces are left alone.

Standard library only.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import signal
import socket
import subprocess
import sys
import time
from pathlib import Path

HOME = Path.home()
GITHUB = HOME / "github"
PROJECTS = HOME / ".local/share/stella/projects.md"
# project slug -> {"workspace_id", "name"}: which space is which project, so a space can be renamed freely
BINDINGS = HOME / ".local/state/herdr-space/spaces.json"
STELLA_SPACE = "stella"
STELLA_SESSION = "stella"
LIVE = ("blocked", "working")  # a session in these states always gets a window


def run(*cmd: str) -> subprocess.CompletedProcess:
    return subprocess.run(cmd, capture_output=True, text=True, timeout=30)


def socket_path() -> str:
    env = os.environ.get("HERDR_SOCKET_PATH")
    if env:
        return env
    p = run("herdr", "session", "list", "--json")
    try:
        return next(s["socket_path"] for s in json.loads(p.stdout)["sessions"] if s.get("default"))
    except (ValueError, KeyError, TypeError, StopIteration):
        sys.exit("herdr-space: no herdr server answers (start it with `tw`)")


def rpc(method: str, params: dict) -> dict:
    req = {"id": "herdr-space", "method": method, "params": params}
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as c:
        c.settimeout(5)
        c.connect(socket_path())
        c.sendall((json.dumps(req, separators=(",", ":")) + "\n").encode())
        buf = b""
        while b"\n" not in buf:
            chunk = c.recv(65536)
            if not chunk:
                break
            buf += chunk
    reply = json.loads(buf.split(b"\n", 1)[0])
    if reply.get("error") is not None:
        sys.exit(f"herdr-space: {method}: {reply['error']}")
    return reply.get("result") or {}


def spaces() -> list[dict]:
    """The workspaces in display order: each has workspace_id, label and focused."""
    return rpc("workspace.list", {}).get("workspaces", [])


# ---------------------------------------------------------------- move

def move(direction: str) -> None:
    ws = spaces()
    here = next((i for i, w in enumerate(ws) if w.get("focused")), None)
    if here is None:
        return
    to = here - 1 if direction == "up" else here + 1
    if 0 <= to < len(ws):
        rpc("workspace.move", {"workspace_id": ws[here]["workspace_id"], "insert_index": to})


# ---------------------------------------------------------------- which project a session belongs to

def norm(name: str) -> str:
    """A name compared loosely: 'merge benchmark-2399' and 'merge-benchmark-2399' are the same session."""
    return re.sub(r"[^a-z0-9]+", "-", name.lower()).strip("-")


def parse_projects(text: str) -> list[dict]:
    """[{slug, text, crew}] from projects.md: `## <slug> — <title>` sections and their `Crew:` lines."""
    out: list[dict] = []
    for block in re.split(r"(?m)^## ", text)[1:]:
        head, _, body = block.partition("\n")
        slug = re.split(r"\s+[—–-]\s+", head.strip(), maxsplit=1)[0].strip()
        crew: set[str] = set()
        for m in re.finditer(r"(?i)crew:\s*([^\n]*)", body):
            line = re.split(r"\s·\s", re.sub(r"\([^)]*\)", "", m.group(1)))[0]
            crew |= {norm(c) for c in line.split(",") if norm(c)}
        out.append({"slug": slug, "text": block, "crew": crew})
    return out


def load_projects() -> list[dict]:
    try:
        return parse_projects(PROJECTS.read_text())
    except OSError:
        return []


def project_of(a: dict, projects: list[dict] | None = None) -> str:
    name = a.get("name") or ""
    key = norm(name)
    if key == STELLA_SESSION:
        return STELLA_SPACE
    projects = projects or []
    for p in projects:
        if key in p["crew"]:
            return p["slug"]
    m = re.search(r"\d{3,}", name)
    if m:
        for p in projects:
            if re.search(rf"\b{m.group(0)}\b", p["text"]):
                return p["slug"]
        return f"pr-{m.group(0)}"
    cwd = Path(a.get("cwd") or HOME)
    try:
        top = cwd.relative_to(GITHUB).parts[0]
    except (ValueError, IndexError):
        return cwd.name or "home"
    return top[:-3] if top.endswith("-wt") else top


# ---------------------------------------------------------------- sync

def agents() -> list[dict]:
    p = run("claude", "agents", "--json", "--all")
    try:
        return [a for a in json.loads(p.stdout) if a.get("kind") == "background"]
    except ValueError:
        sys.exit(f"herdr-space: claude agents --json failed: {(p.stderr or p.stdout).strip()[-200:]}")


def finished_at(sid: str) -> float:
    try:
        return (HOME / ".claude/jobs" / sid / "state.json").stat().st_mtime
    except OSError:
        return 0.0


def attach_cmd(a: dict) -> str:
    sid = a["id"]
    if a.get("state") in LIVE or norm(a.get("name") or "") == STELLA_SESSION:
        return f"claude attach {sid}"
    return (f"claude logs {sid} | less -R +G; printf '\\nfinished: Enter attaches (it starts a host process) '; "
            f"read; claude attach {sid}")


def find_ids(x, keys: tuple[str, ...]) -> dict[str, str]:
    """{id: label} for every dict in a herdr reply that has one of `keys` as id and a label."""
    found: dict[str, str] = {}

    def walk(y):
        if isinstance(y, dict):
            ident = next((y[k] for k in keys if isinstance(y.get(k), str)), None)
            label = y.get("label") or y.get("custom_name")
            if ident and isinstance(label, str):
                found[ident] = label
            for v in y.values():
                walk(v)
        elif isinstance(y, list):
            for v in y:
                walk(v)

    walk(x)
    return found


def herdr_json(*args: str) -> dict:
    p = run("herdr", *args)
    if p.returncode != 0:
        sys.exit(f"herdr-space: herdr {' '.join(args)}: {(p.stderr or p.stdout).strip()[-200:]}")
    try:
        return json.loads(p.stdout)
    except ValueError:
        return {}


def stray_tabs(layout: dict[str, tuple[str, dict[str, str]]], owner: dict[str, str]) -> list[tuple[str, str, str]]:
    """Windows to close: (tab id, its label, why). `layout` is {space id: (space label, {tab id: label})} and
    `owner` {normalised session name: project}. A window named like a session is stray when it sits in a space
    that is not its project's, or when the same space already has a window for that session."""
    out = []
    for _, (space, tabs) in layout.items():
        seen: set[str] = set()
        for tid, label in tabs.items():
            key = norm(label)
            if key not in owner:
                continue
            if owner[key] != space:
                out.append((tid, label, f"belongs to {owner[key]}, not {space}"))
            elif key in seen:
                out.append((tid, label, f"second window for the same session in {space}"))
            else:
                seen.add(key)
    return out


def load_bindings() -> dict[str, dict]:
    try:
        data = json.loads(BINDINGS.read_text())
        return {k: v for k, v in data.items() if isinstance(v, dict)}
    except (OSError, ValueError):
        return {}


def bind(slug: str, spaces_now: dict[str, str], bindings: dict[str, dict]) -> str | None:
    """The workspace id of project `slug`, or None. `spaces_now` is {workspace id: its label now}. A space is
    found by the id it was bound to, so renaming it in herdr changes nothing; if that id is gone (the server
    restarted), by the name it had last time, then by the slug itself. A space another project is bound to is
    never taken."""
    rec = bindings.get(slug) or {}
    if rec.get("workspace_id") in spaces_now:
        return rec["workspace_id"]
    taken = {b.get("workspace_id") for s, b in bindings.items() if s != slug and b.get("workspace_id") in spaces_now}
    by_label = {label: wid for wid, label in spaces_now.items() if wid not in taken}
    for name in (rec.get("name"), slug):
        if name and name in by_label:
            return by_label[name]
    return None


def save_bindings(bindings: dict[str, dict]) -> None:
    BINDINGS.parent.mkdir(parents=True, exist_ok=True)
    BINDINGS.write_text(json.dumps(bindings, indent=1, sort_keys=True) + "\n")


def sync(hours: float, dry: bool) -> None:
    projects = load_projects()
    cutoff = time.time() - hours * 3600
    rows = agents()
    owner = {norm(a.get("name") or a["id"][:8]): project_of(a, projects) for a in rows}
    wanted: dict[str, list[dict]] = {}
    for a in rows:
        if a.get("state") in LIVE or norm(a.get("name") or "") == STELLA_SESSION or (
                a.get("state") == "done" and finished_at(a["id"]) >= cutoff):
            wanted.setdefault(owner[norm(a.get("name") or a["id"][:8])], []).append(a)
    # Stella first, then the projects with sessions that need you, then the rest
    order = sorted(wanted, key=lambda k: (k != STELLA_SPACE,
                                          not any(a.get("state") == "blocked" for a in wanted[k]), k))
    ws = find_ids(herdr_json("workspace", "list"), ("workspace_id", "id"))  # {workspace id: label now}
    bindings = load_bindings()

    def tabs_of(wid: str) -> dict[str, str]:
        return find_ids(herdr_json("tab", "list", "--workspace", wid), ("tab_id", "id"))

    for project in order:
        sessions = sorted(wanted[project], key=lambda a: (a.get("name") or "", a["id"]))
        cwd = sessions[0].get("cwd") or str(HOME)
        wid = bind(project, ws, bindings)
        if not wid:  # an earlier run named the space after the bare number in its sessions' names
            for a in sessions:
                m = re.search(r"\d{3,}", a.get("name") or "")
                num = next((w for w, label in ws.items() if m and label == m.group(0)), None)
                if num:
                    wid = num
                    print(f"{project}: renamed from {m.group(0)}")
                    if not dry:
                        run("herdr", "workspace", "rename", wid, project)
                        ws[wid] = project
                    break
        if wid:
            bindings[project] = {"workspace_id": wid, "name": ws.get(wid, project)}
        have = {norm(v) for v in tabs_of(wid).values()} if wid else set()
        pending = [a for a in sessions if norm(a.get("name") or a["id"][:8]) not in have]
        if not pending:
            continue
        print(f"{project}: + {', '.join(a.get('name') or a['id'][:8] for a in pending)}")
        if dry:
            continue
        for a in pending:
            label = a.get("name") or a["id"][:8]
            if not wid:
                res = herdr_json("workspace", "create", "--label", project, "--cwd", cwd, "--no-focus").get("result", {})
                wid = res["workspace"].get("workspace_id") or res["workspace"]["id"]
                tab = res["tab"].get("tab_id") or res["tab"]["id"]
                pane = res["root_pane"]["pane_id"]
                run("herdr", "tab", "rename", tab, label)
                ws[wid] = project
                bindings[project] = {"workspace_id": wid, "name": project}
            else:
                res = herdr_json("tab", "create", "--workspace", wid, "--label", label, "--cwd",
                                 a.get("cwd") or cwd, "--no-focus").get("result", {})
                pane = res["root_pane"]["pane_id"]
            run("herdr", "pane", "run", pane, attach_cmd(a))
    # a space counts under its project's slug, whatever it is called now
    slug_of = {b["workspace_id"]: slug for slug, b in bindings.items() if b.get("workspace_id") in ws}
    layout = {wid: (slug_of.get(wid, label), tabs_of(wid)) for wid, label in ws.items()}
    for tid, label, why in stray_tabs(layout, owner):
        print(f"close {label}: {why}")
        if not dry:
            run("herdr", "tab", "close", tid)
    if not dry:
        now = {w["workspace_id"]: w.get("label") or "" for w in spaces()}
        for slug, b in bindings.items():  # remember the name each space has now (Stella reads it)
            if b.get("workspace_id") in now:
                b["name"] = now[b["workspace_id"]]
        save_bindings(bindings)
        stella = bind(STELLA_SPACE, now, bindings)
        if stella:
            rpc("workspace.move", {"workspace_id": stella, "insert_index": 0})


# ---------------------------------------------------------------- dots: Claude's state on each window

# herdr has four states to report and draws each in one fixed way (the unknown state is a small grey dot), so
# the five dots are drawn by this program instead: `dot_<kind>` tokens on the window (agents panel) and on the
# space, each styled with its own colour in herdr.toml's sidebar rows. Only the current kind's token has a value.
#   prompt  a prompt waits for you             red
#   next    finished, next steps for you       yellow
#   working actively running                   blue
#   new     finished, nothing for you, unread  green, filled
#   read    finished, nothing for you, read    green, hollow
# The session's state is also reported to herdr (HERDR_STATE) so that herdr keeps its own seen tracking: a
# finished session is `idle` there, and herdr's `done` (idle not yet looked at) is what tells new from read.
HERDR_STATE = {"prompt": "blocked", "working": "working", "next": "unknown", "done": "idle"}
DOT_ORDER = ["prompt", "next", "working", "new", "read"]  # most urgent first
SOURCE = "herdr-space"
STATE_DIR = HOME / ".local/state/herdr-space"
JOBS = HOME / ".claude/jobs"
EVERY = 5  # seconds between looks
REFRESH = 120  # a report that has not changed is repeated this often, so a herdr restart does not lose it


def read_json(path: Path) -> dict:
    try:
        return json.loads(path.read_text())
    except (OSError, ValueError):
        return {}


def pending_prompt(job: dict) -> bool:
    """True when the session's transcript ends in a tool call nobody has answered: a question or approval
    dialog is on screen. A session that finished its turn with next steps ends in text instead."""
    path = job.get("linkScanPath")
    if not path:
        return False
    try:
        with open(path, "rb") as f:
            f.seek(0, 2)
            f.seek(max(0, f.tell() - 200_000))
            lines = f.read().decode("utf-8", "replace").splitlines()
    except OSError:
        return False
    for ln in reversed(lines):
        try:
            d = json.loads(ln)
        except ValueError:
            continue
        if d.get("type") not in ("assistant", "user"):
            continue
        content = (d.get("message") or {}).get("content")
        return d["type"] == "assistant" and isinstance(content, list) and any(
            isinstance(c, dict) and c.get("type") == "tool_use" for c in content)
    return False


def session_status(job: dict) -> str | None:
    """prompt, working, next or done for a job's state.json; None for a stopped or unknown session."""
    state = job.get("state")
    if state == "working":
        return "working"
    if state == "done":
        return "done"
    if state == "blocked":
        return "prompt" if pending_prompt(job) else "next"
    return None


def statuses() -> dict[str, tuple[str, str]]:
    """{normalised session name: (status, one line of what it needs)} from Claude's own job files."""
    out = {}
    if not JOBS.is_dir():
        return out
    for d in JOBS.iterdir():
        job = read_json(d / "state.json")
        name, st = job.get("name"), session_status(job)
        if name and st:
            out[norm(name)] = (st, (job.get("needs") or job.get("detail") or "")[:80])
    return out


def windows() -> dict[str, tuple[str, str]]:
    """{normalised window label: (pane id, space id)} of every window's first pane."""
    tab_label: dict[str, str] = {}
    tab_space: dict[str, str] = {}
    for wid in find_ids(herdr_json("workspace", "list"), ("workspace_id", "id")):
        tabs = find_ids(herdr_json("tab", "list", "--workspace", wid), ("tab_id", "id"))
        tab_label.update(tabs)
        tab_space.update({t: wid for t in tabs})
    out: dict[str, tuple[str, str]] = {}

    def walk(x):
        if isinstance(x, dict):
            if isinstance(x.get("pane_id"), str) and x.get("tab_id") in tab_label:
                out.setdefault(norm(tab_label[x["tab_id"]]), (x["pane_id"], tab_space[x["tab_id"]]))
            for v in x.values():
                walk(v)
        elif isinstance(x, list):
            for v in x:
                walk(v)

    walk(herdr_json("pane", "list"))
    return out


def agent_states() -> dict[str, str]:
    """{pane id: herdr's agent_status} from `herdr agent list`: `done` is idle that you have not looked at."""
    found: dict[str, str] = {}

    def walk(x):
        if isinstance(x, dict):
            if isinstance(x.get("pane_id"), str) and isinstance(x.get("agent_status"), str):
                found[x["pane_id"]] = x["agent_status"]
            for v in x.values():
                walk(v)
        elif isinstance(x, list):
            for v in x:
                walk(v)

    walk(herdr_json("agent", "list"))
    return found


def dot_key(status: str, herdr_status: str | None) -> str:
    """The dot for a session's status: a finished session is new until herdr has shown it as seen."""
    if status == "done":
        return "new" if herdr_status == "done" else "read"
    return status


def token_args(key: str | None) -> list[str]:
    """`--token`/`--clear-token` arguments that leave exactly the dot for `key` set (none when key is None)."""
    args: list[str] = []
    for k in DOT_ORDER:
        args += ["--token", f"dot_{k}={'○' if k == 'read' else '●'}"] if k == key else ["--clear-token", f"dot_{k}"]
    return args


def set_window_dot(pane: str, key: str | None) -> None:
    run("herdr", "pane", "report-metadata", pane, "--source", SOURCE, "--agent", "claude", *token_args(key))


def set_space_dot(space: str, key: str | None) -> None:
    run("herdr", "workspace", "report-metadata", space, "--source", SOURCE, *token_args(key))


def follow_once(last: dict) -> int:
    """Report each window's status and dot to herdr once per change (and every REFRESH seconds). Returns calls."""
    now, calls = time.time(), 0
    wins, st, shown = windows(), statuses(), agent_states()
    best: dict[str, str] = {}  # the most urgent dot of each space

    def due(k, value) -> bool:
        if last.get(k) == value and now - last.get(("at", k), 0) < REFRESH:
            return False
        last[k], last[("at", k)] = value, now
        return True

    for label, (pane, space) in wins.items():
        if label not in st:
            continue
        status, need = st[label]
        if due(("report", pane), (status, need)):
            run("herdr", "pane", "report-agent", pane, "--source", SOURCE, "--agent", "claude", "--state",
                HERDR_STATE[status], "--message", need or status, "--seq", str(time.time_ns() // 1000))
            calls += 1
        key = dot_key(status, shown.get(pane))
        if due(("dot", pane), key):
            set_window_dot(pane, key)
            calls += 1
        if key in DOT_ORDER and (space not in best or DOT_ORDER.index(key) < DOT_ORDER.index(best[space])):
            best[space] = key
    for space in {w[1] for w in wins.values()}:
        if due(("space", space), best.get(space)):
            set_space_dot(space, best.get(space))
            calls += 1
    return calls


FOLLOW_VERSION = 2  # raise it when the reporter's behaviour changes: `tw` then replaces a reporter running the old code


def follower() -> tuple[int, int] | None:
    """(pid, version) of the running reporter, or None (no pid file, or a stale one). A pid file written by a
    version before versions existed has only the pid: version 0."""
    try:
        parts = (STATE_DIR / "follow.pid").read_text().split()
        pid = int(parts[0])
        os.kill(pid, 0)
        return pid, int(parts[1]) if len(parts) > 1 else 0
    except (OSError, ValueError, IndexError):
        return None


def follower_pid() -> int | None:
    f = follower()
    return f[0] if f else None


def follow() -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    (STATE_DIR / "follow.pid").write_text(f"{os.getpid()} {FOLLOW_VERSION}\n")
    last: dict = {}
    while True:
        try:
            follow_once(last)
        except (SystemExit, Exception):  # herdr not answering: try again, never die
            last.clear()
        time.sleep(EVERY)


def ensure_follower() -> None:
    """Start the reporter detached from this shell unless one of this version runs; replace an older one."""
    running = follower()
    if running and running[1] == FOLLOW_VERSION:
        return
    if running:
        try:
            os.kill(running[0], signal.SIGTERM)
        except OSError:
            pass
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    log = open(STATE_DIR / "follow.log", "ab")
    subprocess.Popen([sys.executable, str(Path(__file__).resolve()), "follow"], stdin=subprocess.DEVNULL,
                     stdout=log, stderr=log, start_new_session=True)


def probe(clear: bool) -> None:
    """A space `probe` with one window per dot, to see each colour as drawn."""
    existing = {label: wid for wid, label in find_ids(herdr_json("workspace", "list"), ("workspace_id", "id")).items()}
    if clear:
        if "probe" in existing:
            run("herdr", "workspace", "close", existing["probe"])
        return
    if "probe" in existing:
        sys.exit("herdr-space: the probe space exists; close it with `herdr-space probe --clear`")
    res = herdr_json("workspace", "create", "--label", "probe", "--cwd", str(HOME), "--no-focus").get("result", {})
    wid, tab, pane = res["workspace"]["workspace_id"], res["tab"]["tab_id"], res["root_pane"]["pane_id"]
    kinds = [("1-prompt-red", "prompt"), ("2-next-yellow", "next"), ("3-working-blue", "working"),
             ("4-new-green-filled", "new"), ("5-read-green-hollow", "read")]
    for i, (label, kind) in enumerate(kinds):
        if i:
            pane = herdr_json("tab", "create", "--workspace", wid, "--label", label, "--cwd", str(HOME),
                              "--no-focus")["result"]["root_pane"]["pane_id"]
        else:
            run("herdr", "tab", "rename", tab, label)
        run("herdr", "pane", "run", pane, "sleep 3600")
        run("herdr", "pane", "report-agent", pane, "--source", "herdr-space-probe", "--agent", "claude", "--state",
            {"new": "idle", "read": "idle"}.get(kind) or HERDR_STATE[kind], "--message", kind,
            "--seq", str(time.time_ns() // 1000))
        set_window_dot(pane, kind)
    set_space_dot(wid, "prompt")
    print("probe space opened: its windows should show red, yellow, blue, green and a hollow green dot")


def main() -> None:
    ap = argparse.ArgumentParser(prog="herdr-space")
    sub = ap.add_subparsers(dest="cmd", required=True)
    m = sub.add_parser("move")
    m.add_argument("direction", choices=["up", "down"])
    s = sub.add_parser("sync")
    s.add_argument("--hours", type=float, default=48)
    s.add_argument("--dry-run", action="store_true")
    f = sub.add_parser("follow")
    f.add_argument("--ensure", action="store_true", help="start the reporter in the background unless it runs")
    p = sub.add_parser("probe")
    p.add_argument("--clear", action="store_true")
    args = ap.parse_args()
    if args.cmd == "follow":
        ensure_follower() if args.ensure else follow()
        return
    if args.cmd == "probe":
        probe(args.clear)
        return
    if args.cmd == "move":
        move(args.direction)
    else:
        sync(args.hours, args.dry_run)


if __name__ == "__main__":
    main()
