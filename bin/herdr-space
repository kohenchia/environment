#!/usr/bin/env python3
"""herdr-space: the one thing herdr itself cannot do for the work window.

    herdr-space move up|down    move the focused space one place (bound to Cmd+Ctrl+Shift+K / J)

herdr has actions to create, walk, rename and close spaces, but none to reorder one, so this sends herdr's
`workspace.move_block` over its control socket. Everything else in the left column is herdr's own.

Standard library only.
"""

from __future__ import annotations

import argparse
import json
import os
import socket
import subprocess
import sys


def socket_path() -> str:
    env = os.environ.get("HERDR_SOCKET_PATH")
    if env:
        return env
    p = subprocess.run(["herdr", "session", "list", "--json"], capture_output=True, text=True, timeout=30)
    try:
        return next(s["socket_path"] for s in json.loads(p.stdout)["sessions"] if s.get("default"))
    except (ValueError, KeyError, TypeError, StopIteration):
        sys.exit("herdr-space: no herdr server answers (start it with `tw`)")


def rpc(method: str, params: dict) -> dict:
    req = {"id": "herdr-space", "method": method, "params": params}
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as c:
        c.settimeout(5)
        c.connect(socket_path())
        c.sendall((json.dumps(req, separators=(",", ":")) + "\n").encode())
        buf = b""
        while b"\n" not in buf:
            chunk = c.recv(65536)
            if not chunk:
                break
            buf += chunk
    reply = json.loads(buf.split(b"\n", 1)[0])
    if reply.get("error") is not None:
        sys.exit(f"herdr-space: {method}: {reply['error']}")
    return reply.get("result") or {}


def spaces() -> list[dict]:
    """The workspaces in display order: each has workspace_id, label and focused."""
    return rpc("workspace.list", {}).get("workspaces", [])


def move(direction: str) -> None:
    """Move the focused space one place. `workspace.move_block` names the space to go before (none = the end),
    so the target is explicit; `workspace.move`'s insert_index cannot be trusted to mean "after the removal"
    (moving down by index did nothing)."""
    ws = spaces()
    here = next((i for i, w in enumerate(ws) if w.get("focused")), None)
    if here is None:
        return
    if direction == "up":
        if here == 0:
            return
        before = ws[here - 1]["workspace_id"]
    else:
        if here == len(ws) - 1:
            return
        before = ws[here + 2]["workspace_id"] if here + 2 < len(ws) else None
    rpc("workspace.move_block", {"workspace_ids": [ws[here]["workspace_id"]], "before_workspace_id": before})


def main() -> None:
    ap = argparse.ArgumentParser(prog="herdr-space")
    sub = ap.add_subparsers(dest="cmd", required=True)
    m = sub.add_parser("move")
    m.add_argument("direction", choices=["up", "down"])
    args = ap.parse_args()
    move(args.direction)


if __name__ == "__main__":
    main()
