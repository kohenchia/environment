#!/usr/bin/env python3
"""kc-new: start a new Claude session, in a herdr space, on behalf of a session that cannot do it itself.

A session's shell runs in Claude Code's command sandbox, where `claude` cannot start and herdr's socket cannot be
reached. This helper is the one thing that is allowed to run outside it (a single exact entry in the sandbox's
command allowlist), so it takes no arguments and trusts nothing it reads. The session writes a request, then runs
`~/.local/bin/kc-new` alone:

    $CLAUDE_JOB_DIR/tmp/kc-new.json     {"space": "reports", "dir": "~/github/project",
                                         "name": "reports-docs", "prompt": "..."}

`space` is the herdr space to put the session's window in (created when none has that name), `dir` the working
directory (it must be under ~/github or a directory listed in ~/.config/kc-new/roots), `name` the session's name (lower-case, digits, dashes;
default: the space's), `prompt` its first message, and the optional `model` (opus, sonnet or haiku; default: the
machine's default model) and `effort` (low, medium, high, xhigh or max) the session runs on. The helper starts the background session like `cy` would,
opens a window in the space that runs `claude attach <id>`, and prints one line; the result is also written to
$CLAUDE_JOB_DIR/tmp/kc-new.result.json. It scans every job's tmp directory for requests, oldest first, and
deletes each request as it reads it, so a bad one is never retried.

A second kind of request restarts a named session. A session in a mode that makes it hold Stella's messages for
approval is continued in bypass-permissions mode (one new job: the window is moved to it and the old record is removed
when nothing was done in it since); a session already in bypass mode is restarted in place with "force", which keeps
its job id, flags and crons and reloads the instruction files:

    $CLAUDE_JOB_DIR/tmp/kc-new.json     {"restart": "2332-include-consistency", "prompt": "optional first message",
                                         "space": "optional herdr space to put a window in", "force": true}

It refuses the session called stella (`stella restart` does that), a session already in bypass mode unless "force" is
true, a session that is busy (retry when it is idle), and a name that more than one session holds.
Both restarts are done by `kc-sessions` (next to this file), which also gives the windows their attach back.

A third kind reports on, or repairs, the state of the sessions and windows:

    $CLAUDE_JOB_DIR/tmp/kc-new.json     {"doctor": "report"}      any session: drift in names, windows, tokens (read-only)
                                        {"doctor": "repair"}      only Stella's own job, no parameters, at most once in
                                                                  10 minutes: put every window and session right, never the
                                                                  session that asked

Report and repair run the machine's hooks `~/.config/kc-sessions/doctor` and `~/.config/kc-sessions/repair` when
they exist (the work setup installs them), else `kc-sessions check` / `kc-sessions repair`.

A fourth and a fifth kind move a session's window and rename a session, neither restarting it:

    $CLAUDE_JOB_DIR/tmp/kc-new.json     {"move": "2332-include-consistency", "space": "reports"}
                                        {"rename": "2332-include-consistency", "to": "include-consistency"}

`move` puts the window that runs `claude attach <id>` in the space as a new tab (the space is made when none has that
name); it refuses a name that more than one session holds and a session with no window or with more than one. `rename`
changes the session's name the way the agents view does (its state.json) and the title of its window when that shows the
old name; the new name is lower-case letters, digits and dashes. It refuses `stella`, a busy session (retry when it is
idle), a name that more than one session holds, and a name a live session already has. Neither takes other fields.

A sixth kind stops a session and removes its record, so a throwaway can be cleaned up from the sandbox:

    $CLAUDE_JOB_DIR/tmp/kc-new.json     {"retire": "reports-docs"}

Only the session that started it through kc-new may ask (kc-new records who started whom in
~/.local/state/kc-sessions/started.json), and Stella, for any session. It refuses `stella`, the asker itself, a busy session
(retry when idle) and a name that more than one session holds. A session that runs in a git worktree is stopped but its
record stays. The window falls back to its shell and is left open.

A new session may not take a name that a live session already has.

After it starts a session, kc-new runs the machine's hook `~/.config/kc-new/after-start <new job id>` when it exists
(environment KC_CALLER_JOB = the job that asked). The work setup uses it so that a session started by another one bills
the token the asker bills. A hook that fails does not undo the session: the line kc-new prints says so.

Foreground sessions (`cy` windows). A session that is not a background job writes its request to
`~/.local/state/kc-new/requests/<its CLAUDE_CODE_SESSION_ID>.json`; the answer is `<that id>.result.json` beside it.
For a session in a `cy` window, and for a new session, the requests work through `cy` (next to this file) once the
switch has happened (`~/.local/state/cy/enabled`), and before it only for names starting `fg-probe`:

  - a new session gets a window running `cy -n NAME --prompt-file <file>` (the prompt is saved under
    ~/.local/state/kc-new/prompts/, so no length limit or shell quoting applies; `cy` deletes it once read), on the
    token the asker is pinned to, if it is pinned;
  - `restart` (with `prompt`, `fresh`, `token`; `force` is accepted and changes nothing), `rename` and `retire` are
    queued for the follower, which carries each out when the session is idle: the answer is `queued`, naming the
    request's file, and the follower's verdict appears beside it as `.result.json` (`cag` shows it pending meanwhile);
  - `move` moves the window's pane; the follower follows it;
  - `{"branch": NAME, "to": NEW, "space": S}` opens a window in S running `cy -r NAME --branch NEW`, a copy of the
    conversation as a new session.

Who may retire a window: the session that started it (its launch file's `started_by`) and Stella. A request naming a
session that is neither a background job nor a `cy` window (a plain `claude`) is refused with `cag adopt NAME`.

Standard library only.
"""

from __future__ import annotations

import importlib.machinery
import importlib.util
import json
import os
import re
import shlex
import subprocess
import sys
import time
from pathlib import Path

REQUEST = "kc-new.json"
RESULT = "kc-new.result.json"
SPACE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9 ._#-]{0,60}$")
NAME = re.compile(r"^[a-z0-9][a-z0-9-]{0,48}$")
MAX_PROMPT = 20_000
MODELS = ("opus", "sonnet", "haiku")
EFFORTS = ("low", "medium", "high", "xhigh", "max")


def home() -> Path:
    return Path(os.environ.get("HOME") or Path.home())


_KS = None


def sessions():
    """The kc-sessions module that sits next to this file."""
    global _KS
    if _KS is None:
        path = Path(__file__).resolve().with_name("kc-sessions")
        loader = importlib.machinery.SourceFileLoader("kc_sessions", str(path))
        _KS = importlib.util.module_from_spec(importlib.util.spec_from_loader("kc_sessions", loader))
        sys.modules["kc_sessions"] = _KS  # dataclasses look their module up here
        loader.exec_module(_KS)
    return _KS


_CY = None


def cy():
    """The `cy` library next to this file: launch files, requests, the follower."""
    global _CY
    if _CY is None:
        path = Path(__file__).resolve().with_name("cy")
        loader = importlib.machinery.SourceFileLoader("cy_lib", str(path))
        _CY = importlib.util.module_from_spec(importlib.util.spec_from_loader("cy_lib", loader))
        loader.exec_module(_CY)
    return _CY


def windows_for(name: str | None) -> bool:
    """Does this name go through `cy`: every name after the switch, only the probes' before it. Decided without loading
    `cy`, so a broken checkout of it never stops a job's request."""
    return str(name or "").startswith("fg-probe") or (home() / ".local/state/cy/enabled").exists()


def window_of(name) -> dict | None:
    """The `cy` launch a request names, when it goes through `cy`: a live window first, then one that holds the name
    (or key) now, then a conversation id, then a former name, newest first. An ended window gives way to a live job
    of that name."""
    if not isinstance(name, str) or not windows_for(name):
        return None
    rank = lambda l: (0 if name in (l.get("name"), l["id"]) else 1 if name in (l.get("conversations") or [])
                      else 2 if name in (l.get("former_names") or []) else None)
    hits = [l for l in cy().launches() if rank(l) is not None]
    if not hits:
        return None
    best = min(hits, key=lambda l: (l.get("status") != "live", rank(l), -(l.get("started_at") or 0)))
    if best.get("status") != "live" and any(j.name == name and j.running for j in sessions().load_jobs()):
        return None
    return best


def roots() -> tuple[Path, ...]:
    """~/github, plus one directory per line of ~/.config/kc-new/roots (a machine adds its own there)."""
    extra = []
    try:
        extra = [Path(ln.strip()).expanduser() for ln in (home() / ".config/kc-new/roots").read_text().splitlines()
                 if ln.strip() and not ln.lstrip().startswith("#")]
    except OSError:
        pass
    return (home() / "github", *extra)


def validate(req) -> dict:
    """The request with every field checked and normalised, or ValueError with one sentence saying what is wrong."""
    if not isinstance(req, dict):
        raise ValueError("the request must be a JSON object")
    space, name, prompt = req.get("space"), req.get("name"), req.get("prompt")
    if not isinstance(space, str) or not SPACE.match(space):
        raise ValueError("space must be 1-61 characters: letters, digits, space, dot, dash, underscore, #")
    if name is None:
        name = re.sub(r"[^a-z0-9]+", "-", space.lower()).strip("-")[:49] or "session"
    if not isinstance(name, str) or not NAME.match(name):
        raise ValueError("name must be lower-case letters, digits and dashes, 1-49 characters")
    if not isinstance(prompt, str) or not prompt.strip() or len(prompt) > MAX_PROMPT:
        raise ValueError(f"prompt must be a non-empty string of at most {MAX_PROMPT} characters")
    raw = req.get("dir")
    if not isinstance(raw, str):
        raise ValueError("dir is required")
    directory = Path(raw).expanduser().resolve()
    if not directory.is_dir() or not any(r.resolve() in (directory, *directory.parents) for r in roots()):
        raise ValueError("dir must be an existing directory under ~/github or a root listed in ~/.config/kc-new/roots")
    model = req.get("model")
    if model is not None and model not in MODELS:
        raise ValueError(f"model, when given, must be one of {', '.join(MODELS)}")
    effort = req.get("effort")
    if effort is not None and effort not in EFFORTS:
        raise ValueError(f"effort, when given, must be one of {', '.join(EFFORTS)}")
    return {"space": space, "name": name, "prompt": prompt, "dir": str(directory), "model": model, "effort": effort}


def run(*cmd: str, cwd: str | None = None) -> subprocess.CompletedProcess:
    return subprocess.run(cmd, cwd=cwd, capture_output=True, text=True, timeout=60)


def refuse_live_name(name: str, advice: str = "restart it with a restart request or pick another name") -> None:
    ks = sessions()
    live = [j for j in ks.load_jobs() if j.name == name and (j.running or j.state in ("working", "blocked"))]
    if live:
        raise ValueError(f"a session called {name} already exists ({live[0].id}); {advice}")


def start_session(req: dict) -> str:
    """Start the background session (the same flags as `cy`) and return its id."""
    refuse_live_name(req["name"])
    model = ["--model", req["model"]] if req.get("model") else []
    model += ["--effort", req["effort"]] if req.get("effort") else []
    p = run("claude", "--bg", "-n", req["name"], *model, "--dangerously-skip-permissions", "--", req["prompt"], cwd=req["dir"])
    if p.returncode != 0:
        raise RuntimeError(f"claude --bg failed: {(p.stderr or p.stdout).strip()[-200:]}")
    for _ in range(20):
        try:
            rows = json.loads(run("claude", "agents", "--json").stdout)
        except ValueError:
            rows = []
        row = next((r for r in rows if r.get("name") == req["name"] and r.get("kind") == "background"), None)
        if row:
            return row["id"]
        time.sleep(1)
    raise RuntimeError(f"session {req['name']} did not show up in `claude agents`")


def after_start(request: Path, sid: str) -> str:
    """Run the machine's after-start hook for the new session; returns a warning, or "" when there is none."""
    hook = home() / ".config/kc-new/after-start"
    if not (hook.is_file() and os.access(hook, os.X_OK)):
        return ""
    if not caller_job(request):
        return ""  # a foreground asker has no job to inherit a token from: the session takes the default
    try:
        p = subprocess.run([str(hook), sid], capture_output=True, text=True, timeout=300,
                           env=dict(os.environ, KC_CALLER_JOB=caller_job(request)), start_new_session=True)
    except subprocess.TimeoutExpired:
        return "the after-start hook timed out"
    if p.returncode != 0:
        return f"the after-start hook failed: {(p.stderr or p.stdout).strip()[-200:]}"
    return ""


def find(x, key: str):
    """The first value for `key` anywhere in a herdr reply."""
    if isinstance(x, dict):
        if key in x:
            return x[key]
        for v in x.values():
            r = find(v, key)
            if r is not None:
                return r
    elif isinstance(x, list):
        for v in x:
            r = find(v, key)
            if r is not None:
                return r
    return None


def herdr(*args: str) -> dict:
    p = run("herdr", *args)
    try:
        return json.loads(p.stdout)
    except ValueError:
        raise RuntimeError(f"herdr {' '.join(args)} failed: {(p.stderr or p.stdout).strip()[-200:] or 'no reply'}")


def space_id(label: str) -> str | None:
    found = None

    def walk(x):
        nonlocal found
        if isinstance(x, dict):
            wid = x.get("workspace_id") or x.get("id")
            if isinstance(wid, str) and x.get("label") == label and "tab_id" not in x and "pane_id" not in x:
                found = found or wid
            for v in x.values():
                walk(v)
        elif isinstance(x, list):
            for v in x:
                walk(v)

    walk(herdr("workspace", "list"))
    return found


def place(req: dict, command: str) -> str:
    """Open a window running `command` in the space (made when missing); returns the pane id."""
    wid = space_id(req["space"])
    if wid:
        reply = herdr("tab", "create", "--workspace", wid, "--label", req["name"], "--cwd", req["dir"], "--no-focus")
    else:
        reply = herdr("workspace", "create", "--label", req["space"], "--cwd", req["dir"], "--no-focus")
        tab = find(reply.get("result", {}).get("tab"), "tab_id") or find(reply.get("result", {}).get("tab"), "id")
        if tab:
            run("herdr", "tab", "rename", tab, req["name"])
    pane = find(reply.get("result", {}).get("root_pane"), "pane_id")
    if not pane:
        raise RuntimeError("herdr gave no pane for the new window")
    run("herdr", "pane", "run", pane, command)
    return pane


def restart_session(req: dict) -> tuple[bool, str, dict]:
    """Continue a named session in bypass mode (a fork), or restart a bypass one in place (force). kc-sessions does the work."""
    ks = sessions()
    name = req.get("restart")
    if not isinstance(name, str) or not re.match(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,60}$", name):
        raise ValueError("restart must be the name of a session")
    if name == "stella":
        raise ValueError("stella is not restarted by this helper (run `stella restart`)")
    explicit = bool(req.get("prompt"))
    prompt = req.get("prompt") or "Continue where you left off. The session was restarted in bypass-permissions mode."
    if not isinstance(prompt, str) or len(prompt) > MAX_PROMPT:
        raise ValueError(f"prompt must be a string of at most {MAX_PROMPT} characters")
    space = req.get("space")
    if space is not None and (not isinstance(space, str) or not SPACE.match(space)):
        raise ValueError("space must be 1-61 characters: letters, digits, space, dot, dash, underscore, #")
    try:
        job = ks.resolve(name)
    except ks.Failure as e:
        raise ValueError(str(e))
    mode = job.mode
    if mode == "bypassPermissions" and not req.get("force"):
        raise ValueError(f"{name} is already in bypass-permissions mode (use force to restart it anyway, e.g. to reload the instructions)")
    if job.busy:
        raise ValueError(f"{name} is busy; retry when it is idle")
    lines: list[str] = []
    try:
        if mode == "bypassPermissions":
            problems = ks.restart_with_prompt(job.id, prompt, lines.append) if explicit else ks.respawn([job.id], 0.0, lines.append)
            new_id = ks.resolve(name).id
        else:
            problems = ks.fork(job.id, prompt, lines.append)
            new_id = ks.resolve(name).id
    except ks.Failure as e:
        raise RuntimeError(str(e))
    info = {"ok": not problems, "restarted": name, "id": new_id, "was": mode, "log": lines}
    if space:
        place({"space": space, "name": name, "dir": job.cwd}, f"claude attach {new_id}")
        info["space"] = space
    how = "restarted in place" if new_id == job.id else f"continued as {new_id}"
    line = f"kc-new: {how}: {name} ({new_id}) in bypass-permissions mode (was {mode})"
    if problems:
        line += f"; {problems} window(s) not put back, see the log and `doctor`"
    return not problems, line, info


SESSION = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,60}$")


def resolve_target(field: str, value) -> object:
    """The one job a request names, or ValueError (no such session, or a name that more than one session holds)."""
    ks = sessions()
    if not isinstance(value, str) or not SESSION.match(value):
        raise ValueError(f"{field} must be the name of a session")
    try:
        return ks.resolve(value)
    except ks.Failure as e:
        raise ValueError(str(e))


def attached_panes(job_id: str) -> list[str]:
    """Every herdr pane that runs `claude attach <job_id>`."""
    ks = sessions()
    try:
        return [pane for pane, (job, _) in ks.attachments().items() if job == job_id]
    except ks.Failure as e:
        raise RuntimeError(str(e))


def move_session(req: dict) -> tuple[bool, str, dict]:
    """Move a session's window (the pane running `claude attach`) into a space, made when none has that name. The session
    is not touched: the pane keeps its process, so nothing restarts."""
    ks = sessions()
    if set(req) - {"move", "space"}:
        raise ValueError('a move request has only "move" and "space"')
    space = req.get("space")
    if not isinstance(space, str) or not SPACE.match(space):
        raise ValueError("space must be 1-61 characters: letters, digits, space, dot, dash, underscore, #")
    job = resolve_target("move", req.get("move"))
    panes = attached_panes(job.id)
    if not panes:
        raise ValueError(f"no herdr window attaches {job.name} ({job.id}); open one with `claude attach {job.id}`")
    if len(panes) > 1:
        raise ValueError(f"{len(panes)} windows attach {job.name} ({job.id}): {', '.join(panes)}; close the extra ones first")
    table = {p.id: p for p in ks.panes()}
    here = table.get(panes[0])
    if here is not None and here.workspace == space:
        return True, f"kc-new: {job.name} is already in space {space}", {"ok": True, "moved": job.name, "id": job.id, "space": space,
                                                                         "pane": panes[0], "unchanged": True}
    pane, wid = move_pane(panes[0], job.name, space)
    was = f"{here.workspace}/{here.tab}" if here else "unknown"
    return True, f"kc-new: moved {job.name} ({job.id}) from {was} to space {space}" + ("" if wid else " (new)"), {
        "ok": True, "moved": job.name, "id": job.id, "space": space, "pane": pane, "was": was, "created_space": not wid}


def move_pane(pane: str, label: str, space: str) -> tuple[str, str | None]:
    """Move a pane into the space as a new tab called `label` (the space is made when missing); returns the pane's id
    after the move and the space's id (None when it was made)."""
    wid = space_id(space)
    if wid:
        reply = herdr("pane", "move", pane, "--new-tab", "--workspace", wid, "--label", label, "--no-focus")
    else:
        reply = herdr("pane", "move", pane, "--new-workspace", "--label", space, "--tab-label", label, "--no-focus")
    if find(reply, "error") is not None:
        raise RuntimeError(f"herdr did not move the window: {json.dumps(find(reply, 'error'))[:200]}")
    return find(find(reply, "move_result"), "pane_id") or pane, wid


def rename_session(req: dict) -> tuple[bool, str, dict]:
    """Give a session another name (its state.json, as the agents view does) and the window's title with it. Not for stella,
    not for a busy session, not to a name a live session has."""
    ks = sessions()
    if set(req) - {"rename", "to"}:
        raise ValueError('a rename request has only "rename" and "to"')
    new = req.get("to")
    if not isinstance(new, str) or not NAME.match(new):
        raise ValueError("to must be lower-case letters, digits and dashes, 1-49 characters")
    job = resolve_target("rename", req.get("rename"))
    if job.name == "stella" or job.template == "stella" or new == "stella":
        raise ValueError("stella is not renamed (her session and her tooling go by that name)")
    if new == job.name:
        raise ValueError(f"{job.name} is already called {new}")
    if job.busy:
        raise ValueError(f"{job.name} is busy; retry when it is idle")
    refuse_live_name(new, "pick another name")
    old = job.name
    try:
        ks.rename_job(job.id, new)
    except ks.Failure as e:
        raise RuntimeError(str(e))
    info: dict = {"ok": True, "renamed": old, "to": new, "id": job.id}
    warning = ""
    try:
        panes = attached_panes(job.id)
        table = {p.id: p for p in ks.panes()} if panes else {}
        titled = sorted({table[p].tab_id for p in panes if p in table and table[p].tab == old})
        for tab in titled:
            herdr("tab", "rename", tab, new)
        info["windows"] = titled
    except RuntimeError as e:
        warning = f"the session is renamed, but its window title is not: {e}"
    if warning:
        info.update(ok=False, warning=warning)
    return not warning, f"kc-new: renamed {old} ({job.id}) to {new}" + (f"; WARNING: {warning}" if warning else ""), info


def caller_job(request: Path) -> str:
    """The background job that wrote the request ("" for a foreground session's request)."""
    return request.parent.parent.name if request.name == REQUEST else ""


def caller_key(request: Path) -> str:
    """Who asked, for started.json: the job's id, or `fg:<session id>` for a foreground session."""
    return caller_job(request) or f"fg:{request.stem}"


def window_requests() -> Path:
    return home() / ".local/state/kc-new/requests"


def result_file(request: Path) -> Path:
    return request.with_name(RESULT) if request.name == REQUEST else request.with_name(request.stem + ".result.json")


def asker(request: Path) -> dict:
    """Who wrote the request: its name, whether it is Stella, its `cy` launch when it runs in a window, and its key (the
    first conversation id, which no rename, /clear or restart changes): what `started_by` and a request's `by` hold."""
    jid = caller_job(request)
    if jid:
        job = next((j for j in sessions().load_jobs() if j.id == jid), None)
        return {"name": job.name if job else "", "stella": bool(job and job.name == "stella" and job.template == "stella"),
                "job": jid, "key": job.session_id if job else ""}
    sid = request.stem
    l = next((l for l in cy().launches() if sid == l["id"] or sid in (l.get("conversations") or [])), None)
    if l:
        return {"name": l.get("name") or "", "stella": l.get("name") == "stella" and l.get("agent") == "stella",
                "window": l, "key": l["id"]}
    row = cy().live_row([sid]) or {}
    return {"name": row.get("name") or "", "stella": False, "key": sid}


def by(who: dict) -> str:
    """A request's `by`: `stella` for Stella (the follower lets her retire any window), else the asker's key."""
    return "stella" if who.get("stella") else who.get("key") or ""


def follower() -> str:
    """Start `cy-follow` when it is not running (kc-new runs outside the sandbox, though the asker's variables say
    otherwise)."""
    os.environ.pop("CLAUDECODE", None)
    return cy().start_follower()


def cy_command(*args: str, by: str) -> str:
    """The line a new window runs: `cy` from this checkout, told who started the session."""
    return f"CY_STARTED_BY={shlex.quote(by)} " + " ".join(shlex.quote(a) for a in (str(Path(__file__).resolve().with_name("cy")), *args))


def refuse_window_name(name: str, advice: str = "pick another name") -> None:
    busy = cy().name_in_use(name)
    if busy:
        raise ValueError(f"cy: {name} is already live in {busy}; {advice}")
    refuse_live_name(name, advice)


def start_window(req: dict, who: dict) -> tuple[bool, str, dict]:
    """A new session in a `cy` window: the prompt in a file, the window in the space, on the asker's pinned token."""
    refuse_window_name(req["name"])
    prompts = home() / ".local/state/kc-new/prompts"
    prompts.mkdir(parents=True, exist_ok=True)
    pf = prompts / f"{req['name']}.txt"
    pf.write_text(req["prompt"])
    args = ["-n", req["name"], "--prompt-file", str(pf)]
    args += ["--model", req["model"]] if req.get("model") else []
    args += ["--effort", req["effort"]] if req.get("effort") else []
    args += ["--token-of", who["key"]] if who.get("key") else []  # the launch hook gives it the asker's pin, if any
    try:
        pane = place(req, cy_command(*args, by=by(who)))
    except RuntimeError:
        pf.unlink(missing_ok=True)  # no window will read it
        raise
    seen = cy().wait_for(lambda: next((l for l in cy().launches() if l.get("name") == req["name"]
                                       and l.get("status") == "live"), None), float(os.environ.get("KC_NEW_START_WAIT", "20")))
    info = {"ok": True, "name": req["name"], "space": req["space"], "pane": pane, "window": True,
            **({"id": seen["id"]} if seen else {"warning": "the window is open; the session has not started yet"})}
    line = f"kc-new: started session {req['name']} in a window in space {req['space']}" + (
        "" if seen else "; WARNING: it has not started yet (look at the window)")
    return True, line, info


def queue(kind: str, l: dict, body: dict, who: dict) -> tuple[bool, str, dict]:
    path = cy().submit(l["id"], kind, body, by=by(who))
    state = follower()
    return True, f"kc-new: queued {kind} of {l.get('name')}: {path} (it runs when the session is idle; " \
                 f"the answer appears beside it as .result.json)", {"ok": True, "queued": str(path), kind: l.get("name"),
                                                                     "follower": state}


def window_restart(req: dict, l: dict, who: dict) -> tuple[bool, str, dict]:
    if set(req) - {"restart", "prompt", "fresh", "token", "force", "space"}:
        raise ValueError('a restart request has only "restart", "prompt", "fresh", "token", "force" and "space"')
    if l.get("name") == "stella":
        raise ValueError("stella is not restarted by this helper (run `stella restart`)")
    prompt, token = req.get("prompt"), req.get("token")
    if prompt is not None and (not isinstance(prompt, str) or len(prompt) > MAX_PROMPT):
        raise ValueError(f"prompt must be a string of at most {MAX_PROMPT} characters")
    if token is not None and (not isinstance(token, str) or not re.match(r"^[a-z]{1,20}$", token)):
        raise ValueError("token, when given, must be a token's name")
    body = {k: v for k, v in (("prompt", prompt), ("fresh", bool(req.get("fresh"))), ("token", token)) if v}
    return queue("restart", l, body, who)


def window_rename(req: dict, l: dict, who: dict) -> tuple[bool, str, dict]:
    if set(req) - {"rename", "to"}:
        raise ValueError('a rename request has only "rename" and "to"')
    new = req.get("to")
    if not isinstance(new, str) or not NAME.match(new):
        raise ValueError("to must be lower-case letters, digits and dashes, 1-49 characters")
    if l.get("name") == "stella" or new == "stella":
        raise ValueError("stella is not renamed (her session and her tooling go by that name)")
    if new == l.get("name"):
        raise ValueError(f"{new} is already called {new}")
    refuse_window_name(new)
    return queue("rename", l, {"to": new}, who)


def window_retire(req: dict, l: dict, who: dict) -> tuple[bool, str, dict]:
    if set(req) - {"retire"}:
        raise ValueError('a retire request has only "retire"')
    if l.get("name") == "stella":
        raise ValueError("stella is not retired by this helper")
    if who.get("window") and who["window"]["id"] == l["id"]:
        raise ValueError("a session does not retire itself")
    if not who.get("stella") and (not who.get("key") or l.get("started_by") != who["key"]):
        raise ValueError(f"only the session that started {l.get('name')}, or Stella, may retire it")
    return queue("retire", l, {}, who)


def window_move(req: dict, l: dict) -> tuple[bool, str, dict]:
    if set(req) - {"move", "space"}:
        raise ValueError('a move request has only "move" and "space"')
    space = req.get("space")
    if not isinstance(space, str) or not SPACE.match(space):
        raise ValueError("space must be 1-61 characters: letters, digits, space, dot, dash, underscore, #")
    if l.get("status") != "live" or not l.get("pane"):
        raise ValueError(f"{l.get('name')} has no window (it is {l.get('status')}); open one with `cy -r {l.get('name')}`")
    if l.get("space") == space:
        return True, f"kc-new: {l.get('name')} is already in space {space}", {"ok": True, "moved": l.get("name"),
                                                                                "space": space, "unchanged": True}
    pane, wid = move_pane(l["pane"], l.get("name") or "", space)
    follower()
    return True, f"kc-new: moved {l.get('name')} to space {space}" + ("" if wid else " (new)"), {
        "ok": True, "moved": l.get("name"), "space": space, "pane": pane, "created_space": not wid}


def branch_session(req: dict, who: dict) -> tuple[bool, str, dict]:
    """A copy of a session's conversation, as a new session in its own window."""
    if set(req) - {"branch", "to", "space"}:
        raise ValueError('a branch request has only "branch", "to" and "space"')
    l = window_of(req.get("branch"))
    if not l:
        raise ValueError(f"{req.get('branch')} is not a session in a cy window")
    new, space = req.get("to"), req.get("space")
    if not isinstance(new, str) or not NAME.match(new):
        raise ValueError("to must be lower-case letters, digits and dashes, 1-49 characters")
    if not isinstance(space, str) or not SPACE.match(space):
        raise ValueError("space must be 1-61 characters: letters, digits, space, dot, dash, underscore, #")
    refuse_window_name(new)
    cwd = l.get("cwd") if l.get("cwd") and Path(l["cwd"]).is_dir() else str(home())
    pane = place({"space": space, "name": new, "dir": cwd}, cy_command("-r", l["id"], "--branch", new, by=by(who)))
    return True, f"kc-new: branched {l.get('name')} into {new}, in a window in space {space}", {
        "ok": True, "branched": l.get("name"), "to": new, "space": space, "pane": pane}


def plain_session(name) -> str | None:
    """For a name that only a plain `claude` holds: the refusal, with how to bring it under cy."""
    try:
        plain = isinstance(name, str) and any(d.get("name") == name for d in cy().registry())
    except Exception:  # noqa: BLE001 - the advice is extra; the refusal stands without it
        return None
    if plain:
        return f"{name} is not started by cy: convert it with {shlex.quote(str(Path(__file__).resolve().with_name('cag')))} adopt {name}"
    return None


def started_file() -> Path:
    return sessions().state_dir() / "started.json"


def started_by() -> dict:
    try:
        return json.loads(started_file().read_text())
    except (OSError, ValueError):
        return {}


def record_started(sid: str, caller: str) -> None:
    """Remember which session started a session, so that only that one (and Stella) may retire it later."""
    ks = sessions()
    with ks.state_lock():
        data = started_by()
        data[sid] = caller
        ks.write_json_atomic(started_file(), data)


def retire_session(req: dict, request: Path) -> tuple[bool, str, dict]:
    """Stop a session and remove its record. Only the session that started it through kc-new may ask (so a throwaway can be
    cleaned up from the sandbox), and Stella, who manages them all; never stella, the asker, or a busy session. A session in
    a git worktree is stopped but its record is kept (kc-sessions retire decides)."""
    ks = sessions()
    if set(req) - {"retire"}:
        raise ValueError('a retire request has only "retire"')
    job = resolve_target("retire", req.get("retire"))
    caller = caller_key(request)
    asker = next((j for j in ks.load_jobs() if j.id == caller), None)
    by_stella = asker is not None and asker.name == "stella" and asker.template == "stella"
    if job.id == caller:
        raise ValueError("a session does not retire itself")
    if job.name == "stella" or job.template == "stella":
        raise ValueError("stella is not retired by this helper")
    if not by_stella and started_by().get(job.id) != caller:
        raise ValueError(f"{job.name} ({job.id}) was not started by this session through kc-new; only the session that started it, or Stella, may retire it")
    if job.busy:
        raise ValueError(f"{job.name} is busy; retry when it is idle")
    lines: list[str] = []
    if not ks.retire(job.id, lines.append, remove=True):
        raise RuntimeError(f"{job.name} ({job.id}) was not retired: " + "; ".join(lines))
    with ks.state_lock():
        data = started_by()
        if data.pop(job.id, None) is not None:
            ks.write_json_atomic(started_file(), data)
    return True, f"kc-new: retired {job.name} ({job.id}): " + "; ".join(lines), {"ok": True, "retired": job.name, "id": job.id, "log": lines}


def doctor(req: dict, request: Path) -> tuple[bool, str, dict]:
    """Report on, or repair, the sessions and windows. Repair is Stella's alone, parameterless and rate-limited."""
    ks = sessions()
    what = req.get("doctor")
    if what not in ("report", "repair") or set(req) - {"doctor"}:
        raise ValueError('doctor must be "report" or "repair" and takes no other field')
    caller = caller_job(request)
    env = dict(os.environ, KC_CALLER_JOB=caller)
    if what == "repair":
        job = next((j for j in ks.load_jobs() if j.id == caller), None)
        if job is None or job.name != "stella" or job.template != "stella":
            raise ValueError("repair is only run for Stella's own session")
        stamp = home() / ".local/state/kc-sessions/last-repair"
        if stamp.exists() and time.time() - stamp.stat().st_mtime < 600:
            raise ValueError("repair ran less than 10 minutes ago")
        stamp.parent.mkdir(parents=True, exist_ok=True)
        stamp.touch()
    hook = home() / ".config/kc-sessions" / ("doctor" if what == "report" else "repair")
    usable = hook.is_file() and os.access(hook, os.X_OK)
    if what == "repair":
        # Stella's Bash call gives up after about two minutes and a repair restarts sessions one by one: run it detached,
        # log to a file, and answer at once.
        log_file = home() / ".local/state/kc-sessions/repair.log"
        log_file.parent.mkdir(parents=True, exist_ok=True)
        cmd = [str(hook)] if usable else [sys.executable, str(Path(__file__).resolve().with_name("kc-sessions")), "repair"]
        with open(log_file, "w") as out:
            subprocess.Popen(cmd, stdout=out, stderr=subprocess.STDOUT, env=env, start_new_session=True)
        return True, f"kc-new: repair started; read {log_file} in a minute or two (`ok` or `drift` lines)", {
            "ok": True, "started": True, "log": str(log_file)}
    if usable:
        p = subprocess.run([str(hook)], capture_output=True, text=True, timeout=120, env=env, start_new_session=True)
        lines, ok = (p.stdout + p.stderr).splitlines(), p.returncode == 0
    else:
        issues = ks.check(False)
        lines = [("info: " if i.get("info") else "drift: ") + ks.describe(i) for i in issues] or ["ok: nothing to fix"]
        ok = not any(not i.get("info") for i in issues)
    return ok, f"kc-new: doctor {what}: " + ("ok" if ok else "drift remains") + f" ({len(lines)} lines in the result)", {"ok": ok, "report": lines}


def handle(request: Path) -> tuple[bool, str]:
    """Process one request file; returns (succeeded, the line to print). The file is deleted first."""
    result = result_file(request)
    try:
        raw = request.read_text()
    except OSError as e:
        return False, f"kc-new: cannot read {request}: {e}"
    request.unlink(missing_ok=True)
    try:
        loaded = json.loads(raw)
    except ValueError:
        loaded = None
    kinds = [k for k in ("restart", "move", "rename", "retire", "doctor", "branch") if isinstance(loaded, dict) and k in loaded]
    if kinds:
        try:
            if len(kinds) > 1:
                raise ValueError(f"a request is one of restart, move, rename, retire, branch or doctor, not {' and '.join(kinds)}")
            kind = kinds[0]
            l = window_of(loaded[kind]) if kind in ("restart", "move", "rename", "retire") else None
            if kind == "branch":
                ok, line, info = branch_session(loaded, asker(request))
            elif l:
                ok, line, info = {"restart": lambda: window_restart(loaded, l, asker(request)),
                                  "rename": lambda: window_rename(loaded, l, asker(request)),
                                  "retire": lambda: window_retire(loaded, l, asker(request)),
                                  "move": lambda: window_move(loaded, l)}[kind]()
            else:
                try:
                    ok, line, info = {"doctor": doctor, "retire": retire_session, "restart": lambda r, _: restart_session(r),
                                      "move": lambda r, _: move_session(r),
                                      "rename": lambda r, _: rename_session(r)}[kind](loaded, request)
                except ValueError as e:
                    plain = plain_session(loaded.get(kind)) if "no session called" in str(e) else None
                    raise ValueError(plain or str(e))
        except (ValueError, RuntimeError, OSError) as e:
            result.write_text(json.dumps({"ok": False, "error": str(e)}))
            return False, f"kc-new: {e}"
        result.write_text(json.dumps(info))
        return ok, line
    try:
        req = validate(loaded)
        if windows_for(req["name"]):
            ok, line, info = start_window(req, asker(request))
            result.write_text(json.dumps(info))
            return ok, line
        sid = start_session(req)
    except (ValueError, RuntimeError, OSError) as e:
        result.write_text(json.dumps({"ok": False, "error": str(e)}))
        return False, f"kc-new: {e}"
    try:
        record_started(sid, caller_key(request))
    except OSError:
        pass  # only the later retire is lost
    warning = after_start(request, sid)
    try:
        place(req, f"claude attach {sid}")
    except RuntimeError as e:
        result.write_text(json.dumps({"ok": False, "id": sid, "error": str(e)}))
        return False, f"kc-new: session {req['name']} ({sid}) started, but no window: {e}. Attach with: claude attach {sid}"
    result.write_text(json.dumps({"ok": not warning, "id": sid, "name": req["name"], "space": req["space"],
                                  **({"warning": warning} if warning else {})}))
    return not warning, f"kc-new: started session {req['name']} ({sid}) in space {req['space']}" + (f"; WARNING: {warning}" if warning else "")


def pending() -> list[Path]:
    jobs = home() / ".claude/jobs"
    found = [p for p in jobs.glob(f"*/tmp/{REQUEST}") if p.is_file()] if jobs.is_dir() else []
    fg = window_requests()
    found += [p for p in fg.glob("*.json") if p.is_file() and not p.name.endswith(".result.json")] if fg.is_dir() else []
    return sorted(found, key=lambda p: p.stat().st_mtime)


def main() -> None:
    if len(sys.argv) > 1:
        sys.exit(__doc__)
    todo = pending()
    if not todo:
        sys.exit("kc-new: no request found: write $CLAUDE_JOB_DIR/tmp/kc-new.json (a background job) or "
                 "~/.local/state/kc-new/requests/$CLAUDE_CODE_SESSION_ID.json first (see `kc-new --help`)")
    results = [handle(p) for p in todo]
    print("\n".join(line for _, line in results))
    sys.exit(0 if all(ok for ok, _ in results) else 1)


if __name__ == "__main__":
    main()
